<nav class="pagination" role="navigation">
    {{#if pagination.prev}}
        <a class="pagination-link newer" href="{{page_url pagination.prev}}">&larr; Newer posts</a>
    {{else}}
        <span class="pagination-link is-disabled">&larr; Newer posts</span>
    {{/if}}

    <span class="pagination-meta">Page {{pagination.page}} of {{pagination.pages}}</span>

    {{#if pagination.next}}
        <a class="pagination-link older" href="{{page_url pagination.next}}">Older posts &rarr;</a>
    {{else}}
        <span class="pagination-link is-disabled">Older posts &rarr;</span>
    {{/if}}
</nav>
