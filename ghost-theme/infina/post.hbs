{{!< default}}

{{#post}}
<article class="post">

    <div class="container container-narrow">
        <header class="post-header">
            {{#primary_tag}}<a class="post-tag" href="{{url}}">{{name}}</a>{{/primary_tag}}
            <h1 class="post-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="post-lead">{{custom_excerpt}}</p>{{/if}}
            <div class="post-meta">
                {{#primary_author}}<span class="post-author-name">{{name}}</span>{{/primary_author}}
                <span class="dot">&middot;</span>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
                <span class="dot">&middot;</span>
                {{reading_time}}
            </div>
        </header>
    </div>

    {{#if feature_image}}
        <div class="container">
            <figure class="post-feature-image">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        </div>
    {{/if}}

    <div class="container container-narrow">
        <section class="post-content gh-content">
            {{content}}
        </section>

        {{#primary_author}}
        <div class="post-author-card">
            {{#if profile_image}}<img class="author-img" src="{{profile_image}}" alt="{{name}}">{{/if}}
            <div class="author-info">
                <div class="author-name">{{name}}</div>
                {{#if bio}}<div class="author-bio">{{bio}}</div>{{/if}}
            </div>
        </div>
        {{/primary_author}}
    </div>

</article>

{{#if primary_tag}}
    {{#get "posts" filter="tag:{{primary_tag.slug}}+id:-{{id}}" limit="3" as |related|}}
        {{#if related}}
        <section class="related-section">
            <div class="container">
                <h2 class="related-title">More from the blog</h2>
                <div class="post-grid">
                    {{#foreach related}}
                        {{> "post-card"}}
                    {{/foreach}}
                </div>
            </div>
        </section>
        {{/if}}
    {{/get}}
{{/if}}
{{/post}}
