    .verticals-nav button {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: white;
      cursor: pointer;
      font-size: 20px;
      color: var(--fg);
      transition: all 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .verticals-nav button:hover {
      border-color: var(--fg);
      background: var(--surface);
    }

    .verticals-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    @media (max-width: 1100px) {
      .verticals-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 600px) {
      .verticals-grid { grid-template-columns: 1fr; }
    }

    .vertical-card {
      position: relative;
      height: 420px;
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: block;
    }

    .vertical-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    .vertical-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s;
    }

    .vertical-card:hover img {
      transform: scale(1.08);
    }

    .vertical-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.75) 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 32px;
    }

    .vertical-card h3 {
      font-family: var(--font-display);
      font-size: 26px;
      font-weight: 600;
      color: white;
      letter-spacing: -0.02em;
      margin-bottom: 10px;
    }

    .vertical-card p {
      font-size: 15px;
      color: rgba(255,255,255,0.85);
      line-height: 1.5;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.3s;
    }

    .vertical-card:hover p {
      opacity: 1;
      transform: translateY(0);
    }

    .vertical-arrow {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 44px;
      height: 44px;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 18px;
      opacity: 0;
      transform: translate(10px, -10px);
      transition: all 0.3s;
    }

    .vertical-card:hover .vertical-arrow {
      opacity: 1;
      transform: translate(0, 0);
    }

    /* Partners Section */
    .partners {
      padding: 80px 0;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
      background: var(--surface);
    }

    .partners-label {
      text-align: center;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--muted);
      margin-bottom: 40px;
    }

    .partners-logos {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 64px;
      flex-wrap: wrap;
    }

    .partner-logo {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: -0.02em;
      transition: all 0.3s;
      cursor: default;
      opacity: 0.6;
    }

    .partner-logo:hover {
      color: var(--fg);
      opacity: 1;
      transform: scale(1.05);
    }

    /* Benefits Section */
    .benefits {
      padding: var(--section-gap) 0;
    }

    .section-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--accent);
      margin-bottom: 16px;
    }

    .section-header {
      margin-bottom: 48px;
    }

    .section-header h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 5vw, 52px);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin-bottom: 20px;
    }

    .section-header p {
      font-size: 18px;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.6;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }

    @media (max-width: 900px) {
      .benefits-grid { grid-template-columns: 1fr; }
    }

    .benefit-card {
      padding: 40px 36px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      transition: all 0.4s;
    }

    .benefit-card:hover {
      border-color: transparent;
      box-shadow: 0 20px 60px rgba(0,0,0,0.08);
      transform: translateY(-6px);
    }

    .benefit-icon {
      width: 56px;
      height: 56px;
      background: var(--accent-light);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      margin-bottom: 24px;
    }

    .benefit-card h3 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    .benefit-card p {
      font-size: 15px;
      color: var(--muted);
      line-height: 1.7;
    }

    /* Vertical Detail Sections */
    .vertical-detail {
      padding: 100px 0;
      border-top: 1px solid var(--border-light);
    }

    .vertical-detail:nth-child(even) {
      background: var(--surface);
    }

    .vertical-detail-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    @media (max-width: 900px) {
      .vertical-detail-inner { grid-template-columns: 1fr; gap: 48px; }
    }

    .vertical-detail-content h3 {
      font-family: var(--font-display);
      font-size: 36px;
      font-weight: 600;
      letter-spacing: -0.03em;
      margin-bottom: 20px;
    }

    .vertical-detail-content p {
      font-size: 16px;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 28px;
    }

    .vertical-detail-features {
      list-style: none;
    }

    .vertical-detail-features li {
      font-size: 15px;
      color: var(--fg-secondary);
      padding: 12px 0;
      border-top: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .vertical-detail-features li:last-child {
      border-bottom: 1px solid var(--border-light);
    }

    .vertical-detail-image {
      border-radius: var(--radius);
      overflow: hidden;
      aspect-ratio: 4/3;
    }

    .vertical-detail-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .check {
      width: 20px;
      height: 20px;
      background: var(--accent-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 11px;
      color: var(--accent);
    }

    /* How It Works */
    .how-it-works {
      padding: var(--section-gap) 0;
      background: var(--fg);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .how-it-works-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 20% 80%, rgba(24, 99, 220, 0.15), transparent),
        radial-gradient(ellipse 50% 30% at 80% 20%, rgba(76, 110, 230, 0.1), transparent);
      z-index: 0;
    }

    .how-it-works .container { position: relative; z-index: 1; }

    .how-it-works .section-label { color: rgba(255,255,255,0.5); }
    .how-it-works .section-header h2 { color: white; }
    .how-it-works .section-header p { color: rgba(255,255,255,0.6); }

    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }

    @media (max-width: 900px) {
      .steps-grid { grid-template-columns: 1fr; }
    }

    .step-item {
      text-align: left;
      padding: 36px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: var(--radius);
      transition: all 0.3s;
      position: relative;
    }

    .step-item:hover {
      background: rgba(255,255,255,0.08);
      transform: translateY(-4px);
    }

    .step-number {
      font-family: var(--font-display);
      font-size: 64px;
      font-weight: 700;
      color: rgba(255,255,255,0.1);
      position: absolute;
      top: 20px;
      right: 24px;
    }

    .step-item h4 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
    }

    .step-item p {
      font-size: 15px;
      color: rgba(255,255,255,0.6);
      line-height: 1.7;
    }

    /* CTA Section */
    .cta-section {
      padding: var(--section-gap) 0;
      text-align: center;
      background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
      position: relative;
    }

    .cta-section::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(24, 99, 220, 0.06), transparent 70%);
      transform: translate(-50%, -50%);
      z-index: 0;
    }

    .cta-section .container { position: relative; z-index: 1; }

    .cta-section h2 {
      font-family: var(--font-display);
      font-size: clamp(32px, 5vw, 48px);
      font-weight: 600;
      letter-spacing: -0.03em;
      margin-bottom: 20px;
    }

    .cta-section p {
      font-size: 18px;
      color: var(--muted);
      margin-bottom: 36px;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Footer */
    footer {
      padding: 60px 0;
      border-top: 1px solid var(--border-light);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 32px;
    }

    @media (max-width: 600px) {
      .footer-inner { flex-direction: column; gap: 28px; text-align: center; }
    }

    .footer-logo {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .footer-logo .logo-img { height: 80px; width: auto; display: block; }

    .footer-links {
      display: flex;
      gap: 36px;
    }

    .footer-links a {
      font-size: 14px;
      color: var(--muted);
      transition: color 0.2s;
    }

    .footer-links a:hover { color: var(--fg); }

    .footer-copy {
      font-size: 13px;
      color: var(--muted);
    }
    /* ===== Lead form ===== */
    .lead-section {
      padding: var(--section-gap) 0;
      background: linear-gradient(180deg, #f0f3f9 0%, #e8edf7 100%);
      color: var(--fg);
      position: relative;
      overflow: hidden;
    }
    .lead-section::before {
      content: '';
      position: absolute;
      top: -200px; right: -200px;
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(0,31,92,0.08), transparent 65%);
      filter: blur(40px);
      pointer-events: none;
    }
    .lead-section::after {
      content: '';
      position: absolute;
      bottom: -300px; left: -200px;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(0,31,92,0.05), transparent 65%);
      filter: blur(60px);
      pointer-events: none;
    }
    .lead-grid {
      display: grid;
      grid-template-columns: 1fr 1.05fr;
      gap: 80px;
      align-items: start;
      position: relative;
      z-index: 1;
    }
    @media (max-width: 900px) {
      .lead-grid { grid-template-columns: 1fr; gap: 48px; }
    }
    .lead-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: #fff;
      margin-bottom: 24px;
      padding: 6px 14px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--accent), #2278f6);
      box-shadow: 0 6px 16px -8px rgba(24,99,220,0.55);
    }
    .lead-eyebrow::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 0 4px rgba(255,255,255,0.25);
      animation: core-pill-pulse 1.6s ease-in-out infinite;
    }
    .lead-copy h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 4.5vw, 58px);
      font-weight: 700;
      line-height: 1.08;
      letter-spacing: -0.025em;
      margin-bottom: 24px;
      color: var(--fg);
    }
    .lead-copy h2 .accent {
      background: linear-gradient(135deg, var(--accent) 0%, #1863dc 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .lead-highlight {
      background: #FFD95A;
      border-radius: 6px;
      padding: 2px 6px;
      color: var(--fg);
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
    .lead-sub {
      font-size: 17px;
      color: var(--fg-secondary);
      margin-bottom: 36px;
      max-width: 460px;
      line-height: 1.55;
    }
    .lead-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 40px;
    }
    .lead-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      font-size: 15px;
      color: var(--fg);
      line-height: 1.5;
    }
    .lead-check {
      flex-shrink: 0;
      width: 24px; height: 24px;
      border-radius: 8px;
      background: var(--accent-light);
      border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
      color: var(--accent);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      margin-top: 1px;
    }
    .lead-trust {
      padding-top: 32px;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    .lead-trust-label {
      font-size: 11px; font-weight: 600;
      letter-spacing: 0.15em; text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      margin-bottom: 16px;
    }
    .lead-trust-logos {
      display: flex; flex-wrap: wrap; gap: 24px 32px;
      align-items: center;
    }
    .lead-trust-logos span {
      font-family: var(--font-display);
      font-size: 15px; font-weight: 600;
      color: rgba(255,255,255,0.55);
      letter-spacing: -0.01em;
    }

    .lead-form {
      background: #fff;
      color: var(--fg);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.05);
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
    }
    .lead-form-header {
      margin-bottom: 4px;
    }
    .lead-form-title {
      font-family: var(--font-display);
      font-size: 18px; font-weight: 700;
      letter-spacing: -0.015em;
      margin-bottom: 2px;
    }
    .lead-form-sub {
      font-size: 12px; color: var(--muted);
    }
    @media (max-width: 600px) {
      .lead-form { padding: 24px 20px; }
    }
    .lead-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 480px) {
      .lead-row-2 { grid-template-columns: 1fr; }
    }
    .lead-field {
      position: relative;
    }
    .lead-field input,
    .lead-field select,
    .lead-field textarea,
    .lead-combo-trigger {
      width: 100%;
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--fg);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 14px 6px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      appearance: none;
      -webkit-appearance: none;
      text-align: left;
      cursor: pointer;
      min-height: 50px;
    }
    .lead-field input,
    .lead-field textarea {
      cursor: text;
    }
    .lead-field textarea {
      resize: none;
      min-height: 70px;
      line-height: 1.5;
      padding-top: 22px;
    }
    .lead-field input:focus,
    .lead-field select:focus,
    .lead-field textarea:focus,
    .lead-combo.open .lead-combo-trigger {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-light);
    }
    .lead-field input.invalid,
    .lead-field select.invalid,
    .lead-field textarea.invalid {
      border-color: #dc2626;
    }
    .lead-field label {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 14px;
      color: var(--muted);
      pointer-events: none;
      transition: all 0.15s ease;
      background: transparent;
    }
    .lead-field.lead-textarea label {
      top: 18px;
      transform: none;
    }
    .lead-field input:focus + label,
    .lead-field input:not(:placeholder-shown) + label,
    .lead-field textarea:focus + label,
    .lead-field textarea:not(:placeholder-shown) + label,
    .lead-combo.has-value .lead-combo-trigger + label,
    .lead-combo.open .lead-combo-trigger + label {
      top: 8px;
      transform: none;
      font-size: 10px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .lead-select select {
      cursor: pointer;
      padding-right: 36px;
    }
    .lead-select select:invalid { color: transparent; }
    .lead-caret {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--fg-secondary);
      pointer-events: none;
      font-size: 18px;
      font-weight: 700;
      line-height: 1;
      transition: transform 0.2s;
    }
    .lead-combo.open .lead-caret { transform: translateY(-50%) rotate(180deg); }

    /* Custom combo (replaces select for prettier dropdown) */
    .lead-combo { position: relative; }
    .lead-combo-trigger {
      display: flex; align-items: center; justify-content: flex-start;
      padding-right: 36px;
      color: var(--fg);
    }
    .lead-combo-trigger.placeholder { color: transparent; }
    .lead-combo-menu {
      position: absolute;
      top: calc(100% + 6px); left: 0; right: 0;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
      padding: 6px;
      max-height: 240px; overflow-y: auto;
      z-index: 20;
      display: none;
      animation: lead-combo-in 0.15s ease;
    }
    .lead-combo.open .lead-combo-menu { display: block; }
    @keyframes lead-combo-in {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .lead-combo-option {
      padding: 10px 12px;
      font-size: 14px;
      color: var(--fg);
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.1s;
      display: flex; align-items: center; gap: 10px;
    }
    .lead-combo-option:hover,
    .lead-combo-option.active {
      background: var(--accent-light);
      color: var(--accent);
    }
    .lead-combo-option.selected::after {
      content: '✓';
      margin-left: auto;
      color: var(--accent);
      font-weight: 700;
    }
    .lead-consent {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
      cursor: pointer;
      margin-top: 2px;
    }
    .lead-consent input {
      margin-top: 2px;
      accent-color: var(--accent);
      width: 14px; height: 14px;
      flex-shrink: 0;
    }
    .lead-policy {
      font-size: 12px;
      color: var(--muted);
    }
    .lead-policy a {
      text-decoration: underline;
      color: var(--fg-secondary);
    }
    .lead-submit {
      align-self: stretch;
      justify-content: center;
      background: var(--accent);
      color: #fff;
      border: 0;
      border-radius: 12px;
      padding: 14px 28px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform 0.15s, opacity 0.15s, background 0.15s, box-shadow 0.2s;
      margin-top: 4px;
      position: relative;
      overflow: hidden;
    }
    .lead-submit:hover {
      background: color-mix(in oklab, var(--accent) 85%, #000);
      transform: translateY(-1px);
      box-shadow: 0 12px 30px rgba(24,99,220,0.35);
    }
    .lead-submit::after {
      content: '→';
      font-size: 18px;
      transition: transform 0.2s;
    }
    .lead-submit:hover::after { transform: translateX(4px); }
    .lead-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .lead-submit-spinner {
      display: none;
      width: 14px; height: 14px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: lead-spin 0.7s linear infinite;
    }
    .lead-submit.loading .lead-submit-spinner { display: inline-block; }
    @keyframes lead-spin { to { transform: rotate(360deg); } }
    .lead-status {
      font-size: 14px;
      min-height: 20px;
    }
    .lead-status.success { color: #059669; }
    .lead-status.error { color: #dc2626; }

    footer {
      padding: 60px 0;
      border-top: 1px solid var(--border-light);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    @media (max-width: 600px) {
      .footer-inner { flex-direction: column; gap: 28px; text-align: center; }
    }

    .footer-logo {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .footer-logo .logo-img { height: 23px; width: auto; display: block; }

    .footer-links {
      display: flex;
      gap: 36px;
    }

    .footer-links a {
      font-size: 14px;
      color: var(--muted);
      transition: color 0.2s;
    }

    .footer-links a:hover { color: var(--fg); }

    .footer-copy {
      font-size: 13px;
      color: var(--muted);
    }
  

    /* ============================================================
       === Why Inside Section - Compact with Animation           ===
       ============================================================ */
    .why-inside {
      padding: 80px 0;
      background: linear-gradient(180deg, #fafbfc 0%, #ffffff 100%);
      position: relative;
      overflow: clip;
    }
    .why-inside .container { position: relative; z-index: 2; }
    .why-inside-headline {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 700;
      margin-bottom: 72px;
      line-height: 1.15;
      color: var(--accent);
      text-align: center;
    }
    .why-wrapper {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 80px;
      align-items: center;
      max-width: 1100px;
      margin: 0 auto;
    }
    @media (max-width: 968px) {
      .why-wrapper { 
        grid-template-columns: 1fr; 
        gap: 60px;
      }
      .why-inside { padding: 80px 0; }
      .why-inside-headline { font-size: 38px; margin-bottom: 50px; }
      .why-visual { order: -1; max-width: 300px; margin: 0 auto; }
    }
    .why-list {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    .why-step {
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 20px;
      opacity: 0;
      animation: why-step-in 0.6s ease forwards;
    }
    .why-step:nth-child(1) { animation-delay: 0.1s; }
    .why-step:nth-child(2) { animation-delay: 0.25s; }
    .why-step:nth-child(3) { animation-delay: 0.4s; }
    @keyframes why-step-in {
      from { opacity: 0; transform: translateX(-20px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .why-step-num {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent), #5594e8);
      color: #fff;
      font-size: 24px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 20px rgba(24,99,220,0.25);
      flex-shrink: 0;
      transition: transform 0.3s ease;
    }
    .why-step:hover .why-step-num {
      transform: scale(1.1);
    }
    .why-step-content h3 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      color: #0a1628;
      margin-bottom: 8px;
      line-height: 1.3;
    }
    .why-step-content p {
      font-size: 15px;
      line-height: 1.65;
      color: var(--fg-secondary);
    }
    .why-step-content p strong {
      color: var(--accent);
      font-weight: 700;
    }
    
    /* Animated Visual */
    .why-visual {
      position: relative;
      width: 400px;
      height: 400px;
    }
    .why-visual-center {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 120px;
      height: 120px;
      background: linear-gradient(135deg, var(--accent), #5594e8);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 700;
      text-align: center;
      line-height: 1.3;
      box-shadow: 
        0 20px 60px rgba(24,99,220,0.3),
        inset 0 2px 8px rgba(255,255,255,0.2);
      z-index: 2;
    }
    .why-orbit {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 280px;
      height: 280px;
      margin: -140px 0 0 -140px;
      border: 2px dashed rgba(24,99,220,0.2);
      border-radius: 50%;
    }
    .why-node {
      position: absolute;
      width: 80px;
      height: 80px;
      background: #ffffff;
      border: 3px solid var(--accent);
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      box-shadow: 0 8px 24px rgba(24,99,220,0.2);
      font-size: 11px;
      font-weight: 700;
      text-align: center;
      line-height: 1.2;
      color: var(--accent);
      padding: 8px;
      animation: why-node-pulse 2s ease-in-out infinite;
    }
    .why-node:nth-child(1) {
      top: -40px;
      left: 50%;
      margin-left: -40px;
      animation-delay: 0s;
    }
    .why-node:nth-child(2) {
      bottom: -40px;
      left: 50%;
      margin-left: -40px;
      animation-delay: 0.66s;
    }
    .why-node:nth-child(3) {
      top: 50%;
      right: -40px;
      margin-top: -40px;
      animation-delay: 1.33s;
    }
    @keyframes why-node-pulse {
      0%, 100% { transform: scale(1); box-shadow: 0 8px 24px rgba(24,99,220,0.2); }
      50% { transform: scale(1.08); box-shadow: 0 12px 32px rgba(24,99,220,0.35); }
    }
    .why-node-icon {
      font-size: 24px;
    }
    .why-connector {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100px;
      height: 2px;
      background: linear-gradient(90deg, var(--accent), transparent);
      transform-origin: left center;
      opacity: 0.4;
    }
    .why-connector:nth-child(1) { transform: translate(-50%, -50%) rotate(90deg); }
    .why-connector:nth-child(2) { transform: translate(-50%, -50%) rotate(270deg); }
    .why-connector:nth-child(3) { transform: translate(-50%, -50%) rotate(0deg); }

    /* ============================================================
       === Deployments Section (Simple Cards)                    ===
       ============================================================ */
    .deployments {
      padding: 120px 0;
      background: #fafbfc;
      position: relative;
    }
    .deployments .container { 
      position: relative; 
      z-index: 2; 
      max-width: 1200px;
    }
    .deploy-headline {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 700;
      text-align: center;
      margin-bottom: 60px;
      line-height: 1.15;
      color: var(--accent);
    }
    
    /* Deployments - Image-based cards with hover overlay */
    .deploy-image-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
      max-width: 1200px;
      margin: 0 auto;
    }
    .deploy-image-card {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .deploy-image-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 40px rgba(0,0,0,0.2);
    }
    .deploy-image-wrapper {
      position: relative;
      width: 100%;
      height: 320px;
      overflow: hidden;
    }
    .deploy-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .deploy-image-card:hover img {
      transform: scale(1.1);
    }
    .deploy-image-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 100%);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .deploy-image-card:hover .deploy-image-overlay {
      opacity: 1;
    }
    .deploy-overlay-title {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 12px 0;
      line-height: 1.2;
    }
    .deploy-overlay-context {
      background: #6fa842;
      color: #ffffff;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      font-style: italic;
      margin-bottom: 16px;
      display: inline-block;
      align-self: flex-start;
    }
    .deploy-overlay-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .deploy-overlay-list li {
      font-size: 13px;
      color: rgba(255,255,255,0.95);
      line-height: 1.5;
      padding-left: 20px;
      position: relative;
    }
    .deploy-overlay-list li::before {
      content: '•';
      position: absolute;
      left: 6px;
      color: #6fa842;
      font-weight: 700;
      font-size: 16px;
    }
    @media (max-width: 1024px) {
      .deploy-image-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .deploy-image-wrapper {
        height: 280px;
      }
    }
    @media (max-width: 640px) {
      .deploy-image-grid {
        grid-template-columns: 1fr;
      }
      .deploy-image-wrapper {
        height: 320px;
      }
      .deploy-image-overlay {
        opacity: 1;
      }
      .deploy-headline { font-size: 32px; }
    }
    
    /* Old card styles - keeping for backward compat */
    .deploy-cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    @media (max-width: 1024px) {
      .deploy-cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .deploy-cards-grid {
        grid-template-columns: 1fr;
      }
      .deploy-headline { font-size: 32px; }
    }
    .deploy-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      padding: 32px 24px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      opacity: 0;
      transform: translateY(30px);
      animation: deploy-card-fade-in 0.6s ease forwards;
    }
    .deploy-card:nth-child(1) { animation-delay: 0.1s; }
    .deploy-card:nth-child(2) { animation-delay: 0.2s; }
    .deploy-card:nth-child(3) { animation-delay: 0.3s; }
    .deploy-card:nth-child(4) { animation-delay: 0.4s; }
    @keyframes deploy-card-fade-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .deploy-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--accent), #5594e8);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .deploy-card:hover::before {
      transform: scaleX(1);
    }
    .deploy-card:hover {
      border-color: var(--accent);
      box-shadow: 0 12px 40px rgba(24,99,220,0.15);
      transform: translateY(-8px);
    }
    .deploy-card-icon {
      width: 56px;
      height: 56px;
      margin-bottom: 20px;
    }
    .deploy-card-icon svg {
      width: 100%;
      height: 100%;
    }
    .deploy-card-header h3 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      color: #1e293b;
      margin: 0 0 20px 0;
      line-height: 1.3;
    }
    .deploy-card-context {
      background: linear-gradient(135deg, #1e3a8a, #2563eb);
      color: white;
      font-size: 14px;
      font-weight: 600;
      font-style: italic;
      padding: 10px 16px;
      border-radius: 10px;
      margin-bottom: 24px;
      text-align: center;
      line-height: 1.5;
      box-shadow: 0 2px 8px rgba(37,99,235,0.2);
    }
    .deploy-card-context .context-label {
      font-weight: 700;
      text-transform: uppercase;
      font-size: 13px;
      letter-spacing: 0.5px;
    }
    .deploy-card-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .deploy-card-list li {
      font-size: 14px;
      line-height: 1.6;
      color: #475569;
      padding-left: 20px;
      position: relative;
      transition: all 0.3s ease;
    }
    .deploy-card-list li::before {
      content: '•';
      position: absolute;
      left: 4px;
      color: var(--accent);
      font-weight: 700;
      font-size: 20px;
      transition: all 0.3s ease;
    }
    .deploy-card:hover .deploy-card-list li {
      color: #1e293b;
    }
    .deploy-tabs {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 48px;
      flex-wrap: wrap;
    }
    .deploy-tab {
      background: #ffffff;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 14px 24px;
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 600;
      color: #64748b;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      outline: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .deploy-tab-icon {
      font-size: 20px;
    }
    .deploy-tab:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(24,99,220,0.1);
    }
    .deploy-tab.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(24,99,220,0.25);
    }
    .deploy-content {
      display: none;
    }
    .deploy-content.active {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 28px;
      align-items: start;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
      animation: deploy-fade-in 0.4s ease;
      max-width: 1100px;
      margin: 0 auto;
    }
    @media (max-width: 968px) {
      .deploy-content.active {
        grid-template-columns: 1fr;
        gap: 36px;
        padding: 32px 24px;
      }
      .deployments { padding: 80px 0; }
      .deploy-headline { font-size: 38px; margin-bottom: 48px; }
    }
    
    /* Left: Use cases list */
    .deploy-usecases {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .deploy-usecases-header {
      display: flex;
      align-items: center;
      gap: 14px;
      padding-bottom: 16px;
      border-bottom: 2px solid #e5e7eb;
    }
    .deploy-usecases-header h3 {
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 700;
      color: var(--fg);
      margin: 0 0 2px 0;
    }
    .deploy-usecases-header p {
      font-size: 12px;
      color: var(--fg-secondary);
      margin: 0;
    }
    .deploy-specialist-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #f0f4ff, #e8f1ff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }
    .deploy-bullet-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .deploy-bullet {
      padding: 11px 14px;
      font-size: 13px;
      font-weight: 500;
      color: var(--fg-secondary);
      background: #ffffff;
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      line-height: 1.4;
    }
    .deploy-bullet:hover {
      border-color: var(--accent);
      color: var(--accent);
      background: rgba(24,99,220,0.03);
    }
    .deploy-bullet.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #ffffff;
      font-weight: 600;
      box-shadow: 0 4px 12px rgba(24,99,220,0.25);
    }
    }
    .deploy-bullet.active::before {
      color: var(--accent);
      content: '▸';
    }
    
    /* Right demo area */
    .deploy-demo-container {
      position: relative;
      min-height: 480px;
    }
    .deploy-panel {
      display: none;
      animation: deploy-fade-in 0.4s ease;
    }
    .deploy-panel.active {
      display: block;
    }
    @keyframes deploy-fade-in {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .deploy-demo-inner {
      background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
      border: 2px solid #60a5fa;
      border-radius: 16px;
      padding: 20px;
      min-height: 240px;
      max-height: 340px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 16px rgba(96,165,250,0.15);
    }
    .deploy-demo-inner::before {
      content: "";
      position: absolute;
      top: -100px;
      right: -100px;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(59,130,246,0.18), transparent 60%);
      pointer-events: none;
    }
    .deploy-demo-badge {
      position: absolute;
      top: 20px;
      right: 20px;
      background: rgba(24,99,220,0.1);
      color: var(--accent);
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 6px 12px;
      border-radius: 6px;
      border: 1px solid rgba(24,99,220,0.2);
      z-index: 3;
    }
    .deploy-demo-content {
      position: relative;
      z-index: 2;
    }
    
    /* Chat-style demos */
    .demo-chat {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .chat-msg {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .chat-msg.user {
      flex-direction: row-reverse;
      justify-content: flex-start;
    }
    .chat-msg.ai {
      flex-direction: row;
    }
    .chat-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f0f4ff, #e8f1ff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .chat-msg.ai .chat-avatar {
      background: linear-gradient(135deg, var(--accent), #5594e8);
    }
    .chat-bubble {
      background: #f8fafc;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 12px 14px;
      font-size: 13px;
      line-height: 1.6;
      color: var(--fg);
      max-width: 100%;
    }
    .chat-msg.user .chat-bubble {
      background: var(--accent);
      color: #ffffff;
      border-color: var(--accent);
    }
    .chat-msg.ai .chat-bubble {
      background: linear-gradient(135deg, #f8fafe 0%, #ffffff 100%);
      border-color: rgba(24,99,220,0.15);
    }
    .chat-bubble p {
      margin: 0 0 10px 0;
    }
    .chat-bubble p:last-child {
      margin-bottom: 0;
    }
    .chat-bubble b {
      color: var(--accent);
      font-weight: 600;
    }
    .chat-data {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 10px 12px;
      margin: 8px 0;
      font-size: 12px;
    }
    .chat-data-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      border-bottom: 1px solid #f1f5f9;
      gap: 12px;
    }
    .chat-data-row:last-of-type {
      border-bottom: none;
    }
    .chat-data-row.highlight {
      background: rgba(24,99,220,0.06);
      margin: -4px -8px 4px -8px;
      padding: 8px 8px;
      border-radius: 6px;
      border-bottom: none;
    }
    .chat-data-sub {
      font-size: 11px;
      color: var(--fg-secondary);
      line-height: 1.5;
      padding: 4px 0 8px 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .chat-data-sub:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .chat-data .pos {
      color: #0e7c3e;
      font-weight: 600;
    }
    .chat-data .neg {
      color: #dc2626;
      font-weight: 600;
    }
    
    .deploy-demo {
      display: none;
      animation: deploy-fade-in 0.4s ease;
    }
    .deploy-demo.active {
      display: block;
    }
    .deploy-features li::before {
      content: '✓';
      position: absolute;
      left: 8px;
      top: 12px;
      width: 22px;
      height: 22px;
      background: linear-gradient(135deg, var(--accent), #5594e8);
      border-radius: 50%;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.25s ease;
    }
    .deploy-features li.is-active::before {
      transform: scale(1.15);
      box-shadow: 0 4px 12px rgba(24,99,220,0.3);
    }
    .deploy-info-cta {
      display: inline-flex;
