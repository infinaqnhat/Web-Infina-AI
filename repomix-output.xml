    .vsd-travel-chat { background: #fff; border: 1px solid var(--border-light); border-radius: 16px; overflow: hidden; box-shadow: 0 24px 48px -20px rgba(15,23,42,.14); display: flex; flex-direction: column; min-height: 460px; }
    .vsd-tc-hd { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--border-light); }
