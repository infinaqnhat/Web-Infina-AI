.focus-alignment-page .prio-item-name { font-size: 12px; font-weight: 600; color: var(--fg); margin-bottom: 6px; }
.focus-alignment-page .prio-bar { height: 3px; border-radius: 2px; }
.focus-alignment-page .prio-bar-blue { background: var(--blue); width: 70%; }
.focus-alignment-page .prio-bar-purple { background: #1863dc; width: 40%; }
.focus-alignment-page .prio-queue-card { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; margin-bottom: 6px; }
.focus-alignment-page .hero-teammates { display: flex; align-items: center; gap: 6px; padding: 8px 4px 4px; margin-top: auto; }
.focus-alignment-page .teammate-avatars { display: flex; }
.focus-alignment-page .teammate-avatar { width: 26px; height: 26px; border-radius: 50%; border: 2px solid #fff; margin-right: -7px; font-size: 8px; font-weight: 700; color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.focus-alignment-page .teammate-overflow { width: 26px; height: 26px; border-radius: 50%; border: 2px solid #fff; margin-right: -7px; font-size: 8px; font-weight: 700; color: var(--muted); background: var(--surface); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.focus-alignment-page .teammate-text { font-size: 11px; color: var(--muted); margin-left: 14px; font-weight: 500; line-height: 1.4; }

/* ── Section shared ─────────────────────────────────────────────── */
.focus-alignment-page .section { padding: var(--section-gap) 0; }
.focus-alignment-page .section-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); margin-bottom: 16px; text-align: center; }
.focus-alignment-page .section-header { text-align: center; margin-bottom: 64px; }
.focus-alignment-page .section-header h2 { font-family: var(--font-display); font-size: clamp(30px, 4vw, 46px); font-weight: 700; letter-spacing: -.03em; line-height: 1.2; margin-bottom: 20px; color: #001964; }
.focus-alignment-page .section-header p { font-size: 17px; color: var(--muted); max-width: 600px; line-height: 1.7; margin: 0 auto; }
.focus-alignment-page .accent-blue-text { background: linear-gradient(135deg, var(--accent, #001F5C) 0%, #6fa8ff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }

/* ── Context / Chat window ──────────────────────────────────────── */
.focus-alignment-page .context-section { background: #fff; }
.focus-alignment-page .context-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
@media (max-width: 960px) { .focus-alignment-page .context-grid { grid-template-columns: 1fr; gap: 48px; } }
.focus-alignment-page .chat-window { background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,.08); }
.focus-alignment-page .chat-titlebar { background: #fff; padding: 12px 16px; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between; position: relative; }
.focus-alignment-page .chat-dots { display: flex; gap: 6px; }
.focus-alignment-page .chat-dots span { width: 12px; height: 12px; border-radius: 50%; }
.focus-alignment-page .chat-title-text { font-size: 13px; font-weight: 600; color: var(--fg); position: absolute; left: 50%; transform: translateX(-50%); }
.focus-alignment-page .chat-online { font-size: 12px; color: #22c55e; font-weight: 600; display: flex; align-items: center; gap: 5px; }
.focus-alignment-page .chat-online::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #22c55e; display: inline-block; }
.focus-alignment-page .chat-body { padding: 20px; min-height: 300px; display: flex; flex-direction: column; gap: 16px; position: relative; }
.focus-alignment-page .chat-msg-user { display: flex; justify-content: flex-end; }
.focus-alignment-page .chat-bubble-user { background: var(--blue); color: #fff; padding: 11px 18px; border-radius: 20px 20px 4px 20px; font-size: 14px; font-weight: 500; max-width: 80%; }
.focus-alignment-page .chat-msg-ai { display: flex; gap: 10px; align-items: flex-start; }
.focus-alignment-page .chat-ai-avatar { width: 32px; height: 32px; border-radius: 8px; background: var(--blue); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.focus-alignment-page .chat-bubble-ai { background: var(--surface); border: 1px solid var(--border); border-radius: 4px 16px 16px 16px; padding: 14px 16px; font-size: 13px; line-height: 1.6; color: var(--fg); max-width: 90%; }
.focus-alignment-page .chat-typing { display: flex; align-items: center; gap: 4px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 4px 16px 16px 16px; width: fit-content; }
.focus-alignment-page .chat-typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); display: inline-block; }
.focus-alignment-page .chat-typing span:nth-child(1) { animation: fa-typing-dot 1.2s ease-in-out infinite; }
.focus-alignment-page .chat-typing span:nth-child(2) { animation: fa-typing-dot 1.2s ease-in-out .2s infinite; }
.focus-alignment-page .chat-typing span:nth-child(3) { animation: fa-typing-dot 1.2s ease-in-out .4s infinite; }
.focus-alignment-page .chat-prompt-bar { padding: 12px 16px; border-top: 1px solid var(--border-light); display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; background: #fff; }
.focus-alignment-page .chat-prompt-bar::-webkit-scrollbar { display: none; }
.focus-alignment-page .chat-prompt-btn { flex-shrink: 0; padding: 8px 14px; border-radius: 999px; font-size: 12px; font-weight: 600; border: 1.5px solid var(--border); background: #fff; color: var(--fg-secondary); cursor: pointer; transition: all .2s; white-space: nowrap; }
.focus-alignment-page .chat-prompt-btn:hover { border-color: var(--blue); color: var(--blue); }
.focus-alignment-page .chat-prompt-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); }
.focus-alignment-page .context-check-list { list-style: none; display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px; }
.focus-alignment-page .context-check-list li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: var(--fg); }
.focus-alignment-page .check-icon { width: 24px; height: 24px; border-radius: 50%; border: 1.5px solid var(--blue); color: var(--blue); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }
.focus-alignment-page .pro-tip-box { background: var(--accent-light); border: 1px solid rgba(0,31,92,.1); border-radius: 12px; padding: 18px 20px; }
.focus-alignment-page .pro-tip-label { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
.focus-alignment-page .pro-tip-box p { font-size: 13px; color: var(--muted); line-height: 1.6; }

/* ── Team section ───────────────────────────────────────────────── */
.focus-alignment-page .team-section { background: var(--surface); }
.focus-alignment-page .team-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
@media (max-width: 960px) { .focus-alignment-page .team-grid { grid-template-columns: 1fr; gap: 48px; } }
.focus-alignment-page .team-eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin-bottom: 20px; }
.focus-alignment-page .team-content h2 { font-family: var(--font-display); font-size: clamp(28px, 3.5vw, 44px); font-weight: 700; letter-spacing: -.03em; line-height: 1.15; margin-bottom: 20px; color: #001964; }
.focus-alignment-page .team-content p { font-size: 16px; color: var(--muted); line-height: 1.7; margin-bottom: 36px; }
.focus-alignment-page .team-features { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
@media (max-width: 480px) { .focus-alignment-page .team-features { grid-template-columns: 1fr; } }
.focus-alignment-page .team-feature h4 { font-size: 14px; font-weight: 700; color: var(--fg); margin-bottom: 6px; display: flex; align-items: center; gap: 8px; }
.focus-alignment-page .team-feature h4 svg { color: var(--blue); flex-shrink: 0; }
.focus-alignment-page .team-feature p { font-size: 13px; color: var(--muted); line-height: 1.6; }
.focus-alignment-page .team-mockup { background: #fff; border-radius: 16px; box-shadow: 0 8px 40px rgba(0,0,0,.1); overflow: hidden; }
.focus-alignment-page .team-mockup-header { padding: 16px 20px; border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: space-between; }
.focus-alignment-page .team-mockup-title { font-size: 14px; font-weight: 700; color: var(--fg); }
.focus-alignment-page .team-mockup-search { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; }
.focus-alignment-page .team-member-row { padding: 16px 20px; border-bottom: 1px solid var(--border-light); display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: center; }
.focus-alignment-page .team-member-row:last-child { border-bottom: none; }
.focus-alignment-page .team-avatar { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0; }
.focus-alignment-page .team-member-name { font-size: 14px; font-weight: 700; color: var(--fg); }
.focus-alignment-page .team-member-role { font-size: 12px; color: var(--muted); }
.focus-alignment-page .team-tasks { display: flex; flex-direction: column; gap: 6px; }
.focus-alignment-page .team-task-row { display: flex; align-items: center; justify-content: space-between; font-size: 12px; }
.focus-alignment-page .team-task-id { font-weight: 700; color: var(--blue); font-size: 11px; min-width: 48px; }
.focus-alignment-page .team-task-name { color: var(--fg); flex: 1; padding: 0 8px; }
.focus-alignment-page .status-tag { font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 4px; }
.focus-alignment-page .status-focus { background: rgba(0,31,92,.08); color: var(--accent); }
.focus-alignment-page .status-queue { background: rgba(245,158,11,.12); color: #b45309; }
.focus-alignment-page .status-blocked { background: rgba(239,68,68,.1); color: #dc2626; }
.focus-alignment-page .status-done { background: rgba(34,197,94,.1); color: #15803d; }

/* ── Integrations ───────────────────────────────────────────────── */
.focus-alignment-page .integrations-section { background: #fff; }
.focus-alignment-page .integrations-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 16px; margin-bottom: 32px; }
@media (max-width: 900px) { .focus-alignment-page .integrations-grid { grid-template-columns: repeat(4, 1fr); } }
@media (max-width: 480px) { .focus-alignment-page .integrations-grid { grid-template-columns: repeat(3, 1fr); } }
.focus-alignment-page .integration-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 24px 16px; display: flex; flex-direction: column; align-items: center; gap: 10px; transition: all .25s; cursor: default; }
.focus-alignment-page .integration-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.08); transform: translateY(-3px); border-color: rgba(0,31,92,.2); }
.focus-alignment-page .integration-card span { font-size: 12px; font-weight: 600; color: var(--fg-secondary); text-align: center; }
.focus-alignment-page .integration-note { text-align: center; font-size: 14px; color: var(--muted); }
.focus-alignment-page .integration-note strong { color: var(--fg); }

/* ── Demo band ──────────────────────────────────────────────────── */
.focus-alignment-page .demo-band { padding: var(--section-gap) 0; background: linear-gradient(135deg, #001F5C 0%, #1863dc 100%); }
.focus-alignment-page .demo-band-inner { text-align: center; }
.focus-alignment-page .demo-band h2 { font-family: var(--font-display); font-size: clamp(28px,4vw,44px); font-weight: 700; letter-spacing: -.03em; color: #fff; margin-bottom: 16px; }
.focus-alignment-page .demo-band p { font-size: 17px; color: rgba(255,255,255,.75); margin-bottom: 36px; }
.focus-alignment-page .demo-band-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
.focus-alignment-page .demo-btn-primary { background: #fff; color: #001F5C; padding: 15px 32px; border-radius: 999px; font-size: 15px; font-weight: 700; transition: all .25s; display: inline-flex; align-items: center; gap: 8px; }
.focus-alignment-page .demo-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 24px rgba(0,0,0,.15); }
.focus-alignment-page .demo-btn-secondary { background: rgba(255,255,255,.15); color: #fff; padding: 15px 32px; border-radius: 999px; font-size: 15px; font-weight: 600; border: 1.5px solid rgba(255,255,255,.3); transition: all .25s; display: inline-flex; align-items: center; gap: 8px; }
.focus-alignment-page .demo-btn-secondary:hover { background: rgba(255,255,255,.25); transform: translateY(-2px); }

/* ── Logo + Footer ────────────────────────────────────────────────────
   Restored from focus-alignment.html (source of truth) — the port omitted
   the logo sizing and the whole footer block, leaving the shared
   <LandingFooter> unstyled on this page. Scoped under .focus-alignment-page
   to match this file's convention (its `.focus-alignment-page *` reset has
   specificity (0,1,0), so a bare `footer` rule would lose to it). */
.focus-alignment-page .logo-img { height: 23px; width: auto; display: block; }

.focus-alignment-page footer { background: var(--bg); padding: 48px 0; border-top: 1px solid var(--border-light); }
.focus-alignment-page .footer-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
.focus-alignment-page .footer-logo { display: flex; align-items: center; gap: 10px; }
.focus-alignment-page .footer-logo .logo-img { height: 23px; width: auto; display: block; }
.focus-alignment-page .footer-links { display: flex; gap: 32px; }
.focus-alignment-page .footer-links a { font-size: 14px; color: var(--muted); transition: color 0.2s; }
.focus-alignment-page .footer-links a:hover { color: var(--accent); }
.focus-alignment-page .footer-copy { font-size: 13px; color: var(--muted); }

@media (max-width: 640px) {
  .focus-alignment-page .footer-inner { flex-direction: column; text-align: center; }
}
