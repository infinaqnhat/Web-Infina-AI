/*
 * landing-home.css
 * Component-specific styles for the home page port (LandingHome.tsx).
 * Extracted verbatim from public/landing-html/home.html <style> blocks.
 *
 * SCOPE: These rules are intentionally NOT wrapped in .landing-root because
 * they reference many nested selectors including <nav>, <footer>, and
 * pseudo-elements that are complex to re-scope without risking selector drift.
 * The .landing-root wrapper in LandingLayout provides page-level isolation.
 * Global resets (:root, *, html, body, a, .container) are omitted — they live
 * in landing.css which is always loaded first.
 *
 * SOURCE: home.html <style> blocks (lines 33–5039).
 * DO NOT edit manually — update home.html source and re-extract if needed.
 */

/* Override shared --section-gap for the home page (new design uses tighter gap) */
:root {
  --section-gap: clamp(48px, 6vw, 72px);
}

@keyframes float {

      0%,
      100% {
        transform: translateY(0) rotate(0deg);
      }

      50% {
        transform: translateY(-20px) rotate(3deg);
      }
    }

    @keyframes float-reverse {

      0%,
      100% {
        transform: translateY(0) rotate(0deg);
      }

      50% {
        transform: translateY(20px) rotate(-3deg);
      }
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 0.4;
        transform: scale(1);
      }

      50% {
        opacity: 0.8;
        transform: scale(1.05);
      }
    }

    @keyframes gradient-shift {
      0% {
        background-position: 0% 50%;
      }

      50% {
        background-position: 100% 50%;
      }

      100% {
        background-position: 0% 50%;
      }
    }

    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes counter {
      from {
        opacity: 0;
        transform: scale(0.8);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-light);
      z-index: 1000;
    }

    /* .nav-inner layout owned by .landing-root nav .nav-inner in landing.css */

    .logo {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.03em;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-img {
      height: 23px;
      width: auto;
      display: block;
    }

    .logo:hover .logo-img {
      height: 23px;
      width: auto;
      display: block;
    }

    .nav-center {
      display: flex;
      align-items: center;
      gap: 40px;
    }

    .nav-center a {
      font-size: 15px;
      font-weight: 500;
      color: var(--fg-secondary);
      transition: color 0.2s;
      position: relative;
    }

    .nav-center a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--accent);
      transition: width 0.3s;
    }

    .nav-center a:hover::after {
      width: 100%;
    }

    .nav-cta {
      background: var(--accent);
      color: white;
      padding: 11px 22px;
      border-radius: 9999px;
      font-size: 14px;
      font-weight: 500;
      transition: all 0.3s;
    }

    .nav-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    .nav-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      color: var(--fg-secondary);
      transition: color 0.2s;
    }

    .nav-toggle:hover {
      color: var(--accent);
    }

    .nav-toggle svg {
      width: 24px;
      height: 24px;
      display: block;
    }

    @media (max-width: 768px) {
      /* .nav-cta visibility owned by landing.css (desktop hidden, dropdown shown) */
      .nav-center { display: none; }
      .nav-toggle { display: block; }
    }

    .hero {
      position: relative;
      padding: clamp(100px, 14vw, 140px) 0 clamp(40px, 5vw, 64px);
      text-align: center;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 50% at 70% 30%, rgba(24, 99, 220, 0.14), transparent 60%),
        radial-gradient(ellipse 60% 50% at 20% 80%, rgba(126, 87, 194, 0.08), transparent 60%);
      z-index: 0;
    }

    .hero-grid-bg {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(to right, rgba(24, 99, 220, 0.06) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(24, 99, 220, 0.06) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
      z-index: 0;
      pointer-events: none;
    }

    /* ===== Hero centered layout ===== */
    .hero .container {
      position: relative;
      z-index: 1;
    }

    .hero-grid {
      display: block;
      text-align: center;
    }

    .hero-grid .hero-text {
      max-width: 900px;
      margin: 0 auto;
    }

    .hero-grid .hero-sub {
      margin: 0 auto 44px;
    }

    .hero-grid .hero-ctas {
      justify-content: center;
    }

    /* ===== Hero feature trio ===== */
    .hero-features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      max-width: 920px;
      margin: 8px auto 0;
    }
    .hero-feature {
      padding: 0 28px;
      text-align: center;
      border-left: 1px solid var(--border);
    }
    .hero-feature:first-child { border-left: none; }
    .hero-feature-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: #1a237e;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }
    .hero-feature-icon svg {
      width: 22px;
      height: 22px;
      stroke: #fff;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .hero-feature h3 {
      font-size: 17px;
      font-weight: 700;
      color: var(--fg);
      margin: 0 0 8px;
      letter-spacing: -0.01em;
    }
    .hero-feature p {
      font-size: 14.5px;
      color: var(--muted);
      line-height: 1.55;
      margin: 0;
    }
    .hero-feature a {
      color: var(--accent);
      font-weight: 700;
      text-decoration: underline;
    }

    @media (max-width: 760px) {
      .hero-features {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .hero-feature {
        border-left: none;
        padding: 0;
      }
    }

    @media (max-width: 960px) {
      .hero-visual {
        max-width: 480px;
        margin: 0 auto;
      }
    }

    /* ===== Hero AI visual ===== */
    .hero-visual {
      position: relative;
      aspect-ratio: 1 / 1;
      width: 100%;
      opacity: 0;
      animation: fade-up 1s ease-out 0.6s forwards;
    }

    .hv-orbit {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1px dashed rgba(24, 99, 220, 0.18);
      animation: hv-spin 40s linear infinite;
    }

    .hv-orbit.o2 {
      inset: 12%;
      border-style: solid;
      border-color: rgba(24, 99, 220, 0.08);
      animation-duration: 50s;
      animation-direction: reverse;
    }

    .hv-orbit.o3 {
      inset: 24%;
      border-color: rgba(126, 87, 194, 0.12);
      animation-duration: 30s;
    }

    @keyframes hv-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .hv-core {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 28%;
      aspect-ratio: 1 / 1;
      transform: translate(-50%, -50%);
      perspective: 1000px;
      display: flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 18px 40px rgba(24, 99, 220, 0.35));
    }

    /* Glow halo behind the cube */
    .hv-core::before {
      content: '';
      position: absolute;
      inset: 8%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(76, 143, 255, 0.35) 0%, rgba(24, 99, 220, 0.18) 35%, transparent 65%);
      filter: blur(10px);
      animation: hv-halo 4s ease-in-out infinite;
      z-index: 0;
    }

    @keyframes hv-halo {

      0%,
      100% {
        opacity: 0.6;
        transform: scale(1);
      }

      50% {
        opacity: 1;
        transform: scale(1.12);
      }
    }

    /* True 3x3x3 Rubik built from 27 mini-cubes */
    .hv-cube {
      position: relative;
      width: 1px;
      height: 1px;
      top: 50%;
      left: 50%;
      transform-style: preserve-3d;
      animation: hv-cube-rotate 28s linear infinite;
      z-index: 1;
      --u: clamp(20px, 2.6vw, 32px);
    }

    @keyframes hv-cube-rotate {
      0% {
        transform: rotateX(-22deg) rotateY(0deg);
      }

      100% {
        transform: rotateX(-22deg) rotateY(360deg);
      }
    }

    .rk-cubie {
      position: absolute;
      width: var(--u);
      height: var(--u);
      top: calc(var(--u) * -0.5);
      left: calc(var(--u) * -0.5);
      transform-style: preserve-3d;
      transform:
        translate3d(calc(var(--x) * var(--u)),
          calc(var(--y) * var(--u)),
          calc(var(--z) * var(--u)));
    }

    .rk-cubie>i {
      position: absolute;
      inset: 0;
      border: 1px solid rgba(140, 180, 255, 0.7);
      box-shadow:
        inset 0 0 12px rgba(120, 170, 255, 0.35),
        inset 0 0 0 1px rgba(180, 210, 255, 0.25);
      backface-visibility: hidden;
    }

    /* Different shading per face to read 3D — top brightest, sides medium, bottom darkest */
    .rk-cubie>i.f1 {
      background: linear-gradient(135deg, rgba(76, 143, 255, 0.7), rgba(24, 99, 220, 0.6) 60%, rgba(12, 58, 138, 0.65));
      transform: translateZ(calc(var(--u) * 0.5));
    }

    .rk-cubie>i.f2 {
      background: linear-gradient(135deg, rgba(60, 120, 230, 0.55), rgba(12, 58, 138, 0.6));
      transform: rotateY(180deg) translateZ(calc(var(--u) * 0.5));
    }

    .rk-cubie>i.f3 {
      background: linear-gradient(135deg, rgba(50, 100, 210, 0.65), rgba(12, 40, 110, 0.7));
      transform: rotateY(90deg) translateZ(calc(var(--u) * 0.5));
    }

    .rk-cubie>i.f4 {
      background: linear-gradient(135deg, rgba(50, 100, 210, 0.65), rgba(12, 40, 110, 0.7));
      transform: rotateY(-90deg) translateZ(calc(var(--u) * 0.5));
    }

    .rk-cubie>i.f5 {
      background: linear-gradient(135deg, rgba(140, 190, 255, 0.85), rgba(76, 143, 255, 0.7));
      transform: rotateX(90deg) translateZ(calc(var(--u) * 0.5));
    }

    .rk-cubie>i.f6 {
      background: linear-gradient(135deg, rgba(20, 50, 120, 0.7), rgba(8, 25, 80, 0.75));
      transform: rotateX(-90deg) translateZ(calc(var(--u) * 0.5));
    }

    /* Tech sheen overlay */
    .rk-cubie>i::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(180, 210, 255, 0.32) 0%, rgba(255, 255, 255, 0) 50%);
      pointer-events: none;
    }

    /* Halo pulse */
    .hv-core::before {
      animation: hv-halo 5s ease-in-out infinite;
    }

    .hv-core-label {
      position: absolute;
      bottom: -28px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-display);
      color: var(--accent);
      font-size: clamp(11px, 1.05vw, 13px);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      white-space: nowrap;
      text-shadow: 0 0 14px rgba(24, 99, 220, 0.5);
      z-index: 5;
    }

    .hv-core-label::before,
    .hv-core-label::after {
      content: '';
      display: inline-block;
      width: 18px;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--accent));
      vertical-align: middle;
      margin: 0 10px;
    }

    .hv-core-label::after {
      background: linear-gradient(to left, transparent, var(--accent));
    }

    .hv-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }

    .hv-line {
      stroke: var(--accent);
      stroke-width: 1;
      fill: none;
      stroke-dasharray: 4 4;
      opacity: 0.35;
    }

    .hv-pulse-dot {
      fill: var(--accent);
      filter: drop-shadow(0 0 6px var(--accent));
    }

    .hv-node {
      position: absolute;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid var(--border-light);
      border-radius: 10px;
      padding: 9px 13px;
      display: flex;
      align-items: center;
      gap: 9px;
      font-family: var(--font-body);
      font-size: 11.5px;
      font-weight: 600;
      box-shadow: 0 12px 28px -10px rgba(15, 23, 42, 0.18);
      white-space: nowrap;
      animation: hv-float 6s ease-in-out infinite;
      z-index: 6;
    }

    .hv-node-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--n-color, var(--accent));
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--n-color, var(--accent)) 18%, transparent);
      animation: hv-blink 1.6s ease-in-out infinite;
      flex-shrink: 0;
    }

    .hv-node-text small {
      display: block;
      font-size: 8.5px;
      font-weight: 500;
      color: var(--muted);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 1px;
    }

    @keyframes hv-blink {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.4;
      }
    }

    @keyframes hv-float {

      0%,
      100% {
        translate: 0 0;
      }

      50% {
        translate: 0 -5px;
      }
    }

    /* Push 4 cards OUTSIDE the visual corners so they never overlap the cube */
    .hv-node.n1 {
      top: 4%;
      left: -10%;
      --n-color: #1863dc;
      animation-delay: 0s;
    }

    .hv-node.n2 {
      top: 4%;
      right: -10%;
      left: auto;
      --n-color: #149a6e;
      animation-delay: -1.5s;
    }

    .hv-node.n3 {
      bottom: 4%;
      top: auto;
      left: -10%;
      --n-color: #7e57c2;
      animation-delay: -3s;
    }

    .hv-node.n4 {
      bottom: 4%;
      top: auto;
      right: -10%;
      left: auto;
      --n-color: #1863dc;
      animation-delay: -4.5s;
    }

    @media (max-width: 720px) {

      /* Pull cards back inside on small screens to avoid hitting page edges */
      .hv-node.n1 {
        left: -2%;
      }

      .hv-node.n2 {
