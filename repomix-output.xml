.lead-section {
  padding: var(--section-gap) 0;
  background: linear-gradient(180deg, #f0f3f9 0%, #e8edf7 100%);
  color: var(--fg);
  position: relative;
  overflow: hidden;
}
.lead-section::before {
  content: '';
  position: absolute;
  top: -200px; right: -200px;
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(0,31,92,0.08), transparent 65%);
  filter: blur(40px);
  pointer-events: none;
}
.lead-section::after {
  content: '';
  position: absolute;
  bottom: -300px; left: -200px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(0,31,92,0.05), transparent 65%);
  filter: blur(60px);
  pointer-events: none;
}
.lead-grid {
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  gap: 80px;
  align-items: start;
  position: relative;
  z-index: 1;
}
@media (max-width: 900px) {
  .lead-grid { grid-template-columns: 1fr; gap: 48px; }
}
.lead-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 600;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: #fff;
  margin-bottom: 24px;
  padding: 6px 14px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--accent), #2278f6);
  box-shadow: 0 6px 16px -8px rgba(24,99,220,0.55);
}
.lead-eyebrow::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(255,255,255,0.25);
  animation: pulse 1.6s ease-in-out infinite;
}
.lead-copy h2 {
  font-family: var(--font-display);
  font-size: clamp(36px, 4.5vw, 56px);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.025em;
  margin-bottom: 20px;
  color: var(--fg);
}
.lead-copy h2 .accent {
  background: linear-gradient(135deg, var(--accent) 0%, #1863dc 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.lead-sub {
  font-size: 17px;
  color: var(--fg-secondary);
  margin-bottom: 36px;
  max-width: 460px;
  line-height: 1.55;
}
.lead-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: 40px;
}
.lead-bullets li {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  font-size: 15px;
  color: var(--fg);
  line-height: 1.5;
}
.lead-check {
  flex-shrink: 0;
  width: 24px; height: 24px;
  border-radius: 8px;
  background: var(--accent-light);
  border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
  color: var(--accent);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  margin-top: 1px;
}

.lead-form {
  background: #fff;
  color: var(--fg);
  border-radius: 20px;
  padding: 32px;
  box-shadow: 0 30px 80px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.05);
  display: flex;
  flex-direction: column;
  gap: 12px;
  position: relative;
}
.lead-form-header {
  margin-bottom: 4px;
}
.lead-form-title {
  font-family: var(--font-display);
  font-size: 18px; font-weight: 700;
  letter-spacing: -0.015em;
  margin-bottom: 2px;
}
.lead-form-sub {
  font-size: 12px; color: var(--muted);
}
@media (max-width: 600px) {
  .lead-form { padding: 24px 20px; }
}
.lead-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
@media (max-width: 480px) {
  .lead-row-2 { grid-template-columns: 1fr; }
}
.lead-field {
  position: relative;
}
.lead-field input,
.lead-field select,
.lead-field textarea,
.lead-combo-trigger {
  width: 100%;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--fg);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 14px 6px;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
  appearance: none;
  -webkit-appearance: none;
  text-align: left;
  cursor: pointer;
  min-height: 50px;
}
.lead-field input,
.lead-field textarea {
  cursor: text;
}
.lead-field textarea {
  resize: none;
  min-height: 70px;
  line-height: 1.5;
  padding-top: 22px;
}
.lead-field input:focus,
.lead-field select:focus,
.lead-field textarea:focus,
.lead-combo.open .lead-combo-trigger {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-light);
}
.lead-field input.invalid,
.lead-field select.invalid,
.lead-field textarea.invalid {
  border-color: #dc2626;
}
.lead-field label {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  color: var(--muted);
  pointer-events: none;
  transition: all 0.15s ease;
  background: transparent;
}
.lead-field.lead-textarea label {
  top: 18px;
  transform: none;
}
.lead-field input:focus + label,
.lead-field input:not(:placeholder-shown) + label,
.lead-field textarea:focus + label,
.lead-field textarea:not(:placeholder-shown) + label,
.lead-combo.has-value .lead-combo-trigger + label,
.lead-combo.open .lead-combo-trigger + label {
  top: 8px;
  transform: none;
  font-size: 10px;
  font-weight: 600;
  color: var(--muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.lead-caret {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--fg-secondary);
  pointer-events: none;
  font-size: 18px;
  font-weight: 700;
  line-height: 1;
  transition: transform 0.2s;
}
.lead-combo.open .lead-caret { transform: translateY(-50%) rotate(180deg); }

/* Custom combo (replaces select for prettier dropdown) */
.lead-combo { position: relative; }
.lead-combo-trigger {
  display: flex; align-items: center; justify-content: flex-start;
  padding-right: 36px;
  color: var(--fg);
}
.lead-combo-trigger.placeholder { color: transparent; }
.lead-combo-menu {
  position: absolute;
  top: calc(100% + 6px); left: 0; right: 0;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  padding: 6px;
  max-height: 240px; overflow-y: auto;
  z-index: 20;
  display: none;
  animation: lead-combo-in 0.15s ease;
}
.lead-combo.open .lead-combo-menu { display: block; }
@keyframes lead-combo-in {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}
.lead-combo-option {
  padding: 10px 12px;
  font-size: 14px;
  color: var(--fg);
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.1s;
  display: flex; align-items: center; gap: 10px;
}
.lead-combo-option:hover,
.lead-combo-option.active {
  background: var(--accent-light);
  color: var(--accent);
}
.lead-combo-option.selected::after {
  content: '✓';
  margin-left: auto;
  color: var(--accent);
  font-weight: 700;
}
.lead-consent {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  color: var(--muted);
  line-height: 1.45;
  cursor: pointer;
  margin-top: 2px;
}
.lead-consent input {
  margin-top: 2px;
  accent-color: var(--accent);
  width: 14px; height: 14px;
  flex-shrink: 0;
}
.lead-submit {
  align-self: stretch;
  justify-content: center;
  background: var(--accent);
  color: #fff;
  border: 0;
  border-radius: 12px;
  padding: 14px 28px;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: transform 0.15s, opacity 0.15s, background 0.15s, box-shadow 0.2s;
  margin-top: 4px;
  position: relative;
  overflow: hidden;
}
.lead-submit:hover {
  background: color-mix(in oklab, var(--accent) 85%, #000);
  transform: translateY(-1px);
  box-shadow: 0 12px 30px rgba(24,99,220,0.35);
}
.lead-submit::after {
  content: '→';
  font-size: 18px;
  transition: transform 0.2s;
}
.lead-submit:hover::after { transform: translateX(4px); }
.lead-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.lead-submit-spinner {
  display: none;
  width: 14px; height: 14px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: lead-spin 0.7s linear infinite;
}
.lead-submit.loading .lead-submit-spinner { display: inline-block; }
@keyframes lead-spin { to { transform: rotate(360deg); } }
.lead-status {
  font-size: 14px;
  min-height: 20px;
}
.lead-status.success { color: #059669; }
.lead-status.error { color: #dc2626; }

/* Footer */
footer {
  background: var(--bg);
  padding: 48px 0;
  border-top: 1px solid var(--border-light);
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
}

.footer-logo {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.03em;
  display: flex;
  align-items: center;
  gap: 10px;
}

.footer-logo .logo-img {
  height: 23px;
  width: auto;
  display: block;
}

.footer-links {
  display: flex;
  gap: 32px;
}

.footer-links a {
  font-size: 14px;
  color: var(--muted);
  transition: color 0.2s;
}

.footer-links a:hover {
  color: var(--accent);
}

.footer-copy {
  font-size: 13px;
  color: var(--muted);
}

@media (max-width: 640px) {
  .footer-inner {
    flex-direction: column;
    text-align: center;
  }
}

@media (max-width: 720px) {
  .hero h1 { font-size: clamp(34px, 9vw, 52px); }
  .hero h1 .line { display: inline; }
  .hero h1 br { display: inline; }
  .hero-sub { font-size: 17px; }
}
@media (max-width: 640px) {
  .mission blockquote { font-size: 22px; }
  .different-grid { grid-template-columns: 1fr; }
}
@media (max-width: 420px) {
  .hero h1 { font-size: clamp(30px, 8.5vw, 38px); letter-spacing: -0.03em; }
}

/* === MOBILE RESPONSIVE OVERRIDES === */
@media (max-width: 768px) {
  /* Critical: collapse different-grid to single column at 768px */
  .different-grid { grid-template-columns: 1fr; }

  /* Critical: tighten timeline vertical line and item indent */
  .timeline::before { left: 7px; }
  .timeline-item { padding-left: 36px; }

  /* Critical: hide decorative overflow blobs to prevent horizontal scroll */
  .different::before { display: none; }
  .lead-section::before, .lead-section::after { display: none; }

  /* Moderate: reduce different-card padding on mobile */
  .different-card { padding: 20px 16px; }

  /* Moderate: reduce lead-form padding at 768px */
  .lead-form { padding: 24px 20px; }
}

@media (max-width: 480px) {
  /* Moderate: tighter container padding on small screens */
  .container { padding: 0 16px; }

  /* Moderate: reduce mission blockquote font size on small screens */
  .mission blockquote { font-size: 20px; }

  /* Moderate: compact button padding and font size on small screens */
  .btn-primary, .btn-ghost { padding: 14px 24px; font-size: 14px; }
}

/* ===== Mobile nav panel ===== */
.nav-toggle {
  display: none;
  background: none;
