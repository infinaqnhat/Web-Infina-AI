      letter-spacing: 0.12em;
      opacity: 0.6;
    }
    .surface-tab svg { width: 16px; height: 16px; opacity: 0.75; transition: opacity .2s ease; }
    .surface-tab:hover { color: var(--fg-secondary); }
    .surface-tab.is-active {
      color: #fff;
    }
    .surface-tab.is-active svg { opacity: 1; }
    .surface-tab.is-active .surface-tab-num { opacity: 0.85; }
    @media (max-width: 720px) {
      .surface-tabs {
        padding: 4px;
        gap: 4px;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        width: 100%;
        margin-bottom: 32px;
      }
      .surface-tabs::-webkit-scrollbar { display: none; }
      .surface-tab {
        padding: 12px 16px;
        font-size: 13px;
        scroll-snap-align: start;
        flex: 0 0 auto;
        min-height: 44px;
      }
      .surface-tab-indicator { display: none; }
      .surface-tab.is-active {
        background: linear-gradient(135deg, var(--accent), #2278f6);
        box-shadow: 0 6px 16px -6px rgba(24,99,220,0.55);
      }
    }

    .surface-panel-wrap {
      position: relative;
      min-height: 580px;
    }
    .surface-panel {
      display: grid;
      grid-template-columns: 1fr 1.05fr;
      gap: 80px;
      align-items: center;
      opacity: 0;
      pointer-events: none;
      position: absolute;
      inset: 0;
      transition: opacity .35s ease;
    }
    .surface-panel.is-active {
      opacity: 1;
      pointer-events: auto;
      position: relative;
    }
    .surface-panel > * { min-width: 0; }
    @media (max-width: 900px) {
      .surface-panel {
        grid-template-columns: 1fr;
        grid-template-areas: "visual" "copy";
        gap: 32px;
      }
      .surface-visual { grid-area: visual; min-height: 0; }
      .surface-copy   { grid-area: copy; }
      .surface-panel-wrap { min-height: 0; }
      .surface-tabs { display: flex; }
    }
    .surface-copy h3 {
      font-family: var(--font-display);
      font-size: clamp(22px, 2.4vw, 28px);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.3;
      color: var(--fg);
      margin-bottom: 24px;
      overflow-wrap: anywhere;
    }
    .surface-copy h3 .accent { color: var(--accent); font-weight: 700; }
    .surface-copy p {
      font-size: 16px;
      line-height: 1.65;
      color: var(--fg-secondary);
      margin-bottom: 20px;
      overflow-wrap: anywhere;
    }
    .surface-copy p:last-of-type { margin-bottom: 28px; }

    /* Inline integration code snippet */
    .surface-snippet {
      position: relative;
      margin: 0 0 28px;
      padding: 14px 16px 16px;
      background: #0f1428;
      border: 1px solid rgba(111,168,255,0.18);
      border-radius: 12px;
      font-family: ui-monospace, 'SF Mono', Menlo, monospace;
      font-size: 12.5px;
      line-height: 1.55;
      color: rgba(255,255,255,0.92);
      box-shadow: 0 14px 30px -18px rgba(15,23,42,0.45);
      overflow: hidden;
    }
    .surface-snippet::before {
      content: "";
      position: absolute; top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(111,168,255,0.55), transparent);
    }
    .surface-snippet-head {
      display: flex; align-items: center; gap: 8px;
      margin-bottom: 10px;
      font-size: 10.5px;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-family: var(--font-body);
    }
    .surface-snippet-head .dot {
      width: 5px; height: 5px;
      border-radius: 50%;
      background: #4cd584;
      box-shadow: 0 0 6px #4cd584;
    }
    .surface-snippet-head .lang { color: rgba(111,168,255,0.85); }
    .surface-snippet code { display: block; white-space: pre; overflow-x: auto; }
    .surface-snippet .tok-kw   { color: #c084fc; }
    .surface-snippet .tok-fn   { color: #6fa8ff; }
    .surface-snippet .tok-str  { color: #4cd584; }
    .surface-snippet .tok-attr { color: #f5b962; }
    .surface-snippet .tok-c    { color: #7a839a; }
    @media (max-width: 720px) {
      .surface-snippet code { white-space: pre-wrap; word-break: break-word; }
    }
    @media (max-width: 380px) {
      .phone { width: 220px; height: 440px; border-radius: 38px; }
      .phone-screen { padding: 40px 11px 14px; border-radius: 30px; }
    }
    .surface-cta {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 24px;
      background: var(--accent);
      color: #fff;
      border-radius: 999px;
      font-weight: 500;
      font-size: 15px;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .surface-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 28px -14px rgba(24,99,220,0.5);
    }
    .surface-cta::after {
      content: "→";
      transition: transform .2s ease;
    }
    .surface-cta:hover::after { transform: translateX(4px); }

    /* === Mobile SDK mock — rich phone with AI Goal advisor === */
    .surface-visual {
      position: relative;
      display: flex; justify-content: center; align-items: center;
      min-height: 500px;
    }
    .surface-visual::before {
      content: "";
      position: absolute;
      inset: 8% 12%;
      background:
        radial-gradient(ellipse at center, rgba(24,99,220,0.28) 0%, transparent 65%);
      filter: blur(28px);
      pointer-events: none;
      z-index: 0;
      animation: surface-halo 6s ease-in-out infinite;
    }
    .surface-visual > * { position: relative; z-index: 1; }
    @keyframes surface-halo {
      0%, 100% { transform: scale(1); opacity: 0.75; }
      50%      { transform: scale(1.06); opacity: 1; }
    }
    @keyframes phone-float {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }
    @keyframes ai-card-glow {
      0%, 100% { box-shadow: 0 8px 24px rgba(24,99,220,0.08), 0 0 0 0 rgba(24,99,220,0); }
      50%      { box-shadow: 0 8px 24px rgba(24,99,220,0.15), 0 0 0 4px rgba(24,99,220,0.08); }
    }
    @keyframes phone-dot-pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50%      { transform: scale(1.4); opacity: 0.6; }
    }
    @keyframes phone-progress {
      from { width: 0; }
      to { width: 62%; }
    }
    @keyframes ai-typing {
      0%, 100% { opacity: 0.4; transform: translateY(0); }
      50%      { opacity: 1; transform: translateY(-2px); }
    }

    .phone {
      position: relative;
      width: 240px;
      height: 480px;
      background:
        linear-gradient(145deg, #2a2f3a 0%, #14171f 35%, #0a0c12 65%, #1c2230 100%);
      border-radius: 44px;
      padding: 10px;
      box-shadow:
        0 50px 100px -30px rgba(24,99,220,0.35),
        0 30px 60px -20px rgba(0,0,0,0.4),
        inset 0 0 0 1px rgba(255,255,255,0.08),
        inset 0 1px 0 rgba(255,255,255,0.18),
        inset 0 -1px 0 rgba(0,0,0,0.5);
      z-index: 1;
      animation: phone-float 6s ease-in-out infinite;
    }
    .phone::before {
      content: "";
      position: absolute; inset: 0;
      border-radius: 44px;
      background: linear-gradient(160deg, rgba(255,255,255,0.18), transparent 35%, transparent 65%, rgba(255,255,255,0.06));
      pointer-events: none; mix-blend-mode: overlay;
    }
    .phone::after {
      content: "";
      position: absolute;
      left: -2px; top: 140px;
      width: 3px; height: 56px;
      background: linear-gradient(180deg, #1a1d24, #0a0c12);
      border-radius: 2px 0 0 2px;
      box-shadow: 0 76px 0 #1a1d24, 0 140px 0 #1a1d24;
    }
    .phone-notch {
      position: absolute;
      top: 18px; left: 50%;
      transform: translateX(-50%);
      width: 104px; height: 30px;
      background: #050608;
      border-radius: 999px;
      z-index: 4;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04);
    }
    .phone-notch::after {
      content: "";
      position: absolute;
      top: 50%; right: 14px;
      transform: translateY(-50%);
      width: 7px; height: 7px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #2d3548, #0a0c12 70%);
      box-shadow: inset 0 0 0 1px rgba(111,168,255,0.18);
    }
    .phone-screen {
      position: relative;
      width: 100%; height: 100%;
      background: linear-gradient(180deg, #fafafa 0%, #f4f6fb 100%);
      border-radius: 34px;
      padding: 45px 13px 16px;
      overflow: hidden;
      font-family: var(--font-body);
      color: var(--fg);
    }
    .phone-status {
      position: absolute;
      top: 13px; left: 19px; right: 19px;
      display: flex; justify-content: space-between; align-items: center;
      font-size: 9.6px; font-weight: 600;
      color: var(--fg);
      z-index: 3;
    }
    .phone-status-icons { display: flex; gap: 4px; align-items: center; }
    .phone-status-icons svg:first-child { width: 10.4px; height: 7.2px; }
    .phone-status-icons svg:last-child { width: 16px; height: 8.8px; }
    .phone-header {
      display: flex; align-items: center; gap: 7px;
      margin-bottom: 13px;
    }
    .phone-avatar {
      width: 29px; height: 29px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), #6fa8ff);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
    }
    .phone-avatar svg { width: 17.6px; height: 17.6px; }
    .phone-greeting { flex: 1; line-height: 1.2; text-align: left; }
    .phone-greeting small { display: block; font-size: 8.4px; color: var(--muted); }
    .phone-greeting strong { font-size: 11.2px; font-weight: 700; color: var(--fg); }
    .phone-icon-btn {
      width: 24px; height: 24px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--border-light);
      display: flex; align-items: center; justify-content: center;
      color: var(--muted);
      cursor: pointer;
    }
    .phone-icon-btn svg { width: 11.2px; height: 11.2px; }

    .phone-balance {
      background: linear-gradient(135deg, #0a0a0a 0%, #0f1a3a 50%, #112a5e 100%);
      border-radius: 13px;
      padding: 13px;
      color: #fff;
      margin-bottom: 9.6px;
      position: relative;
      overflow: hidden;
    }
    .phone-balance::before {
      content: "";
      position: absolute;
      inset: -30% -30% auto auto;
      width: 144px; height: 144px;
      background: radial-gradient(circle, rgba(111,168,255,0.3), transparent 70%);
      pointer-events: none;
    }
    .phone-balance-row {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 5px;
      position: relative; z-index: 1;
    }
    .phone-balance-label { font-size: 8px; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.08em; }
    .phone-balance-trend {
      display: inline-flex; align-items: center; gap: 3px;
      padding: 2.4px 5.6px;
      background: rgba(40,200,120,0.15);
      border: 1px solid rgba(40,200,120,0.3);
      border-radius: 999px;
      font-size: 8.4px; font-weight: 600;
      color: #4cd584;
    }
    .phone-balance-trend svg { width: 7.2px; height: 7.2px; }
    .phone-balance-value {
      font-family: var(--font-display);
      font-size: 17.6px; font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 9.6px;
      position: relative; z-index: 1;
    }
    .phone-balance-actions {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 5.6px;
      position: relative; z-index: 1;
    }
    .phone-action {
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(4px);
      border-radius: 7px;
      padding: 5.6px 3.2px;
      text-align: center;
      font-size: 8.4px;
      color: rgba(255,255,255,0.85);
    }
    .phone-action span { display: block; font-size: 10.4px; margin-bottom: 1.6px; color: #fff; }

    .phone-ai-card {
      background: #fff;
      border: 1px solid color-mix(in oklab, var(--accent) 20%, transparent);
      border-radius: 11px;
      padding: 9.6px;
      box-shadow: 0 6.4px 19.2px rgba(24,99,220,0.08);
      position: relative;
      animation: ai-card-glow 3s ease-in-out infinite;
    }
    .phone-ai-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 6.4px;
    }
    .phone-ai-badge {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 9.2px; font-weight: 700;
      color: var(--accent);
    }
    .phone-ai-dot {
      width: 4.8px; height: 4.8px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 4.8px var(--accent);
      animation: phone-dot-pulse 1.6s ease-in-out infinite;
    }
    .phone-ai-msg {
      font-size: 9.6px; line-height: 1.5;
      color: var(--fg-secondary);
      margin: 0 0 8px;
      text-align: left;
      font-weight: 500;
    }
    .phone-goal {
      background: #fff;
      border: 1px solid rgba(24,99,220,0.14);
      border-radius: 8.8px;
      padding: 7.2px 8.8px;
      margin-bottom: 8px;
      box-shadow: 0 1.6px 6.4px rgba(24,99,220,0.04);
    }
    .phone-goal-top {
      display: flex; align-items: center; gap: 6.4px;
      margin-bottom: 6.4px;
    }
    .phone-goal-icon {
      width: 22.4px; height: 22.4px;
      border-radius: 6.4px;
      background: linear-gradient(135deg, var(--accent), #6fa8ff);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 2.4px 8px rgba(24,99,220,0.25);
    }
    .phone-goal-icon svg { width: 12px; height: 12px; }
    .phone-goal-info { flex: 1; line-height: 1.15; text-align: left; }
    .phone-goal-info small {
      font-size: 6.8px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }
    .phone-goal-info strong {
      display: block;
      font-size: 10.4px;
      font-weight: 700;
      color: var(--fg);
      letter-spacing: -0.01em;
    }
    .phone-goal-badge {
      display: inline-flex; align-items: center; gap: 2.4px;
      font-size: 7.2px; font-weight: 700;
      color: #0e7c3e;
      background: rgba(40,200,120,0.13);
      padding: 2.4px 5.6px;
      border-radius: 999px;
      white-space: nowrap;
    }
    .phone-goal-badge svg { width: 7.2px; height: 7.2px; }
    .phone-progress {
      height: 4px;
      background: rgba(24,99,220,0.1);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 8px;
      position: relative;
    }
    .phone-progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--accent), #6fa8ff);
      border-radius: 999px;
      animation: phone-progress 2.4s cubic-bezier(0.16,1,0.3,1) 0.5s forwards;
      box-shadow: 0 0 6.4px rgba(24,99,220,0.4);
      position: relative;
    }
    .phone-progress-bar::after {
      content: "";
      position: absolute;
      top: 0; bottom: 0; right: 0;
      width: 4.8px;
      background: rgba(255,255,255,0.6);
      border-radius: 999px;
      filter: blur(1.6px);
    }
    .phone-goal-stats { display: flex; align-items: center; gap: 8px; }
    .phone-stat { flex: 1; line-height: 1.15; text-align: left; }
    .phone-stat small {
      font-size: 6.8px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: block;
      font-weight: 600;
    }
    .phone-stat strong {
      font-size: 10px;
      font-weight: 700;
      color: var(--fg);
      font-family: var(--font-display);
      letter-spacing: -0.01em;
    }
    .phone-stat-up { color: #0e7c3e !important; }
    .phone-stat-divider {
      width: 1px; height: 17.6px;
      background: rgba(24,99,220,0.12);
    }
    .phone-ai-actions { display: flex; gap: 4.8px; }
    .phone-btn-primary {
      flex: 1;
      padding: 6.4px 8px;
      border-radius: 7px;
      font-size: 9.2px; font-weight: 600;
      border: 0; cursor: pointer;
      font-family: inherit;
      display: inline-flex; align-items: center; justify-content: center; gap: 4.8px;
      background: var(--accent);
      color: #fff;
    }
    .phone-btn-primary svg { width: 9.6px; height: 9.6px; }
    .phone-ai-typing {
      position: absolute;
      bottom: -13px; left: 14px;
      display: flex; gap: 3.2px;
      padding: 4px 8px;
      background: var(--accent);
      border-radius: 999px;
      box-shadow: 0 3.2px 9.6px rgba(24,99,220,0.25);
    }
    .phone-ai-typing span {
      width: 3.2px; height: 3.2px;
      background: #fff;
      border-radius: 50%;
      opacity: 0.4;
      animation: ai-typing 1.2s ease-in-out infinite;
    }
    .phone-ai-typing span:nth-child(2) { animation-delay: 0.15s; }
    .phone-ai-typing span:nth-child(3) { animation-delay: 0.3s; }

    /* === Web Embed mock === */
    .mock-browser {
      width: 100%;
      max-width: 560px;
      background: #fff;
      border: 1px solid var(--border-light);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 30px 60px -25px rgba(24,99,220,0.25);
      position: relative;
    }
    .mock-browser-bar {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 16px;
      background: #f5f7fb;
      border-bottom: 1px solid var(--border-light);
    }
    .mock-browser-dots { display: flex; gap: 6px; }
    .mock-browser-dots span {
      width: 10px; height: 10px;
      border-radius: 50%;
      background: var(--border);
    }
    .mock-browser-url {
      flex: 1;
      padding: 5px 12px;
      background: #fff;
      border-radius: 999px;
      font-size: 11px;
      color: var(--muted);
      display: flex; align-items: center; gap: 6px;
    }
    .mock-browser-body {
      position: relative;
      padding: 20px;
      min-height: 380px;
      background: #fff;
    }
    .mock-skel-row {
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 18px;
    }
    .mock-skel-logo {
      width: 28px; height: 28px;
      border-radius: 7px;
      background: var(--accent-light);
      color: var(--accent);
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 14px;
    }
    .mock-skel-brand { font-size: 13px; font-weight: 600; }
    .mock-skel-line {
      flex: 1; height: 6px;
      background: var(--surface);
      border-radius: 999px;
    }
    .mock-skel-line.short { flex: 0 0 60px; }
    .mock-skel-line.tall { height: 10px; }
    .mock-skel-block {
      height: 14px;
      background: var(--surface);
      border-radius: 4px;
      margin-bottom: 12px;
    }
    .mock-skel-block.w70 { width: 70%; }
    .mock-skel-block.w90 { width: 90%; }
    .mock-skel-block.w50 { width: 50%; }
    .mock-skel-block.w80 { width: 80%; }
    .mock-skel-pillrow { display: flex; gap: 8px; margin-bottom: 16px; }
    .mock-skel-pill {
      height: 22px;
      background: color-mix(in oklab, var(--accent) 8%, var(--surface));
      border-radius: 999px;
    }
    .mock-skel-pill.w60 { width: 60px; }
    .mock-skel-pill.w40 { width: 40px; }

    .mock-chat {
      position: absolute;
      bottom: 16px; right: 16px;
      width: 250px;
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 20px 40px -20px rgba(0,0,0,0.25);
      overflow: hidden;
      animation: mock-chat-in .8s cubic-bezier(.22,.61,.36,1) both;
    }
    @keyframes mock-chat-in {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .mock-chat-head {
      background: var(--accent);
      color: #fff;
      padding: 10px 14px;
    }
    .mock-chat-head strong { display: block; font-size: 13px; font-weight: 600; }
    .mock-chat-head small { font-size: 9px; opacity: 0.8; letter-spacing: 0.1em; }
    .mock-chat-body {
      padding: 12px;
      display: flex; flex-direction: column; gap: 8px;
      background: #f8fafc;
    }
    .mock-chat-msg {
      max-width: 85%;
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 11px;
      line-height: 1.4;
    }
    .mock-chat-msg.user {
      align-self: flex-end;
      background: #fff;
      border: 1px solid var(--border-light);
      color: var(--fg-secondary);
    }
    .mock-chat-msg.ai {
      align-self: flex-start;
      background: var(--accent-light);
      color: var(--fg-secondary);
      display: flex; gap: 6px;
    }
    .mock-chat-msg.ai::before {
      content: "AI";
      flex-shrink: 0;
      width: 18px; height: 18px;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      font-size: 8px; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      margin-top: -1px;
    }
    .mock-chat-input {
      display: flex; align-items: center; gap: 6px;
      padding: 8px 10px;
      border-top: 1px solid var(--border-light);
