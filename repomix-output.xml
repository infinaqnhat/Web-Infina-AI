    /* ============================================================
       === SECTION 1: Infina AI Inside (Architecture)             ===
       ============================================================ */
    .core {
      position: relative;
      padding: 80px 0;
      background: var(--surface);
      overflow: hidden;
    }

    .core-left .section-eyebrow-plain { color: var(--muted); }
    .core-left h2 { color: var(--fg); }
    .core-left-desc { color: var(--muted); }

    .step-journey-panel {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 32px 24px 28px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    }

    .core-layout {
      display: grid;
      grid-template-columns: 320px minmax(0, 1fr);
      gap: 64px;
      align-items: center;
    }

    .core-left {
      position: sticky;
      top: 100px;
    }

    .core-left h2 {
      font-family: var(--font-display);
      font-size: clamp(28px, 3vw, 40px);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #001964;
      line-height: 1.15;
      margin-bottom: 16px;
    }

    .core-left .accent-text {
      background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .core-left-desc {
      font-size: 15px;
      color: var(--muted);
      line-height: 1.65;
      margin-top: 12px;
    }

    @media (max-width: 1024px) {
      .core-layout { grid-template-columns: 1fr; gap: 40px; }
      .core-left { position: static; }
    }

    /* Step journey flow */
    .step-journey {
      display: flex;
      align-items: flex-start;
      gap: 0;
      position: relative;
    }

    .step-journey .step-item {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
      background: transparent;
      border: none;
      border-radius: 0;
      padding: 0;
      transition: none;
      transform: none;
    }

    .step-journey .step-item:hover {
      background: transparent;
      transform: none;
    }

    .step-num-row {
      display: flex;
      align-items: center;
      width: 100%;
      position: relative;
    }

    .step-num {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #1863dc;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 2;
      flex-shrink: 0;
      margin: 0 auto;
      box-shadow: 0 0 0 6px rgba(24,99,220,0.08);
    }

    .step-item:last-child .step-num {
      background: #149a6e;
      box-shadow: 0 0 0 6px rgba(20,154,110,0.08);
    }

    /* Data stream connector */
    .step-connector {
      position: absolute;
      top: 17px;
      left: 50%;
      right: -50%;
      height: 2px;
      overflow: hidden;
      z-index: 1;
    }

    .step-connector-track {
      position: absolute;
      inset: 0;
      background: rgba(99,150,255,0.2);
    }

    .step-connector-stream {
      position: absolute;
      top: 0;
      left: -100%;
      width: 60%;
      height: 100%;
      background: linear-gradient(to right, transparent 0%, #1863dc 30%, #4c8ef0 60%, transparent 100%);
      animation: data-stream 1.8s ease-in-out infinite;
    }

    .step-connector-dot {
      position: absolute;
      top: -2px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #1863dc;
      animation: dot-travel 1.8s ease-in-out infinite;
    }

    .step-connector-dot:nth-child(2) { animation-delay: 0.6s; }
    .step-connector-dot:nth-child(3) { animation-delay: 1.2s; }

    @keyframes data-stream {
      0%   { left: -60%; }
      100% { left: 100%; }
    }

    @keyframes dot-travel {
      0%   { left: 0%; opacity: 0; transform: scale(0.6); }
      10%  { opacity: 1; transform: scale(1); }
      90%  { opacity: 1; transform: scale(1); }
      100% { left: 100%; opacity: 0; transform: scale(0.6); }
    }

    .step-item:last-child .step-connector { display: none; }

    .step-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: transparent;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 14px auto 10px;
    }

    .step-icon svg {
      width: 28px;
      height: 28px;
    }

    .step-item:last-child .step-icon svg {
      stroke: #149a6e;
    }

    .step-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--fg);
      margin: 0 0 6px;
      letter-spacing: -0.01em;
    }

    .step-sub {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.55;
      padding: 0 4px;
    }
    /* First section (hero) needs taller top-padding to clear fixed nav */
    .core#hero {
      padding: clamp(140px, 18vw, 180px) 0 clamp(64px, 8vw, 96px);
    }
    .core::before {
      content: "";
      position: absolute; inset: 0;
      background-image:
        radial-gradient(circle at 18% 28%, rgba(24,99,220,0.07), transparent 55%),
        radial-gradient(circle at 82% 72%, rgba(24,99,220,0.06), transparent 55%);
      pointer-events: none;
    }
    .core::after {
      /* Subtle dot grid pattern */
      content: "";
      position: absolute; inset: 0;
      background-image: radial-gradient(circle, rgba(24,99,220,0.09) 1px, transparent 1px);
      background-size: 28px 28px;
      mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.7), transparent 70%);
      -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.7), transparent 70%);
      opacity: 0.6;
      pointer-events: none;
    }
    .core .container { position: relative; z-index: 1; }

    .core-top {
      display: flex; flex-wrap: wrap; align-items: center; gap: 14px;
      margin-bottom: 24px;
    }
    .core-pill {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px;
      background: linear-gradient(135deg, var(--accent), #2278f6);
      color: #fff;
      border-radius: 999px;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      box-shadow: 0 6px 16px -8px rgba(24,99,220,0.55);
    }
    .core-pill-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 0 4px rgba(255,255,255,0.25);
      animation: core-pill-pulse 1.6s ease-in-out infinite;
    }
    @keyframes core-pill-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0.4); }
      50%      { box-shadow: 0 0 0 6px rgba(255,255,255,0); }
    }
    .core-eyebrow {
      font-size: 12px; font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .core-headline {
      font-family: var(--font-display);
      font-size: clamp(36px, 5.4vw, 64px);
      font-weight: 600;
      line-height: 1.08;
      letter-spacing: -0.025em;
      color: var(--fg);
      max-width: 980px;
      margin-bottom: 24px;
    }
    /* Hero headline uses the canonical landing clamp */
    #hero .core-headline {
      font-size: clamp(40px, 5.5vw, 72px);
      font-weight: 700;
    }
    .headline-gradient {
      background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 50%, var(--accent) 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradient-shift 4s ease infinite;
    }
    .core-headline em {
      font-style: italic;
      font-weight: 600;
      background: linear-gradient(135deg, var(--accent), #6fa8ff);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      position: relative;
    }
    .core-sub {
      font-size: 17px;
      line-height: 1.65;
      color: var(--muted);
      max-width: 720px;
      margin-bottom: 56px;
    }

    /* Architecture stage — dark card with glow */
    .core-arch {
      position: relative;
      padding: 56px 40px 44px;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(24,99,220,0.18), transparent 70%),
        linear-gradient(180deg, #0d1428 0%, #0a0f20 100%);
      border-radius: 28px;
      box-shadow:
        0 40px 100px -40px rgba(15,23,42,0.5),
        0 0 0 1px rgba(255,255,255,0.04);
      overflow: hidden;
    }
    .core-arch::before {
      /* Subtle grid */
      content: "";
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
      background-size: 32px 32px;
      mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.6), transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.6), transparent 75%);
      pointer-events: none;
    }
    .core-arch::after {
      /* Floating glow particles */
      content: "";
      position: absolute;
      top: 10%; left: 50%;
      width: 320px; height: 320px;
      background: radial-gradient(circle, rgba(24,99,220,0.25), transparent 60%);
      transform: translateX(-50%);
      filter: blur(40px);
      pointer-events: none;
    }
    .core-arch-flow {
      position: relative; z-index: 2;
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1.15fr auto 1fr;
      align-items: stretch;
      gap: 12px;
    }
    @media (max-width: 900px) {
      .core-arch { padding: 36px 20px 32px; }
      .core-arch-flow {
        grid-template-columns: 1fr;
        gap: 14px;
      }
