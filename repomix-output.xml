  animation: inside-fade-up 0.6s ease-out 0.2s forwards;
}
.inside-page .hero h1 {
  font-family: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  font-size: clamp(40px, 5.5vw, 72px);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1.05;
  margin-bottom: 28px;
  opacity: 0;
  color: #001964;
  animation: inside-fade-up 0.8s ease-out 0.3s forwards;
}
.inside-page .hero h1 .line { white-space: normal; display: inline-block; padding: 0.12em 0 0.05em; line-height: 1.15; max-width: 100%; }
.inside-page .hero h1 .line-accent {
  background: linear-gradient(135deg, #001F5C 0%, #4c6ee6 50%, #001F5C 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: inside-gradient-shift 4s ease infinite;
}
.inside-page .hero-sub {
  font-size: 20px;
  color: #6b6b76;
  max-width: 580px;
  line-height: 1.65;
  margin: 0 auto 44px;
  opacity: 0;
  animation: inside-fade-up 0.8s ease-out 0.4s forwards;
}
.inside-page .hero-ctas {
  display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
  opacity: 0;
  animation: inside-fade-up 0.8s ease-out 0.5s forwards;
}
.inside-page .btn-primary {
  background: #001F5C;
  color: white;
  padding: 16px 32px;
  border-radius: 9999px;
  font-size: 15px;
  font-weight: 500;
  transition: all 0.3s;
  display: inline-flex; align-items: center; gap: 8px;
  position: relative; overflow: hidden;
  text-decoration: none;
}
.inside-page .btn-primary::before {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transform: translateX(-100%);
  transition: transform 0.5s;
}
.inside-page .btn-primary:hover::before { transform: translateX(100%); }
.inside-page .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.2); }
.inside-page .btn-ghost {
  background: transparent;
  color: #000;
  padding: 16px 32px;
  border-radius: 9999px;
  font-size: 15px;
  font-weight: 500;
  transition: all 0.3s;
  border: 1px solid #e5e7eb;
  text-decoration: none;
}
.inside-page .btn-ghost:hover { border-color: #000; background: #fafafa; }

@media (max-width: 720px) {
  .inside-page .hero h1 { font-size: clamp(34px, 9vw, 52px); }
  .inside-page .hero h1 .line { display: inline; }
  .inside-page .hero h1 br { display: inline; }
  .inside-page .hero-sub { font-size: 17px; }
}
@media (max-width: 420px) {
  .inside-page .hero h1 { font-size: clamp(30px, 8.5vw, 38px); letter-spacing: -0.03em; }
}
@media (max-width: 768px) {
  .inside-page .shape-1, .inside-page .shape-2 { display: none; }
}

/* ── Section common ── */
.inside-page .container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}
.inside-page .container-wide {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 32px;
}
.inside-page .section-label {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: #001F5C;
  margin-bottom: 16px;
}
.inside-page .section-header { margin-bottom: 64px; }
.inside-page .section-header h2 {
  font-family: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  font-size: clamp(36px, 5vw, 52px);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin-bottom: 20px;
  color: #001964;
}
.inside-page .section-header p { font-size: 18px; color: #6b6b76; max-width: 520px; line-height: 1.6; }
.inside-page .accent { color: #001F5C; }

/* ── Core (How It Works — dark panel) ── */
/* Base rule superseded by new dark-layout block appended below. */
.inside-page .core .container { position: relative; z-index: 1; }
.inside-page .core-top {
  display: flex; flex-wrap: wrap; align-items: center; gap: 14px;
  margin-bottom: 24px;
}
.inside-page .core-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 14px;
  background: linear-gradient(135deg, #001F5C, #2278f6);
  color: #fff;
  border-radius: 999px;
  font-size: 12px; font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  box-shadow: 0 6px 16px -8px rgba(24,99,220,0.55);
}
.inside-page .core-pill-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(255,255,255,0.25);
  animation: inside-core-pill-pulse 1.6s ease-in-out infinite;
}
.inside-page .core-eyebrow {
  font-size: 12px; font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #6b6b76;
}
.inside-page .core-headline {
  font-family: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  font-size: clamp(36px, 5.4vw, 64px);
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.025em;
  color: #000;
  max-width: 980px;
  margin-bottom: 24px;
}
.inside-page #hero .core-headline {
  font-size: clamp(40px, 5.5vw, 72px);
  font-weight: 700;
}
.inside-page .headline-gradient {
  background: linear-gradient(135deg, #001F5C 0%, #4c6ee6 50%, #001F5C 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: inside-gradient-shift2 4s ease infinite;
}
.inside-page .core-headline em {
  font-style: italic;
  font-weight: 600;
  background: linear-gradient(135deg, #001F5C, #6fa8ff);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
.inside-page .core-sub {
  font-size: 17px;
  line-height: 1.65;
  color: #6b6b76;
  max-width: 720px;
  margin-bottom: 56px;
}
.inside-page .core-arch {
  position: relative;
  padding: 56px 40px 44px;
  background:
    radial-gradient(ellipse 80% 60% at 50% 0%, rgba(24,99,220,0.18), transparent 70%),
    linear-gradient(180deg, #0d1428 0%, #0a0f20 100%);
