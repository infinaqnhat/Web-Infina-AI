<!DOCTYPE html>
<html lang="en">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Focus & Alignment Agent · Infina AI Work</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #ffffff;
      --surface: #fafafa;
      --fg: #1a1f2e;
      --fg-secondary: #334155;
      --muted: #64748b;
      --border: #e5e7eb;
      --border-light: #f2f2f2;
      --accent: #001F5C;
      --accent-dark: #001340;
      --accent-light: rgba(0, 31, 92, 0.08);
      --blue: #1863dc;
      --blue-light: rgba(24, 99, 220, 0.08);
      --font-display: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
      --font-body: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
      --section-gap: 96px;
      --radius: 20px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); background: var(--bg); color: var(--fg); line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }

    @keyframes fade-up { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes gradient-shift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
    @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
    @keyframes typing-dot { 0%,80%,100%{transform:scale(0);opacity:.3} 40%{transform:scale(1);opacity:1} }

    /* ===== NAV ===== */
    nav { position: fixed; top:0; left:0; right:0; background: rgba(255,255,255,.9); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-light); z-index: 1000; }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; max-width: 1200px; margin: 0 auto; padding: 0 32px; }
    .logo { font-family: var(--font-display); font-size: 22px; font-weight: 600; letter-spacing: -.03em; display: flex; align-items: center; gap: 10px; }
    .logo-img { height: 23px; width: auto; display: block; }
    .nav-center { display: flex; align-items: center; gap: 40px; }
    .nav-center a { font-size: 15px; font-weight: 500; color: var(--fg-secondary); transition: color .2s; position: relative; }
    .nav-center a.active { color: var(--fg); }
    .nav-center a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--accent); transition: width .3s; }
    .nav-center a.active::after, .nav-center a:hover::after { width: 100%; }

    /* Dropdown */
    .nav-dropdown { position: relative; }
    .nav-dropdown-toggle { font-size: 15px; font-weight: 500; color: var(--fg-secondary); transition: color .2s; position: relative; cursor: pointer; display: flex; align-items: center; gap: 4px; }
    .nav-dropdown-toggle.active { color: var(--fg); }
    .nav-dropdown-toggle::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--accent); transition: width .3s; }
    .nav-dropdown:hover .nav-dropdown-toggle::after { width: 100%; }
    .nav-dropdown-toggle svg { transition: transform .2s; }
    .nav-dropdown:hover .nav-dropdown-toggle svg { transform: rotate(180deg); }
    .nav-dropdown-menu { position: absolute; top: calc(100% + 16px); left: 50%; transform: translateX(-50%); background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,.1); padding: 6px; min-width: 200px; opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s, transform .2s; transform: translateX(-50%) translateY(-4px); }
    .nav-dropdown:hover .nav-dropdown-menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
    .nav-dropdown-menu a { display: block; padding: 10px 14px; font-size: 14px; font-weight: 500; color: var(--fg-secondary); border-radius: 8px; transition: background .15s, color .15s; white-space: nowrap; }
    .nav-dropdown-menu a:hover, .nav-dropdown-menu a.active { background: var(--accent-light); color: var(--accent); }
    .nav-dropdown-menu a::after { display: none; }
    .nav-cta { background: var(--accent); color: #fff; padding: 11px 22px; border-radius: 9999px; font-size: 14px; font-weight: 500; transition: all .3s; }
    .nav-cta:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(24,99,220,.25); }
    @media (max-width: 768px) { .nav-center { display: none; } }

    /* Mobile nav */
    .nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; color: var(--fg-secondary); }
    .nav-toggle svg { width: 24px; height: 24px; display: block; }
    .nav-mobile-panel { display: none; }
    @media (max-width: 768px) {
      .nav-toggle { display: block; }
      .nav-mobile-panel { display: flex; flex-direction: column; position: fixed; top: 72px; left: 0; right: 0; background: rgba(255,255,255,.98); backdrop-filter: blur(20px); padding: 8px 24px 20px; gap: 0; border-bottom: 1px solid var(--border-light); box-shadow: 0 10px 30px rgba(0,0,0,.06); transform: translateY(-12px); opacity: 0; visibility: hidden; transition: transform .25s ease, opacity .25s ease, visibility .25s ease; z-index: 999; }
      body.nav-open .nav-mobile-panel { transform: translateY(0); opacity: 1; visibility: visible; }
      .nav-mobile-panel a { padding: 14px 6px; font-size: 16px; font-weight: 500; color: var(--fg-secondary); border-bottom: 1px solid var(--border-light); }
      .nav-mobile-panel a:last-child { border-bottom: none; }
      .nav-mobile-panel a.nav-mobile-cta { margin-top: 14px; text-align: center; background: var(--accent); color: #fff; padding: 14px 24px; border-radius: 9999px; border: none; font-weight: 600; }
      body.nav-open { overflow: hidden; }
    }

    @keyframes float { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(-20px) rotate(3deg)} }
    @keyframes float-reverse { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(20px) rotate(-3deg)} }
    @keyframes pulse { 0%,100%{opacity:.4;transform:scale(1)} 50%{opacity:.8;transform:scale(1.05)} }

    /* ===== HERO ===== */
    .hero { padding: clamp(130px, 16vw, 160px) 0 clamp(60px, 8vw, 80px); background: #fff; position: relative; overflow: hidden; }
    .hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 50% at 70% 30%, rgba(24,99,220,.14), transparent 60%), radial-gradient(ellipse 60% 50% at 20% 80%, rgba(126,87,194,.08), transparent 60%); z-index: 0; pointer-events: none; }
    .hero-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(24,99,220,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(24,99,220,.06) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); z-index: 0; pointer-events: none; }
    .fa-shape { position: absolute; border-radius: 50%; z-index: 0; pointer-events: none; }
    .fa-shape-1 { width:400px;height:400px;background:linear-gradient(135deg,rgba(24,99,220,.08),transparent);top:10%;right:-10%;animation:float 8s ease-in-out infinite; }
    .fa-shape-2 { width:300px;height:300px;background:linear-gradient(135deg,rgba(24,99,220,.05),transparent);bottom:20%;left:-5%;animation:float-reverse 10s ease-in-out infinite; }
    .fa-shape-3 { width:200px;height:200px;border:1px solid var(--border-light);top:30%;left:10%;animation:pulse 6s ease-in-out infinite; }
    .fa-shape-4 { width:150px;height:150px;border:1px solid var(--border-light);bottom:30%;right:15%;animation:pulse 8s ease-in-out infinite;animation-delay:2s; }
    .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; position: relative; z-index: 1; }
    @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; gap: 48px; } }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .15em; padding: 0; border: none; border-radius: 0; background: none; margin-bottom: 24px; opacity: 0; animation: fade-up .6s ease-out .1s forwards; }
    .hero h1 { font-family: var(--font-display); font-size: clamp(36px, 5vw, 64px); font-weight: 700; letter-spacing: -.04em; line-height: 1.08; margin-bottom: 24px; opacity: 0; animation: fade-up .8s ease-out .2s forwards; color: #001964; }
    .hero h1 .accent-blue { background: linear-gradient(135deg, var(--accent, #001F5C) 0%, #1863dc 50%, #6fa8ff 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradient-shift 4s ease infinite; }
