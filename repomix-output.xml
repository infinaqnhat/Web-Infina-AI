 */

type ExpandCard = "c1" | "c4" | "c5" | "c6" | null;

const CARD_ROW: Record<NonNullable<ExpandCard>, "row1" | "row2"> = {
  c1: "row1",
  c4: "row2",
  c5: "row2",
  c6: "row2",
};

