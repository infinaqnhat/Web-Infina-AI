      color: var(--fg);
      box-shadow: 0 24px 48px -20px rgba(0,0,0,0.4), 0 0 0 1px rgba(24,99,220,0.4), 0 0 40px -8px rgba(24,99,220,0.5);
    }
    .core-node--platform .core-node-icon {
      background: linear-gradient(135deg, var(--accent), #6fa8ff);
      color: #fff;
      box-shadow: 0 6px 14px -4px rgba(24,99,220,0.6);
    }
    .core-platform-title {
      font-family: var(--font-display);
      font-size: 14px; font-weight: 700;
      color: var(--fg);
      letter-spacing: -0.01em;
      margin-bottom: 10px;
    }
    .core-platform-row {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 10px;
      background: linear-gradient(135deg, #f7faff, #eef3fc);
      border: 1px solid rgba(24,99,220,0.12);
      border-radius: 9px;
