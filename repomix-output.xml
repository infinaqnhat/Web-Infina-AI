/*
 * landing-inside.css
 * Component-specific styles for the inside page port (LandingInside.tsx).
 * Extracted verbatim from public/landing-html/inside.html <style> block
 * (lines 10–4766). Global resets (:root, *, html, body, a, .container) are
 * omitted — they live in landing.css. Keyframe names that collide with other
 * page CSS are prefixed with `inside-`.
 *
 * SCOPE: All rules are intentionally unscoped to match the original CSS
 * selector patterns. .inside-page wrapper in LandingInside.tsx provides
 * page-level isolation for the div wrapper.
 */

/* ── Keyframes ── */
@keyframes inside-float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(3deg); }
}
@keyframes inside-float-reverse {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(20px) rotate(-3deg); }
}
@keyframes inside-pulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.05); }
}
@keyframes inside-gradient-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes inside-fade-up {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-core-pill-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0.4); }
  50% { box-shadow: 0 0 0 6px rgba(255,255,255,0); }
}
@keyframes inside-core-flow-dot {
  0% { left: -5px; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { left: calc(100% - 5px); opacity: 0; }
}
@keyframes inside-core-flow-dot-vertical {
  0% { top: -5px; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { top: calc(100% - 5px); opacity: 0; }
}
@keyframes inside-surface-halo {
  0%, 100% { transform: scale(1); opacity: 0.75; }
  50% { transform: scale(1.06); opacity: 1; }
}
@keyframes inside-phone-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
@keyframes inside-ai-card-glow {
  0%, 100% { box-shadow: 0 8px 24px rgba(24,99,220,0.08), 0 0 0 0 rgba(24,99,220,0); }
  50% { box-shadow: 0 8px 24px rgba(24,99,220,0.15), 0 0 0 4px rgba(24,99,220,0.08); }
}
@keyframes inside-phone-dot-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.4); opacity: 0.6; }
}
@keyframes inside-phone-progress {
  from { width: 0; }
  to { width: 62%; }
}
@keyframes inside-ai-typing {
  0%, 100% { opacity: 0.4; transform: translateY(0); }
  50% { opacity: 1; transform: translateY(-2px); }
}
@keyframes inside-mock-chat-in {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-why-step-in {
  from { opacity: 0; transform: translateX(-20px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes inside-why-node-pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 8px 24px rgba(24,99,220,0.2); }
  50% { transform: scale(1.08); box-shadow: 0 12px 32px rgba(24,99,220,0.35); }
}
@keyframes inside-deploy-card-fade-in {
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-deploy-fade-in {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-deploy-msg-in {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-lead-combo-in {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-lead-spin { to { transform: rotate(360deg); } }
@keyframes inside-vspec-fade {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-vsd-bar-grow { from { width: 0; } }
@keyframes inside-vsd-line-draw {
  from { stroke-dashoffset: 300; }
  to { stroke-dashoffset: 0; }
}
@keyframes inside-vsd-wave {
  0%, 100% { transform: scaleY(.5); }
  50% { transform: scaleY(1); }
}
@keyframes inside-vsd-dot {
  0%, 60%, 100% { opacity: 0; }
  30% { opacity: 1; }
}
@keyframes inside-vsd-progress {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
@keyframes inside-vsd-fade-in {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .5; transform: scale(1.3); }
}
@keyframes inside-deploy-uc-in {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes inside-gradient-shift2 {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ── Navigation ── */
.inside-page nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--inside-border-light, #f2f2f2);
  z-index: 1000;
}
/* .nav-inner layout owned by .landing-root nav .nav-inner in landing.css */
.inside-page .logo {
  font-family: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.03em;
  display: flex;
  align-items: center;
  gap: 10px;
  color: inherit;
  text-decoration: none;
}
.inside-page .logo-img { height: 23px; width: auto; display: block; }
.inside-page .nav-center {
  display: flex;
  align-items: center;
  gap: 40px;
}
.inside-page .nav-center a {
  font-size: 15px;
  font-weight: 500;
  color: #212121;
  transition: color 0.2s;
  position: relative;
  text-decoration: none;
}
.inside-page .nav-center a.active { color: #000000; }
.inside-page .nav-center a::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0;
  height: 2px;
  background: #001F5C;
  transition: width 0.3s;
}
.inside-page .nav-center a.active::after,
.inside-page .nav-center a:hover::after { width: 100%; }
.inside-page .nav-cta {
  background: #001F5C;
  color: white;
  padding: 11px 22px;
  border-radius: 9999px;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.3s;
  text-decoration: none;
}
.inside-page .nav-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}
.inside-page .nav-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  color: #212121;
}
.inside-page .nav-toggle svg { width: 24px; height: 24px; display: block; }

@media (max-width: 768px) {
  /* .nav-cta visibility owned by landing.css */
  .inside-page .nav-center { display: none; }
  .inside-page .nav-toggle { display: block; }
}

/* ── Mobile nav panel ── */
.inside-page .nav-mobile-panel { display: none; }
@media (max-width: 768px) {
  .inside-page .nav-mobile-panel {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 8px 24px 20px;
    gap: 0;
    border-bottom: 1px solid #f2f2f2;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
    z-index: 999;
  }
  .inside-page .nav-mobile-panel.is-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }
  .inside-page .nav-mobile-panel a {
    padding: 14px 6px;
    font-size: 16px;
    font-weight: 500;
    color: #212121;
    border-bottom: 1px solid #f2f2f2;
    text-decoration: none;
  }
  .inside-page .nav-mobile-panel a:last-child { border-bottom: none; }
  .inside-page .nav-mobile-panel a.nav-mobile-cta {
    margin-top: 14px;
    text-align: center;
    justify-content: center;
    background: #001F5C;
    color: #fff;
    padding: 14px 24px;
    border-radius: 9999px;
    border: none;
    font-weight: 600;
  }
}

/* ── Hero ── */
.inside-page .hero {
  position: relative;
  padding: clamp(140px, 18vw, 180px) 0 clamp(48px, 6vw, 72px);
  text-align: center;
  overflow: hidden;
}
.inside-page .hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 70% 30%, rgba(24, 99, 220, 0.14), transparent 60%),
    radial-gradient(ellipse 60% 50% at 20% 80%, rgba(126, 87, 194, 0.08), transparent 60%);
  z-index: 0;
}
.inside-page .hero-grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, rgba(24, 99, 220, 0.06) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(24, 99, 220, 0.06) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
  z-index: 0;
  pointer-events: none;
}
.inside-page .hero .container { position: relative; z-index: 1; }
.inside-page .hero-grid { display: block; text-align: center; }
.inside-page .hero-grid .hero-text { max-width: 900px; margin: 0 auto; }
.inside-page .shape {
  position: absolute;
  border-radius: 50%;
  z-index: 0;
  pointer-events: none;
}
.inside-page .shape-1 {
  width: 400px; height: 400px;
  background: linear-gradient(135deg, rgba(24, 99, 220, 0.08), transparent);
  top: 10%; right: -10%;
  animation: inside-float 8s ease-in-out infinite;
}
.inside-page .shape-2 {
  width: 300px; height: 300px;
  background: linear-gradient(135deg, rgba(24, 99, 220, 0.05), transparent);
  bottom: 20%; left: -5%;
  animation: inside-float-reverse 10s ease-in-out infinite;
}
.inside-page .shape-3 {
  width: 200px; height: 200px;
  border: 1px solid #f2f2f2;
  top: 30%; left: 10%;
  animation: inside-pulse 6s ease-in-out infinite;
}
.inside-page .shape-4 {
  width: 150px; height: 150px;
  border: 1px solid #f2f2f2;
