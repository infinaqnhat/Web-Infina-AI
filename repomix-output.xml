    /* Tech sheen overlay */
    .rk-cubie>i::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(180, 210, 255, 0.32) 0%, rgba(255, 255, 255, 0) 50%);
