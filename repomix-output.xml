.inside-page .core-layout {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 64px;
  align-items: center;
}
.inside-page .core-left {
  position: sticky;
  top: 100px;
}
.inside-page .core-left .section-eyebrow-plain { color: var(--muted); }
.inside-page .core-left h2 {
  font-family: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 16px;
  color: #001964;
}
.inside-page .core-left .accent-text {
  background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.inside-page .core-left-desc {
  font-size: 15px;
  color: var(--muted);
  line-height: 1.65;
  margin-top: 12px;
}
.inside-page .step-journey-panel {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 32px 24px 28px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.06);
}
.inside-page .step-journey {
  display: flex;
  align-items: flex-start;
  gap: 0;
  position: relative;
}
.inside-page .step-journey .step-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
}
.inside-page .step-num-row {
  display: flex;
  align-items: center;
  width: 100%;
  position: relative;
}
.inside-page .step-num {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: #1863dc;
  color: #fff;
  font-size: 14px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  position: relative; z-index: 2;
  flex-shrink: 0; margin: 0 auto;
  box-shadow: 0 0 0 6px rgba(24,99,220,0.08);
}
.inside-page .step-journey .step-item:last-child .step-num {
  background: #149a6e;
  box-shadow: 0 0 0 6px rgba(20,154,110,0.08);
}
/* Data stream connector */
.inside-page .step-connector {
  position: absolute;
  top: 17px;
  left: 50%; right: -50%;
  height: 2px;
  overflow: hidden;
  z-index: 1;
}
.inside-page .step-connector-track {
  position: absolute; inset: 0;
  background: rgba(99,150,255,0.2);
}
.inside-page .step-connector-stream {
  position: absolute; top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(to right, transparent 0%, #1863dc 30%, #4c8ef0 60%, transparent 100%);
  animation: inside-data-stream 1.8s ease-in-out infinite;
}
.inside-page .step-connector-dot {
  position: absolute; top: -2px;
  width: 6px; height: 6px;
  border-radius: 50%; background: #1863dc;
  animation: inside-dot-travel 1.8s ease-in-out infinite;
}
.inside-page .step-connector-dot:nth-child(4) { animation-delay: 0.6s; }
.inside-page .step-connector-dot:nth-child(5) { animation-delay: 1.2s; }
@keyframes inside-data-stream {
  0%   { left: -60%; }
  100% { left: 100%; }
}
@keyframes inside-dot-travel {
  0%   { left: 0%; opacity: 0; transform: scale(0.6); }
  10%  { opacity: 1; transform: scale(1); }
  90%  { opacity: 1; transform: scale(1); }
  100% { left: 100%; opacity: 0; transform: scale(0.6); }
}
.inside-page .step-journey .step-item:last-child .step-connector { display: none; }
.inside-page .step-icon {
  width: 44px; height: 44px;
  border-radius: 12px;
  background: transparent; border: none;
  display: flex; align-items: center; justify-content: center;
  margin: 14px auto 10px;
}
.inside-page .step-icon svg { width: 28px; height: 28px; }
.inside-page .step-title {
  font-size: 15px; font-weight: 700;
  color: var(--fg);
  margin: 0 0 6px; letter-spacing: -0.01em;
}
.inside-page .step-sub {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.55; padding: 0 4px;
}
@media (max-width: 1024px) {
  .inside-page .core-layout { grid-template-columns: 1fr; gap: 40px; }
  .inside-page .core-left { position: static; }
}

/* ── AI Quality tools row ── */
.inside-page .ai-quality-tools {
  margin-top: 48px;
  border-top: 1px solid #f2f2f2;
  padding-top: 36px;
}
.inside-page .ai-quality-tools-label {
  font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.14em;
  color: #6b6b76; margin-bottom: 20px; text-align: center;
}
.inside-page .ai-quality-tools-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  max-width: 820px;
  margin: 0 auto;
}
.inside-page .ai-quality-tool-card {
  display: flex; align-items: flex-start; gap: 16px;
  background: #fafafa;
  border: 1px solid #f2f2f2;
  border-radius: 14px; padding: 22px 20px;
}
.inside-page .ai-quality-tool-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(24,99,220,0.1), rgba(24,99,220,0.05));
  border: 1px solid rgba(24,99,220,0.15);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; color: #1863dc;
}
.inside-page .ai-quality-tool-icon svg { width: 18px; height: 18px; }
.inside-page .ai-quality-tool-card h4 {
  font-size: 15px; font-weight: 700; color: #000; margin-bottom: 6px;
}
.inside-page .ai-quality-tool-card p {
  font-size: 13px; color: #6b6b76; line-height: 1.6; margin: 0;
}
@media (max-width: 640px) {
  .inside-page .ai-quality-tools-row { grid-template-columns: 1fr; }
}

/* ── Meet Specialists section ── */
.inside-page .meet-specialists {
  padding: 100px 0;
  background: #fff;
}
.inside-page .meet-specialists-layout {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 64px;
  align-items: start;
}
.inside-page .meet-specialists-left {
  position: sticky;
  top: 100px;
}
.inside-page .meet-specialists-left h2 {
  font-family: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  font-size: clamp(28px, 3vw, 40px);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 16px;
  color: #001964;
}
.inside-page .meet-specialists-desc {
  font-size: 15px;
  color: #6b6b76;
  line-height: 1.65;
  margin-top: 12px;
}
.inside-page .hero-agents-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.inside-page .hero-agent-card {
  background: #fff;
  border: 1.5px solid #f2f2f2;
  border-top: 4px solid #1863dc;
  border-radius: 18px;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  text-align: left;
}
.inside-page .hero-agent-title-main {
  font-size: 21px; font-weight: 700;
  color: #1863dc; letter-spacing: -0.02em; display: block;
}
.inside-page .hero-agent-title-sub {
  display: block;
  font-size: 10px; font-weight: 600;
  color: #6b6b76;
  text-transform: uppercase; letter-spacing: 0.08em; margin-top: 2px;
}
.inside-page .hero-agent-badge {
  font-size: 13px; color: #6b6b76;
  font-style: italic; font-weight: 600;
}
.inside-page .hero-agent-list {
  list-style: none;
  border-top: 1.5px solid #f2f2f2;
  padding-top: 12px; margin-top: 2px;
  display: flex; flex-direction: column; gap: 8px;
}
.inside-page .hero-agent-list li {
  font-size: 14px; color: #212121;
  line-height: 1.5; padding-left: 14px; position: relative;
}
.inside-page .hero-agent-list li::before {
  content: '';
  position: absolute; left: 0; top: 7px;
  width: 5px; height: 5px;
  border-radius: 50%; background: #1863dc;
}
@media (max-width: 1024px) {
  .inside-page .meet-specialists-layout { grid-template-columns: 1fr; gap: 40px; }
  .inside-page .meet-specialists-left { position: static; }
}
@media (max-width: 520px) {
  .inside-page .hero-agents-grid { grid-template-columns: 1fr; }
}

/* ── Mobile responsive overrides ── */
@media (max-width: 480px) {
  .inside-page .container, .inside-page .container-wide, .inside-page .footer-inner {
    padding-left: 16px; padding-right: 16px;
  }
  .inside-page .core#hero { padding-top: 88px; padding-bottom: 60px; }
}
</file>

<file path="src/styles/landing-personal.css">
/*
 * landing-personal.css
 * Page-specific styles for /personal (port of public/landing-html/personal.html).
 * Class names are preserved verbatim so HTML selectors continue to match.
 * :root CSS custom-properties are shared — only page-specific rules here.
 * All selectors scoped under .personal-page to prevent bleed.
 */

/* ── Animations ─────────────────────────────────────────────────── */
@keyframes personal-fade-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes personal-pulse-dot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(1.3); } }
@keyframes personal-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
@keyframes personal-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .8; transform: scale(1.05); } }
@keyframes personal-gradient-shift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
@keyframes personal-shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
@keyframes personal-wiggle { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } }
@keyframes personal-stock-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
@keyframes personal-type-dot { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }
@keyframes personal-usecase-fade-in { to { opacity: 1; transform: translateY(0); } }
@keyframes personal-cursor-ripple { from { width: 0; height: 0; margin-left: 0; margin-top: 0; opacity: .6; } to { width: 40px; height: 40px; margin-left: -20px; margin-top: -20px; opacity: 0; } }
@keyframes personal-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-20px) rotate(3deg); } }
@keyframes personal-float-reverse { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(20px) rotate(-3deg); } }
@keyframes personal-mc-bounce { 0%, 80%, 100% { transform: translateY(0); opacity: .4; } 40% { transform: translateY(-5px); opacity: 1; } }

/* ── CSS variables ──────────────────────────────────────────────── */
.personal-page {
  --bg: #fff;
  --surface: #fafafa;
  --fg: #000;
  --fg-secondary: #212121;
  --muted: #6b6b76;
  --border: #e5e7eb;
  --border-light: #f2f2f2;
  --accent: #001F5C;
  --accent-dark: #001340;
  --accent-light: rgba(0,31,92,.08);
  --accent-tint: rgba(0,31,92,.04);
  --font-display: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  --font-body: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  --section-gap: 120px;
  --radius: 22px;
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--fg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.personal-page * { margin: 0; padding: 0; box-sizing: border-box; }
.personal-page a { color: inherit; text-decoration: none; }
.personal-page html { scroll-behavior: smooth; }
.personal-page .container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
@media (max-width: 480px) { .personal-page .container { padding: 0 16px; } }

/* ── Nav ────────────────────────────────────────────────────────── */
.personal-page nav { position: fixed; top: 0; left: 0; right: 0; background: rgba(255,255,255,.85); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-light); z-index: 1000; }
/* .nav-inner layout owned by .landing-root nav .nav-inner in landing.css */
.personal-page .logo { font-family: var(--font-display); font-size: 22px; font-weight: 600; letter-spacing: -.03em; display: flex; align-items: center; gap: 10px; }
.personal-page .logo-img { height: 23px; width: auto; display: block; }
.personal-page .nav-center { display: flex; align-items: center; gap: 40px; }
.personal-page .nav-center a { font-size: 15px; font-weight: 500; color: var(--fg-secondary); transition: color .2s; position: relative; }
.personal-page .nav-center a.active { color: var(--fg); }
.personal-page .nav-center a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--accent); transition: width .3s; }
.personal-page .nav-center a.active::after, .personal-page .nav-center a:hover::after { width: 100%; }
.personal-page .nav-cta { background: var(--accent); color: #fff; padding: 11px 22px; border-radius: 9999px; font-size: 14px; font-weight: 500; transition: all .3s; }
.personal-page .nav-cta:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(24,99,220,.25); }
@media (max-width: 768px) { .personal-page .nav-center { display: none; } /* .nav-cta visibility owned by landing.css */ }

/* ── Mobile nav toggle ──────────────────────────────────────────── */
.personal-page .nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 8px; color: var(--fg-secondary); }
.personal-page .nav-toggle svg { width: 24px; height: 24px; display: block; }
.personal-page .nav-mobile-panel { display: none; }
@media (max-width: 768px) {
  .personal-page .nav-toggle { display: block; }
  .personal-page .nav-mobile-panel {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 8px 24px 20px;
    gap: 0;
    border-bottom: 1px solid var(--border-light);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
    z-index: 999;
  }
  .personal-page .nav-mobile-panel.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }
  .personal-page .nav-mobile-panel a {
    padding: 14px 6px;
    font-size: 16px;
    font-weight: 500;
    color: var(--fg-secondary);
    border-bottom: 1px solid var(--border-light);
  }
  .personal-page .nav-mobile-panel a:last-child { border-bottom: none; }
  .personal-page .nav-mobile-panel a.nav-mobile-cta {
    margin-top: 14px;
    text-align: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    padding: 14px 24px;
    border-radius: 9999px;
    border: none;
    font-weight: 600;
  }
}

/* ── Hero ────────────────────────────────────────────────────────── */
.personal-page .hero { position: relative; padding: clamp(140px,18vw,180px) 0 clamp(40px,5vw,60px); text-align: center; overflow: hidden; }
@media (max-width: 768px) { .personal-page .hero { padding: 80px 0 20px; } }
@media (max-width: 480px) { .personal-page .hero { padding: 88px 0 16px; } }
/* Dual-radial bg: blue at top-right + purple at bottom-left (NEW design) */
.personal-page .hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 50% at 70% 30%,rgba(24,99,220,.14),transparent 60%),radial-gradient(ellipse 60% 50% at 20% 80%,rgba(126,87,194,.08),transparent 60%); z-index: 0; }
.personal-page .hero-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(to right,rgba(24,99,220,.06) 1px,transparent 1px),linear-gradient(to bottom,rgba(24,99,220,.06) 1px,transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 40%,#000 20%,transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%,#000 20%,transparent 75%); z-index: 0; pointer-events: none; }
.personal-page .hero-inner { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }
.personal-page .hero h1 { font-family: var(--font-display); font-size: clamp(40px,5.5vw,72px); font-weight: 700; letter-spacing: -.03em; line-height: 1.08; margin-bottom: 18px; opacity: 0; animation: personal-fade-up .7s ease-out .2s forwards; color: #001964; }
.personal-page .hero h1 .accent { background: linear-gradient(135deg,var(--accent) 0%,#4c6ee6 50%,var(--accent) 100%); background-size: 200% 200%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: personal-gradient-shift 4s ease infinite; }
.personal-page .hero-sub { font-size: 16px; color: var(--muted); max-width: 540px; margin: 0 auto 32px; line-height: 1.65; opacity: 0; animation: personal-fade-up .7s ease-out .3s forwards; }
@media (max-width: 480px) { .personal-page .hero-sub { font-size: 14px; max-width: 100%; } }

/* ── Floating shapes ─────────────────────────────────────────────── */
.personal-page .shape { position: absolute; border-radius: 50%; z-index: 0; pointer-events: none; }
.personal-page .shape-1 { width: 400px; height: 400px; background: linear-gradient(135deg,rgba(24,99,220,.08),transparent); top: 10%; right: -10%; animation: personal-float 8s ease-in-out infinite; }
.personal-page .shape-2 { width: 300px; height: 300px; background: linear-gradient(135deg,rgba(24,99,220,.05),transparent); bottom: 20%; left: -5%; animation: personal-float-reverse 10s ease-in-out infinite; }
.personal-page .shape-3 { width: 200px; height: 200px; border: 1px solid var(--border-light); top: 30%; left: 10%; animation: personal-pulse 6s ease-in-out infinite; }
.personal-page .shape-4 { width: 150px; height: 150px; border: 1px solid var(--border-light); bottom: 30%; right: 15%; animation: personal-pulse 8s ease-in-out infinite; animation-delay: 2s; }
@media (max-width: 768px) { .personal-page .shape-1,.personal-page .shape-2,.personal-page .shape-3,.personal-page .shape-4 { display: none; } }

/* ── Chat bar — flex-column layout ──────────────────────────────── */
.personal-page .cbar-wrap { max-width: 680px; margin: 0 auto; opacity: 0; animation: personal-fade-up .7s ease-out .4s forwards; }
.personal-page .cbar { background: #fff; border: 1.5px solid var(--border); border-radius: 28px; box-shadow: 0 20px 50px -16px rgba(15,23,42,.14),0 4px 12px rgba(15,23,42,.04); transition: border-color .25s,box-shadow .25s; display: flex; flex-direction: column; position: relative; overflow: hidden; }
.personal-page .cbar:focus-within { border-color: var(--accent); box-shadow: 0 20px 50px -8px rgba(24,99,220,.22),0 0 0 4px rgba(24,99,220,.1); }

/* Input row */
.personal-page .cbar-row { display: flex; align-items: flex-end; gap: 10px; padding: 14px 14px 14px 22px; }
.personal-page .cbar-input-wrap { flex: 1; position: relative; min-height: 32px; display: flex; align-items: center; padding: 8px 0; }
.personal-page .cbar-input { width: 100%; border: none; outline: none; font-family: var(--font-body); font-size: 16px; color: var(--fg); background: transparent; resize: none; line-height: 1.5; min-height: 24px; max-height: 120px; position: relative; z-index: 2; padding: 0; }
.personal-page .cbar-ghost { position: absolute; top: 50%; transform: translateY(-50%); left: 0; right: 0; font-family: var(--font-body); font-size: 16px; color: #9ca3af; line-height: 1.5; pointer-events: none; white-space: nowrap; overflow: hidden; z-index: 1; }
.personal-page .cbar-ghost::after { content: ''; display: inline-block; width: 2px; height: 1em; background: var(--accent); margin-left: 2px; vertical-align: -2px; animation: personal-blink 1s step-end infinite; }
.personal-page .cbar-ghost.hidden { display: none; }
.personal-page .cbar-icons { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
@media (max-width: 480px) { .personal-page .cbar-icons { display: none; } }
.personal-page .cbar-icon-btn { all: unset; cursor: pointer; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--muted); transition: all .15s; }
.personal-page .cbar-icon-btn:hover { background: var(--surface); color: var(--fg); }
.personal-page .cbar-icon-btn svg { width: 18px; height: 18px; }
.personal-page .cbar-send { background: var(--accent); color: #fff; border: none; cursor: pointer; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all .15s; flex-shrink: 0; }
.personal-page .cbar-send:hover { background: var(--accent-dark); transform: scale(1.05); }
.personal-page .cbar-send svg { width: 18px; height: 18px; }

/* Collapsible messages panel */
.personal-page .cbar-messages { max-height: 0; overflow: hidden; transition: max-height .38s cubic-bezier(0.4,0,0.2,1); }
.personal-page .cbar.expanded .cbar-messages { max-height: 460px; }
.personal-page .cbar-messages-inner { padding: 16px 22px 14px; border-bottom: 1px solid var(--border-light); overflow-y: auto; max-height: 460px; }

/* Close row */
.personal-page .mc-close-row { display: flex; justify-content: flex-end; margin-bottom: 10px; }
.personal-page .mc-close { all: unset; cursor: pointer; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 18px; line-height: 1; transition: all .15s; }
.personal-page .mc-close:hover { background: var(--surface); color: var(--fg); }

/* User bubble */
.personal-page .mc-user { display: flex; justify-content: flex-end; margin-bottom: 16px; }
.personal-page .mc-user-bubble { background: var(--accent); color: #fff; padding: 10px 16px; border-radius: 18px 18px 4px 18px; font-size: 14px; font-weight: 500; max-width: 85%; line-height: 1.45; }

/* Agent response */
.personal-page .mc-agent { display: flex; gap: 12px; align-items: flex-start; }
.personal-page .mc-avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--accent-light); border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 15px; }
