  <style>
    /* ===== Product panel (accordion on mobile, full-width reveal on desktop) ===== */
    #tab-inside   { --panel-color: #1863dc; }
    #tab-work     { --panel-color: #149a6e; }
    #tab-personal { --panel-color: #7e57c2; }

    /* Desktop default: hide/show with display + fade-up */
    .product-panel { display: none; }
    .product-panel.active {
      display: block;
      animation: fade-up 0.4s ease-out both;
    }

    /* Desktop: group dissolves into grid so card+panel are direct grid children */
    @media (min-width: 1001px) {
      .product-group { display: contents; }
      .product-card  { grid-row: 1; }
      .product-panel { grid-row: 2; grid-column: 1 / -1; }
    }

    /* Mobile: stack card + panel, accordion expand */
    @media (max-width: 1000px) {
      .products-grid { display: flex; flex-direction: column; gap: 16px; }
      .product-group { display: flex; flex-direction: column; }
      .product-tree-connector { display: none; }
      .product-panel {
        display: block;
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        animation: none;
        transition: max-height 0.5s cubic-bezier(0.4,0,0.2,1), opacity 0.35s ease;
      }
      .product-panel.active { max-height: 3000px; opacity: 1; }
    }

    /* Ensure agents-grid fills the outlined box exactly, ignoring its standalone max-width */
    .product-panel-inner .agents-grid {
      max-width: none;
      margin: 0;
    }

    /* Panel inner — desktop: outlined box + caret pointer */
    @media (min-width: 1001px) {
      .product-tree-connector {
        height: 12px;
      }

      .product-panel-inner {
        position: relative;
        background: var(--surface);
        padding: 32px;
        border: 2px solid var(--panel-color, var(--accent));
        border-radius: 20px;
      }

      /* Caret pointer on top border of panel */
      .product-panel-inner::before {
        content: '';
        position: absolute;
        top: 0;
        width: 18px;
        height: 18px;
        background: var(--surface);
        border-top: 2px solid var(--panel-color, var(--accent));
        border-left: 2px solid var(--panel-color, var(--accent));
        transform: translateX(-50%) translateY(-50%) rotate(45deg);
      }
      #tab-inside   .product-panel-inner::before { left: calc(100% / 6); }
      #tab-work     .product-panel-inner::before { left: 50%; }
      #tab-personal .product-panel-inner::before { left: calc(100% * 5 / 6); }
    }

    /* Panel inner — mobile: continue card border as merged unit */
    @media (max-width: 1000px) {
      .product-panel-inner {
        background: var(--surface);
        padding: 24px 16px;
        border: 2px solid var(--panel-color, var(--accent));
        border-top: none;
        border-radius: 0 0 20px 20px;
      }
    }

    /* ===== What Our Agents Get Done ===== */
    .agents-section {
      padding: 0 0 var(--section-gap);
      background: var(--surface);
    }

    /* Match header styling to products section */
    .agents-section .section-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 48px;
    }

    .agents-section .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0;
      background: none;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 20px;
      box-shadow: none;
    }

    .agents-section .section-eyebrow::before {
      content: none;
    }

    .agents-section .section-header h2 {
      text-align: center;
      max-width: none;
      font-size: clamp(36px, 4.6vw, 56px);
      line-height: 1.08;
      letter-spacing: -0.025em;
      margin-bottom: 0;
    }

    .agents-section .section-header h2 .accent {
      background: linear-gradient(135deg, var(--accent) 0%, #6fa8ff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    /* Tab bar */
    .agents-tabs {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }

    .agents-tab {
      display: inline-block;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      background: transparent;
      border: 2px solid var(--border);
      color: var(--muted);
      padding: 8px 22px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
