  <!--
    ====== Google Sheet Lead Capture ======
    Setup instructions (5 minutes):
    1. Create a new Google Sheet. Row 1 column headers:
       timestamp | fullName | email | company | jobTitle | companySize | phone | product | industry | useCase | consent | source
    2. Extensions → Apps Script. Delete sample code, paste below, Save:

       const SHEET_NAME = 'Leads';
       function doPost(e) {
         try {
           const data = JSON.parse(e.postData.contents);
           const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME)
             || SpreadsheetApp.getActiveSpreadsheet().insertSheet(SHEET_NAME);
           sheet.appendRow([
             new Date(), data.fullName||'', data.email||'',
             data.company||'', data.jobTitle||'', data.companySize||'', data.phone||'',
             data.product||'', data.industry||'', data.useCase||'',
             data.consent ? 'Yes' : 'No', data.source||'infina-ai-main-v1'
           ]);
           return ContentService.createTextOutput(JSON.stringify({ok:true}))
             .setMimeType(ContentService.MimeType.JSON);
         } catch (err) {
           return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)}))
             .setMimeType(ContentService.MimeType.JSON);
         }
       }

    3. Deploy → New deployment → Type: Web app
       - Execute as: Me
       - Who has access: Anyone
       Copy URL format: https://script.google.com/macros/s/AKfycb.../exec
    4. Paste that URL into the SHEETS_ENDPOINT constant below.
  -->
  <script>
    (function () {
      const SHEETS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyO618yfsKfO4nHni2qBe62GWp9fM0vEb0h-Gccw-1wV-w5wJpN3Zayhai1OFxPl98x/exec';

      const form = document.getElementById('lead-form');
      const submitBtn = document.getElementById('lf-submit');
      const status = document.getElementById('lf-status');
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.className = 'lead-status';
        status.textContent = '';

        // Validate
        const required = form.querySelectorAll('[required]');
        let firstInvalid = null;
        required.forEach(el => {
          const ok = el.checkValidity();
          el.classList.toggle('invalid', !ok);
          if (!ok && !firstInvalid) firstInvalid = el;
        });
        if (firstInvalid) {
          status.className = 'lead-status error';
          status.textContent = 'Vui lòng điền đầy đủ các trường bắt buộc.';
          firstInvalid.focus();
          return;
        }

        const data = {
          fullName: form.fullName.value.trim(),
          email: form.email.value.trim(),
          company: form.company.value.trim(),
          jobTitle: form.jobTitle.value.trim(),
          companySize: form.companySize.value,
          phone: form.phone.value.trim(),
          product: form.product.value,
          industry: form.industry.value,
          useCase: form.useCase.value.trim(),
          consent: form.consent.checked,
          source: 'infina-ai-main-v1',
        };

        submitBtn.disabled = true;
        submitBtn.classList.add('loading');
        submitBtn.querySelector('.lead-submit-label').textContent = 'Sending...';

        try {
          if (!SHEETS_ENDPOINT) {
            // Demo mode — chưa cấu hình endpoint
            await new Promise(r => setTimeout(r, 600));
            console.log('[Lead form] SHEETS_ENDPOINT not configured. Data:', data);
          } else {
            console.log('[Lead form] Sending to:', SHEETS_ENDPOINT);
            console.log('[Lead form] Payload:', data);
            // Use FormData -> Apps Script reads via e.parameter (avoid preflight CORS).
            const fd = new FormData();
            Object.keys(data).forEach(k => fd.append(k, typeof data[k] === 'boolean' ? (data[k] ? 'true' : 'false') : data[k]));
            const res = await fetch(SHEETS_ENDPOINT, { method: 'POST', body: fd });
            const txt = await res.text();
            console.log('[Lead form] Response:', res.status, txt);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            try {
              const json = JSON.parse(txt);
              if (json && json.ok === false) throw new Error(json.error || 'Sheet error');
            } catch (parseErr) {
              // Nếu response không phải JSON (ví dụ HTML đăng nhập) → endpoint chưa public
              if (txt.indexOf('<!DOCTYPE') === 0 || txt.indexOf('<html') >= 0) {
                throw new Error('Endpoint chưa public — vào Apps Script → Deploy → Manage deployments → đổi "Who has access" thành "Anyone".');
              }
            }
          }

          status.className = 'lead-status success';
          status.textContent = '✓ Cảm ơn bạn! Đội ngũ Infina AI sẽ liên hệ trong vòng 24 giờ.';
          form.reset();
        } catch (err) {
          status.className = 'lead-status error';
          status.textContent = 'An error occurred. Please try again or email contact@infina.ai.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.classList.remove('loading');
          submitBtn.querySelector('.lead-submit-label').textContent = 'Đặt lịch demo';
        }
      });

      // Clear invalid state on input
      form.querySelectorAll('input, select, textarea').forEach(el => {
        el.addEventListener('input', () => el.classList.remove('invalid'));
        el.addEventListener('change', () => el.classList.remove('invalid'));
      });

      // ===== Custom combo (replaces native <select>) =====
      const combos = form.querySelectorAll('.lead-combo');
      combos.forEach(combo => {
        const trigger = combo.querySelector('.lead-combo-trigger');
        const menu = combo.querySelector('.lead-combo-menu');
        const hidden = combo.querySelector('input[type="hidden"]');
        const options = combo.querySelectorAll('.lead-combo-option');

        const close = () => combo.classList.remove('open');
        const open = () => {
          // Close other combos
          combos.forEach(c => { if (c !== combo) c.classList.remove('open'); });
          combo.classList.add('open');
        };

        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          combo.classList.contains('open') ? close() : open();
        });

        options.forEach(opt => {
          opt.addEventListener('click', (e) => {
            e.stopPropagation();
            const val = opt.dataset.value;
            const label = opt.textContent;
            hidden.value = val;
            trigger.textContent = label;
            trigger.classList.remove('placeholder');
            combo.classList.add('has-value');
            combo.classList.remove('invalid');
            hidden.classList.remove('invalid');
            options.forEach(o => o.classList.toggle('selected', o === opt));
            close();
          });
        });

        // Reset support
        form.addEventListener('reset', () => {
          hidden.value = '';
          trigger.textContent = 'Chọn...';
          trigger.classList.add('placeholder');
          combo.classList.remove('has-value');
          options.forEach(o => o.classList.remove('selected'));
        });
      });
      document.addEventListener('click', () => {
        combos.forEach(c => c.classList.remove('open'));
      });
    })();

    // ===== Marker underline animation =====
    (function() {
      const els = document.querySelectorAll('.marker-underline');
      if (!els.length) return;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });
      els.forEach(el => observer.observe(el));
    })();
  </script>

