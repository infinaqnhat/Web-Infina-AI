<!DOCTYPE html>
<html lang="en">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Infina AI Work · Specialist Agents for Your Company</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #ffffff;
      --surface: #fafafa;
      --fg: #1a1f2e;
      --fg-secondary: #334155;
      --muted: #64748b;
      --border: #e5e7eb;
      --border-light: #f2f2f2;
      --accent: #001F5C;
      --accent-dark: #001340;
      --accent-light: rgba(0, 31, 92, 0.08);
      --blue: #1863dc;
      --blue-light: rgba(24, 99, 220, 0.08);
      --font-display: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
      --font-body: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
      --section-gap: 96px;
      --radius: 20px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); background: var(--bg); color: var(--fg); line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }

    @keyframes float { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(-20px) rotate(3deg)} }
    @keyframes float-reverse { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(20px) rotate(-3deg)} }
    @keyframes pulse { 0%,100%{opacity:.4;transform:scale(1)} 50%{opacity:.8;transform:scale(1.05)} }
    @keyframes gradient-shift { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }
    @keyframes fade-up { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
    @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.3)} }
    @keyframes pulse-ring { 0%{transform:scale(0.8);opacity:1} 100%{transform:scale(2);opacity:0} }
    @keyframes spin-slow { to{transform:rotate(360deg)} }
    @keyframes icon-pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.05)} }
    @keyframes shimmer { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }

    /* Nav */
    nav { position: fixed; top:0; left:0; right:0; background: rgba(255,255,255,.9); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-light); z-index: 1000; }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; max-width: 1200px; margin: 0 auto; padding: 0 32px; }
    .logo { font-family: var(--font-display); font-size: 22px; font-weight: 600; letter-spacing: -.03em; display: flex; align-items: center; gap: 10px; }
    .logo-img { height: 23px; width: auto; display: block; }
    .logo:hover .logo-img { height: 23px; width: auto; display: block; }
    .nav-center { display: flex; align-items: center; gap: 40px; }
    .nav-center a { font-size: 15px; font-weight: 500; color: var(--fg-secondary); transition: color .2s; position: relative; }
    .nav-center a.active { color: var(--fg); }
    .nav-center a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--accent); transition: width .3s; }
    .nav-center a.active::after, .nav-center a:hover::after { width: 100%; }
    .nav-cta { background: var(--accent); color: #fff; padding: 11px 22px; border-radius: 9999px; font-size: 14px; font-weight: 500; transition: all .3s; }
    .nav-cta:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(24,99,220,.25); }
    /* Dropdown */
    .nav-dropdown { position: relative; }
    .nav-dropdown-toggle { font-size: 15px; font-weight: 500; color: var(--fg-secondary); transition: color .2s; position: relative; cursor: pointer; display: flex; align-items: center; gap: 4px; }
    .nav-dropdown-toggle.active { color: var(--fg); }
    .nav-dropdown-toggle::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--accent); transition: width .3s; }
    .nav-dropdown:hover .nav-dropdown-toggle::after { width: 100%; }
    .nav-dropdown-toggle svg { transition: transform .2s; }
    .nav-dropdown:hover .nav-dropdown-toggle svg { transform: rotate(180deg); }
    .nav-dropdown-menu { position: absolute; top: calc(100% + 16px); left: 50%; transform: translateX(-50%) translateY(-4px); background: #fff; border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,.1); padding: 6px; min-width: 200px; opacity: 0; visibility: hidden; transition: opacity .2s, visibility .2s, transform .2s; }
    .nav-dropdown:hover .nav-dropdown-menu { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
    .nav-dropdown-menu a { display: block; padding: 10px 14px; font-size: 14px; font-weight: 500; color: var(--fg-secondary); border-radius: 8px; transition: background .15s, color .15s; white-space: nowrap; }
    .nav-dropdown-menu a::after { display: none; }
    .nav-dropdown-menu a:hover, .nav-dropdown-menu a.active { background: var(--accent-light); color: var(--accent); }

    /* Hero */
    .hero { position: relative; padding: clamp(140px, 18vw, 180px) 0 clamp(48px, 6vw, 72px); overflow: hidden; background: transparent; }
    .hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 50% at 70% 30%, rgba(24,99,220,.14), transparent 60%), radial-gradient(ellipse 60% 50% at 20% 80%, rgba(126,87,194,.08), transparent 60%); z-index: -2; pointer-events: none; }
    .hero-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(24,99,220,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(24,99,220,.06) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); z-index: -2; pointer-events: none; }
    .shape { position: absolute; border-radius: 50%; z-index: -1; pointer-events: none; }
    .shape-1 { width: 400px; height: 400px; background: linear-gradient(135deg, rgba(24,99,220,.08), transparent); top: 10%; right: -10%; animation: float 8s ease-in-out infinite; }
    .shape-2 { width: 300px; height: 300px; background: linear-gradient(135deg, rgba(24,99,220,.05), transparent); bottom: 20%; left: -5%; animation: float-reverse 10s ease-in-out infinite; }
    .shape-3 { width: 200px; height: 200px; border: 1px solid var(--border-light); top: 30%; left: 10%; animation: pulse 6s ease-in-out infinite; }
    .shape-4 { width: 150px; height: 150px; border: 1px solid var(--border-light); bottom: 30%; right: 15%; animation: pulse 8s ease-in-out infinite; animation-delay: 2s; }
    .hero .container { position: relative; z-index: 1; text-align: center; }
    .hero-grid { display: block; text-align: center; }
    .hero-grid .hero-text { max-width: 900px; margin: 0 auto; }
    .hero-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: .14em; margin-bottom: 28px; opacity: 0; animation: fade-up .6s ease-out .2s forwards; }
    .hero-badge::before { content: ''; width: 6px; height: 6px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 10px var(--accent); animation: pulse-dot 2s ease-in-out infinite; flex-shrink: 0; }
    .hero h1 { font-family: var(--font-display); font-size: clamp(40px, 5.5vw, 72px); font-weight: 700; letter-spacing: -.04em; line-height: 1.05; margin-bottom: 28px; opacity: 0; animation: fade-up .8s ease-out .3s forwards; color: #001964; }
    .hero h1 .line { white-space: normal; display: inline-block; padding: .12em 0 .05em; line-height: 1.15; max-width: 100%; }
    .hero h1 .line-accent { background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 50%, var(--accent) 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradient-shift 4s ease infinite; }
    .hero-sub { font-size: 20px; color: #64748b; line-height: 1.65; margin: 0 auto 32px; opacity: 0; animation: fade-up .8s ease-out .4s forwards; max-width: 580px; font-weight: 400; }
    .hero-value-list { list-style: none; display: flex; flex-direction: row; justify-content: center; gap: 0; margin: 28px auto 0; padding: 0; text-align: left; max-width: 860px; opacity: 0; animation: fade-up .8s ease-out .48s forwards; }
    .hero-value-list li { font-size: 15px; color: var(--fg-secondary); padding: 16px 24px; line-height: 1.5; flex: 1; border-left: 1.5px solid var(--border-light); display: flex; align-items: center; gap: 10px; white-space: nowrap; }
    .hero-value-list li:first-child { border-left: none; }
    .hero-value-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px; background: rgba(24,99,220,.08); color: #1863dc; }
    .hero-value-icon svg { width: 16px; height: 16px; }
    @media (max-width: 640px) { .hero-value-list { flex-direction: column; } .hero-value-list li { border-left: none; border-top: 1.5px solid var(--border-light); padding: 12px 0; white-space: normal; } .hero-value-list li:first-child { border-top: none; } }
    .hero-ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; opacity: 0; animation: fade-up .8s ease-out .5s forwards; }
    .btn-primary { background: var(--accent); color: #fff; padding: 16px 32px; border-radius: 999px; font-size: 15px; font-weight: 600; transition: all .25s; display: inline-flex; align-items: center; gap: 10px; border: 0; cursor: pointer; }
    .btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 16px 32px rgba(24,99,220,.3); }
    .btn-ghost { background: transparent; color: var(--fg); padding: 15px 32px; border-radius: 999px; font-size: 15px; font-weight: 600; transition: all .25s; border: 1.5px solid var(--border); }
    .btn-ghost:hover { border-color: var(--fg); background: var(--surface); }

    /* Section header */
    .section { padding: var(--section-gap) 0; }
    .section-header { margin-bottom: 48px; text-align: center; }
    .section-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--accent); margin-bottom: 16px; }
    .section-header h2 { font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 700; letter-spacing: -.03em; line-height: 1.2; margin-bottom: 20px; color: var(--fg); }
    .section-header p { font-size: 17px; color: #64748b; max-width: 660px; line-height: 1.7; margin: 0 auto; font-weight: 400; }

    /* Agents Grid */
    .agents-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 80px; }
    @media (max-width: 1100px) { .agents-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .agents-grid { grid-template-columns: 1fr; } }
    .agent-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 0; overflow: hidden; transition: all .4s cubic-bezier(.16,1,.3,1); position: relative; }
    .agent-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.16,1,.3,1); }
    .agent-card:hover { transform: translateY(-6px); box-shadow: 0 24px 48px -16px rgba(24,99,220,.18); border-color: rgba(24,99,220,.3); }
    .agent-card:hover::before { transform: scaleX(1); }
    .agent-icon-wrap { padding: 36px 28px 24px; background: linear-gradient(160deg, var(--accent-light) 0%, transparent 80%); border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; min-height: 140px; position: relative; overflow: hidden; }
    .agent-icon-wrap::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, var(--accent-light), transparent 70%); opacity: 0; transition: opacity .5s; }
    .agent-card:hover .agent-icon-wrap::before { opacity: 1; }
    .agent-icon { width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, var(--accent) 0%, #0e4eb8 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(24,99,220,.2); position: relative; transition: all .4s cubic-bezier(.16,1,.3,1); overflow: hidden; }
    .agent-icon::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent); transform: translateX(-100%); }
    .agent-card:hover .agent-icon::after { animation: shimmer 1.5s ease-in-out; }
    .agent-card:hover .agent-icon { transform: translateY(-4px) scale(1.05); box-shadow: 0 12px 32px rgba(24,99,220,.35); animation: icon-pulse 2s ease-in-out infinite; }
    .agent-icon svg { width: 24px; height: 24px; stroke-width: 2.5; transition: transform .4s cubic-bezier(.16,1,.3,1); }
    .agent-card:hover .agent-icon svg { transform: scale(1.1); }
    .agent-icon::before { content: ''; position: absolute; inset: -2px; border-radius: 16px; background: linear-gradient(135deg, rgba(255,255,255,.3), transparent); opacity: 0; transition: opacity .4s; }
    .agent-card:hover .agent-icon::before { opacity: 1; }
    .agent-body { padding: 28px; }
    .agent-num { display: none; }
    .agent-card h3 { font-family: var(--font-display); font-size: 19px; font-weight: 700; letter-spacing: -.015em; margin-bottom: 12px; line-height: 1.35; color: var(--fg); }
    .agent-card p { font-size: 15px; color: #64748b; line-height: 1.7; font-weight: 400; }

    /* Sales Section - Redesigned Clean */
    .sales-section { background: var(--surface); }
    .sales-features-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    @media (max-width: 1100px) {
      .sales-features-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .sales-features-grid { grid-template-columns: 1fr; }
    }
    .sales-feature-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px 24px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .sales-feature-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(0,31,92,0.12);
      border-color: rgba(0,31,92,0.2);
    }
    .sales-card-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      margin-bottom: 20px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .sales-feature-card:hover .sales-card-icon {
      transform: scale(1.05);
      box-shadow: 0 8px 24px rgba(0,31,92,0.3);
    }
    .sales-card-icon svg {
      width: 24px;
      height: 24px;
      stroke-width: 2.5;
    }
    .sales-feature-card h3 {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.015em;
      line-height: 1.3;
      margin-bottom: 12px;
      color: var(--fg);
    }
    .sales-feature-card p {
      font-size: 14px;
      color: #64748b;
      line-height: 1.6;
    }

    /* Context-Aware AI Section */
    .context-ai-section { 
      padding: var(--section-gap) 0; 
      background: #fff;
    }
    .context-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    @media (max-width: 1000px) {
      .context-grid { grid-template-columns: 1fr; gap: 60px; }
      .context-visual { order: -1; }
    }
    .context-visual {
      position: relative;
    }
    .context-chat-window {
      background: #f8f9fa;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.12);
    }
    .context-chat-header {
      background: #fff;
      padding: 12px 16px;
      border-bottom: 1px solid #e5e7eb;
    }
    .context-dots {
      display: flex;
      gap: 6px;
    }
    .context-dots span {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }
    .context-chat-body {
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      min-height: 320px;
    }
    .context-msg {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .context-msg-user {
      flex-direction: row-reverse;
    }
    .context-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .context-avatar-user {
      background: #64748b;
    }
    .context-avatar-ai {
      background: var(--accent);
    }
    .context-bubble {
      padding: 14px 18px;
      border-radius: 16px;
      font-size: 14px;
      line-height: 1.5;
      max-width: 420px;
    }
    .context-bubble-user {
      background: #3b82f6;
      color: #fff;
    }
    .context-bubble-ai {
      background: #fff;
      color: var(--fg);
      border: 1px solid #e5e7eb;
    }
    .context-priority-item {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }
    .context-priority-item:last-child {
      margin-bottom: 0;
    }
    .context-priority-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .context-priority-bar {
      height: 8px;
      border-radius: 4px;
      transition: width 0.6s ease;
    }
    .context-metric-card {
      position: absolute;
      bottom: -20px;
      left: 20px;
      background: #fff;
      border-radius: 12px;
      padding: 16px 20px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .context-metric-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: rgba(16, 185, 129, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .context-metric-label {
      font-size: 12px;
      color: #64748b;
      margin-bottom: 2px;
    }
    .context-metric-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--fg);
    }
    .context-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(59, 130, 246, 0.1);
      color: #3b82f6;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 24px;
    }
    .context-content h2 {
      font-family: var(--font-display);
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.15;
      margin-bottom: 20px;
      color: var(--fg);
    }
    .context-highlight {
      background: linear-gradient(135deg, var(--accent) 0%, #1863dc 50%, var(--accent) 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradient-shift 4s ease infinite;
    }
    @keyframes gradient-shift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    
    /* Gradient text animation utility */
    .gradient-text {
      background: linear-gradient(135deg, var(--accent) 0%, #1863dc 50%, var(--accent) 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradient-shift 4s ease infinite;
    }
    
    .context-description {
      font-size: 17px;
      color: #64748b;
      line-height: 1.7;
      margin-bottom: 32px;
    }
    .context-features {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .context-features li {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 15px;
      color: var(--fg);
      line-height: 1.5;
    }
    .context-check {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background: rgba(59, 130, 246, 0.1);
      color: #3b82f6;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }

    /* Lead Section - Light Theme like AI Inside */
    .lead-section {
      padding: var(--section-gap) 0;
      background: linear-gradient(180deg, #f0f3f9 0%, #e8edf7 100%);
      color: var(--fg);
      position: relative;
      overflow: hidden;
    }
    .lead-section::before {
      content: '';
      position: absolute;
      top: -200px; right: -200px;
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(0,31,92,0.08), transparent 65%);
      filter: blur(40px);
      pointer-events: none;
    }
    .lead-section::after {
      content: '';
      position: absolute;
      bottom: -300px; left: -200px;
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(0,31,92,0.05), transparent 65%);
      filter: blur(60px);
      pointer-events: none;
    }
    .lead-grid {
      display: grid;
      grid-template-columns: 1fr 1.05fr;
      gap: 80px;
      align-items: start;
      position: relative;
      z-index: 1;
    }
    @media (max-width: 900px) {
      .lead-grid { grid-template-columns: 1fr; gap: 48px; }
    }
    .lead-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: #fff;
      margin-bottom: 24px;
      padding: 6px 14px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--accent), #2278f6);
      box-shadow: 0 6px 16px -8px rgba(24,99,220,0.55);
    }
    .lead-eyebrow::before {
      content: ''; width: 6px; height: 6px; border-radius: 50%;
      background: #fff;
      box-shadow: 0 0 0 4px rgba(255,255,255,0.25);
    }
    .lead-copy h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 4.5vw, 56px);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.025em;
      margin-bottom: 20px;
      color: var(--fg);
    }
    .lead-copy h2 .accent {
      background: linear-gradient(135deg, var(--accent) 0%, #1863dc 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .lead-sub {
      font-size: 17px;
      color: var(--fg-secondary);
      margin-bottom: 36px;
      max-width: 460px;
      line-height: 1.55;
    }
    .lead-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 40px;
    }
    .lead-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      font-size: 15px;
      color: var(--fg);
      line-height: 1.5;
    }
    .lead-check {
      flex-shrink: 0;
      width: 24px; height: 24px;
      border-radius: 8px;
      background: var(--accent-light);
      border: 1px solid rgba(0, 31, 92, 0.35);
      color: var(--accent);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      margin-top: 1px;
    }
    .lead-form {
      background: #fff;
      color: var(--fg);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.15), 0 0 0 1px rgba(255,255,255,0.05);
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
    }
    .lead-form-header {
      margin-bottom: 4px;
    }
    .lead-form-title {
      font-family: var(--font-display);
      font-size: 18px; font-weight: 700;
      letter-spacing: -0.015em;
      margin-bottom: 2px;
    }
    .lead-form-sub {
      font-size: 12px; color: var(--muted);
    }
    @media (max-width: 600px) {
      .lead-form { padding: 24px 20px; }
    }
    .lead-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    @media (max-width: 480px) {
      .lead-row-2 { grid-template-columns: 1fr; }
    }
    .lead-field {
      position: relative;
    }
    .lead-field input,
    .lead-field select,
    .lead-field textarea,
    .lead-combo-trigger {
      width: 100%;
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--fg);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 14px 6px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      appearance: none;
      -webkit-appearance: none;
      text-align: left;
      cursor: pointer;
      min-height: 50px;
    }
    .lead-field input,
    .lead-field textarea {
      cursor: text;
    }
    .lead-field textarea {
      resize: none;
      min-height: 70px;
      line-height: 1.5;
      padding-top: 22px;
    }
    .lead-field input:focus,
    .lead-field select:focus,
    .lead-field textarea:focus,
    .lead-combo.open .lead-combo-trigger {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-light);
    }
    .lead-field input.invalid,
    .lead-field select.invalid,
    .lead-field textarea.invalid {
      border-color: #dc2626;
    }
    .lead-field label {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 14px;
      color: var(--muted);
      pointer-events: none;
      transition: all 0.15s ease;
      background: transparent;
    }
    .lead-field.lead-textarea label {
      top: 18px;
      transform: none;
    }
    .lead-field input:focus + label,
    .lead-field input:not(:placeholder-shown) + label,
    .lead-field textarea:focus + label,
    .lead-field textarea:not(:placeholder-shown) + label,
    .lead-combo.has-value .lead-combo-trigger + label,
    .lead-combo.open .lead-combo-trigger + label {
      top: 8px;
      transform: none;
      font-size: 10px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .lead-caret {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--fg-secondary);
      pointer-events: none;
      font-size: 18px;
      font-weight: 700;
      line-height: 1;
      transition: transform 0.2s;
    }
    .lead-combo.open .lead-caret { transform: translateY(-50%) rotate(180deg); }
    .lead-combo { position: relative; }
    .lead-combo-trigger {
      display: flex; align-items: center; justify-content: flex-start;
      padding-right: 36px;
      color: var(--fg);
    }
    .lead-combo-trigger.placeholder { color: transparent; }
    .lead-combo-menu {
      position: absolute;
      top: calc(100% + 6px); left: 0; right: 0;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
      padding: 6px;
      max-height: 240px; overflow-y: auto;
      z-index: 20;
      display: none;
      animation: lead-combo-in 0.15s ease;
    }
    .lead-combo.open .lead-combo-menu { display: block; }
    @keyframes lead-combo-in {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .lead-combo-option {
      padding: 10px 12px;
      font-size: 14px;
      color: var(--fg);
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.1s;
      display: flex; align-items: center; gap: 10px;
    }
    .lead-combo-option:hover,
    .lead-combo-option.active {
      background: var(--accent-light);
      color: var(--accent);
    }
    .lead-combo-option.selected::after {
      content: '✓';
      margin-left: auto;
      color: var(--accent);
      font-weight: 700;
    }
    .lead-consent {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
      cursor: pointer;
      margin-top: 2px;
    }
    .lead-consent input {
      margin-top: 2px;
      accent-color: var(--accent);
      width: 14px; height: 14px;
      flex-shrink: 0;
    }
    .lead-submit {
      align-self: stretch;
      justify-content: center;
      background: var(--accent);
      color: #fff;
      border: 0;
      border-radius: 12px;
      padding: 14px 28px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform 0.15s, opacity 0.15s, background 0.15s, box-shadow 0.2s;
      margin-top: 4px;
      position: relative;
      overflow: hidden;
    }
    .lead-submit:hover {
      background: #001340;
      transform: translateY(-1px);
      box-shadow: 0 12px 30px rgba(0,31,92,0.35);
    }
    .lead-submit::after {
      content: '→';
      font-size: 18px;
      transition: transform 0.2s;
    }
    .lead-submit:hover::after { transform: translateX(4px); }
    .lead-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
    .lead-submit-spinner {
      display: none;
      width: 14px; height: 14px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: lead-spin 0.7s linear infinite;
    }
    .lead-submit.loading .lead-submit-spinner { display: inline-block; }
    @keyframes lead-spin { to { transform: rotate(360deg); } }
    .lead-status {
      font-size: 14px;
      min-height: 20px;
    }
    .lead-status.success { color: #059669; }
    .lead-status.error { color: #dc2626; }

    /* Footer */
    footer { padding: 48px 0; border-top: 1px solid var(--border-light); background: var(--bg); }
    .footer-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; }
    .footer-links { display: flex; gap: 32px; }
    .footer-links a { font-size: 14px; color: var(--muted); transition: color .2s; }
    .footer-links a:hover { color: var(--accent); }
    .footer-copy { font-size: 13px; color: var(--muted); }
    @media (max-width: 640px) { .footer-inner { flex-direction: column; text-align: center; } }

    /* Coworkers Section */
    .coworkers-section { background: #fafafa; padding-top: 60px; }
    .coworkers-header { max-width: 680px; margin: 0 auto 56px; text-align: center; }
    .coworkers-header h2 { font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 700; letter-spacing: -.03em; line-height: 1.2; margin-bottom: 20px; color: #001964; text-wrap: balance; }
    .coworkers-sub { font-size: 17px; color: #64748b; line-height: 1.7; margin: 0 auto 32px; font-weight: 400; max-width: 520px; text-wrap: pretty; }
    .btn-slack { display: inline-flex; align-items: center; gap: 10px; background: #fff; color: #1a1f2e; padding: 14px 28px; border-radius: 8px; font-size: 15px; font-weight: 600; border: 1px solid var(--border); cursor: pointer; transition: all .2s; }
    .btn-slack:hover { border-color: #1a1f2e; box-shadow: 0 4px 12px rgba(0,0,0,.08); transform: translateY(-1px); }
    .btn-whatsapp { display: inline-flex; align-items: center; gap: 10px; background: #25D366; color: #fff; padding: 14px 28px; border-radius: 8px; font-size: 15px; font-weight: 600; border: 1px solid #25D366; cursor: pointer; transition: all .2s; }
    .btn-whatsapp:hover { background: #1ebe5d; border-color: #1ebe5d; box-shadow: 0 4px 12px rgba(37,211,102,.3); transform: translateY(-1px); }
    .coworkers-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .coworkers-grid { display: grid; grid-template-columns: 280px 1fr; gap: 48px; align-items: stretch; }
    .cw-panel { display: none; }
    .cw-panel.active { display: block; }
    .cw-panels-wrap { position: sticky; top: 100px; height: 100%; }
    .cw-panel { height: 100%; }
    .slack-mockup { height: 100%; }
    @media (max-width: 1000px) {
      .coworkers-grid { grid-template-columns: 1fr; gap: 32px; }
      .coworkers-features { flex-direction: row; flex-wrap: wrap; gap: 8px; }
      .feature-item { flex-direction: row; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px; }
      .feature-icon { width: 28px; height: 28px; border-radius: 8px; margin-bottom: 0; flex-shrink: 0; }
      .feature-content p { display: none !important; max-height: 0 !important; opacity: 0 !important; }
      .feature-content h4 { font-size: 14px; }
      .cw-panels-wrap { position: static; }
    }
    
    .coworkers-features { display: flex; flex-direction: column; gap: 12px; }
    .feature-pills { display: flex; flex-direction: column; gap: 8px; }
    .feature-pill { width: 100%; padding: 11px 16px; border-radius: 10px; font-size: 14px; font-weight: 600; font-family: var(--font-display); border: 1.5px solid var(--border); background: #fff; color: var(--fg-secondary); cursor: pointer; transition: all .2s; text-align: left; }
    .feature-pill:hover { border-color: var(--blue); color: var(--blue); background: var(--blue-light); }
    .feature-pill.feature-pill-active { background: var(--blue); color: #fff; border-color: var(--blue); }
    .feature-display { background: var(--blue-light); border: 1px solid var(--border); border-left: 3px solid var(--blue); border-radius: 16px; padding: 24px; }
    .feature-display-icon { width: 44px; height: 44px; border-radius: 10px; background: var(--blue); color: #fff; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
    .feature-display h4 { font-family: var(--font-display); font-size: 17px; font-weight: 700; letter-spacing: -.015em; color: var(--fg); margin-bottom: 8px; }
    .feature-display p { font-size: 14px; color: #64748b; line-height: 1.65; }
    .text-highlight { color: var(--accent); font-weight: 500; }

    /* Slack Mockup */
    .slack-mockup { position: relative; }
    .slack-window { background: #1a1f2e; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.25); }
    .slack-header { background: #0f1419; padding: 12px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,.08); }
    .slack-channel { font-size: 15px; font-weight: 700; color: #fff; }
    .slack-time { font-size: 12px; color: rgba(255,255,255,.5); }
    .slack-messages { padding: 24px; display: flex; flex-direction: column; gap: 20px; min-height: 400px; }
    .slack-message { display: flex; gap: 12px; }
    .slack-avatar { width: 36px; height: 36px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff; flex-shrink: 0; }
    .slack-bot-avatar { background: var(--accent); }
    .slack-msg-content { flex: 1; }
    .slack-msg-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .slack-username { font-size: 14px; font-weight: 700; color: #fff; }
    .slack-app-badge { font-size: 9px; font-weight: 700; letter-spacing: .08em; color: rgba(255,255,255,.6); background: rgba(255,255,255,.1); padding: 2px 6px; border-radius: 4px; }
    .slack-timestamp { font-size: 12px; color: rgba(255,255,255,.4); }
    .slack-msg-text { font-size: 14px; color: rgba(255,255,255,.9); line-height: 1.6; }
    .slack-mention { color: #5b9cff; font-weight: 600; }
    .slack-card { background: #0f1419; border: 1px solid rgba(255,255,255,.1); border-radius: 10px; padding: 20px; margin-top: 12px; }
    .slack-card-label { font-size: 10px; font-weight: 700; letter-spacing: .1em; color: rgba(255,255,255,.5); margin-bottom: 12px; }
    .slack-card-item { display: flex; gap: 12px; margin-bottom: 16px; }
    .slack-warning-bar { width: 3px; background: #f59e0b; border-radius: 999px; flex-shrink: 0; }
    .slack-card-title { font-size: 14px; font-weight: 700; color: #f59e0b; margin-bottom: 4px; }
    .slack-card-desc { font-size: 13px; color: rgba(255,255,255,.65); line-height: 1.6; }
    .slack-card-actions { display: flex; gap: 10px; }
    .slack-btn-primary { background: var(--accent); color: #fff; border: 0; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s; }
    .slack-btn-primary:hover { background: var(--accent-dark); }
    .slack-btn-ghost { background: transparent; color: rgba(255,255,255,.7); border: 0; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s; }
    .slack-btn-ghost:hover { background: rgba(255,255,255,.05); color: #fff; }

    /* Reveal animation */
    .reveal { opacity: 0; transform: translateY(20px); transition: opacity .6s ease-out, transform .6s ease-out; }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* === HERO MOBILE RESPONSIVENESS (C1) === */
    @media (max-width: 720px) {
      .hero h1 { font-size: clamp(28px, 7vw, 40px); overflow-wrap: anywhere; }
      .hero h1 .line { white-space: normal; display: inline; }
      .hero h1 br { display: inline; }
      .hero-sub { font-size: 17px; }
    }

    /* === MOBILE RESPONSIVE OVERRIDES (≤480px) === */
    @media (max-width: 480px) {
      /* 1. Container padding */
      .container { padding: 0 16px; }
      .nav-inner { padding: 0 16px; }
      .footer-inner { padding: 0 16px; }

      /* 2. Hero padding — keep above fixed nav (72px), match home.html spacing */
      .hero { padding: 140px 0 48px; }

      /* 3. Section vertical spacing */
      .section { padding: 48px 0; }

      /* 4. Context metric card absolute positioning */
      .context-metric-card { position: static; margin-top: 16px; }

      /* 5. Context bubble max-width */
      .context-bubble { max-width: 100%; }

      /* 6. Card padding */
      .agent-icon-wrap { padding: 24px 20px 16px; }
      .agent-body { padding: 20px; }
      .sales-feature-card { padding: 20px 16px; }

      /* 7. Context chat min-height */
      .context-chat-body { min-height: 240px; }

      /* 8. Slack mockup min-height + actions wrap */
      .slack-messages { min-height: 280px; }
      .slack-card-actions { flex-wrap: wrap; }

      /* 9. Excessive grid gaps on stacked mobile */
      .context-grid { gap: 40px; }
      .lead-grid { gap: 32px; }
    }

    /* ===== Mobile nav panel ===== */
    .nav-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      color: var(--fg-secondary);
    }
    .nav-toggle svg { width: 24px; height: 24px; display: block; }
    .nav-mobile-panel { display: none; }
    @media (max-width: 768px) {
      .nav-toggle { display: block; }
      .nav-mobile-panel {
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 72px;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.98);
        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);
        padding: 8px 24px 20px;
        gap: 0;
        border-bottom: 1px solid var(--border-light);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        transform: translateY(-12px);
        opacity: 0;
        visibility: hidden;
        transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
        z-index: 999;
      }
      body.nav-open .nav-mobile-panel {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }
      .nav-mobile-panel a {
        padding: 14px 6px;
        font-size: 16px;
        font-weight: 500;
        color: var(--fg-secondary);
        border-bottom: 1px solid var(--border-light);
      }
      .nav-mobile-panel a:last-child { border-bottom: none; }
      .nav-mobile-panel a.nav-mobile-cta {
        margin-top: 14px;
        text-align: center;
        justify-content: center;
        background: var(--accent);
        color: #fff;
        padding: 14px 24px;
        border-radius: 9999px;
        border: none;
        font-weight: 600;
      }
      body.nav-open { overflow: hidden; }
    }
  </style>
</head>
