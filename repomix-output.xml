  <script>
    // Reveal on scroll
    document.querySelectorAll('.reveal').forEach(el => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      observer.observe(el);
    });

    // Feature cards interaction
    (function() {
      const scenarios = {
        'real-time': {
          channel: 'support-queries',
          time: '10:22 AM',
          user: 'Sarah L.',
          userInitials: 'SL',
          userColor: '#1863dc',
          userMessage: '<span class="slack-mention">@Infina AI</span> What\'s the tax impact if I sell my AAPL position today?',
          botResponse: 'Selling today realises a <span style="color: #22c55e; font-weight: 600;">long-term gain of $4,280</span>.',
          cardLabel: 'TAX SUMMARY',
          cardItems: [
            { label: 'Cost basis', value: '$12,400' },
            { label: 'Proceeds', value: '$16,680' },
            { label: 'Est. tax (15%)', value: '$642', highlight: true }
          ],
          buttons: ['See full analysis', 'Dismiss']
        },
        'instant': {
          channel: 'compliance-review',
          time: '2:15 PM',
          user: 'Peter W.',
          userInitials: 'PW',
          userColor: '#9333ea',
          userMessage: '<span class="slack-mention">@Infina AI Work</span> Check this marketing draft against SEC Rule 206(4)-1.',
          botResponse: 'Compliance Analysis — SEC Rule 206(4)-1<br>Reviewed 847 words. <span style="color: #22c55e; font-weight: 600;">12 rules passed</span>, <span style="color: #f59e0b; font-weight: 600;">1 flagged</span>.',
          cardLabel: 'FLAGGED ISSUE',
          cardWarning: true,
          cardTitle: 'Missing Disclosure',
          cardDesc: 'Requires standard performance disclaimer — past results do not guarantee future returns.',
          buttons: ['View suggested fix', 'Ignore']
        },
        'simplify': {
          channel: 'finops-team',
          time: '9:47 AM',
          user: 'Maria Kim',
          userInitials: 'MK',
          userColor: '#9333ea',
          userMessage: '<span class="slack-mention">@Infina AI</span> Run the month-end close.',
          botResponse: 'Running month-end close for November…',
          cardLabel: 'RECONCILIATION RESULTS',
          cardChecks: [
            { text: 'Transactions matched', done: true },
            { text: 'Ledger reconciled', done: true },
            { text: '1 exception flagged', warning: true }
          ],
          buttons: ['View exception', 'Download report']
        }
      };

      const featureData = [
        {
          icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
          title: 'Real-time Support',
          description: 'Resolves tier-1 and tier-2 queries instantly, providing insights and unblocking your team in seconds.',
          scenario: 'real-time'
        },
        {
          icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
          title: 'Instant Solutions',
          description: 'Retrieves accurate answers and actionable guidance instantly, helping teams execute workflows 5x faster.',
          scenario: 'instant'
        },
        {
          icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6M5.64 5.64l4.24 4.24m4.24 4.24l4.24 4.24M1 12h6m6 0h6M5.64 18.36l4.24-4.24m4.24-4.24l4.24-4.24"/></svg>`,
          title: 'Simplify Operations',
          description: 'Automates data retrieval, synthesis, and operational checks, empowering your team to focus on high-impact tasks.',
          scenario: 'simplify'
        }
      ];

      const pills = document.querySelectorAll('.feature-pill');
      const featureDisplay = document.getElementById('feature-display');
      const slackChannel = document.querySelector('.slack-channel');
      const slackTime = document.querySelector('.slack-time');
      const slackMessages = document.querySelector('.slack-messages');

      function renderFeatureDisplay(data) {
        featureDisplay.innerHTML = `
          <div class="feature-display-icon">${data.icon}</div>
          <h4>${data.title}</h4>
          <p>${data.description}</p>
        `;
      }

      function renderSlackMockup(scenario) {
        slackChannel.textContent = `# ${scenario.channel}`;
        slackTime.textContent = scenario.time;

        let cardHTML = '';
        if (scenario.cardItems) {
          cardHTML = `<div class="slack-card">
            <div class="slack-card-label">${scenario.cardLabel}</div>
            ${scenario.cardItems.map(item => `
              <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px;">
                <span style="color: rgba(255,255,255,.6);">${item.label}</span>
                <span style="color: ${item.highlight ? '#f59e0b' : '#fff'}; font-weight: 600;">${item.value}</span>
              </div>
            `).join('')}
            <div class="slack-card-actions" style="margin-top: 16px;">
              ${scenario.buttons.map((btn, i) => 
                `<button class="slack-btn-${i === 0 ? 'primary' : 'ghost'}">${btn}</button>`
              ).join('')}
            </div>
          </div>`;
        } else if (scenario.cardWarning) {
          cardHTML = `<div class="slack-card">
            <div class="slack-card-label">${scenario.cardLabel}</div>
            <div class="slack-card-item">
              <div class="slack-warning-bar"></div>
              <div>
                <div class="slack-card-title">${scenario.cardTitle}</div>
                <div class="slack-card-desc">${scenario.cardDesc}</div>
              </div>
            </div>
            <div class="slack-card-actions">
              ${scenario.buttons.map((btn, i) => 
                `<button class="slack-btn-${i === 0 ? 'primary' : 'ghost'}">${btn}</button>`
              ).join('')}
            </div>
          </div>`;
        } else if (scenario.cardChecks) {
          cardHTML = `<div class="slack-card">
            <div class="slack-card-label">${scenario.cardLabel}</div>
            ${scenario.cardChecks.map(check => `
              <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                <span style="color: ${check.warning ? '#f59e0b' : '#22c55e'}; font-size: 16px;">${check.done ? '✓' : '⚠'}</span>
                <span style="font-size: 13px; color: ${check.warning ? '#f59e0b' : 'rgba(255,255,255,.8)'};">${check.text}</span>
              </div>
            `).join('')}
            <div class="slack-card-actions" style="margin-top: 16px;">
              ${scenario.buttons.map((btn, i) => 
                `<button class="slack-btn-${i === 0 ? 'primary' : 'ghost'}">${btn}</button>`
              ).join('')}
            </div>
          </div>`;
        }

        slackMessages.innerHTML = `
          <div class="slack-message">
            <div class="slack-avatar" style="background: ${scenario.userColor};">${scenario.userInitials}</div>
            <div class="slack-msg-content">
              <div class="slack-msg-header">
                <span class="slack-username">${scenario.user}</span>
                <span class="slack-timestamp">${scenario.time}</span>
              </div>
              <div class="slack-msg-text">${scenario.userMessage}</div>
            </div>
          </div>

          <div class="slack-message slack-bot">
            <div class="slack-avatar slack-bot-avatar">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z"/>
              </svg>
            </div>
            <div class="slack-msg-content">
              <div class="slack-msg-header">
                <span class="slack-username">Infina AI${scenario.channel === 'finops-team' ? '' : ' Work'}</span>
                <span class="slack-app-badge">APP</span>
                <span class="slack-timestamp">${scenario.time}</span>
              </div>
              <div class="slack-msg-text">${scenario.botResponse}</div>
              ${cardHTML}
            </div>
          </div>
        `;
      }

      pills.forEach((pill, index) => {
        pill.addEventListener('click', () => {
          pills.forEach(p => p.classList.remove('feature-pill-active'));
          pill.classList.add('feature-pill-active');
          renderFeatureDisplay(featureData[index]);
          renderSlackMockup(scenarios[featureData[index].scenario]);
        });
      });

      // Initial render
      renderFeatureDisplay(featureData[0]);
      renderSlackMockup(scenarios['real-time']);
    })();

    // Fix select label positioning
    document.querySelectorAll('.form-field select').forEach(select => {
      const updateLabel = () => {
        const field = select.closest('.form-field');
        if (select.value && select.value !== '') {
          field.classList.add('has-value');
        } else {
          field.classList.remove('has-value');
        }
      };
      
      select.addEventListener('change', updateLabel);
      select.addEventListener('blur', updateLabel);
      updateLabel(); // Initial check
    });

    // Form handling
    (function() {
      const SHEETS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyO618yfsKfO4nHni2qBe62GWp9fM0vEb0h-Gccw-1wV-w5wJpN3Zayhai1OFxPl98x/exec';
      const form = document.getElementById('lead-form');
      const submitBtn = document.getElementById('df-submit');
      const status = document.getElementById('df-status');
      
      if (!form) return;

      // ===== Custom combo (replaces native <select>) =====
      const combos = document.querySelectorAll('.lead-combo');
      console.log('Found combos:', combos.length);
      
      combos.forEach((combo, idx) => {
        const trigger = combo.querySelector('.lead-combo-trigger');
        const menu = combo.querySelector('.lead-combo-menu');
        const hidden = combo.querySelector('input[type="hidden"]');
        const options = combo.querySelectorAll('.lead-combo-option');

        console.log(`Combo ${idx}:`, { trigger: !!trigger, menu: !!menu, hidden: !!hidden, options: options.length });

        if (!trigger || !menu || !hidden || !options.length) {
          console.warn('Combo missing elements:', combo);
          return;
        }

        const close = () => {
          combo.classList.remove('open');
          console.log('Closed combo', idx);
        };
        
        const open = () => {
          combo.classList.add('open');
          console.log('Opened combo', idx);
        };

        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          console.log('Trigger clicked', idx, 'current open:', combo.classList.contains('open'));
          combo.classList.toggle('open');
        });

        options.forEach((opt, optIdx) => {
          opt.addEventListener('click', (e) => {
            e.stopPropagation();
            const val = opt.dataset.value;
            const label = opt.textContent.trim();
            console.log('Option clicked:', val);
            hidden.value = val;
            trigger.textContent = label;
            trigger.classList.remove('placeholder');
            combo.classList.add('has-value');
            close();
          });
        });

        document.addEventListener('click', (e) => {
          if (!combo.contains(e.target)) {
            close();
          }
        });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.className = 'form-status';
        status.textContent = '';

        // Validate required fields
        const required = form.querySelectorAll('[required]');
        let isValid = true;
        required.forEach(el => {
          if (!el.value.trim()) {
            isValid = false;
          }
        });

        if (!isValid) {
          status.className = 'form-status error';
          status.textContent = 'Please fill in all required fields.';
          return;
        }

        // Collect data
        const data = {
          fullName: form.fullName.value.trim(),
          email: form.email.value.trim(),
          company: form.company.value.trim(),
          jobTitle: form.jobTitle.value.trim(),
          companySize: form.companySize.value,
          phone: form.phone.value.trim(),
          product: form.product.value,
          industry: form.industry.value,
          useCase: form.useCase.value.trim(),
          consent: form.consent.checked,
          source: 'ai-work-en',
        };

        submitBtn.disabled = true;
        submitBtn.querySelector('span').textContent = 'Submitting...';

        try {
          const fd = new FormData();
          Object.keys(data).forEach(k => fd.append(k, typeof data[k] === 'boolean' ? (data[k] ? 'true' : 'false') : data[k]));
          
          const res = await fetch(SHEETS_ENDPOINT, { method: 'POST', body: fd });
          const txt = await res.text();
          
          if (!res.ok) throw new Error('HTTP ' + res.status);

          status.className = 'form-status success';
          status.textContent = 'Thank you! We\'ll be in touch soon.';
          form.reset();
          
        } catch (err) {
          console.error('Form error:', err);
          status.className = 'form-status error';
          status.textContent = 'Something went wrong. Please try again or email us directly.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.querySelector('span').textContent = 'Book a demo';
        }
      });
    })();
  </script>

  <script src="nav.js"></script>
  <script src="footer.js"></script>
  <script>
    (function () {
      var toggle = document.getElementById('crm-video-toggle');
      var panel = document.getElementById('crm-video-panel');
      var iframe = document.getElementById('crm-video-iframe');
      var label = toggle.querySelector('.crm-video-toggle-text');
      var VIDEO_SRC = 'https://www.youtube-nocookie.com/embed/z3EU2NE_gEU?rel=0';
      var open = false;

      toggle.addEventListener('click', function () {
        open = !open;
        panel.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          iframe.src = VIDEO_SRC;
          label.textContent = 'Hide video';
        } else {
          iframe.src = '';
          label.textContent = 'See how it works';
        }
      });
    })();
  </script>
</body>
