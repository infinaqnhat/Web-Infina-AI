      align-items: center;
      justify-content: center;
    }

    .phone-avatar svg {
      width: 24px;
      height: 24px;
    }

    .phone-greeting {
      flex: 1;
      line-height: 1.2;
      text-align: left;
    }

    .phone-greeting small {
      display: block;
      font-size: 11px;
      color: var(--muted);
    }

    .phone-greeting strong {
      font-size: 15px;
      font-weight: 700;
      color: var(--fg);
    }

    .phone-icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      cursor: pointer;
    }

    .phone-icon-btn svg {
      width: 16px;
      height: 16px;
    }

    .phone-balance {
      background: linear-gradient(135deg, #0a0a0a 0%, #0f1a3a 50%, #112a5e 100%);
      border-radius: 18px;
      padding: 18px;
      color: #fff;
      margin-bottom: 14px;
      position: relative;
      overflow: hidden;
    }

    .phone-balance::before {
      content: "";
      position: absolute;
      inset: -30% -30% auto auto;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(111, 168, 255, 0.3), transparent 70%);
      pointer-events: none;
    }

    .phone-balance-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      position: relative;
      z-index: 1;
    }

    .phone-balance-label {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .phone-balance-trend {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      background: rgba(40, 200, 120, 0.15);
      border: 1px solid rgba(40, 200, 120, 0.3);
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      color: #4cd584;
    }

    .phone-balance-trend svg {
      width: 10px;
      height: 10px;
    }

    .phone-balance-value {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
      position: relative;
      z-index: 1;
    }

    .phone-balance-actions {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      position: relative;
      z-index: 1;
    }

    .phone-action {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(4px);
      border-radius: 10px;
      padding: 8px 4px;
      text-align: center;
      font-size: 11px;
      color: rgba(255, 255, 255, 0.85);
    }

    .phone-action span {
      display: block;
      font-size: 14px;
      margin-bottom: 2px;
      color: #fff;
    }

    .phone-ai-card {
      background: #fff;
      border: 1px solid color-mix(in oklab, var(--accent) 20%, transparent);
      border-radius: 16px;
      padding: 14px;
      box-shadow: 0 8px 24px rgba(24, 99, 220, 0.08);
      position: relative;
      animation: ai-card-glow 3s ease-in-out infinite;
    }

    @keyframes ai-card-glow {

      0%,
      100% {
        box-shadow: 0 8px 24px rgba(24, 99, 220, 0.08), 0 0 0 0 rgba(24, 99, 220, 0);
      }

      50% {
        box-shadow: 0 8px 24px rgba(24, 99, 220, 0.15), 0 0 0 4px rgba(24, 99, 220, 0.08);
      }
    }

    .phone-ai-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .phone-ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 700;
      color: var(--accent);
    }

    .phone-ai-dot {
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 6px var(--accent);
      animation: speed-dot 1.6s ease-in-out infinite;
    }

    .phone-ai-brand {
      font-size: 9px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.12em;
    }

    .phone-ai-msg {
      font-size: 12.5px;
      line-height: 1.5;
      color: var(--fg-secondary);
      margin: 0 0 10px;
      text-align: left;
      font-weight: 500;
    }

    /* Goal block inside AI card */
    .phone-goal {
      background: #fff;
      border: 1px solid rgba(24, 99, 220, 0.14);
      border-radius: 12px;
      padding: 10px 12px;
      margin-bottom: 10px;
      box-shadow: 0 2px 8px rgba(24, 99, 220, 0.04);
    }

    .phone-goal-top {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 8px;
    }

    .phone-goal-icon {
      width: 30px;
      height: 30px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--accent), #6fa8ff);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(24, 99, 220, 0.25);
    }

    .phone-goal-icon svg {
      width: 16px;
      height: 16px;
    }

    .phone-goal-info {
      flex: 1;
      line-height: 1.15;
      text-align: left;
    }

    .phone-goal-info small {
      font-size: 9px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }

    .phone-goal-info strong {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--fg);
      letter-spacing: -0.01em;
    }

    .phone-goal-badge {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 9.5px;
      font-weight: 700;
      color: #0e7c3e;
      background: rgba(40, 200, 120, 0.13);
      padding: 3px 7px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .phone-goal-badge svg {
      width: 9px;
      height: 9px;
    }

    .phone-progress {
      height: 5px;
      background: rgba(24, 99, 220, 0.1);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 10px;
      position: relative;
    }

    .phone-progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--accent), #6fa8ff);
      border-radius: 999px;
      animation: phone-progress 2.4s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
      box-shadow: 0 0 8px rgba(24, 99, 220, 0.4);
      position: relative;
    }

    .phone-progress-bar::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: 6px;
      background: rgba(255, 255, 255, 0.6);
      border-radius: 999px;
      filter: blur(2px);
    }

    @keyframes phone-progress {
      from {
        width: 0;
      }

      to {
        width: 85%;
      }
    }

    .phone-goal-stats {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .phone-stat {
      flex: 1;
      line-height: 1.15;
      text-align: left;
    }

    .phone-stat small {
      font-size: 9px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: block;
      font-weight: 600;
    }

    .phone-stat strong {
      font-size: 13px;
      font-weight: 700;
      color: var(--fg);
      font-family: var(--font-display);
      letter-spacing: -0.01em;
    }

    .phone-stat-up {
      color: #0e7c3e !important;
    }

    .phone-stat-divider {
      width: 1px;
      height: 22px;
      background: rgba(24, 99, 220, 0.12);
    }

    .phone-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .phone-btn-primary svg {
      width: 13px;
      height: 13px;
    }

    .phone-ai-actions {
      display: flex;
      gap: 6px;
    }

    .phone-btn-ghost,
    .phone-btn-primary {
      flex: 1;
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 600;
      border: 0;
      cursor: pointer;
      font-family: inherit;
    }

    .phone-btn-ghost {
      background: #f4f6fb;
      color: var(--fg-secondary);
      border: 1px solid var(--border-light);
    }

    .phone-btn-primary {
      background: var(--accent);
      color: #fff;
    }

    .phone-ai-typing {
      position: absolute;
      bottom: -18px;
      left: 18px;
      display: flex;
      gap: 4px;
      padding: 6px 10px;
      background: var(--accent);
      border-radius: 999px;
      box-shadow: 0 4px 12px rgba(24, 99, 220, 0.25);
    }

    .phone-ai-typing span {
      width: 5px;
      height: 5px;
      background: #fff;
      border-radius: 50%;
      opacity: 0.4;
      animation: ai-typing 1.2s ease-in-out infinite;
    }

    .phone-ai-typing span:nth-child(2) {
      animation-delay: 0.15s;
    }

    .phone-ai-typing span:nth-child(3) {
      animation-delay: 0.3s;
    }

    @keyframes ai-typing {

      0%,
      100% {
        opacity: 0.4;
        transform: translateY(0);
      }

      50% {
        opacity: 1;
        transform: translateY(-2px);
      }
    }

    /* ===== Infina AI Core Section ===== */
    .core-section {
      padding: var(--section-gap) 0;
      position: relative;
      background:
        radial-gradient(ellipse 70% 50% at 50% 50%, rgba(24, 99, 220, 0.06), transparent 70%),
        #fafafa;
      overflow: hidden;
    }

    .core-section::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(24, 99, 220, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(24, 99, 220, 0.04) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 0%, transparent 70%);
      -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 0%, transparent 70%);
      pointer-events: none;
    }

    .core-section .container {
      position: relative;
      z-index: 1;
    }

    .core-header {
      text-align: center;
      margin-bottom: 56px;
    }

    .core-headline {
      font-family: var(--font-display);
      font-size: clamp(28px, 3.8vw, 48px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.025em;
      color: var(--fg);
      max-width: 900px;
      margin: 0 auto;
    }

    .core-accent {
      background: linear-gradient(135deg, var(--accent) 0%, #6fa8ff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .core-products-row {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 48px;
    }

    .core-product-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 24px;
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: 999px;
      font-size: 15px;
      font-weight: 600;
      color: var(--fg);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: default;
    }

    .core-product-pill[data-product="personal"] {
      --pill-color: #7e57c2;
    }

    .core-product-pill[data-product="inside"] {
      --pill-color: #1863dc;
    }

    .core-product-pill[data-product="work"] {
      --pill-color: #149a6e;
    }

    .core-product-pill:hover {
      transform: translateY(-3px);
      border-color: var(--pill-color);
      box-shadow: 0 12px 32px -8px color-mix(in oklab, var(--pill-color) 35%, transparent);
    }

    .core-pill-icon {
      width: 22px;
      height: 22px;
      border-radius: 8px;
      background: color-mix(in oklab, var(--pill-color) 10%, transparent);
      color: var(--pill-color);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .core-pill-icon svg {
      width: 13px;
      height: 13px;
    }

    .core-platform {
      position: relative;
      margin-bottom: 64px;
    }

    .core-platform-header {
      display: flex;
      justify-content: center;
      margin-bottom: 40px;
    }

    .core-platform-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 28px;
      background: linear-gradient(135deg, var(--accent), #4c8df0);
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: #fff;
      text-transform: uppercase;
      box-shadow: 0 8px 24px rgba(24, 99, 220, 0.3);
      position: relative;
      overflow: hidden;
    }

    .core-platform-badge::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transform: translateX(-100%);
      animation: core-shine 3s ease-in-out infinite;
    }

    @keyframes core-shine {

      0%,
      100% {
        transform: translateX(-100%);
      }

      50% {
        transform: translateX(100%);
      }
    }

    .core-badge-dot {
      width: 7px;
      height: 7px;
      background: #fff;
      border-radius: 50%;
      box-shadow: 0 0 12px rgba(255, 255, 255, 0.8);
      animation: core-dot-pulse 2s ease-in-out infinite;
    }

    @keyframes core-dot-pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.7;
        transform: scale(1.3);
      }
    }

    .core-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      max-width: 1100px;
      margin: 0 auto;
    }

    @media (max-width: 768px) {
      .core-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 568px) {
      .core-grid {
        grid-template-columns: 1fr;
      }
    }

    .core-card {
      background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
      border: 1px solid var(--border-light);
      border-radius: 18px;
      padding: 28px 24px;
      position: relative;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 0;
      animation: core-card-in 0.6s ease-out forwards;
      animation-delay: var(--delay, 0s);
      overflow: hidden;
    }

    @keyframes core-card-in {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .core-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, var(--accent-light) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.4s;
      pointer-events: none;
    }

    .core-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in oklab, var(--accent) 25%, transparent);
      box-shadow:
        0 24px 48px -16px rgba(24, 99, 220, 0.2),
        0 0 0 1px color-mix(in oklab, var(--accent) 15%, transparent);
    }

    .core-card:hover::before {
      opacity: 1;
    }

    .core-card-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, #001F5C 0%, #003380 100%);
      border: 1px solid #001F5C;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      color: #ffffff;
      position: relative;
      overflow: hidden;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
      box-shadow: 0 4px 12px rgba(0, 31, 92, 0.15);
    }

    .core-card-icon::after {
      content: "";
      position: absolute;
      inset: -100%;
      background: conic-gradient(from 0deg, transparent 0%, rgba(255, 255, 255, 0.2) 50%, transparent 100%);
      opacity: 0;
      animation: core-icon-spin 4s linear infinite;
      transition: opacity 0.3s;
    }

    @keyframes core-icon-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .core-card:hover .core-card-icon {
      transform: scale(1.08) rotate(-5deg);
      box-shadow: 0 6px 16px rgba(0, 31, 92, 0.25);
    }

    .core-card:hover .core-card-icon::after {
      opacity: 0.4;
    }

    .core-card-icon svg {
      width: 28px;
      height: 28px;
      position: relative;
      z-index: 1;
    }

    .core-card-title {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--fg);
      margin-bottom: 10px;
      line-height: 1.3;
    }

    .core-card-desc {
      font-size: 14px;
      line-height: 1.65;
      color: var(--muted);
    }

    .core-footer {
      text-align: center;
      padding-top: 24px;
    }

    .core-tagline {
      font-family: var(--font-display);
      font-size: clamp(18px, 2.2vw, 26px);
      font-weight: 600;
      line-height: 1.4;
      color: var(--fg-secondary);
      font-style: italic;
      max-width: 900px;
      margin: 0 auto;
      white-space: nowrap;
    }

    @media (max-width: 768px) {
      .core-tagline {
        white-space: normal;
      }
    }

    .core-tagline-accent {
      color: var(--accent);
      font-weight: 700;
      font-style: normal;
    }

    /* Legacy stats hidden */
    .stats {
      display: none;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
      text-align: center;
    }

    @media (max-width: 800px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .stat-item {
      opacity: 0;
      animation: counter 0.6s ease-out forwards;
    }

    .stat-item:nth-child(1) {
      animation-delay: 0.1s;
    }

    .stat-item:nth-child(2) {
      animation-delay: 0.2s;
    }

    .stat-item:nth-child(3) {
      animation-delay: 0.3s;
    }

    .stat-item:nth-child(4) {
      animation-delay: 0.4s;
    }

    .stat-number {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 700;
      letter-spacing: -0.03em;
      background: linear-gradient(135deg, var(--fg) 0%, var(--accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .stat-label {
      font-size: 14px;
      color: var(--muted);
      margin-top: 8px;
    }

    .products {
      padding: var(--section-gap) 0;
      background: linear-gradient(180deg, #fafafa 0%, var(--bg) 100%);
      position: relative;
      overflow: hidden;
    }

    .products::before {
      content: '';
      position: absolute;
      top: -200px;
      right: -200px;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, var(--accent-light) 0%, transparent 70%);
      opacity: 0.5;
      pointer-events: none;
    }

    .products .container {
      position: relative;
      z-index: 1;
    }

    .products .section-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 72px;
    }

    .products .section-header h2 {
      text-align: center;
      max-width: none;
      font-size: clamp(36px, 4.6vw, 56px);
      line-height: 1.08;
      letter-spacing: -0.025em;
      color: #001964;
    }

    .products .section-header h2 .accent {
      background: linear-gradient(135deg, var(--accent) 0%, #6fa8ff 50%, var(--accent) 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      animation: gradient-shift 4s ease infinite;
    }

    .products .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0;
      background: none;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 20px;
      box-shadow: none;
    }

    .products .section-eyebrow::before {
      content: none;
    }

    .section-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .section-header {
      margin-bottom: 64px;
    }

    .section-header h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 5vw, 52px);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin-bottom: 20px;
    }

    .section-header p {
      font-size: 18px;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.6;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    @media (max-width: 1000px) {
      .products-grid {
        grid-template-columns: 1fr;
      }
    }

    .product-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px 32px 32px;
      position: relative;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s, border-color 0.3s;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      isolation: isolate;
    }

    .product-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, var(--card-tint, var(--accent-light)) 0%, transparent 55%);
      opacity: 0;
      transition: opacity 0.4s;
      z-index: -1;
    }

    .product-card[data-product="personal"] {
      --card-tint: rgba(0, 31, 92, 0.04);
      --card-accent: rgba(0, 31, 92, 0.5);
    }

    .product-card[data-product="inside"] {
      --card-tint: rgba(0, 31, 92, 0.04);
      --card-accent: rgba(0, 31, 92, 0.5);
    }

    .product-card[data-product="work"] {
      --card-tint: rgba(0, 31, 92, 0.04);
      --card-accent: rgba(0, 31, 92, 0.5);
    }

    .product-num {
      position: absolute;
      top: 24px;
      right: 28px;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 700;
      color: #001F5C;
      letter-spacing: 0.1em;
      opacity: 0.6;
    }

    .product-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), #4c6ee6);
      transform: scaleX(0);
      transition: transform 0.4s;
    }

    .product-card:hover {
      transform: translateY(-6px);
      border-color: transparent;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 31, 92, 0.3);
    }

    /* Active card — desktop: lift + colored ring */
    @media (min-width: 1001px) {
      .product-card.active {
        transform: translateY(-6px);
        border-color: transparent;
        box-shadow: none;
      }
      .product-card[data-product="inside"].active  { box-shadow: 0 24px 60px rgba(24,99,220,0.15),  0 0 0 2px #1863dc; }
      .product-card[data-product="work"].active    { box-shadow: 0 24px 60px rgba(20,154,110,0.15), 0 0 0 2px #149a6e; }
      .product-card[data-product="personal"].active{ box-shadow: 0 24px 60px rgba(126,87,194,0.15), 0 0 0 2px #7e57c2; }
    }

    /* Active card — mobile: flatten bottom, merge into accordion panel */
    @media (max-width: 1000px) {
      .product-card.active {
        transform: translateY(0);
        border-radius: 20px 20px 0 0;
        border-bottom: none;
        box-shadow: none;
      }
      .product-card[data-product="inside"].active  { border-color: #1863dc; border-width: 2px; }
      .product-card[data-product="work"].active    { border-color: #149a6e; border-width: 2px; }
      .product-card[data-product="personal"].active{ border-color: #7e57c2; border-width: 2px; }
    }

    .product-card:hover::before {
      opacity: 1;
    }

    /* See-more accordion toggle */
    .product-see-more {
      font-size: 13px;
      font-weight: 600;
      color: var(--muted, #9ca3af);
      margin-top: auto;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      user-select: none;
      transition: color 0.2s;
    }
    .product-see-more::before {
      content: '';
      display: inline-block;
      flex-shrink: 0;
      width: 0;
      height: 0;
      border-top: 5px solid transparent;
      border-bottom: 5px solid transparent;
      border-left: 8px solid currentColor;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .see-more-default { display: inline; }
    .see-more-active  { display: none; }
    .product-card.active .see-more-default { display: none; }
    .product-card.active .see-more-active  { display: inline; }
    .product-card.active .product-see-more::before {
      transform: rotate(90deg);
    }
    .product-card:hover .product-see-more {
      color: var(--accent, #001F5C);
    }
    .product-card[data-product="inside"].active .product-see-more  { color: #1863dc; }
    .product-card[data-product="work"].active .product-see-more    { color: #149a6e; }
    .product-card[data-product="personal"].active .product-see-more{ color: #7e57c2; }

    /* ===== Product panel (accordion on mobile, full-width reveal on desktop) ===== */
    #tab-inside   { --panel-color: #1863dc; }
    #tab-work     { --panel-color: #149a6e; }
    #tab-personal { --panel-color: #7e57c2; }

    .product-panel { display: none; }
    .product-panel.active {
      display: block;
      animation: fade-up 0.4s ease-out both;
    }

    @media (min-width: 1001px) {
      .product-group { display: contents; }
      .product-card  { grid-row: 1; }
      .product-panel { grid-row: 2; grid-column: 1 / -1; }
    }

    @media (max-width: 1000px) {
      .products-grid { display: flex; flex-direction: column; gap: 16px; }
      .product-group { display: flex; flex-direction: column; }
      .product-tree-connector { display: none; }
      .product-panel {
        display: block;
        overflow: hidden;
        max-height: 0;
        opacity: 0;
        animation: none;
        transition: max-height 0.5s cubic-bezier(0.4,0,0.2,1), opacity 0.35s ease;
      }
      .product-panel.active { max-height: 3000px; opacity: 1; }
    }

    .product-panel-inner .agents-grid {
      max-width: none;
      margin: 0;
    }

    @media (min-width: 1001px) {
      .product-tree-connector {
        height: 12px;
      }
      .product-panel-inner {
        position: relative;
        background: var(--surface);
        padding: 32px;
        border: 2px solid var(--panel-color, var(--accent));
        border-radius: 20px;
      }
      .product-panel-inner::before {
        content: '';
        position: absolute;
        top: 0;
        width: 18px;
        height: 18px;
        background: var(--surface);
        border-top: 2px solid var(--panel-color, var(--accent));
        border-left: 2px solid var(--panel-color, var(--accent));
        transform: translateX(-50%) translateY(-50%) rotate(45deg);
      }
      #tab-inside   .product-panel-inner::before { left: calc(100% / 6); }
      #tab-work     .product-panel-inner::before { left: 50%; }
      #tab-personal .product-panel-inner::before { left: calc(100% * 5 / 6); }
    }

    @media (max-width: 1000px) {
      .product-panel-inner {
        background: var(--surface);
        padding: 24px 16px;
        border: 2px solid var(--panel-color, var(--accent));
        border-top: none;
        border-radius: 0 0 20px 20px;
      }
    }

    .product-icon {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #001F5C 0%, #003380 100%);
      border-radius: 14px;
      margin-bottom: 20px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
      position: relative;
      overflow: hidden;
      border: none;
      box-shadow: 0 4px 12px rgba(0, 31, 92, 0.25);
    }

    .product-icon svg {
      width: 26px;
      height: 26px;
      color: #ffffff;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .product-icon::after {
      content: '';
      position: absolute;
      inset: -50%;
      background: conic-gradient(from 0deg, transparent 0%, rgba(0, 31, 92, 0.1) 50%, transparent 100%);
      opacity: 0;
      animation: icon-spin 4s linear infinite;
      transition: opacity 0.3s;
    }

    .product-icon::before {
      content: '';
      position: absolute;
      inset: 2px;
      background: linear-gradient(135deg, rgba(0, 31, 92, 0.06) 0%, rgba(0, 31, 92, 0.1) 100%);
      border-radius: 12px;
      z-index: 1;
    }

    .product-icon svg {
      position: relative;
      z-index: 2;
    }

    .product-card:hover .product-icon::after {
      opacity: 0.6;
    }

    @keyframes icon-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .product-icon .icon-pulse {
      animation: icon-pulse 2s ease-in-out infinite;
      transform-origin: center;
    }

    .product-card:hover .icon-pulse {
      animation-duration: 1s;
    }

    @keyframes icon-pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.6;
        transform: scale(0.92);
      }
    }

    .product-icon .icon-dot {
      animation: icon-dot 1.6s ease-in-out infinite;
    }

    .product-icon .icon-dot:nth-child(2) {
      animation-delay: 0.2s;
    }

    .product-icon .icon-dot:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes icon-dot {

      0%,
      100% {
        opacity: 0.3;
      }

      50% {
        opacity: 1;
      }
    }

    .product-card:hover .product-icon {
      transform: scale(1.05) rotate(-3deg);
      background: linear-gradient(135deg, #003380 0%, #004aad 100%);
      box-shadow: 0 6px 16px rgba(0, 31, 92, 0.35);
    }

    .product-audience-label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: #4a4a55;
      margin-bottom: 8px;
      padding-left: 20px;
    }

    .product-tag {
      display: inline-block;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--tag-color, rgba(0, 31, 92, 0.9));
      background: transparent;
      border: 2px solid var(--tag-color, rgba(0, 31, 92, 0.9));
      padding: 6px 18px;
      border-radius: 999px;
      margin-bottom: 20px;
      align-self: flex-start;
      box-shadow: none;
    }

    .product-card[data-product="inside"] .product-tag {
      --tag-color: #1863dc;
    }

    .product-card[data-product="work"] .product-tag {
      --tag-color: #149a6e;
    }

    .product-card[data-product="personal"] .product-tag {
      --tag-color: #7e57c2;
    }

    .product-bullets {
      list-style: none;
      padding: 0;
      margin: 0 0 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .product-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: #4a4a55;
      line-height: 1.5;
    }

    .product-bullets li::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
      opacity: 0.7;
      margin-top: 6px;
    }

    .product-card h3 {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
      color: var(--fg);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-tagline {
      font-size: 14px;
      font-weight: 500;
      color: var(--fg-secondary);
      line-height: 1.55;
      margin-bottom: 24px;
      min-height: 44px;
    }

    .product-desc {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 24px;
      flex-grow: 1;
    }

    .product-desc:empty {
      display: none;
    }

    .product-features {
      list-style: none;
      margin-bottom: 28px;
      flex-grow: 1;
    }

    .product-features li {
      font-size: 13px;
      color: var(--fg-secondary);
      padding: 10px 0;
      border-top: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      gap: 10px;
      transition: transform 0.2s;
    }

    .product-card:hover .product-features li {
      transform: translateX(4px);
    }

    .product-features li:last-child {
      border-bottom: 1px solid var(--border-light);
    }

    .check {
      width: 18px;
      height: 18px;
      background: rgba(0, 31, 92, 0.08);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 10px;
      color: #001F5C;
      border: 1px solid rgba(0, 31, 92, 0.15);
    }

    .product-link {
      font-size: 14px;
      font-weight: 600;
      color: var(--fg);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s;
      margin-top: auto;
    }

    .product-link:hover {
      color: var(--card-accent, var(--accent));
      gap: 14px;
    }

    .product-link::after {
      content: "→";
    }

    /* ===== Why Infina — Light high-tech ===== */
    .why-infina {
      padding: var(--section-gap) 0;
      background: linear-gradient(180deg, #f7f9ff 0%, var(--bg) 100%);
      position: relative;
      overflow: hidden;
      color: var(--fg);
    }

    .why-infina::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 0%, rgba(24, 99, 220, 0.12), transparent 55%),
        radial-gradient(ellipse at 85% 100%, rgba(111, 168, 255, 0.10), transparent 55%);
      pointer-events: none;
    }

    .why-infina::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(24, 99, 220, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(24, 99, 220, 0.06) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse at 50% 40%, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 30%, transparent 75%);
      pointer-events: none;
      animation: why-grid-drift 30s linear infinite;
    }

    @keyframes why-grid-drift {
      from {
        background-position: 0 0, 0 0;
      }

      to {
        background-position: 56px 56px, 56px 56px;
      }
    }

    .why-infina .container {
      position: relative;
      z-index: 1;
    }

    .why-infina .section-header {
      text-align: center;
      margin-bottom: 72px;
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
    }

    .why-infina .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: var(--accent-light);
      border: 1px solid color-mix(in oklab, var(--accent) 22%, transparent);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 20px;
    }

    .why-infina .eyebrow::before {
      content: "";
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--accent);
      animation: why-pulse 2s ease-in-out infinite;
    }

    @keyframes why-pulse {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.4;
      }
    }

    .why-infina h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 4.6vw, 60px);
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: var(--fg);
      font-weight: 700;
    }

    .why-infina h2 .accent {
      background: linear-gradient(135deg, #6fa8ff 0%, var(--accent) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    @media (max-width: 900px) {
      .why-grid {
        grid-template-columns: 1fr;
      }
    }

    .why-item {
      position: relative;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(24, 99, 220, 0.12);
      border-radius: 20px;
      padding: 36px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
      overflow: hidden;
      isolation: isolate;
      opacity: 0;
      animation: why-card-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .why-item:nth-child(1) {
      animation-delay: 0.05s;
    }

    .why-item:nth-child(2) {
      animation-delay: 0.18s;
    }

    .why-item:nth-child(3) {
      animation-delay: 0.31s;
    }

    .why-item:nth-child(4) {
      animation-delay: 0.44s;
    }

    @keyframes why-card-in {
      from {
        opacity: 0;
        transform: translateY(28px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .why-item::before {
      content: "";
      position: absolute;
      top: -1px;
      left: -1px;
      right: -1px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(24, 99, 220, 0.5), transparent);
      opacity: 0.5;
      animation: why-top-shimmer 4s ease-in-out infinite;
    }

    .why-item:nth-child(2)::before {
      animation-delay: 1s;
    }

    .why-item:nth-child(3)::before {
      animation-delay: 2s;
    }

    .why-item:nth-child(4)::before {
      animation-delay: 3s;
    }

    @keyframes why-top-shimmer {

      0%,
      100% {
        opacity: 0.3;
        background-position: -100% 0;
      }

      50% {
        opacity: 0.8;
        background-position: 200% 0;
      }
    }

    .why-item::after {
      content: "";
      position: absolute;
      inset: -40% -40% auto auto;
      width: 280px;
      height: 280px;
      background: radial-gradient(circle, rgba(24, 99, 220, 0.15), transparent 70%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: -1;
    }

    .why-item:hover {
      transform: translateY(-4px);
      border-color: rgba(24, 99, 220, 0.35);
      background: #fff;
      box-shadow: 0 18px 50px -20px rgba(24, 99, 220, 0.35);
    }

    .why-item:hover::after {
      opacity: 1;
    }

    .why-item-num {
      position: absolute;
      top: 28px;
      right: 32px;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.12em;
      transition: color 0.3s ease, transform 0.3s ease;
    }

    .why-item:hover .why-item-num {
      color: var(--accent);
      transform: translateX(-2px);
    }

    .why-item-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(24, 99, 220, 0.18), rgba(24, 99, 220, 0.05));
      border: 1px solid rgba(24, 99, 220, 0.18);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .why-item:hover .why-item-icon {
      transform: rotate(-8deg) scale(1.08);
    }

    .why-item-icon::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 14px;
      box-shadow: 0 0 24px rgba(24, 99, 220, 0.3);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .why-item:hover .why-item-icon::after {
      opacity: 1;
    }

    .why-item-icon svg {
      width: 26px;
      height: 26px;
      stroke-width: 1.6;
      position: relative;
      z-index: 1;
      transition: transform 0.4s ease;
    }

    .why-item:hover .why-item-icon svg {
      transform: rotate(8deg);
    }

    .why-item h4 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      color: var(--fg);
      margin: 0;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    .why-item p {
      font-size: 15px;
      line-height: 1.65;
      color: var(--muted);
      margin: 0;
    }

    .platform-deprecated {
      padding: 0;
      background: var(--fg);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .platform-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 20% 80%, rgba(24, 99, 220, 0.15), transparent),
        radial-gradient(ellipse 50% 30% at 80% 20%, rgba(76, 110, 230, 0.1), transparent);
      z-index: 0;
    }

    .platform .container {
      position: relative;
      z-index: 1;
    }

    .platform .section-label {
      color: rgba(255, 255, 255, 0.5);
    }

    .platform .section-header h2 {
      color: white;
    }

    .platform .section-header p {
      color: rgba(255, 255, 255, 0.6);
      white-space: nowrap;
      max-width: none;
    }

    .platform-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }

    @media (max-width: 900px) {
      .platform-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
    }

    .platform-item {
      text-align: left;
      padding: 32px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius);
      transition: all 0.3s;
    }

    .platform-item:hover {
      background: rgba(255, 255, 255, 0.08);
      transform: translateY(-4px);
    }

    .platform-icon {
      width: 56px;
      height: 56px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
    }

    .platform-item h4 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    .platform-item p {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.65;
    }

    .partners {
      padding: 40px 0;
      background: linear-gradient(135deg, #f0f4ff 0%, #e8eef9 100%);
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    .partners::before {
      content: '';
      position: absolute;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 500px;
      background: radial-gradient(circle, rgba(24,99,220,0.1), transparent 70%);
      filter: blur(80px);
      pointer-events: none;
    }

    .partners-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0;
      background: none;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 auto 14px;
      box-shadow: none;
      position: relative;
      z-index: 1;
      text-align: center;
      width: fit-content;
    }

    .partners-eyebrow::before {
      content: none;
    }

    .partners-headline {
      font-family: var(--font-display);
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 700;
      letter-spacing: -.03em;
      color: var(--fg);
      margin-bottom: 8px;
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .partners-sub {
      font-size: 15px;
      color: var(--muted);
      margin-bottom: 48px;
      position: relative;
      z-index: 1;
      text-align: center;
    }

    @keyframes pulse-dot {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.6;
        transform: scale(1.2);
      }
    }

    .industry-marquee {
      overflow: hidden;
      position: relative;
      z-index: 1;
      margin-top: 20px;
      padding-bottom: 0;
    }

    .industry-track {
      display: flex;
      gap: 24px;
      width: max-content;
      animation: marquee-slide 30s linear infinite;
    }

    .industry-track:hover {
      animation-play-state: paused;
    }

    @keyframes marquee-slide {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-33.333%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .industry-track {
        animation: none;
      }
    }

    .industry-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 12px;
      flex-shrink: 0;
      cursor: default;
      background: transparent;
      border-radius: 24px;
    }

    .industry-card img {
      width: 220px;
      height: 220px;
      border-radius: 16px;
      object-fit: cover;
      display: block;
    }

    .industry-card span {
      font-size: 14px;
      font-weight: 600;
      color: #001964;
      white-space: nowrap;
    }

    .cta-section {
      padding: var(--section-gap) 0;
      text-align: center;
      background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
      position: relative;
    }

    .cta-section::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(24, 99, 220, 0.06), transparent 70%);
      transform: translate(-50%, -50%);
      z-index: 0;
    }

    .cta-section .container {
      position: relative;
      z-index: 1;
    }

    .cta-section h2 {
      font-family: var(--font-display);
      font-size: clamp(32px, 5vw, 48px);
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 20px;
    }

    .cta-section p {
      font-size: 18px;
      color: var(--muted);
      margin-bottom: 36px;
      max-width: 480px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ===== Lead form ===== */
    .lead-section {
      padding: var(--section-gap) 0;
      background: linear-gradient(180deg, #f0f3f9 0%, #e8edf7 100%);
      color: var(--fg);
      position: relative;
      overflow: hidden;
    }

    .lead-section::before {
      content: '';
      position: absolute;
      top: -200px;
      right: -200px;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle, rgba(0, 31, 92, 0.08), transparent 65%);
      filter: blur(40px);
      pointer-events: none;
    }

    .lead-section::after {
      content: '';
      position: absolute;
      bottom: -300px;
      left: -200px;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(0, 31, 92, 0.05), transparent 65%);
      filter: blur(60px);
      pointer-events: none;
    }

    .lead-grid {
      display: grid;
      grid-template-columns: 1fr 1.05fr;
      gap: 80px;
      align-items: start;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 900px) {
      .lead-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
    }

    .lead-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #ffffff;
      margin-bottom: 24px;
      padding: 7px 18px;
      border: none;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--accent) 0%, #1863dc 100%);
      box-shadow: 0 4px 12px rgba(0, 31, 92, 0.25);
    }

    .lead-eyebrow::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
    }

    .lead-copy h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 4.5vw, 56px);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.025em;
      margin-bottom: 20px;
      color: var(--fg);
    }

    .lead-copy h2 .accent {
      background: linear-gradient(135deg, var(--accent) 0%, #1863dc 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .lead-sub {
      font-size: 17px;
      color: var(--fg-secondary);
      margin-bottom: 36px;
      max-width: 460px;
      line-height: 1.55;
    }

    .lead-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 40px;
    }

    .lead-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      font-size: 15px;
      color: var(--fg);
      line-height: 1.5;
    }

    .lead-check {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background: var(--accent-light);
      border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
      color: var(--accent);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      margin-top: 1px;
    }

    .lead-trust {
      padding-top: 32px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .lead-trust-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.4);
      margin-bottom: 16px;
    }

    .lead-trust-logos {
      display: flex;
      flex-wrap: wrap;
      gap: 24px 32px;
      align-items: center;
    }

    .lead-trust-logos span {
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.55);
      letter-spacing: -0.01em;
    }

    .lead-form {
      background: #fff;
      color: var(--fg);
      border-radius: 20px;
      padding: 32px;
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.05);
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
    }

    .lead-form-header {
      margin-bottom: 4px;
    }

    .lead-form-title {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.015em;
      margin-bottom: 2px;
    }

    .lead-form-sub {
      font-size: 12px;
      color: var(--muted);
    }

    @media (max-width: 600px) {
      .lead-form {
        padding: 24px 20px;
      }
    }

    .lead-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    @media (max-width: 480px) {
      .lead-row-2 {
        grid-template-columns: 1fr;
      }
    }

    .lead-field {
      position: relative;
    }

    .lead-field input,
    .lead-field select,
    .lead-field textarea,
    .lead-combo-trigger {
      width: 100%;
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--fg);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 14px 6px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
      appearance: none;
      -webkit-appearance: none;
      text-align: left;
      cursor: pointer;
      min-height: 50px;
    }

    .lead-field input,
    .lead-field textarea {
      cursor: text;
    }

    .lead-field textarea {
      resize: none;
      min-height: 70px;
      line-height: 1.5;
      padding-top: 22px;
    }

    .lead-field input:focus,
    .lead-field select:focus,
    .lead-field textarea:focus,
    .lead-combo.open .lead-combo-trigger {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-light);
    }

    .lead-field input.invalid,
    .lead-field select.invalid,
    .lead-field textarea.invalid {
      border-color: #dc2626;
    }

    .lead-field label {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 14px;
      color: var(--muted);
      pointer-events: none;
      transition: all 0.15s ease;
      background: transparent;
    }

    .lead-field.lead-textarea label {
      top: 18px;
      transform: none;
    }

    .lead-field input:focus+label,
    .lead-field input:not(:placeholder-shown)+label,
    .lead-field textarea:focus+label,
    .lead-field textarea:not(:placeholder-shown)+label,
    .lead-combo.has-value .lead-combo-trigger+label,
    .lead-combo.open .lead-combo-trigger+label {
      top: 8px;
      transform: none;
      font-size: 10px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .lead-select select {
      cursor: pointer;
      padding-right: 36px;
    }

    .lead-select select:invalid {
      color: transparent;
    }

    .lead-caret {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--fg-secondary);
      pointer-events: none;
      font-size: 18px;
      font-weight: 700;
      line-height: 1;
      transition: transform 0.2s;
    }

    .lead-combo.open .lead-caret {
      transform: translateY(-50%) rotate(180deg);
    }

    /* Custom combo (replaces select for prettier dropdown) */
    .lead-combo {
      position: relative;
    }

    .lead-combo-trigger {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding-right: 36px;
      color: var(--fg);
    }

    .lead-combo-trigger.placeholder {
      color: transparent;
    }

    .lead-combo-menu {
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
      padding: 6px;
      max-height: 240px;
      overflow-y: auto;
      z-index: 20;
      display: none;
      animation: lead-combo-in 0.15s ease;
    }

    .lead-combo.open .lead-combo-menu {
      display: block;
    }

    @keyframes lead-combo-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .lead-combo-option {
      padding: 10px 12px;
      font-size: 14px;
      color: var(--fg);
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.1s;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .lead-combo-option:hover,
    .lead-combo-option.active {
      background: var(--accent-light);
      color: var(--accent);
    }

    .lead-combo-option.selected::after {
      content: '✓';
      margin-left: auto;
      color: var(--accent);
      font-weight: 700;
    }

    .lead-consent {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.45;
      cursor: pointer;
      margin-top: 2px;
    }

    .lead-consent input {
      margin-top: 2px;
      accent-color: var(--accent);
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    .lead-policy {
      font-size: 12px;
      color: var(--muted);
    }

    .lead-policy a {
      text-decoration: underline;
      color: var(--fg-secondary);
    }

    .lead-submit {
      align-self: stretch;
      justify-content: center;
      background: var(--accent);
      color: #fff;
      border: 0;
      border-radius: 12px;
      padding: 14px 28px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: transform 0.15s, opacity 0.15s, background 0.15s, box-shadow 0.2s;
      margin-top: 4px;
      position: relative;
      overflow: hidden;
    }

    .lead-submit:hover {
      background: color-mix(in oklab, var(--accent) 85%, #000);
      transform: translateY(-1px);
      box-shadow: 0 12px 30px rgba(24, 99, 220, 0.35);
    }

    .lead-submit::after {
      content: '→';
      font-size: 18px;
      transition: transform 0.2s;
    }

    .lead-submit:hover::after {
      transform: translateX(4px);
    }

    .lead-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .lead-submit-spinner {
      display: none;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: lead-spin 0.7s linear infinite;
    }

    .lead-submit.loading .lead-submit-spinner {
      display: inline-block;
    }

    @keyframes lead-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .lead-status {
      font-size: 14px;
      min-height: 20px;
    }

    .lead-status.success {
      color: #059669;
    }

    .lead-status.error {
      color: #dc2626;
    }

    footer {
      padding: 60px 0;
      border-top: 1px solid var(--border-light);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    @media (max-width: 600px) {
      .footer-inner {
        flex-direction: column;
        gap: 28px;
        text-align: center;
      }
    }

    .footer-logo {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .footer-logo .logo-img {
      height: 23px;
      width: auto;
      display: block;
    }

    .footer-links {
      display: flex;
      gap: 36px;
    }

    .footer-links a {
      font-size: 14px;
      color: var(--muted);
      transition: color 0.2s;
    }

    .footer-links a:hover {
      color: var(--fg);
    }

    .footer-copy {
      font-size: 13px;
      color: var(--muted);
    }

    /* === MOBILE RESPONSIVE OVERRIDES (≤768px / ≤600px / ≤480px) === */

    /* 1. Hide hero decorative shapes — overflow viewport on mobile */
    @media (max-width: 768px) {
      .shape-1,
      .shape-2,
      .shape-3,
      .shape-4 {
        display: none;
      }
    }

    /* 4. Hide decorative glow orbs on mobile — performance + overflow prevention */
    @media (max-width: 768px) {
      .products::before,
      .partners::before,
      .cta-section::before,
      .lead-section::before,
      .lead-section::after {
        display: none;
      }
    }

    /* 3. Footer links — allow wrap to prevent overflow at narrow viewports */
    @media (max-width: 600px) {
      .footer-links {
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
      }
    }

    /* 2. Phone mockup — prevent fixed width overflowing small viewports */
    @media (max-width: 480px) {
      .phone {
        width: 90vw;
        max-width: 320px;
      }
    }

    /* 5. Container padding — ensure comfortable side margins on small screens */
    @media (max-width: 480px) {
      .container {
        padding: 0 16px;
      }
    }

    /* 6. Product card padding — reduce inner padding on small screens */
    @media (max-width: 480px) {
      .product-card {
        padding: 24px 20px 20px;
      }
    }

    /* ===== Mobile nav panel ===== */
    .nav-mobile-panel { display: none; }
    @media (max-width: 768px) {
      .nav-mobile-panel {
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 72px;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.98);
        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);
        padding: 8px 24px 20px;
        gap: 0;
        border-bottom: 1px solid var(--border-light);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        transform: translateY(-12px);
        opacity: 0;
        visibility: hidden;
        transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
        z-index: 999;
      }
      body.nav-open .nav-mobile-panel,
      .nav-mobile-panel.open {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }
      .nav-mobile-panel a {
        padding: 14px 6px;
        font-size: 16px;
        font-weight: 500;
        color: var(--fg-secondary);
        border-bottom: 1px solid var(--border-light);
      }
      .nav-mobile-panel a:last-child { border-bottom: none; }
      .nav-mobile-panel a.nav-mobile-cta {
        margin-top: 14px;
        text-align: center;
        justify-content: center;
        background: var(--accent);
        color: #fff;
        padding: 14px 24px;
        border-radius: 9999px;
        border: none;
        font-weight: 600;
      }
      body.nav-open { overflow: hidden; }
    }

    /* ===== Hero mobile responsiveness fix ===== */
    @media (max-width: 720px) {
      .hero h1 { font-size: clamp(34px, 9vw, 52px); }
      .hero h1 .line {
        white-space: normal;
        display: inline;
      }
      .hero h1 br { display: inline; }
      .hero .container { padding: 0 20px; }
      .hero-sub { font-size: 17px; }
      .hero-ctas { gap: 12px; }
      .btn-primary, .btn-ghost { padding: 14px 22px; font-size: 14px; }
    }
    @media (max-width: 420px) {
      .hero h1 { font-size: clamp(30px, 8.5vw, 38px); letter-spacing: -0.03em; }
      .btn-primary, .btn-ghost { padding: 13px 20px; }
    }

  

    .tweaks-panel {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 14px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
      padding: 18px 20px;
      width: 300px;
      font-family: 'Be Vietnam Pro', system-ui, sans-serif;
      display: none;
    }

    .tweaks-panel.open {
      display: block;
    }

    .tweaks-panel h4 {
      margin: 0 0 4px;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #0a0a0a;
    }

    .tweaks-panel .tweaks-sub {
      margin: 0 0 14px;
      font-size: 12px;
      color: #6b7280;
    }

    .tweaks-panel .tweaks-close {
      position: absolute;
      top: 10px;
      right: 12px;
      background: none;
      border: 0;
      cursor: pointer;
      font-size: 18px;
      color: #9ca3af;
      line-height: 1;
    }

    .tweaks-panel .tweaks-close:hover {
      color: #0a0a0a;
    }

    .tweaks-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .tweaks-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      background: #f7f7f5;
      border: 1px solid #ececea;
      border-radius: 10px;
      cursor: grab;
      user-select: none;
      transition: background 0.15s, border-color 0.15s;
    }

    .tweaks-item:hover {
      background: #f0efeb;
    }

    .tweaks-item.dragging {
      opacity: 0.4;
      cursor: grabbing;
    }

    .tweaks-item.drag-over {
      border-color: #0a0a0a;
    }

    .tweaks-handle {
      color: #9ca3af;
      font-size: 14px;
    }

    .tweaks-num {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: #0a0a0a;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 600;
    }

    .tweaks-label {
      font-size: 14px;
      font-weight: 500;
      color: #0a0a0a;
    }

    .tweaks-tag {
      margin-left: auto;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: #6b7280;
    }

    /* ===== Agents tabbed section ===== */
    .agents-section {
      padding: var(--section-gap) 0;
      background: var(--bg);
    }

    .agents-section .section-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 48px;
    }

    .agents-section .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0;
      background: none;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 20px;
      box-shadow: none;
    }

    .agents-section .section-eyebrow::before {
      content: none;
    }

    .agents-section .section-header h2 {
      text-align: center;
      max-width: none;
      font-size: clamp(36px, 4.6vw, 56px);
      line-height: 1.08;
      letter-spacing: -0.025em;
      margin-bottom: 0;
    }

    .agents-section .section-header h2 .accent {
      background: linear-gradient(135deg, var(--accent) 0%, #6fa8ff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    /* Tab bar */
    .agents-tabs {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-bottom: 40px;
      flex-wrap: wrap;
    }

    .agents-tab {
      display: inline-block;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      background: transparent;
      border: 2px solid var(--border);
      color: var(--muted);
      padding: 8px 22px;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .agents-tab[data-tab="inside"] {
      --tab-color: #1863dc;
    }

    .agents-tab[data-tab="work"] {
      --tab-color: #149a6e;
    }

    .agents-tab[data-tab="personal"] {
      --tab-color: #7e57c2;
    }

    .agents-tab:hover {
      border-color: var(--tab-color);
      color: var(--tab-color);
    }

    .agents-tab.active {
      background: transparent;
      border-color: var(--tab-color);
      color: var(--tab-color);
      box-shadow: none;
    }

    /* Panels */
    .agents-panel {
      display: none;
    }

    .agents-panel.active {
      display: block;
      animation: fade-up 0.4s ease-out both;
    }

    .agents-panel-tagline {
      text-align: center;
      font-size: 16px;
      font-weight: 600;
      font-style: italic;
      color: var(--muted);
      margin-bottom: 32px;
    }

    /* Shared grid */
    .agents-grid {
      display: grid;
      gap: 20px;
      max-width: 1100px;
      margin: 0 auto;
    }

    .agents-grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }

    @media (max-width: 900px) {
      .agents-grid-4 { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 520px) {
      .agents-grid-4 { grid-template-columns: 1fr; }
    }

    /* Per-tab card colour */
    #tab-inside  .agents-card { --card-color: #1863dc; }
    #tab-work    .agents-card { --card-color: #149a6e; }
    #tab-personal .agents-card { --card-color: #7e57c2; }
    #tab-personal .agents-personal-row { --card-color: #7e57c2; }

    .agents-card {
      background: #fff;
      border: 1.5px solid var(--border-light);
      border-radius: 18px;
      padding: 26px 22px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
      box-shadow: 0 0 0 1px color-mix(in oklab, var(--card-color, var(--accent)) 18%, transparent),
                  0 4px 16px -4px color-mix(in oklab, var(--card-color, var(--accent)) 12%, transparent);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .agents-card:hover {
      transform: translateY(-5px);
      border-color: color-mix(in oklab, var(--card-color, var(--accent)) 25%, transparent);
      box-shadow: 0 0 0 1.5px color-mix(in oklab, var(--card-color, var(--accent)) 40%, transparent),
                  0 20px 48px -16px color-mix(in oklab, var(--card-color, var(--accent)) 25%, transparent);
    }

    .agents-card-title {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .agents-title-main {
      font-size: 18px;
      font-weight: 700;
      color: var(--card-color, var(--accent));
      line-height: 1.2;
      letter-spacing: -0.02em;
      min-height: calc(1.2em * 2);
    }

    .agents-title-sub {
      display: none;
    }

    /* Layout-C horizontal rows (preserved for reference) */
    .agents-grid-4.layout-c {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .layout-c .agents-card {
      border-top: none;
      border-left: 4px solid var(--card-color, var(--accent));
      border-right: none;
      border-bottom: 1px solid var(--border-light);
      border-radius: 0;
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
      padding: 24px 0;
    }

    .layout-c .agents-card:first-child {
      border-radius: 14px 14px 0 0;
      border-top: 1.5px solid var(--border-light);
    }

    .layout-c .agents-card:last-child {
      border-radius: 0 0 14px 14px;
      border-bottom: 1.5px solid var(--border-light);
    }

    .layout-c .agents-card:hover {
      transform: none;
      background: color-mix(in oklab, var(--card-color, var(--accent)) 3%, #fff);
    }

    .layout-c .agents-card-left {
      width: 32%;
      flex-shrink: 0;
      padding: 0 28px 0 24px;
      border-right: 1px solid var(--border-light);
    }

    .layout-c .agents-card-right {
      flex: 1;
      padding: 0 28px;
    }

    .layout-c .agents-card-title {
      font-size: 15px;
      margin-bottom: 6px;
    }

    .layout-c .agents-context-badge {
      margin-bottom: 0;
    }

    .agents-context-badge {
      display: block;
      background: none;
      color: var(--muted);
      font-size: 13.5px;
      font-weight: 600;
      font-style: italic;
      padding: 0;
      border-radius: 0;
      line-height: 1.4;
      margin-bottom: 2px;
      min-height: calc(1.4em * 2);
    }

    .agents-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 9px;
      border-top: 1.5px solid var(--border-light);
      padding-top: 14px;
      margin-top: 4px;
    }

    .agents-list li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 13.5px;
      color: var(--fg-secondary);
      line-height: 1.5;
    }

    .agents-list li::before {
      content: "";
      flex-shrink: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--muted);
      margin-top: 6px;
    }

    /* Personal tab */
    .agents-personal-rows {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 860px;
      margin: 0 auto;
    }

    .agents-personal-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    @media (max-width: 900px) {
      .agents-personal-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 520px) {
      .agents-personal-grid { grid-template-columns: 1fr; }
    }

    .agents-personal-more {
      font-size: 12.5px;
      font-style: italic;
      color: var(--muted);
      margin: 0;
    }

    .agents-personal-sub {
      font-size: 13.5px;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
    }

    .agents-personal-row {
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: #fff;
      border: 1.5px solid var(--border-light);
      border-radius: 18px;
      padding: 26px 22px;
      box-shadow: 0 0 0 1px color-mix(in oklab, var(--card-color, #7e57c2) 18%, transparent),
                  0 4px 16px -4px color-mix(in oklab, var(--card-color, #7e57c2) 12%, transparent);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .agents-personal-row:hover {
      transform: translateY(-5px);
      border-color: color-mix(in oklab, var(--card-color, #7e57c2) 25%, transparent);
      box-shadow: 0 0 0 1.5px color-mix(in oklab, var(--card-color, #7e57c2) 40%, transparent),
                  0 20px 48px -16px color-mix(in oklab, var(--card-color, #7e57c2) 25%, transparent);
    }

    .agents-personal-row--muted {
      background: var(--surface, #fafafa);
      border-top-color: var(--border-light);
    }

    .agents-personal-row--muted:hover {
      transform: none;
      box-shadow: none;
      border-color: var(--border-light);
    }

    .agents-personal-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .agents-personal-tags span {
      font-size: 13px;
      font-weight: 500;
      color: var(--fg-secondary);
      background: var(--surface, #fafafa);
      border: 1px solid var(--border-light);
      border-radius: 999px;
      padding: 5px 14px;
    }

    .agents-personal-cta {
      display: block;
      text-align: right;
      margin-top: 4px;
      font-size: 13px;
      font-weight: 500;
      color: var(--card-color, #7e57c2);
      text-decoration: none;
    }

    .agents-personal-cta-arrow {
      display: inline-block;
      transition: transform 0.2s;
    }

    .agents-personal-cta:hover .agents-personal-cta-arrow {
      transform: translateX(4px);
    }

    /* Work tab — audience sections */
    .agents-work-audience {
      margin-bottom: 40px;
    }

    .agents-work-audience:last-child { margin-bottom: 0; }

    .agents-audience-label {
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      border-left: 3px solid var(--muted);
      padding-left: 10px;
      margin-bottom: 16px;
    }

    /* Wide (row) card for Sales Pipeline */
    .agents-card.agents-card-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 28px;
    }

    .agents-card-row-meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 180px;
      flex-shrink: 0;
    }

    .agents-list.agents-list-row {
      border-top: none;
      border-left: 1.5px solid var(--border-light);
      padding-top: 0;
      padding-left: 24px;
      margin: 0;
      flex: 1;
    }

    @media (max-width: 640px) {
      .agents-card.agents-card-row { flex-direction: column; }
      .agents-list.agents-list-row {
        border-left: none;
        border-top: 1.5px solid var(--border-light);
        padding-left: 0;
        padding-top: 14px;
      }
    }

/* ===== Phase: core-v2 section (mirrors home.html #core-v2) ===== */
.core-v2-section {
      padding: var(--section-gap) 0;
      padding-top: calc(var(--section-gap) + 24px);
      background: #fafafa;
    }

    /* Header — matched to "Jobs We Get Done" styling */
    .core-v2-eyebrow {
      display: inline-block;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 20px;
    }
    .core-v2-headline {
      font-family: var(--font-display);
      font-size: clamp(36px, 4.6vw, 56px);
      font-weight: 700;
      color: #001964;
      line-height: 1.08;
      letter-spacing: -0.025em;
      text-align: center;
      margin: 0 auto 56px;
      max-width: 760px;
    }
    .core-v2-headline .core-v2-accent {
      background: linear-gradient(135deg, var(--accent) 0%, #6fa8ff 50%, var(--accent) 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      animation: gradient-shift 4s ease infinite;
    }
    .core-v2-header { text-align: center; margin-bottom: 0; }

    /* Column labels */
    .core-v2-col-labels {
      display: grid;
      grid-template-columns: 1fr 160px 1fr;
      margin-bottom: 12px;
      padding: 0 24px;
    }
    .core-v2-label-blue {
      font-size: 15px;
      font-weight: 700;
      color: #1863dc;
      text-align: center;
    }
    .core-v2-label-green {
      font-size: 15px;
      font-weight: 700;
      color: #149a6e;
      text-align: center;
    }

    /* Rows wrapper — holds both brackets + rows */
    .core-v2-rows-wrap {
      position: relative;
      padding: 0 12px;
    }

    /* Left green bracket (Client Context) */
    .core-v2-rows-wrap::before {
      content: '';
      position: absolute;
      left: 0;
      top: 20px;
      bottom: 20px;
      width: 16px;
      border-top: 2px solid #149a6e;
      border-left: 2px solid #149a6e;
      border-bottom: 2px solid #149a6e;
      border-radius: 10px 0 0 10px;
      pointer-events: none;
    }

    /* Right blue bracket (Infina AI Core) */
    .core-v2-rows-wrap::after {
      content: '';
      position: absolute;
      right: 0;
      top: 20px;
      bottom: 20px;
      width: 16px;
      border-top: 2px solid #1863dc;
      border-right: 2px solid #1863dc;
      border-bottom: 2px solid #1863dc;
      border-radius: 0 10px 10px 0;
      pointer-events: none;
    }

    /* Rows */
    .core-v2-rows {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .core-v2-row {
      display: grid;
      grid-template-columns: 1fr 160px 1fr;
      align-items: center;
      gap: 0;
    }

    /* Cards */
    .core-v2-lcard,
    .core-v2-rcard {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: #f5f8ff;
      border: 1.5px solid #dae4fb;
      border-radius: 12px;
      padding: 18px;
    }
    .core-v2-lcard { background: #f6fdf9; border-color: #c8edd9; }

    .core-v2-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .core-v2-icon--blue { background: #eff4ff; }
    .core-v2-icon--blue svg { stroke: #1863dc; }
    .core-v2-icon--green { background: #edfaf4; }
    .core-v2-icon--green svg { stroke: #149a6e; }
    .core-v2-icon svg { width: 22px; height: 22px; fill: none; }

    .core-v2-card-text h3 {
      font-size: 15px;
      font-weight: 700;
      margin: 0 0 4px;
      line-height: 1.3;
    }
    .core-v2-lcard .core-v2-card-text h3 { color: #149a6e; }
    .core-v2-rcard .core-v2-card-text h3 { color: var(--fg); }
    .core-v2-card-text p {
      font-size: 13px;
      color: var(--muted);
      margin: 0;
      line-height: 1.5;
    }

    /* Connector — single arrow line with label below */
    .core-v2-conn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 0 8px;
    }
    .core-v2-conn-line {
      display: flex;
      align-items: center;
      width: 100%;
      position: relative;
    }
    .core-v2-conn-line::before {
      content: '';
      flex: 1;
      height: 1.5px;
      background: #94a3b8;
    }
    .core-v2-conn-line::after {
      content: '';
      width: 0;
      height: 0;
      border-top: 5px solid transparent;
      border-bottom: 5px solid transparent;
      border-left: 8px solid #94a3b8;
      flex-shrink: 0;
    }
    .core-v2-conn-label {
      font-size: 11.5px;
      color: var(--muted);
      text-align: center;
      line-height: 1.4;
    }

    /* Converge — simple dashed line from center down to output card */
    .core-v2-converge {
      display: flex;
      justify-content: center;
      padding: 0;
      position: relative;
      height: 40px;
    }
    .core-v2-converge::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 2px;
      height: 30px;
      border-left: 2px dashed #1863dc;
      transform: translateX(-50%);
    }
    .core-v2-converge::after {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 6px solid transparent;
      border-right: 6px solid transparent;
      border-bottom: 8px solid #1863dc;
    }
    /* New 2-color branch SVG — desktop only (hidden on mobile, dashed line stays) */
    .core-v2-converge-svg { display: none; }
    @media (min-width: 901px) {
      .core-v2-converge { height: 48px; align-items: flex-start; }
      .core-v2-converge::before,
      .core-v2-converge::after { display: none; }
      .core-v2-converge-svg { display: block; width: 100%; height: 48px; }
    }

    /* Output card */
    .core-v2-output-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 0;
    }
    .core-v2-output {
      display: flex;
      align-items: center;
      gap: 20px;
      background: #fff;
      border: 2px solid #1863dc;
      border-radius: 16px;
      padding: 22px 28px;
      max-width: 680px;
      width: 100%;
      box-shadow: 0 4px 24px -4px rgba(24, 99, 220, 0.15);
    }
    .core-v2-output-icon {
      width: 56px;
      height: 56px;
      background: #fff;
      border: 2px solid #1863dc;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .core-v2-output-icon svg { width: 32px; height: 18px; }
    .core-v2-output-text h3 {
      font-size: 22px;
      font-weight: 800;
      color: #1863dc;
      margin: 0 0 6px;
    }
    .core-v2-output-text p {
      font-size: 14px;
      color: var(--muted);
      margin: 0;
      line-height: 1.5;
    }

    /* Chips with dotted fan line */
    .core-v2-chips-section {
      position: relative;
      margin-top: 0;
      padding-top: 0;
    }

    /* SVG fan lines drawn inline */
    .core-v2-fan-svg {
      display: block;
      width: 100%;
      margin-top: -2px;
      overflow: visible;
    }

    .core-v2-chips {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      align-items: center;
      justify-items: center;
      gap: 8px;
      padding-top: 4px;
    }
    .core-v2-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #fff;
      border: 1.5px solid #e2e8f0;
      border-radius: 40px;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 600;
    }
    .core-v2-chip svg { width: 18px; height: 18px; fill: none; }
    .core-v2-chip--blue { color: #1863dc; border-color: #c7d9f8; }
    .core-v2-chip--blue svg { stroke: #1863dc; }
    .core-v2-chip--green { color: #149a6e; border-color: #b6e8d4; }
    .core-v2-chip--green svg { stroke: #149a6e; }
    .core-v2-chip--purple { color: #7e57c2; border-color: #d4c9f0; }
    .core-v2-chip--purple svg { stroke: #7e57c2; }

    /* Mobile */
    @media (max-width: 900px) {
      .core-v2-col-labels { display: none; }
      .core-v2-rows-wrap { padding: 0; }
      .core-v2-rows-wrap::before,
      .core-v2-rows-wrap::after { display: none; }
      .core-v2-rows { gap: 20px; }

      /* Each row = a card box: side-by-side pair + "=" result below */
      .core-v2-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        grid-template-areas:
          "lcard plus rcard"
          "result result result";
        align-items: stretch;
        gap: 10px;
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 16px;
        padding: 12px;
      }
      .core-v2-lcard {
        grid-area: lcard;
        flex-direction: row;
        border: 1.5px solid #c8edd9;
        background: #f6fdf9;
        border-radius: 12px;
        padding: 14px;
        gap: 12px;
      }
      .core-v2-rcard {
        grid-area: rcard;
        flex-direction: row;
        border: 1.5px solid #dae4fb;
        background: #f5f8ff;
        border-radius: 12px;
        padding: 14px;
        gap: 12px;
      }

      /* Connector becomes transparent; children re-placed into grid */
      .core-v2-conn { display: contents; }

      /* "+" symbol between the two cards */
      .core-v2-conn-line {
        grid-area: plus;
        display: flex;
        align-items: center;
        justify-content: center;
        width: auto;
      }
      .core-v2-conn-line::before {
        content: '+';
        flex: none;
        width: auto;
        height: auto;
        background: none;
        font-size: 20px;
        font-weight: 400;
        color: #94a3b8;
      }
      .core-v2-conn-line::after { display: none; }

      /* "=" result label spanning full width below the pair */
      .core-v2-conn-label {
        grid-area: result;
        font-size: 13px;
        font-weight: 600;
        color: var(--fg);
        text-align: center;
        padding-top: 2px;
      }
      .core-v2-conn-label::before { content: '= '; font-weight: 700; color: #1863dc; }

      .core-v2-fan-svg { display: none; }
      .core-v2-output-wrap { margin-top: 16px; }

      /* Chips in a 2-column grid, last one centered full-width */
      .core-v2-chips {
