  font-size: 13.5px;
  line-height: 1.6;
  color: var(--muted);
}

/* ── CTA Section ──────────────────────────────────────────────────── */
.about-page .cta {
  padding: var(--section-gap) 0;
  background: linear-gradient(135deg, #e8eaf6 0%, #f5f7ff 100%);
  text-align: center;
  position: relative;
  overflow: hidden;
}

.about-page .cta .container { position: relative; z-index: 1; }

.about-page .cta h2 {
  font-family: var(--font-display);
  font-size: clamp(32px, 4.5vw, 52px);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.15;
  color: var(--fg);
  margin-bottom: 20px;
}

.about-page .cta p {
  font-size: 17px;
  color: var(--muted);
  max-width: 560px;
  margin: 0 auto 36px;
  line-height: 1.7;
}

.about-page .cta-btns {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}

/* ── Lead form ────────────────────────────────────────────────────── */
.about-page .lead-section {
  padding: var(--section-gap) 0;
  background: linear-gradient(180deg, #f0f3f9 0%, #e8edf7 100%);
  color: var(--fg);
  position: relative;
  overflow: hidden;
}
.about-page .lead-section::before {
  content: '';
  position: absolute;
  top: -200px; right: -200px;
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(0,31,92,0.08), transparent 65%);
  filter: blur(40px);
  pointer-events: none;
}
.about-page .lead-section::after {
  content: '';
  position: absolute;
  bottom: -300px; left: -200px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(0,31,92,0.05), transparent 65%);
  filter: blur(60px);
  pointer-events: none;
}
.about-page .lead-grid {
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  gap: 80px;
  align-items: start;
  position: relative;
  z-index: 1;
}
@media (max-width: 900px) {
  .about-page .lead-grid { grid-template-columns: 1fr; gap: 48px; }
}
.about-page .lead-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 600;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: #fff;
  margin-bottom: 24px;
  padding: 6px 14px;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--accent), #2278f6);
  box-shadow: 0 6px 16px -8px rgba(24,99,220,0.55);
}
.about-page .lead-eyebrow::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(255,255,255,0.25);
  animation: about-pulse-dot 1.6s ease-in-out infinite;
}
.about-page .lead-copy h2 {
  font-family: var(--font-display);
  font-size: clamp(36px, 4.5vw, 56px);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.025em;
  margin-bottom: 20px;
  color: var(--fg);
}
.about-page .lead-copy h2 .accent {
  background: linear-gradient(135deg, var(--accent) 0%, #1863dc 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.about-page .lead-sub {
  font-size: 17px;
  color: var(--fg-secondary);
  margin-bottom: 36px;
  max-width: 460px;
  line-height: 1.55;
}
.about-page .lead-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: 40px;
  padding: 0;
}
.about-page .lead-bullets li {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  font-size: 15px;
  color: var(--fg);
  line-height: 1.5;
}
.about-page .lead-check {
  flex-shrink: 0;
  width: 24px; height: 24px;
  border-radius: 8px;
  background: var(--accent-light);
  border: 1px solid color-mix(in oklab, var(--accent) 35%, transparent);
  color: var(--accent);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  margin-top: 1px;
}
.about-page .lead-form {
  background: #fff;
  color: var(--fg);
  border-radius: 20px;
  padding: 32px;
  box-shadow: 0 30px 80px rgba(0,0,0,0.4), 0 0 0 1px rgba(255,255,255,0.05);
  display: flex;
  flex-direction: column;
  gap: 12px;
  position: relative;
}
.about-page .lead-form-header { margin-bottom: 4px; }
.about-page .lead-form-title {
  font-family: var(--font-display);
  font-size: 18px; font-weight: 700;
  letter-spacing: -0.015em;
  margin-bottom: 2px;
}
.about-page .lead-form-sub { font-size: 12px; color: var(--muted); }
@media (max-width: 600px) {
  .about-page .lead-form { padding: 24px 20px; }
}
.about-page .lead-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
@media (max-width: 480px) {
  .about-page .lead-row-2 { grid-template-columns: 1fr; }
}
.about-page .lead-field { position: relative; }
.about-page .lead-field input,
.about-page .lead-field select,
.about-page .lead-field textarea,
.about-page .lead-combo-trigger {
  width: 100%;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--fg);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 14px 6px;
  outline: none;
  transition: border-color 0.15s, box-shadow 0.15s;
  appearance: none;
  -webkit-appearance: none;
  text-align: left;
  cursor: pointer;
  min-height: 50px;
}
.about-page .lead-field input,
.about-page .lead-field textarea { cursor: text; }
.about-page .lead-field textarea {
  resize: none;
  min-height: 70px;
  line-height: 1.5;
  padding-top: 22px;
}
.about-page .lead-field input:focus,
.about-page .lead-field select:focus,
.about-page .lead-field textarea:focus,
.about-page .lead-combo.open .lead-combo-trigger {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-light);
}
.about-page .lead-field.invalid input,
.about-page .lead-field.invalid select,
.about-page .lead-field.invalid textarea,
.about-page .lead-combo.invalid .lead-combo-trigger {
  border-color: #dc2626;
}
.about-page .lead-field label {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  color: var(--muted);
  pointer-events: none;
  transition: all 0.15s ease;
  background: transparent;
}
.about-page .lead-field.lead-textarea label { top: 18px; transform: none; }
.about-page .lead-field input:focus + label,
.about-page .lead-field input:not(:placeholder-shown) + label,
.about-page .lead-field textarea:focus + label,
.about-page .lead-field textarea:not(:placeholder-shown) + label,
.about-page .lead-combo.has-value .lead-combo-trigger + label,
.about-page .lead-combo.open .lead-combo-trigger + label {
  top: 8px;
  transform: none;
  font-size: 10px;
  font-weight: 600;
  color: var(--muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.about-page .lead-caret {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--fg-secondary);
  pointer-events: none;
  font-size: 18px;
  font-weight: 700;
  line-height: 1;
  transition: transform 0.2s;
}
.about-page .lead-combo.open .lead-caret { transform: translateY(-50%) rotate(180deg); }
.about-page .lead-combo { position: relative; }
.about-page .lead-combo-trigger {
  display: flex; align-items: center; justify-content: flex-start;
  padding-right: 36px;
  color: var(--fg);
}
.about-page .lead-combo-trigger.placeholder { color: transparent; }
.about-page .lead-combo-menu {
  position: absolute;
  top: calc(100% + 6px); left: 0; right: 0;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.12);
  padding: 6px;
  max-height: 240px; overflow-y: auto;
  z-index: 20;
  display: none;
  animation: lead-combo-in 0.15s ease;
}
.about-page .lead-combo.open .lead-combo-menu { display: block; }
.about-page .lead-combo-option {
  padding: 10px 12px;
  font-size: 14px;
  color: var(--fg);
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.1s;
  display: flex; align-items: center; gap: 10px;
}
.about-page .lead-combo-option:hover,
.about-page .lead-combo-option.active { background: var(--accent-light); color: var(--accent); }
.about-page .lead-combo-option.selected::after {
  content: '✓';
  margin-left: auto;
  color: var(--accent);
  font-weight: 700;
}
.about-page .lead-consent {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  color: var(--muted);
  line-height: 1.45;
  cursor: pointer;
  margin-top: 2px;
}
.about-page .lead-consent input {
  margin-top: 2px;
  accent-color: var(--accent);
  width: 14px; height: 14px;
  flex-shrink: 0;
}
.about-page .lead-submit {
  align-self: stretch;
  justify-content: center;
  background: var(--accent);
  color: #fff;
  border: 0;
  border-radius: 12px;
  padding: 14px 28px;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: transform 0.15s, opacity 0.15s, background 0.15s, box-shadow 0.2s;
  margin-top: 4px;
  position: relative;
  overflow: hidden;
}
.about-page .lead-submit:hover {
  background: color-mix(in oklab, var(--accent) 85%, #000);
  transform: translateY(-1px);
  box-shadow: 0 12px 30px rgba(24,99,220,0.35);
}
.about-page .lead-submit::after {
  content: '→';
  font-size: 18px;
  transition: transform 0.2s;
}
.about-page .lead-submit:hover::after { transform: translateX(4px); }
.about-page .lead-submit:disabled { opacity: 0.6; cursor: not-allowed; }
.about-page .lead-submit-spinner {
  display: none;
  width: 14px; height: 14px;
  border: 2px solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: lead-spin 0.7s linear infinite;
}
.about-page .lead-submit.loading .lead-submit-spinner { display: inline-block; }
.about-page .lead-status { font-size: 14px; min-height: 20px; }
.about-page .lead-status.success { color: #059669; }
.about-page .lead-status.error { color: #dc2626; }

/* ── Footer ───────────────────────────────────────────────────────── */
.about-page footer {
  background: var(--bg);
  padding: 48px 0;
  border-top: 1px solid var(--border-light);
}

.about-page .footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
}

.about-page .footer-logo {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.03em;
  display: flex;
  align-items: center;
  gap: 10px;
}

.about-page .footer-logo .logo-img { height: 23px; width: auto; display: block; }

.about-page .footer-links { display: flex; gap: 32px; }

.about-page .footer-links a {
  font-size: 14px;
  color: var(--muted);
  transition: color 0.2s;
}

.about-page .footer-links a:hover { color: var(--accent); }

.about-page .footer-copy { font-size: 13px; color: var(--muted); }

@media (max-width: 640px) {
  .about-page .footer-inner { flex-direction: column; text-align: center; }
}

/* ── Responsive overrides ─────────────────────────────────────────── */
@media (max-width: 720px) {
  .about-page .hero h1 { font-size: clamp(34px, 9vw, 52px); }
  .about-page .hero h1 .line { display: inline; }
  .about-page .hero h1 br { display: inline; }
  .about-page .hero-sub { font-size: 17px; }
}
@media (max-width: 640px) {
  .about-page .mission blockquote { font-size: 22px; }
  .about-page .different-grid { grid-template-columns: 1fr; }
}
@media (max-width: 420px) {
  .about-page .hero h1 { font-size: clamp(30px, 8.5vw, 38px); letter-spacing: -0.03em; }
}

@media (max-width: 768px) {
  .about-page .different-grid { grid-template-columns: 1fr; }
  .about-page .timeline::before { left: 7px; }
  .about-page .timeline-item { padding-left: 36px; }
  .about-page .different::before { display: none; }
  .about-page .lead-section::before,
  .about-page .lead-section::after { display: none; }
  .about-page .different-card { padding: 20px 16px; }
  .about-page .lead-form { padding: 24px 20px; }
}

@media (max-width: 480px) {
  .about-page .container { padding: 0 16px; }
  .about-page .mission blockquote { font-size: 20px; }
  .about-page .btn-primary,
  .about-page .btn-ghost { padding: 14px 24px; font-size: 14px; }
}

/* ── Mobile nav panel ─────────────────────────────────────────────── */
.about-page .nav-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  color: var(--fg-secondary);
}
.about-page .nav-toggle svg { width: 24px; height: 24px; display: block; }
.about-page .nav-mobile-panel { display: none; }

@media (max-width: 768px) {
  .about-page .nav-toggle { display: block; }
  .about-page .nav-mobile-panel {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 8px 24px 20px;
    gap: 0;
    border-bottom: 1px solid var(--border-light);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
    z-index: 999;
  }
  .about-page .nav-mobile-panel.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }
  .about-page .nav-mobile-panel a {
    padding: 14px 6px;
    font-size: 16px;
    font-weight: 500;
    color: var(--fg-secondary);
    border-bottom: 1px solid var(--border-light);
  }
  .about-page .nav-mobile-panel a:last-child { border-bottom: none; }
  .about-page .nav-mobile-panel a.nav-mobile-cta {
    margin-top: 14px;
    text-align: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    padding: 14px 24px;
    border-radius: 9999px;
    border: none;
    font-weight: 600;
  }
}
