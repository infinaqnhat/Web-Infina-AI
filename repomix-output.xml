    /* Phone ≤600px: keep side-by-side 2-column layout, tighten for narrow viewports */
    @media (max-width: 600px) {
      .core-v2-row {
        gap: 6px;
        padding: 10px 8px;
      }
      .core-v2-lcard,
      .core-v2-rcard {
        padding: 10px 8px;
