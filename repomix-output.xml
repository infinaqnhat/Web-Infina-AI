    }
    
    /* Chat-style demos */
    .demo-chat {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .chat-msg {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .chat-msg.user {
      flex-direction: row-reverse;
      justify-content: flex-start;
    }
    .chat-msg.ai {
      flex-direction: row;
    }
    .chat-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f0f4ff, #e8f1ff);
