// ========== Slack demo: cursor + click + type + reveal messages ==========
(function(){
  const cursor = document.getElementById('smCursor');
  const ch1 = document.getElementById('smCh1');
  const input = document.getElementById('smInput');
  const typed = document.getElementById('smTyped');
  const placeholder = document.getElementById('smPlaceholder');
  const msgs = document.querySelectorAll('#smBody .sm-msg');
  const mock = document.querySelector('.slack-mock');
  
  // Check if elements exist before proceeding
  if (!cursor || !ch1 || !input || !typed || !placeholder || !mock || msgs.length === 0) {
    return; // Exit if Slack section was removed
  }

  function moveCursor(targetEl, delay){
    return new Promise(resolve => {
      setTimeout(() => {
        const mockRect = mock.getBoundingClientRect();
        const t = targetEl.getBoundingClientRect();
        const x = t.left - mockRect.left + t.width * 0.5;
        const y = t.top - mockRect.top + t.height * 0.5;
        cursor.style.left = (x - 9) + 'px';
        cursor.style.top = (y - 9) + 'px';
        cursor.classList.add('show');
        setTimeout(resolve, 950);
      }, delay);
    });
  }
  function click(){
    cursor.classList.add('click');
    setTimeout(() => cursor.classList.remove('click'), 600);
    return new Promise(r => setTimeout(r, 500));
  }
  function typeText(text, speed=55){
    typed.textContent = '';
    placeholder.style.display = 'none';
    input.classList.add('is-typing');
    return new Promise(resolve => {
      let i = 0;
      const tick = () => {
        if (i >= text.length) return resolve();
        typed.textContent = text.substring(0, ++i);
        setTimeout(tick, speed + Math.random()*30);
      };
      tick();
    });
  }
  function clearInput(){
    typed.textContent = '';
    placeholder.style.display = '';
    input.classList.remove('is-typing');
  }
  function showMsg(idx){
    if (msgs[idx]) msgs[idx].classList.add('show');
    return new Promise(r => setTimeout(r, 800));
  }
  function hideAllMsgs(){
    msgs.forEach(m => m.classList.remove('show'));
  }

  async function cycle(){
    hideAllMsgs();
    clearInput();
    cursor.classList.remove('show');
    await new Promise(r => setTimeout(r, 600));

    // Move to input, click, type message 1
    await moveCursor(input, 200);
    await click();
    await typeText('@AI summarize today\'s #project-launch thread for me');
    await new Promise(r => setTimeout(r, 400));
    clearInput();
    cursor.classList.remove('show');
    await showMsg(0);
    await showMsg(1);
    await new Promise(r => setTimeout(r, 1400));

    // Type second message
    await moveCursor(input, 200);
    await click();
    await typeText('Draft an email reminder for Hung to review');
    await new Promise(r => setTimeout(r, 400));
    clearInput();
    cursor.classList.remove('show');
    await showMsg(2);
    await showMsg(3);
    await new Promise(r => setTimeout(r, 3000));

    cycle();
  }

  // Start when visible
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { cycle(); io.disconnect(); }
    });
  }, {threshold: 0.3});
  io.observe(document.querySelector('.slack-mock'));
})();
</script>

