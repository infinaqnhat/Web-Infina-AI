  <script>
    document.querySelectorAll('.product-see-more').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        var card = trigger.closest('.product-card');
        var isActive = card.classList.contains('active');
        var product = card.getAttribute('data-product');

        document.querySelectorAll('.product-card').forEach(function(c) { c.classList.remove('active'); });
        document.querySelectorAll('.product-panel').forEach(function(p) { p.classList.remove('active'); });

        if (!isActive) {
          card.classList.add('active');
          var panel = document.getElementById('tab-' + product);
          if (panel) panel.classList.add('active');
        }
      });
    });
  </script>

