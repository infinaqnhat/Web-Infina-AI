    }

    .hv-node-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--n-color, var(--accent));
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--n-color, var(--accent)) 18%, transparent);
      animation: hv-blink 1.6s ease-in-out infinite;
