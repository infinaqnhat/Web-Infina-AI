.focus-alignment-page .hero-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(24,99,220,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(24,99,220,.06) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); z-index: 0; pointer-events: none; }
.focus-alignment-page .fa-shape { position: absolute; border-radius: 50%; z-index: 0; pointer-events: none; }
.focus-alignment-page .fa-shape-1 { width:400px;height:400px;background:linear-gradient(135deg,rgba(24,99,220,.08),transparent);top:10%;right:-10%;animation:fa-float 8s ease-in-out infinite; }
.focus-alignment-page .fa-shape-2 { width:300px;height:300px;background:linear-gradient(135deg,rgba(24,99,220,.05),transparent);bottom:20%;left:-5%;animation:fa-float-reverse 10s ease-in-out infinite; }
