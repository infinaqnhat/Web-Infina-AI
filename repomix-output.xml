<title>Infina AI Personal · AI Specialists for every decision</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fff;--surface:#fafafa;--fg:#000;--fg-secondary:#212121;
  --muted:#6b6b76;--border:#e5e7eb;--border-light:#f2f2f2;
  --accent:#001F5C;--accent-dark:#001340;
  --accent-light:rgba(0,31,92,.08);--accent-tint:rgba(0,31,92,.04);
  --font-display:'Be Vietnam Pro',-apple-system,system-ui,sans-serif;
  --font-body:'Be Vietnam Pro',-apple-system,system-ui,sans-serif;
  --section-gap:120px;--radius:22px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:var(--font-body);background:var(--bg);color:var(--fg);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.container{max-width:1200px;margin:0 auto;padding:0 32px}

@keyframes fade-up{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.8;transform:scale(1.05)}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes shine{0%{left:-100%}100%{left:100%}}
@keyframes progress{0%{width:0%}50%{width:60%}100%{width:0%}}
    @keyframes fadeInUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
    @keyframes stock-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
    @keyframes stock-glow{0%,100%{box-shadow:0 0 0 rgba(16,185,129,0)}50%{box-shadow:0 0 12px rgba(16,185,129,0.3)}}
    
    .insurance-logo {
      animation: stock-float 2s ease-in-out infinite;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .insurance-logo:hover {
      transform: translateY(-6px) scale(1.05);
    }
    .insurance-logo:hover > div {
      box-shadow: 0 8px 20px rgba(59,130,246,0.2);
      border-color: #3b82f6;
    }

/* Nav */
nav{position:fixed;top:0;left:0;right:0;background:rgba(255,255,255,.85);backdrop-filter:blur(20px);border-bottom:1px solid var(--border-light);z-index:1000}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:72px;max-width:1200px;margin:0 auto;padding:0 32px}
.logo{font-family:var(--font-display);font-size:22px;font-weight:600;letter-spacing:-.03em;display:flex;align-items:center;gap:10px}
.logo-img{height:23px;width:auto;display:block}
.nav-center{display:flex;align-items:center;gap:40px}
.nav-center a{font-size:15px;font-weight:500;color:var(--fg-secondary);transition:color .2s;position:relative}
.nav-center a.active{color:var(--fg)}
.nav-center a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:2px;background:var(--accent);transition:width .3s}
.nav-center a.active::after,.nav-center a:hover::after{width:100%}
.nav-cta{background:var(--accent);color:#fff;padding:11px 22px;border-radius:9999px;font-size:14px;font-weight:500;transition:all .3s}
.nav-cta:hover{background:var(--accent-dark);transform:translateY(-2px);box-shadow:0 8px 20px rgba(24,99,220,.25)}
@media(max-width:768px){.nav-center,.nav-cta{display:none}}

/* Hero */
.hero{position:relative;padding:clamp(140px,18vw,180px) 0 clamp(40px,5vw,60px);text-align:center;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 50% at 70% 30%,rgba(24,99,220,.14),transparent 60%),radial-gradient(ellipse 60% 50% at 20% 80%,rgba(126,87,194,.08),transparent 60%);z-index:-2}
.hero-grid-bg{position:absolute;inset:0;background-image:linear-gradient(to right,rgba(24,99,220,.06) 1px,transparent 1px),linear-gradient(to bottom,rgba(24,99,220,.06) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(ellipse 70% 60% at 50% 40%,#000 20%,transparent 75%);-webkit-mask-image:radial-gradient(ellipse 70% 60% at 50% 40%,#000 20%,transparent 75%);z-index:-2;pointer-events:none}
@keyframes float{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-20px) rotate(3deg)}}
@keyframes float-reverse{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(20px) rotate(-3deg)}}
.shape{position:absolute;border-radius:50%;z-index:-1;pointer-events:none}
.shape-1{width:400px;height:400px;background:linear-gradient(135deg,rgba(24,99,220,.08),transparent);top:10%;right:-10%;animation:float 8s ease-in-out infinite}
.shape-2{width:300px;height:300px;background:linear-gradient(135deg,rgba(24,99,220,.05),transparent);bottom:20%;left:-5%;animation:float-reverse 10s ease-in-out infinite}
.shape-3{width:200px;height:200px;border:1px solid var(--border-light);top:30%;left:10%;animation:pulse 6s ease-in-out infinite}
.shape-4{width:150px;height:150px;border:1px solid var(--border-light);bottom:30%;right:15%;animation:pulse 8s ease-in-out infinite;animation-delay:2s}
@media(max-width:768px){.shape-1,.shape-2,.shape-3,.shape-4{display:none}}
.hero-inner{position:relative;z-index:1;max-width:900px;margin:0 auto}
.hero-badge{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:600;color:var(--accent);text-transform:uppercase;letter-spacing:.14em;margin-bottom:22px;opacity:0;animation:fade-up .6s ease-out .1s forwards}
.hero-badge::before{content:'';width:6px;height:6px;background:var(--accent);border-radius:50%;box-shadow:0 0 10px var(--accent);animation:pulse-dot 2s ease-in-out infinite}
.hero h1{font-family:var(--font-display);font-size:clamp(40px,5.5vw,72px);font-weight:700;letter-spacing:-.03em;line-height:1.08;margin-bottom:18px;opacity:0;animation:fade-up .7s ease-out .2s forwards;color:#001964}
.hero h1 .accent{background:linear-gradient(135deg,var(--accent) 0%,#4c6ee6 50%,var(--accent) 100%);background-size:200% 200%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:gradient-shift 4s ease infinite}
@keyframes gradient-shift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.hero-sub{font-size:16px;color:var(--muted);max-width:540px;margin:0 auto 32px;line-height:1.65;opacity:0;animation:fade-up .7s ease-out .3s forwards}

/* Chat bar — AI website style */
.cbar-wrap{max-width:680px;margin:0 auto;opacity:0;animation:fade-up .7s ease-out .4s forwards}
.cbar{background:#fff;border:1.5px solid rgba(24,99,220,0.2);border-radius:28px;box-shadow:0 8px 32px rgba(24,99,220,0.12),0 20px 50px -16px rgba(15,23,42,.18),0 4px 12px rgba(15,23,42,.06);transition:border-color .25s,box-shadow .25s;display:flex;flex-direction:column;position:relative;overflow:hidden}
.cbar-row{display:flex;align-items:flex-end;gap:10px;padding:14px 14px 14px 22px}
.cbar:focus-within{border-color:var(--accent);box-shadow:0 20px 50px -8px rgba(24,99,220,.22),0 0 0 4px rgba(24,99,220,.1)}
.cbar-input-wrap{flex:1;position:relative;min-height:32px;display:flex;align-items:center;padding:8px 0}
.cbar-input{width:100%;border:none;outline:none;font-family:var(--font-body);font-size:16px;color:var(--fg);background:transparent;resize:none;line-height:1.5;min-height:24px;max-height:120px;position:relative;z-index:2;padding:0}
.cbar-ghost{position:absolute;top:50%;transform:translateY(-50%);left:0;right:0;font-family:var(--font-body);font-size:16px;color:#9ca3af;line-height:1.5;pointer-events:none;white-space:nowrap;overflow:hidden;z-index:1}
.cbar-ghost::after{content:'';display:inline-block;width:2px;height:1em;background:var(--accent);margin-left:2px;vertical-align:-2px;animation:blink 1s step-end infinite}
.cbar-ghost.hidden{display:none}
.cbar-icons{display:flex;align-items:center;gap:6px;flex-shrink:0}
.cbar-icon-btn{all:unset;cursor:pointer;width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--muted);transition:all .15s}
.cbar-icon-btn:hover{background:var(--surface);color:var(--fg)}
.cbar-icon-btn svg{width:18px;height:18px}
.cbar-send{background:var(--accent);color:#fff;border:none;cursor:pointer;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .15s;flex-shrink:0}
.cbar-send:hover{background:var(--accent-dark);transform:scale(1.05)}
.cbar-send svg{width:18px;height:18px}
.cbar-hint{font-size:11.5px;color:var(--muted);margin-top:14px;text-align:center;opacity:0;animation:fade-up .7s ease-out .5s forwards}
.cbar-hint kbd{background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:2px 6px;font-family:inherit;font-size:10.5px;color:var(--fg-secondary)}

/* Job Picker */
.job-picker{max-width:760px;margin:28px auto 0;opacity:0;animation:fade-up .7s ease-out .5s forwards;text-align:center}
.jp-tabs{display:inline-flex;align-items:center;gap:6px;background:var(--surface);border:1px solid var(--border);border-radius:9999px;padding:5px;margin-bottom:18px}
.jp-tab{all:unset;cursor:pointer;padding:8px 24px;border-radius:9999px;font-size:14px;font-weight:500;color:var(--muted);transition:all .2s}
.jp-tab.active{background:var(--accent);color:#fff;box-shadow:0 2px 8px rgba(0,31,92,.25)}
.jp-tab:not(.active):hover{color:var(--fg);background:rgba(0,0,0,.05)}
.jp-tab-soon{color:var(--muted)!important;cursor:default!important;font-style:italic;opacity:.7}
.jp-tab-soon:hover{background:transparent!important;color:var(--muted)!important}
.jp-chips-outer{position:relative;padding-top:20px}
.jp-chips{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;transition:opacity .15s}
.jp-card{position:relative;background:#fff;border:1.5px solid var(--border);border-radius:16px;padding:20px;cursor:pointer;transition:all .2s;display:flex;flex-direction:column;justify-content:space-between;gap:12px;text-align:left}
.jp-card:hover{border-color:var(--accent);box-shadow:0 4px 16px rgba(0,31,92,.1);transform:translateY(-2px)}
.jp-card-title{font-size:15px;font-weight:600;color:var(--fg);line-height:1.4}
.jp-card-count{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted)}
.jp-card-count svg{flex-shrink:0;opacity:.6}
.jp-card-count strong{color:var(--fg-secondary);font-weight:600}
.jp-card-badge{position:absolute;top:-10px;right:12px;background:var(--accent);color:#fff;font-size:9px;font-weight:700;letter-spacing:.06em;padding:3px 9px;border-radius:9999px;white-space:nowrap;text-transform:uppercase}
.jp-card-cta{background:transparent;border:1.5px dashed var(--border);cursor:pointer;display:flex;align-items:center;justify-content:center;text-align:center;min-height:90px}
.jp-card-cta:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:none}
.jp-card-cta-text{font-size:15px;font-weight:600;color:var(--accent);line-height:1.45}
@media(max-width:640px){.jp-chips{grid-template-columns:1fr}.jp-tab{padding:7px 18px;font-size:13px}}

/* Chat expansion — messages panel inside cbar */
.cbar-messages{max-height:0;overflow:hidden;transition:max-height .38s cubic-bezier(0.4,0,0.2,1)}
.cbar.expanded .cbar-messages{max-height:460px}
.cbar-messages-inner{padding:16px 22px 14px;border-bottom:1px solid var(--border-light);overflow-y:auto;max-height:460px}
.mc-close-row{display:flex;justify-content:flex-end;margin-bottom:10px}
.mc-close{all:unset;cursor:pointer;width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:18px;line-height:1;transition:all .15s}
.mc-close:hover{background:var(--surface);color:var(--fg)}
.mc-user{display:flex;justify-content:flex-end;margin-bottom:16px}
.mc-user-bubble{background:var(--accent);color:#fff;padding:10px 16px;border-radius:18px 18px 4px 18px;font-size:14px;font-weight:500;max-width:85%;line-height:1.45}
.mc-agent{display:flex;gap:12px;align-items:flex-start}
.mc-avatar{width:34px;height:34px;border-radius:50%;background:var(--accent-light);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:15px}
.mc-body{flex:1;min-width:0}
.mc-name{font-size:11px;font-weight:600;color:var(--muted);margin-bottom:6px;letter-spacing:.06em;text-transform:uppercase}
.mc-bubble{background:var(--surface);border:1px solid var(--border);border-radius:4px 16px 16px 16px;padding:12px 16px;font-size:14px;color:var(--fg-secondary);line-height:1.65;text-align:left;white-space:pre-line}
.mc-thinking{display:flex;gap:5px;align-items:center;padding:4px 0}
.mc-dot{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:mc-bounce .9s ease-in-out infinite}
.mc-dot:nth-child(2){animation-delay:.15s}
.mc-dot:nth-child(3){animation-delay:.3s}
@keyframes mc-bounce{0%,80%,100%{transform:translateY(0);opacity:.4}40%{transform:translateY(-5px);opacity:1}}
.mc-followups{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}
.mc-followup{all:unset;cursor:pointer;padding:7px 14px;border-radius:9999px;font-size:13px;font-weight:500;border:1.5px solid var(--border);color:var(--fg-secondary);background:#fff;transition:all .2s;white-space:nowrap}
.mc-followup:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-tint)}
.mc-cta{margin-top:16px;padding-top:14px;border-top:1px solid var(--border-light);text-align:center}
.mc-cta-btn{display:inline-flex;align-items:center;gap:7px;background:var(--accent);color:#fff;padding:9px 20px;border-radius:9999px;font-size:13px;font-weight:500;cursor:pointer;border:none;transition:all .2s}
.mc-cta-btn:hover{background:var(--accent-dark);transform:translateY(-1px)}

/* ===== Jobs Section (Job-to-be-done) ===== */
.jobs{padding:80px 0 var(--section-gap);background:#fff}
.jobs-head{text-align:center;max-width:720px;margin:0 auto 56px}
.jobs-head h2{font-family:var(--font-display);font-size:18px;font-weight:600;letter-spacing:-.01em;line-height:1.3;margin-bottom:14px;color:var(--fg-secondary)}
.jobs-head p{font-size:16px;color:var(--muted);line-height:1.65}

.jobs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:20px;max-width:1200px;margin:0 auto}
@media(max-width:768px){.jobs-grid{grid-template-columns:1fr;gap:18px}}

.job-card{background:#fff;border:1px solid var(--border);border-radius:20px;padding:0;transition:all .3s ease;position:relative;overflow:hidden;display:flex;flex-direction:column;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.04)}
.job-card:hover{border-color:#3b82f6;box-shadow:0 8px 24px rgba(59,130,246,0.15);transform:translateY(-4px)}

.job-visual{padding:16px 18px;height:240px;display:flex;align-items:center;justify-content:center;position:relative;transition:all .3s ease}
.job-card:hover .job-visual{transform:scale(1.02)}
.job-card:nth-child(1) .job-visual{background:linear-gradient(135deg,#e0f2fe 0%,#f0f9ff 100%)}
.job-card:nth-child(2) .job-visual{background:linear-gradient(135deg,#dbeafe 0%,#eff6ff 100%)}
.job-card:nth-child(3) .job-visual{background:linear-gradient(135deg,#e0f2fe 0%,#f0f9ff 100%)}
.job-card:nth-child(4) .job-visual{background:linear-gradient(135deg,#dbeafe 0%,#eff6ff 100%)}
.job-card:nth-child(5) .job-visual{background:linear-gradient(135deg,#e0f2fe 0%,#f0f9ff 100%)}
.job-card:nth-child(6) .job-visual{background:linear-gradient(135deg,#dbeafe 0%,#eff6ff 100%)}

.job-tag{position:absolute;top:16px;right:16px;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);padding:6px 11px;border-radius:99px;transition:all .25s;box-shadow:0 4px 12px rgba(59,130,246,0.4);border:2px solid rgba(255,255,255,0.3)}
.job-card:hover .job-tag{transform:translateY(-3px) scale(1.05);box-shadow:0 6px 20px rgba(59,130,246,0.5)}

.job-body{padding:16px 20px 8px;flex:1;display:flex;flex-direction:column}
.job-title{font-family:var(--font-display);font-size:16px;font-weight:700;line-height:1.3;color:var(--fg);margin-bottom:8px}
.job-desc{font-size:13px;line-height:1.5;color:var(--muted);margin-bottom:auto}

.job-footer{display:flex;align-items:center;justify-content:space-between;padding:12px 20px 16px;border-top:none}
.job-stats{font-size:14px;color:var(--fg-secondary);display:flex;align-items:center;gap:8px;font-weight:600}
.job-stats svg{width:18px;height:18px;opacity:.6}
.job-chat-btn{background:linear-gradient(135deg,var(--accent) 0%,#4c6ee6 100%);color:#fff;border:none;border-radius:20px;padding:10px 24px;font-size:14px;font-weight:600;cursor:pointer;transition:all 0.3s ease;box-shadow:0 2px 12px rgba(0,31,92,0.2)}
.job-chat-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,31,92,0.3);background:linear-gradient(135deg,#0029a3 0%,#3b5ed9 100%)}

/* ===== Slack section ===== */
.slack{padding:var(--section-gap) 0;background:var(--surface)}
.slack-head{text-align:center;max-width:640px;margin:0 auto 56px}
.slack-eyebrow{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);background:rgba(24,99,220,.1);padding:5px 14px;border-radius:99px;margin-bottom:18px}
.slack-head h2{font-family:var(--font-display);font-size:clamp(28px,3.6vw,40px);font-weight:700;letter-spacing:-.025em;line-height:1.15;margin-bottom:14px}
.slack-head p{font-size:15px;color:var(--muted);line-height:1.6}

/* Slack mockup with animated cursor + typing */
.slack-mock-wrap{max-width:920px;margin:0 auto;position:relative}
.slack-mock{background:#19171D;border-radius:18px;overflow:hidden;box-shadow:0 32px 80px -24px rgba(15,23,42,.45),0 8px 24px -12px rgba(15,23,42,.2);display:grid;grid-template-columns:220px 1fr;min-height:480px;position:relative}
@media(max-width:600px){.slack-mock{grid-template-columns:52px 1fr;min-height:520px}}

.sm-side{background:#3F0E40;padding:14px 12px;color:#fff;border-right:1px solid rgba(255,255,255,.06)}
.sm-ws{display:flex;align-items:center;gap:8px;padding-bottom:12px;margin-bottom:12px;border-bottom:1px solid rgba(255,255,255,.1)}
.sm-ws-mark{width:24px;height:24px;border-radius:5px;background:#fff;color:#3F0E40;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:11px;flex-shrink:0}
.sm-ws-name{font-size:13px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
@media(max-width:600px){.sm-ws-name,.sm-side-section,.sm-ch-name{display:none}}
.sm-side-section{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.5);font-weight:700;padding:8px 6px 4px}
.sm-ch{display:flex;align-items:center;gap:6px;padding:5px 6px;border-radius:4px;color:rgba(255,255,255,.65);font-size:13px;cursor:pointer;transition:all .15s}
.sm-ch:hover{background:rgba(255,255,255,.06);color:#fff}
.sm-ch.active{background:rgba(24,99,220,.9);color:#fff}
.sm-ch-prefix{flex-shrink:0;font-weight:400}
.sm-ch-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sm-ch-dot{margin-left:auto;width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0}

.sm-main{display:flex;flex-direction:column;background:#fff}
.sm-main-hd{padding:14px 18px;border-bottom:1px solid #e9e9e9;display:flex;justify-content:space-between;align-items:center}
.sm-main-hd b{font-size:14px;font-weight:700}
.sm-main-hd small{font-size:11px;color:#616061}
.sm-body{flex:1;padding:14px 18px;display:flex;flex-direction:column;gap:14px;overflow:hidden;position:relative;min-height:280px}
.sm-msg{display:flex;gap:10px;align-items:flex-start;opacity:0;transform:translateY(6px);transition:all .4s cubic-bezier(.16,1,.3,1)}
.sm-msg.show{opacity:1;transform:translateY(0)}
.sm-av{width:32px;height:32px;border-radius:6px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff}
.sm-av.u1{background:#36C5F0}
.sm-av.ai{background:linear-gradient(135deg,var(--accent),#4c6ee6)}
.sm-msg-content{flex:1;min-width:0}
.sm-msg-meta{display:flex;align-items:baseline;gap:8px;margin-bottom:3px}
.sm-msg-meta b{font-size:13px;font-weight:700;color:#1d1c1d}
.sm-msg-meta small{font-size:11px;color:#616061}
.sm-ai-badge{display:inline-block;background:var(--accent-light);color:var(--accent);padding:1px 6px;border-radius:3px;font-size:9.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;margin-left:4px}
.sm-msg-text{font-size:13.5px;color:#1d1c1d;line-height:1.55}
.sm-msg-text b{color:var(--accent)}
.sm-list{padding-left:18px;margin-top:6px;display:flex;flex-direction:column;gap:3px}
.sm-list li{list-style:disc;font-size:13px}
.sm-typing{display:inline-flex;gap:3px;align-items:center;padding:6px 0}
.sm-typing span{width:5px;height:5px;border-radius:50%;background:var(--accent);animation:type-dot 1.4s ease-in-out infinite}
.sm-typing span:nth-child(2){animation-delay:.15s}
.sm-typing span:nth-child(3){animation-delay:.3s}
@keyframes type-dot{0%,80%,100%{opacity:.3;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}

.sm-input{padding:10px 16px 14px;border-top:1px solid #e9e9e9;background:#fff;position:relative}
.sm-input-box{border:1.5px solid #bbb;border-radius:8px;padding:9px 12px;font-size:12.5px;color:#1d1c1d;background:#fff;min-height:38px;position:relative;display:flex;align-items:center}
.sm-input-box.is-typing{border-color:var(--accent);box-shadow:0 0 0 3px rgba(24,99,220,.08)}
.sm-input-typed{position:relative;color:#1d1c1d}
.sm-input-typed::after{content:'';display:inline-block;width:2px;height:1em;background:var(--accent);margin-left:1px;vertical-align:-2px;animation:blink 1s step-end infinite}
.sm-input-placeholder{color:#9c9c9c}

/* Animated cursor */
.sm-cursor{position:absolute;width:18px;height:18px;pointer-events:none;z-index:50;transition:all .9s cubic-bezier(.34,1.1,.64,1);opacity:0;filter:drop-shadow(0 2px 6px rgba(15,23,42,.3))}
.sm-cursor.show{opacity:1}
.sm-cursor svg{width:100%;height:100%;display:block;color:#1863dc}
.sm-cursor.click::after{content:'';position:absolute;left:9px;top:9px;width:0;height:0;border-radius:50%;background:rgba(24,99,220,.4);animation:cursor-ripple .55s ease-out forwards}
@keyframes cursor-ripple{from{width:0;height:0;margin-left:0;margin-top:0;opacity:.6}to{width:40px;height:40px;margin-left:-20px;margin-top:-20px;opacity:0}}

/* ===== Waitlist modal ===== */
.modal-bg{position:fixed;inset:0;background:rgba(15,23,42,.55);backdrop-filter:blur(8px);z-index:2000;display:none;align-items:center;justify-content:center;padding:20px;opacity:0;transition:opacity .25s}
.modal-bg.open{display:flex;opacity:1}
.modal{background:#fff;border-radius:24px;max-width:440px;width:100%;padding:36px 32px 32px;position:relative;box-shadow:0 40px 100px rgba(15,23,42,.3);transform:scale(.9);transition:transform .3s cubic-bezier(.34,1.4,.64,1)}
.modal-bg.open .modal{transform:scale(1)}
.modal-close{position:absolute;top:14px;right:14px;all:unset;cursor:pointer;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--muted);transition:all .15s}
.modal-close:hover{background:var(--surface);color:var(--fg)}
.modal-close svg{width:16px;height:16px}
.modal-emoji{font-size:48px;margin-bottom:14px;animation:wiggle 1.6s ease-in-out infinite}
@keyframes wiggle{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(8deg)}}
.modal h3{font-family:var(--font-display);font-size:22px;font-weight:700;letter-spacing:-.02em;line-height:1.2;margin-bottom:8px}
.modal p{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:22px}
.modal-form{display:flex;gap:8px}
.modal-form input{flex:1;padding:12px 16px;font-family:var(--font-body);font-size:14px;border:1.5px solid var(--border);border-radius:99px;outline:none;background:#fff;transition:all .2s}
.modal-form input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-light)}
.modal-form button{background:var(--accent);color:#fff;border:none;cursor:pointer;padding:0 22px;border-radius:99px;font-family:inherit;font-size:13.5px;font-weight:600;transition:all .2s;white-space:nowrap}
.modal-form button:hover{background:var(--accent-dark);transform:translateY(-1px)}
.modal-success{display:none;text-align:center;padding:20px 0}
.modal-success-icon{width:56px;height:56px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:24px}
.modal-success b{font-family:var(--font-display);font-size:18px;font-weight:700;display:block;margin-bottom:6px}
.modal-success span{font-size:13.5px;color:var(--muted);line-height:1.55}
.modal.done .modal-form-wrap{display:none}
.modal.done .modal-success{display:block}

/* CTA */
.cta{padding:var(--section-gap) 0;background:linear-gradient(135deg, #e8eaf6 0%, #f5f7ff 100%);text-align:center;position:relative;overflow:hidden}
.cta .container{position:relative;z-index:1}
.cta h2{font-family:var(--font-display);font-size:clamp(28px,4vw,46px);font-weight:700;letter-spacing:-.035em;line-height:1.12;color:#1a1a1a;margin-bottom:18px}
.cta p{font-size:16px;color:rgba(255,255,255,.55);max-width:460px;margin:0 auto 32px;line-height:1.7}
.cta-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.btn-w{background:var(--accent);color:#fff;padding:14px 28px;border-radius:9999px;font-size:14px;font-weight:600;transition:all .2s;display:inline-flex;align-items:center;gap:8px}
.btn-w:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(24,99,220,.3)}
.btn-ow{background:transparent;color:#fff;padding:13px 28px;border-radius:9999px;font-size:14px;font-weight:600;border:1.5px solid rgba(255,255,255,.2);transition:all .2s;display:inline-flex;align-items:center;gap:8px}
.btn-ow:hover{border-color:rgba(255,255,255,.45);background:rgba(255,255,255,.06)}

/* Footer */
footer{background:#fff;padding:48px 0;border-top:1px solid var(--border-light)}
.footer-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:24px}
.footer-logo{font-family:var(--font-display);font-size:22px;font-weight:600;letter-spacing:-.03em;display:flex;align-items:center;gap:10px}
.footer-logo img{height:64px;width:auto;display:block}
.footer-links{display:flex;gap:32px}
.footer-links a{font-size:14px;color:var(--muted);transition:color .2s}
.footer-links a:hover{color:var(--accent)}
.footer-copy{font-size:13px;color:var(--muted)}
@media(max-width:640px){.footer-inner{flex-direction:column;text-align:center}}

    /* ============================================================
       === Modern Use Cases Section                            ===
       ============================================================ */
    .usecases-modern {
      padding: 100px 0;
      background: linear-gradient(180deg, #ffffff 0%, #f8f9fb 100%);
      position: relative;
      overflow: hidden;
    }
    .usecases-modern::before {
      content: '';
      position: absolute;
      top: -200px;
      right: -200px;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(24,99,220,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .usecases-headline {
      font-family: var(--font-display);
      font-size: 42px;
      font-weight: 800;
      text-align: center;
      margin-bottom: 60px;
      color: #0a0f1e;
      letter-spacing: -0.02em;
    }
    .usecases-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 28px;
      max-width: 1240px;
      margin: 0 auto;
    }
    .usecase-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      padding: 32px 24px;
      position: relative;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 0;
      transform: translateY(30px);
      animation: usecase-fade-in 0.6s ease forwards;
    }
    .usecase-card[data-index="0"] { animation-delay: 0.1s; }
    .usecase-card[data-index="1"] { animation-delay: 0.2s; }
    .usecase-card[data-index="2"] { animation-delay: 0.3s; }
    .usecase-card[data-index="3"] { animation-delay: 0.4s; }
    
    @keyframes usecase-fade-in {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .usecase-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 16px;
      background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 100%);
      opacity: 0;
      transition: opacity 0.4s ease;
      z-index: 0;
    }
    .usecase-card:hover::before {
      opacity: 0.06;
    }
    .usecase-card:hover {
      transform: translateY(-8px);
      border-color: var(--accent);
      box-shadow: 0 16px 40px rgba(0,31,92,0.15);
    }
    
    .usecase-icon-wrapper {
      position: relative;
      z-index: 1;
      margin-bottom: 24px;
    }
    .usecase-icon {
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(24,99,220,0.25);
      transition: all 0.4s ease;
    }
    .usecase-card:hover .usecase-icon {
      transform: scale(1.1) rotate(5deg);
      box-shadow: 0 12px 32px rgba(24,99,220,0.35);
    }
    .usecase-icon svg {
      color: #ffffff;
    }
    
    .usecase-title {
      position: relative;
      z-index: 1;
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 700;
      color: #0a0f1e;
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }
    .usecase-subtitle {
      position: relative;
      z-index: 1;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 20px;
      font-weight: 500;
    }
    .usecase-list {
      position: relative;
      z-index: 1;
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .usecase-list li {
      font-size: 14px;
      color: #4b5563;
      padding-left: 24px;
      position: relative;
      line-height: 1.6;
      transition: all 0.3s ease;
    }
    .usecase-list li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      transition: all 0.3s ease;
    }
    .usecase-card:hover .usecase-list li::before {
      transform: scale(1.5);
      box-shadow: 0 0 8px rgba(24,99,220,0.4);
    }
    .usecase-card:hover .usecase-list li {
      padding-left: 28px;
      color: #1f2937;
    }
    
    @media (max-width: 1024px) {
      .usecases-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .usecases-grid {
        grid-template-columns: 1fr;
      }
      .usecases-headline {
        font-size: 32px;
        margin-bottom: 40px;
      }
      .usecases-modern {
        padding: 60px 0;
      }
    }

    /* ============================================================
       === Deployments Section (Tab-based with Demos)            ===
       ============================================================ */
    .deployments {
      padding: 120px 0;
      background: #fafbfc;
      position: relative;
    }
    .deployments .container { 
      position: relative; 
      z-index: 2; 
      max-width: 1200px;
    }
    .deploy-headline {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 700;
      text-align: center;
      margin-bottom: 48px;
      line-height: 1.15;
      color: var(--accent);
    }
    .deploy-tabs {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-bottom: 48px;
      flex-wrap: wrap;
    }
    .deploy-tab {
      background: #ffffff;
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 14px 24px;
      font-family: var(--font-display);
      font-size: 15px;
      font-weight: 600;
      color: #64748b;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      outline: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .deploy-tab-icon {
      font-size: 20px;
    }
    .deploy-tab:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(24,99,220,0.1);
    }
    .deploy-tab.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #ffffff;
      box-shadow: 0 8px 20px rgba(24,99,220,0.25);
    }
    .deploy-content {
      display: none;
    }
    .deploy-specialist-card {
      background: linear-gradient(135deg, #ffffff 0%, #fafbfc 100%);
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      padding: 32px 28px;
      box-shadow: 0 2px 8px rgba(0,31,92,0.04);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .deploy-specialist-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent) 0%, #4c6ee6 100%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .deploy-specialist-card:hover::before {
      opacity: 1;
    }
    .deploy-specialist-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 32px rgba(0,31,92,0.12);
      border-color: rgba(0,31,92,0.2);
    }
    @media (max-width: 1024px) {
      .deploy-specialist-card {
        grid-column: span 2;
      }
    }
    @media (max-width: 640px) {
      .deploy-specialist-card {
        grid-column: span 1;
      }
    }
    @media (max-width: 968px) {
      .deploy-content.active {
        padding: 32px 24px;
      }
      .deployments { padding: 80px 0; }
      .deploy-headline { font-size: 38px; margin-bottom: 48px; }
    }
    
    /* Left: Use cases list */
    .deploy-usecases-header {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding-bottom: 24px;
      margin-bottom: 20px;
      border-bottom: 1px solid #e5e7eb;
    }
    .deploy-usecases-header h3 {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      color: var(--fg);
      margin: 0 0 5px 0;
      letter-spacing: -0.01em;
    }
    .deploy-usecases-header p {
      font-size: 13px;
      color: var(--muted);
      margin: 0;
      line-height: 1.4;
    }
    .deploy-specialist-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(0,31,92,0.2);
    }
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, #f0f4ff, #e8f1ff);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
