/* === MOBILE RESPONSIVE OVERRIDES === */

/* 1. Slack mockup — compact sidebar in the 601-768px gap (existing 600px rule handles narrower) */
@media (min-width: 601px) and (max-width: 768px) {
  .slack-mock { grid-template-columns: 52px 1fr; min-height: 420px; }
  .sm-ws-name, .sm-side-section, .sm-ch-name { display: none; }
}

/* 2. Deployments headline + section padding */
@media (max-width: 768px) {
  .deploy-headline { font-size: 32px; margin-bottom: 40px; }
  .deployments { padding: 80px 0; }
}

/* 3. Hero padding */
@media (max-width: 768px) {
  .hero { padding: 80px 0 20px; }
}

/* 4. CTA section padding */
@media (max-width: 768px) {
  .cta { padding: 60px 0; }
}

/* 5. Modal — full-width on small screens */
@media (max-width: 640px) {
  .modal { padding: 28px 24px 24px; max-width: 100%; }
  .modal-form { flex-direction: column; }
  .modal-form button { width: 100%; }
}

/* 6. Container + nav padding */
@media (max-width: 480px) {
  .container, .nav-inner { padding: 0 16px; }
}

/* 7. Hero compact — keep padding-top above fixed nav (72px) */
@media (max-width: 480px) {
  .hero { padding: 88px 0 16px; }
}

/* 8. Hero subtitle */
@media (max-width: 480px) {
  .hero-sub { font-size: 14px; max-width: 100%; }
}

/* 9. Use cases decorative blob — hide on very small screens to prevent overflow */
@media (max-width: 480px) {
  .usecases-modern::before { display: none; }
}

/* 10. CTA buttons */
@media (max-width: 480px) {
  .btn-w, .btn-ow { padding: 12px 20px; font-size: 13px; }
}

/* 11. Chat input — hide attach + voice icons so placeholder is readable (M3) */
@media (max-width: 480px) {
  .cbar-icons { display: none; }
}

/* ===== Mobile nav panel ===== */
.nav-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  color: var(--fg-secondary);
}
.nav-toggle svg { width: 24px; height: 24px; display: block; }
.nav-mobile-panel { display: none; }
@media (max-width: 768px) {
