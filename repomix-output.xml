  <script>
    (function() {
      var tabs = document.querySelectorAll('.feature-item[data-tab]');
      var panels = document.querySelectorAll('.cw-panel[data-panel]');
      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var id = this.getAttribute('data-tab');
          tabs.forEach(function(t) { t.classList.remove('feature-active'); });
          panels.forEach(function(p) { p.classList.remove('active'); });
          this.classList.add('feature-active');
          var panel = document.querySelector('.cw-panel[data-panel="' + id + '"]');
          if (panel) panel.classList.add('active');
        }.bind(tab));
      });
    })();
