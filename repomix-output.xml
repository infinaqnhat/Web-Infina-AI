    .rk-cubie>i.f4 {
      background: linear-gradient(135deg, rgba(50, 100, 210, 0.65), rgba(12, 40, 110, 0.7));
      transform: rotateY(-90deg) translateZ(calc(var(--u) * 0.5));
    }

    .rk-cubie>i.f5 {
      background: linear-gradient(135deg, rgba(140, 190, 255, 0.85), rgba(76, 143, 255, 0.7));
      transform: rotateX(90deg) translateZ(calc(var(--u) * 0.5));
    }

    .rk-cubie>i.f6 {
      background: linear-gradient(135deg, rgba(20, 50, 120, 0.7), rgba(8, 25, 80, 0.75));
      transform: rotateX(-90deg) translateZ(calc(var(--u) * 0.5));
