/* Mobile: de-sticky specialists left */
@media (max-width: 768px) {
  .work-page .specialists-grid { grid-template-columns: 1fr; gap: 32px; }
  .work-page .specialists-left { position: static; }
}

/* ── Hero mobile responsiveness ─────────────────────────────────── */
@media (max-width: 720px) {
  .work-page .hero h1 { font-size: clamp(28px, 7vw, 40px); overflow-wrap: anywhere; }
  .work-page .hero h1 .line { white-space: normal; display: inline; }
  .work-page .hero h1 br { display: inline; }
  .work-page .hero-sub { font-size: 17px; }
}

/* ── Hero value list: stack into a column on phones (matches work.html) ── */
@media (max-width: 640px) {
  .work-page .hero-value-list { flex-direction: column; }
  .work-page .hero-value-list li { border-left: none; border-top: 1.5px solid var(--border-light); padding: 12px 0; white-space: normal; }
  .work-page .hero-value-list li:first-child { border-top: none; }
}

/* ── Mobile overrides (≤480px) ──────────────────────────────────── */
@media (max-width: 480px) {
  .work-page .container { padding: 0 16px; }
  .work-page .footer-inner { padding: 0 16px; }
  .work-page .hero { padding: 140px 0 48px; }
  .work-page .section { padding: 48px 0; }
  .work-page .agents-section { padding: 48px 0; }
  .work-page .slack-messages { min-height: 280px; }
  .work-page .slack-card-actions { flex-wrap: wrap; }
  .work-page .lead-grid { gap: 32px; }
  .work-page .coworkers-ctas { flex-direction: column; align-items: stretch; }
  .work-page .btn-slack, .work-page .btn-whatsapp { justify-content: center; }
}
