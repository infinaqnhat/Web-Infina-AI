  <script>
    /* ===== Build 3x3x3 Rubik cube ===== */
    (function () {
      const cube = document.getElementById('hv-cube');
      if (!cube) return;
      const FACES = ['<i class="f1"></i><i class="f2"></i><i class="f3"></i><i class="f4"></i><i class="f5"></i><i class="f6"></i>'];
      let html = '';
      let i = 0;
      for (let x = -1; x <= 1; x++) {
        for (let y = -1; y <= 1; y++) {
          for (let z = -1; z <= 1; z++) {
            // Random scramble offset and rotation per cubie
            const sx = (1.6 + Math.random() * 1.4).toFixed(2);
            const sy = (1.6 + Math.random() * 1.4).toFixed(2);
            const sz = (1.6 + Math.random() * 1.4).toFixed(2);
            const rx = Math.round((Math.random() - 0.5) * 90);
            const ry = Math.round((Math.random() - 0.5) * 90);
            const rz = Math.round((Math.random() - 0.5) * 90);
            const delay = (-(i * 0.08)).toFixed(2);
            html += `<div class="rk-cubie" style="--x:${x};--y:${y};--z:${z};--sx:${sx};--sy:${sy};--sz:${sz};--rx:${rx}deg;--ry:${ry}deg;--rz:${rz}deg;animation-delay:${delay}s">${FACES[0]}</div>`;
            i++;
          }
        }
      }
      cube.innerHTML = html;
    })();
  </script>
  <script>
    (function () {
      const PRODUCT_META = {
        inside: { label: 'Infina AI Inside', tag: 'B2B2C' },
        work: { label: 'Infina AI Work', tag: 'B2B' },
        personal: { label: 'Infina AI Personal', tag: 'B2C' },
      };

      const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
        "productOrder": ["inside", "work", "personal"]
      }/*EDITMODE-END*/;

      let state = JSON.parse(JSON.stringify(TWEAK_DEFAULTS));

      const grid = document.getElementById('products-grid');
      const panel = document.getElementById('tweaks-panel');
      const list = document.getElementById('tweaks-list');
      const closeBtn = document.getElementById('tweaks-close');

      function applyOrder() {
        const groups = {};
        grid.querySelectorAll('.product-group').forEach(g => {
          groups[g.dataset.product] = g;
        });
        state.productOrder.forEach(key => {
          if (groups[key]) grid.appendChild(groups[key]);
        });
      }

      function renderList() {
        list.innerHTML = '';
        state.productOrder.forEach((key, i) => {
          const meta = PRODUCT_META[key];
          const li = document.createElement('li');
          li.className = 'tweaks-item';
          li.draggable = true;
          li.dataset.key = key;
          li.innerHTML = `
            <span class="tweaks-handle">☰</span>
            <span class="tweaks-num">${i + 1}</span>
            <span class="tweaks-label">${meta.label}</span>
            <span class="tweaks-tag">${meta.tag}</span>
          `;
          list.appendChild(li);
        });
        wireDrag();
      }

      let dragKey = null;
      function wireDrag() {
        list.querySelectorAll('.tweaks-item').forEach(item => {
          item.addEventListener('dragstart', e => {
            dragKey = item.dataset.key;
            item.classList.add('dragging');
            e.dataTransfer.effectAllowed = 'move';
          });
          item.addEventListener('dragend', () => {
            item.classList.remove('dragging');
            list.querySelectorAll('.tweaks-item').forEach(i => i.classList.remove('drag-over'));
          });
          item.addEventListener('dragover', e => {
            e.preventDefault();
            if (item.dataset.key !== dragKey) item.classList.add('drag-over');
          });
          item.addEventListener('dragleave', () => {
            item.classList.remove('drag-over');
          });
          item.addEventListener('drop', e => {
            e.preventDefault();
            const targetKey = item.dataset.key;
            if (!dragKey || dragKey === targetKey) return;
            const next = state.productOrder.filter(k => k !== dragKey);
            const idx = next.indexOf(targetKey);
            next.splice(idx, 0, dragKey);
            state.productOrder = next;
            applyOrder();
            renderList();
            persist();
          });
        });
      }

      function persist() {
        try {
          window.parent.postMessage({
            type: '__edit_mode_set_keys',
            edits: { productOrder: state.productOrder }
          }, '*');
        } catch (e) { }
      }

      // Tweaks protocol
      window.addEventListener('message', e => {
        const d = e.data || {};
        if (d.type === '__activate_edit_mode') {
          panel.classList.add('open');
          renderList();
        } else if (d.type === '__deactivate_edit_mode') {
          panel.classList.remove('open');
        }
      });
      closeBtn.addEventListener('click', () => {
        panel.classList.remove('open');
        try { window.parent.postMessage({ type: '__edit_mode_dismissed' }, '*'); } catch (e) { }
      });

      // Initial render with default order
      applyOrder();

      // Announce availability AFTER listener is registered
      try { window.parent.postMessage({ type: '__edit_mode_available' }, '*'); } catch (e) { }
    })();
  </script>

  <script>
    /* ===== Speed banner — timeline fill animation ===== */
    (function () {
      const section = document.querySelector('.speed-banner');
      if (!section) return;
      const fill = section.querySelector('.speed-tl-fill');
      if (!fill) return;
      let activated = false;
      const activate = () => {
        if (activated) return;
        activated = true;
        // Animate via incremental width updates (more reliable than CSS transitions in some iframe contexts)
        const start = performance.now();
        const dur = 1600;
        const tick = (now) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          fill.style.width = (eased * 100) + '%';
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const check = () => {
        const r = section.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        if (r.top < vh * 0.85 && r.bottom > 0) activate();
      };
      window.addEventListener('scroll', check, { passive: true });
      window.addEventListener('resize', check, { passive: true });
      check();
      requestAnimationFrame(() => requestAnimationFrame(check));
    })();
  </script>

  <script src="nav.js"></script>
  <script src="footer.js"></script>

</body>

