    .deploy-info-cta:hover {
      background: #1554c0;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(24,99,220,0.3);
    }
    
    /* Right demo area */
    .deploy-demo-area {
      background: linear-gradient(135deg, #f8fafe 0%, #ffffff 100%);
      border: 2px solid #e5e7eb;
      border-radius: 20px;
      padding: 32px;
      min-height: 480px;
      position: relative;
      overflow: hidden;
    }
    .deploy-demo-area::before {
      content: "";
      position: absolute;
      top: -100px;
      right: -100px;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(24,99,220,0.08), transparent 60%);
      pointer-events: none;
    }
    .deploy-demo-content {
      position: relative;
      z-index: 2;
      width: 100%;
