    }
    .deploy-use-case {
      display: none;
      animation: deploy-uc-in 0.4s ease;
    }
    .deploy-use-case.is-active {
      display: block;
    }
    @keyframes deploy-uc-in {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    /* Demo mockup styles */
    .demo-phone {
      width: 320px;
      height: 420px;
      margin: 0 auto;
      background: #1a1d2e;
      border-radius: 32px;
      padding: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.25);
      position: relative;
    }
    .demo-phone-screen {
      background: #ffffff;
      border-radius: 24px;
      height: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .demo-phone-status {
      padding: 12px 16px 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: #64748b;
      border-bottom: 1px solid #e5e7eb;
    }
    .demo-content-area {
      flex: 1;
      padding: 20px;
      overflow-y: auto;
    }
    .demo-chart {
      width: 100%;
