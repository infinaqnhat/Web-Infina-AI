    /* ════════════ Verticals — Specialist accordion + interactive demos ════════════ */
    .verticals { padding: var(--section-gap) 0; }
    .verticals-header { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; margin-bottom: 48px; flex-wrap: wrap; }
    .verticals-header h2 { font-family: var(--font-display); font-size: clamp(32px, 4.2vw, 46px); font-weight: 700; letter-spacing: -.03em; line-height: 1.12; margin-bottom: 0; }
    .verticals-header .section-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .15em; color: var(--accent); margin-bottom: 12px; }
    .verticals-sub { font-size: 15px; color: var(--muted); line-height: 1.6; max-width: 320px; text-align: right; }
    @media (max-width: 760px) { .verticals-sub { text-align: left; } }

    /* Card track + nav arrows */
    .vspec-nav { display: flex; gap: 10px; }
    .vspec-nav-btn { all: unset; cursor: pointer; width: 44px; height: 44px; border-radius: 50%; background: #fff; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--fg-secondary); transition: all .25s cubic-bezier(.16,1,.3,1); }
    .vspec-nav-btn:hover { border-color: var(--fg); background: var(--fg); color: #fff; transform: translateY(-2px); }
    .vspec-nav-btn svg { width: 16px; height: 16px; }
    .vspec-nav-btn:disabled { opacity: .35; cursor: not-allowed; transform: none; }
    .vspec-nav-btn:disabled:hover { border-color: var(--border); background: #fff; color: var(--fg-secondary); }

    .vspec-track { position: relative; margin-bottom: 40px; margin-left: -8px; margin-right: -8px; padding: 0 8px; }
    .vspec-grid {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      padding: 12px 0 16px;
      scrollbar-width: none;
    }
    .vspec-grid::-webkit-scrollbar { display: none; }

    .vspec-card {
      all: unset;
      position: relative;
      flex: 0 0 260px;
      aspect-ratio: 4 / 5;
      border-radius: 14px;
      cursor: pointer;
      overflow: hidden;
      scroll-snap-align: start;
      box-shadow: 0 8px 24px -16px rgba(15,23,42,.25);
      transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s;
      background: #0f172a;
      display: block;
      isolation: isolate;
    }
    @media (max-width: 720px) { .vspec-card { flex-basis: 220px; } }
    .vspec-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .6s cubic-bezier(.16,1,.3,1), filter .35s;
      filter: saturate(.7) brightness(.92);
    }
    .vspec-card:hover { transform: translateY(-6px) scale(1.03); box-shadow: 0 24px 48px -20px rgba(15,23,42,.35); z-index: 2; }
    .vspec-card:hover img { transform: scale(1.08); filter: saturate(1) brightness(1); }
    .vspec-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(15,23,42,0) 35%, rgba(15,23,42,.55) 70%, rgba(15,23,42,.92) 100%);
      pointer-events: none;
      transition: opacity .3s;
    }
    .vspec-card h3 {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 20px;
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -.015em;
      line-height: 1.25;
      color: #fff;
      margin: 0;
      z-index: 2;
      text-shadow: 0 2px 12px rgba(0,0,0,.5);
    }
    /* Active state: bottom accent bar + subtle lift, NO garish blue overlay */
    .vspec-card.active { box-shadow: 0 24px 48px -16px rgba(15,23,42,.35); transform: translateY(-4px); }
    .vspec-card.active::after {
      content: '';
      position: absolute;
      left: 20px; right: 20px; bottom: 12px;
      height: 3px;
      background: var(--accent);
      border-radius: 99px;
      z-index: 3;
      box-shadow: 0 0 16px rgba(24,99,220,.6);
    }
    .vspec-card.active img { filter: saturate(1) brightness(1); }

    /* Panels (accordion) */
    .vspec-panels { position: relative; }
    .vspec-panel { display: none; opacity: 0; animation: vspec-fade .4s cubic-bezier(.16,1,.3,1) forwards; }
    .vspec-panel.active { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: stretch; padding: 36px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
    @media (max-width: 960px) { .vspec-panel.active { grid-template-columns: 1fr; gap: 28px; padding: 24px; } }
    @keyframes vspec-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    .vspec-demo { display: flex; align-items: center; justify-content: center; min-height: 360px; }
    .vspec-body { display: flex; flex-direction: column; justify-content: center; }
    .vspec-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
    .vspec-body h3 { font-family: var(--font-display); font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; letter-spacing: -.02em; line-height: 1.2; margin-bottom: 14px; }
    .vspec-body > p { font-size: 15.5px; color: var(--muted); line-height: 1.65; margin-bottom: 22px; }
    .vspec-feat { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0; }
    .vspec-feat li { font-size: 14px; color: var(--fg-secondary); padding: 11px 0; border-top: 1px solid var(--border-light); display: flex; gap: 12px; align-items: flex-start; line-height: 1.55; }
    .vspec-feat li:first-child { border-top: none; padding-top: 4px; }
    .vspec-feat li::before { content: ''; flex-shrink: 0; width: 3px; height: 16px; background: var(--accent); border-radius: 2px; margin-top: 2px; }

    /* ───── Demo card primitives (shared across panels) ───── */
    .vsd-card { width: 100%; max-width: 440px; background: #fff; border: 1px solid var(--border-light); border-radius: 16px; padding: 18px 18px 20px; box-shadow: 0 24px 48px -20px rgba(15,23,42,.14); }
    .vsd-hd { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--border-light); }
    .vsd-hd b { font-family: var(--font-display); font-size: 14px; font-weight: 700; color: var(--fg); }
    .vsd-hd small { font-size: 11px; color: var(--muted); }
    .vsd-hd small.vsd-live { display: inline-flex; align-items: center; gap: 5px; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: 10px; }
    .vsd-hd small.vsd-live::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse 1.5s ease-in-out infinite; }

    .vsd-insight { margin-top: 14px; padding: 12px 14px; background: var(--accent-light); border-left: 3px solid var(--accent); border-radius: 8px; font-size: 12px; color: var(--fg-secondary); line-height: 1.55; display: flex; gap: 10px; align-items: flex-start; }
    .vsd-insight b { color: var(--accent); font-weight: 700; }
    .vsd-insight-tag { display: inline-block; background: var(--accent); color: #fff; padding: 2px 8px; border-radius: 99px; font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; flex-shrink: 0; }
    .vsd-insight-tag.warn { background: #d97706; }
    .vsd-insight-warn { background: rgba(217,119,6,.08); border-left-color: #d97706; }
    .vsd-insight-warn b { color: #d97706; }

    /* Budget demo */
    .vsd-budget-row { display: grid; grid-template-columns: 70px 1fr 60px; gap: 8px; align-items: center; font-size: 11.5px; padding: 6px 0; }
    .vsd-budget-row span:first-child { color: var(--fg-secondary); }
    .vsd-budget-row span:last-child { color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
    .vsd-budget-row span.over { color: #d97706; font-weight: 600; }
    .vsd-bar { height: 4px; background: #eef2f7; border-radius: 99px; overflow: hidden; }
    .vsd-bar i { display: block; height: 100%; background: var(--accent); border-radius: 99px; animation: vsd-bar-grow 1.5s cubic-bezier(.16,1,.3,1); }
    .vsd-bar i.over { background: #d97706; }
    @keyframes vsd-bar-grow { from { width: 0; } }

    /* Insurance compare */
    .vsd-ins-row { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; padding: 10px 12px; margin: 4px -4px; border-radius: 8px; font-size: 11.5px; position: relative; }
    .vsd-ins-row.best { background: var(--accent-light); }
    .vsd-tag { display: inline-block; position: absolute; top: -8px; left: 8px; background: var(--accent); color: #fff; font-size: 9px; font-weight: 700; padding: 3px 8px; border-radius: 99px; letter-spacing: .04em; text-transform: uppercase; }
    .vsd-ins-info b { display: block; font-size: 12px; font-weight: 700; color: var(--fg); margin-bottom: 2px; }
    .vsd-ins-info small { font-size: 10.5px; color: var(--muted); }
    .vsd-ins-row.best .vsd-ins-info b { color: var(--accent); }
    .vsd-ins-rating { color: var(--accent); font-size: 10px; letter-spacing: -1px; white-space: nowrap; }

    /* Payment transactions */
    .vsd-tx-row { display: grid; grid-template-columns: 28px 1fr auto; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border-light); font-size: 11.5px; }
    .vsd-tx-row:last-child { border-bottom: none; }
    .vsd-tx-row.alert { background: rgba(217,119,6,.06); margin: 0 -8px; padding: 8px; border-radius: 6px; border-bottom: none; }
    .vsd-tx-ic { width: 22px; height: 22px; border-radius: 50%; background: var(--accent-light); position: relative; flex-shrink: 0; }
    .vsd-tx-ic::after { content: ''; position: absolute; inset: 6px; border-radius: 50%; background: var(--accent); }
    .vsd-tx-ic[data-status="warn"] { background: rgba(217,119,6,.15); }
    .vsd-tx-ic[data-status="warn"]::after { background: #d97706; animation: pulse 1.4s ease-in-out infinite; }
    .vsd-tx-ic[data-status="in"] { background: rgba(14,124,62,.12); }
    .vsd-tx-ic[data-status="in"]::after { background: #0e7c3e; }
    .vsd-tx-info b { display: block; font-size: 12px; font-weight: 600; color: var(--fg); }
    .vsd-tx-info small { font-size: 10px; color: var(--muted); }
    .vsd-tx-amt { font-size: 12px; font-weight: 600; color: var(--fg); font-variant-numeric: tabular-nums; }
    .vsd-tx-amt.warn { color: #d97706; }
    .vsd-tx-amt.in { color: #0e7c3e; }

    /* Wallet */
    .vsd-wallet-balance { background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 100%); border-radius: 12px; padding: 16px 18px; color: #fff; margin-bottom: 14px; }
    .vsd-wallet-balance small { font-size: 10px; opacity: .8; text-transform: uppercase; letter-spacing: .08em; }
    .vsd-wallet-balance b { display: block; font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: -.02em; margin: 4px 0; }
    .vsd-wallet-trend { font-size: 11px; opacity: .85; }
    .vsd-wallet-actions { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 14px; }
    .vsd-wallet-action { background: var(--surface); border: 1px solid var(--border-light); padding: 10px 6px; border-radius: 10px; text-align: center; font-size: 10.5px; color: var(--fg-secondary); font-weight: 500; }
    .vsd-wallet-action span { display: block; width: 18px; height: 18px; background: var(--accent-light); border: 1.5px solid var(--accent); border-radius: 50%; margin: 0 auto 4px; }
    .vsd-wallet-hd { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 6px; }

    /* Portfolio */
    .vsd-port-hd { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--border-light); }
    .vsd-port-hd small { display: block; font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 4px; }
    .vsd-port-hd b { font-family: var(--font-display); font-size: 16px; font-weight: 700; letter-spacing: -.02em; }
    .vsd-port-chg { font-size: 11px; color: var(--accent); font-weight: 700; }
    .vsd-port-row { display: grid; grid-template-columns: 36px 1fr 36px 60px 40px; gap: 8px; align-items: center; padding: 6px 0; font-size: 10.5px; }
    .vsd-tk { font-family: ui-monospace, monospace; font-weight: 700; color: var(--fg); font-size: 10.5px; }
    .vsd-port-track { height: 3px; background: rgba(24,99,220,.1); border-radius: 99px; overflow: hidden; }
    .vsd-port-track i { display: block; height: 100%; background: var(--accent); animation: vsd-bar-grow 1.5s cubic-bezier(.16,1,.3,1); }
    .vsd-port-wt { font-size: 9.5px; color: var(--muted); text-align: right; }
    .vsd-port-price { font-size: 10px; color: var(--fg-secondary); text-align: right; font-variant-numeric: tabular-nums; }
    .vsd-port-chg-s { font-size: 10px; color: var(--accent); font-weight: 700; text-align: right; }
    .vsd-port-chg-s.neg { color: #94a3b8; }

    /* Fund */
    .vsd-fund-hd { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 8px; margin-bottom: 8px; border-bottom: 1px solid var(--border-light); }
    .vsd-fund-hd small { display: block; font-size: 9px; color: var(--muted); margin-bottom: 2px; }
    .vsd-fund-hd b { font-family: var(--font-display); font-size: 16px; font-weight: 700; }
    .vsd-fund-val { font-size: 14px; font-weight: 700; color: var(--accent); }
    .vsd-fund-chart { height: 60px; margin-bottom: 10px; }
    .vsd-fund-chart svg { width: 100%; height: 100%; }
    .vsd-fund-chart .line { stroke-dasharray: 300; animation: vsd-line-draw 1.8s cubic-bezier(.16,1,.3,1) forwards; }
    @keyframes vsd-line-draw { from { stroke-dashoffset: 300; } to { stroke-dashoffset: 0; } }
    .vsd-fund-list { display: flex; flex-direction: column; gap: 6px; }
