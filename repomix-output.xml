  overflow-x: hidden;
}

.focus-alignment-page * { margin: 0; padding: 0; box-sizing: border-box; }
.focus-alignment-page a { color: inherit; text-decoration: none; }
.focus-alignment-page .container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
@media (max-width: 480px) { .focus-alignment-page .container { padding: 0 16px; } }

