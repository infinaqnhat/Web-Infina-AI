<file path="src/styles/landing-work.css">
/*
 * landing-work.css
 * Page-specific styles for /work (port of public/landing-html/work.html).
 * Class names are preserved verbatim so HTML selectors continue to match.
 * :root CSS custom-properties are shared via landing.css — only page-specific
 * rules are added here.
 */

/* ── Animations ───────────────────────────────────────────────── */
@keyframes float { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(-20px) rotate(3deg)} }
@keyframes float-reverse { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(20px) rotate(-3deg)} }
@keyframes pulse { 0%,100%{opacity:.4;transform:scale(1)} 50%{opacity:.8;transform:scale(1.05)} }
@keyframes gradient-shift { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }
@keyframes fade-up { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
@keyframes pulse-ring { 0%{transform:scale(0.8);opacity:1} 100%{transform:scale(2);opacity:0} }
@keyframes spin-slow { to{transform:rotate(360deg)} }
@keyframes icon-pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.05)} }
@keyframes shimmer { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }
@keyframes lead-combo-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
@keyframes lead-spin { to { transform: rotate(360deg); } }

/* ── CSS variables (mirrored from work.html :root for self-containment) ── */
.work-page {
  --bg: #ffffff;
  --surface: #fafafa;
  --fg: #1a1f2e;
  --fg-secondary: #334155;
  --muted: #64748b;
  --border: #e5e7eb;
  --border-light: #f2f2f2;
  --accent: #001F5C;
  --accent-dark: #001340;
  --accent-light: rgba(0, 31, 92, 0.08);
  --font-display: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  --font-body: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  --section-gap: 120px;
  --radius: 20px;
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--fg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

.work-page * { margin: 0; padding: 0; box-sizing: border-box; }
.work-page a { color: inherit; text-decoration: none; }
.work-page .container { max-width: 1200px; margin: 0 auto; padding: 0 32px; }

/* ── Nav ────────────────────────────────────────────────────────── */
.work-page nav { position: fixed; top:0; left:0; right:0; background: rgba(255,255,255,.9); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-light); z-index: 1000; }
/* .nav-inner layout owned by .landing-root nav .nav-inner in landing.css */
.work-page .logo { font-family: var(--font-display); font-size: 22px; font-weight: 600; letter-spacing: -.03em; display: flex; align-items: center; gap: 10px; }
.work-page .logo-img { height: 23px; width: auto; display: block; }
.work-page .nav-center { display: flex; align-items: center; gap: 40px; }
.work-page .nav-center a { font-size: 15px; font-weight: 500; color: var(--fg-secondary); transition: color .2s; position: relative; }
.work-page .nav-center a.active { color: var(--fg); }
.work-page .nav-center a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: var(--accent); transition: width .3s; }
.work-page .nav-center a.active::after, .work-page .nav-center a:hover::after { width: 100%; }
.work-page .nav-cta { background: var(--accent); color: #fff; padding: 11px 22px; border-radius: 9999px; font-size: 14px; font-weight: 500; transition: all .3s; }
.work-page .nav-cta:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(24,99,220,.25); }
@media (max-width: 768px) { .work-page .nav-center { display: none; } }

/* ── Mobile nav toggle ──────────────────────────────────────────── */
.work-page .nav-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  color: var(--fg-secondary);
}
.work-page .nav-toggle svg { width: 24px; height: 24px; display: block; }
.work-page .nav-mobile-panel { display: none; }
@media (max-width: 768px) {
  .work-page .nav-toggle { display: block; }
  .work-page .nav-mobile-panel {
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 8px 24px 20px;
    gap: 0;
    border-bottom: 1px solid var(--border-light);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
    z-index: 999;
  }
  .work-page .nav-mobile-panel.open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }
  .work-page .nav-mobile-panel a {
    padding: 14px 6px;
    font-size: 16px;
    font-weight: 500;
    color: var(--fg-secondary);
    border-bottom: 1px solid var(--border-light);
  }
  .work-page .nav-mobile-panel a:last-child { border-bottom: none; }
  .work-page .nav-mobile-panel a.nav-mobile-cta {
    margin-top: 14px;
    text-align: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    padding: 14px 24px;
    border-radius: 9999px;
    border: none;
    font-weight: 600;
  }
}

/* ── Hero ────────────────────────────────────────────────────────── */
.work-page .hero { position: relative; padding: clamp(140px, 18vw, 180px) 0 clamp(48px, 6vw, 72px); overflow: hidden; background: linear-gradient(180deg, #fafafa 0%, #ffffff 100%); }
.work-page .hero-bg { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 50% at 70% 30%, rgba(24,99,220,.14), transparent 60%), radial-gradient(ellipse 60% 50% at 20% 80%, rgba(126,87,194,.08), transparent 60%); z-index: 0; pointer-events: none; }
.work-page .hero-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(to right, rgba(24,99,220,.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(24,99,220,.06) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%); z-index: 0; pointer-events: none; }
.work-page .shape { position: absolute; border-radius: 50%; z-index: 0; pointer-events: none; }
.work-page .shape-1 { width: 400px; height: 400px; background: linear-gradient(135deg, rgba(24,99,220,.08), transparent); top: 10%; right: -10%; animation: float 8s ease-in-out infinite; }
.work-page .shape-2 { width: 300px; height: 300px; background: linear-gradient(135deg, rgba(24,99,220,.05), transparent); bottom: 20%; left: -5%; animation: float-reverse 10s ease-in-out infinite; }
.work-page .shape-3 { width: 200px; height: 200px; border: 1px solid var(--border-light); top: 30%; left: 10%; animation: pulse 6s ease-in-out infinite; }
.work-page .shape-4 { width: 150px; height: 150px; border: 1px solid var(--border-light); bottom: 30%; right: 15%; animation: pulse 8s ease-in-out infinite; animation-delay: 2s; }
.work-page .hero .container { position: relative; z-index: 1; text-align: center; }
.work-page .hero-grid { display: block; text-align: center; }
.work-page .hero-grid .hero-text { max-width: 900px; margin: 0 auto; }
.work-page .hero-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: .12em; padding: 8px 16px; border: 1px solid rgba(24,99,220,.2); border-radius: 999px; background: var(--accent-light); margin-bottom: 28px; opacity: 0; animation: fade-up .6s ease-out .2s forwards; }
.work-page .hero h1 { font-family: var(--font-display); font-size: clamp(40px, 5.5vw, 72px); font-weight: 700; letter-spacing: -.04em; line-height: 1.05; margin-bottom: 28px; opacity: 0; animation: fade-up .8s ease-out .3s forwards; color: #001964; }
.work-page .hero h1 .line { white-space: normal; display: inline-block; padding: .12em 0 .05em; line-height: 1.15; max-width: 100%; }
.work-page .hero h1 .line-accent { background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 50%, var(--accent) 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradient-shift 4s ease infinite; }
.work-page .hero-sub { font-size: 20px; color: #64748b; line-height: 1.65; margin: 0 auto 44px; opacity: 0; animation: fade-up .8s ease-out .4s forwards; max-width: 580px; font-weight: 400; }
.work-page .hero-ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; opacity: 0; animation: fade-up .8s ease-out .5s forwards; }
.work-page .btn-primary { background: var(--accent); color: #fff; padding: 16px 32px; border-radius: 999px; font-size: 15px; font-weight: 600; transition: all .25s; display: inline-flex; align-items: center; gap: 10px; border: 0; cursor: pointer; }
.work-page .btn-primary:hover { background: var(--accent-dark); transform: translateY(-2px); box-shadow: 0 16px 32px rgba(24,99,220,.3); }
.work-page .btn-ghost { background: transparent; color: var(--fg); padding: 15px 32px; border-radius: 999px; font-size: 15px; font-weight: 600; transition: all .25s; border: 1.5px solid var(--border); }
.work-page .btn-ghost:hover { border-color: var(--fg); background: var(--surface); }

/* ── Section header ─────────────────────────────────────────────── */
.work-page .section { padding: var(--section-gap) 0; }
.work-page .section-header { margin-bottom: 64px; text-align: center; }
.work-page .section-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--accent); margin-bottom: 16px; }
.work-page .section-header h2 { font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 700; letter-spacing: -.03em; line-height: 1.2; margin-bottom: 20px; color: var(--fg); }
.work-page .section-header p { font-size: 17px; color: #64748b; max-width: 660px; line-height: 1.7; margin: 0 auto; font-weight: 400; }

/* ── Agents Grid ────────────────────────────────────────────────── */
.work-page .agents-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 80px; }
@media (max-width: 1100px) { .work-page .agents-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .work-page .agents-grid { grid-template-columns: 1fr; } }
.work-page .agent-card { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 0; overflow: hidden; transition: all .4s cubic-bezier(.16,1,.3,1); position: relative; }
.work-page .agent-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.16,1,.3,1); }
.work-page .agent-card:hover { transform: translateY(-6px); box-shadow: 0 24px 48px -16px rgba(24,99,220,.18); border-color: rgba(24,99,220,.3); }
.work-page .agent-card:hover::before { transform: scaleX(1); }
.work-page .agent-icon-wrap { padding: 36px 28px 24px; background: linear-gradient(160deg, var(--accent-light) 0%, transparent 80%); border-bottom: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; min-height: 140px; position: relative; overflow: hidden; }
.work-page .agent-icon-wrap::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, var(--accent-light), transparent 70%); opacity: 0; transition: opacity .5s; }
.work-page .agent-card:hover .agent-icon-wrap::before { opacity: 1; }
.work-page .agent-icon { width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, var(--accent) 0%, #0e4eb8 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 16px rgba(24,99,220,.2); position: relative; transition: all .4s cubic-bezier(.16,1,.3,1); overflow: hidden; }
.work-page .agent-icon::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.2), transparent); transform: translateX(-100%); }
.work-page .agent-card:hover .agent-icon::after { animation: shimmer 1.5s ease-in-out; }
.work-page .agent-card:hover .agent-icon { transform: translateY(-4px) scale(1.05); box-shadow: 0 12px 32px rgba(24,99,220,.35); animation: icon-pulse 2s ease-in-out infinite; }
.work-page .agent-icon svg { width: 24px; height: 24px; stroke-width: 2.5; transition: transform .4s cubic-bezier(.16,1,.3,1); }
.work-page .agent-card:hover .agent-icon svg { transform: scale(1.1); }
.work-page .agent-icon::before { content: ''; position: absolute; inset: -2px; border-radius: 16px; background: linear-gradient(135deg, rgba(255,255,255,.3), transparent); opacity: 0; transition: opacity .4s; }
.work-page .agent-card:hover .agent-icon::before { opacity: 1; }
.work-page .agent-body { padding: 28px; }
.work-page .agent-num { display: none; }
.work-page .agent-card h3 { font-family: var(--font-display); font-size: 19px; font-weight: 700; letter-spacing: -.015em; margin-bottom: 12px; line-height: 1.35; color: var(--fg); }
.work-page .agent-card p { font-size: 15px; color: #64748b; line-height: 1.7; font-weight: 400; }

/* ── Sales Section ──────────────────────────────────────────────── */
.work-page .sales-section { background: var(--surface); }
.work-page .sales-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
@media (max-width: 1100px) { .work-page .sales-features-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .work-page .sales-features-grid { grid-template-columns: 1fr; } }
.work-page .sales-feature-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 32px 24px; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); display: flex; flex-direction: column; align-items: center; text-align: center; }
.work-page .sales-feature-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,31,92,0.12); border-color: rgba(0,31,92,0.2); }
.work-page .sales-card-icon { width: 56px; height: 56px; border-radius: 14px; background: var(--accent); display: flex; align-items: center; justify-content: center; color: #fff; margin-bottom: 20px; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
.work-page .sales-feature-card:hover .sales-card-icon { transform: scale(1.05); box-shadow: 0 8px 24px rgba(0,31,92,0.3); }
.work-page .sales-card-icon svg { width: 24px; height: 24px; stroke-width: 2.5; }
.work-page .sales-feature-card h3 { font-family: var(--font-display); font-size: 18px; font-weight: 700; letter-spacing: -0.015em; line-height: 1.3; margin-bottom: 12px; color: var(--fg); }
.work-page .sales-feature-card p { font-size: 14px; color: #64748b; line-height: 1.6; }

/* ── Context-Aware AI Section ───────────────────────────────────── */
.work-page .context-ai-section { padding: var(--section-gap) 0; background: #fff; }
.work-page .context-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
@media (max-width: 1000px) { .work-page .context-grid { grid-template-columns: 1fr; gap: 60px; } .work-page .context-visual { order: -1; } }
.work-page .context-visual { position: relative; }
.work-page .context-chat-window { background: #f8f9fa; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.12); }
.work-page .context-chat-header { background: #fff; padding: 12px 16px; border-bottom: 1px solid #e5e7eb; }
.work-page .context-dots { display: flex; gap: 6px; }
.work-page .context-dots span { width: 12px; height: 12px; border-radius: 50%; }
.work-page .context-chat-body { padding: 24px; display: flex; flex-direction: column; gap: 20px; min-height: 320px; }
.work-page .context-msg { display: flex; gap: 12px; align-items: flex-start; }
.work-page .context-msg-user { flex-direction: row-reverse; }
.work-page .context-avatar { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.work-page .context-avatar-user { background: #64748b; }
.work-page .context-avatar-ai { background: var(--accent); }
.work-page .context-bubble { padding: 14px 18px; border-radius: 16px; font-size: 14px; line-height: 1.5; max-width: 420px; }
.work-page .context-bubble-user { background: #3b82f6; color: #fff; }
.work-page .context-bubble-ai { background: #fff; color: var(--fg); border: 1px solid #e5e7eb; }
.work-page .context-priority-item { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.work-page .context-priority-item:last-child { margin-bottom: 0; }
.work-page .context-priority-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.work-page .context-priority-bar { height: 8px; border-radius: 4px; transition: width 0.6s ease; }
.work-page .context-metric-card { position: absolute; bottom: -20px; left: 20px; background: #fff; border-radius: 12px; padding: 16px 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.1); display: flex; align-items: center; gap: 14px; }
.work-page .context-metric-icon { width: 40px; height: 40px; border-radius: 10px; background: rgba(16, 185, 129, 0.1); display: flex; align-items: center; justify-content: center; }
.work-page .context-metric-label { font-size: 12px; color: #64748b; margin-bottom: 2px; }
.work-page .context-metric-value { font-size: 16px; font-weight: 700; color: var(--fg); }
.work-page .context-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(59, 130, 246, 0.1); color: #3b82f6; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; margin-bottom: 24px; }
.work-page .context-content h2 { font-family: var(--font-display); font-size: clamp(32px, 4vw, 48px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 20px; color: var(--fg); }
.work-page .context-highlight { background: linear-gradient(135deg, var(--accent) 0%, #1863dc 50%, var(--accent) 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradient-shift 4s ease infinite; }
.work-page .gradient-text { background: linear-gradient(135deg, var(--accent) 0%, #1863dc 50%, var(--accent) 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradient-shift 4s ease infinite; }
.work-page .context-description { font-size: 17px; color: #64748b; line-height: 1.7; margin-bottom: 32px; }
.work-page .context-features { list-style: none; display: flex; flex-direction: column; gap: 16px; }
.work-page .context-features li { display: flex; align-items: flex-start; gap: 12px; font-size: 15px; color: var(--fg); line-height: 1.5; }
.work-page .context-check { flex-shrink: 0; width: 24px; height: 24px; border-radius: 8px; background: rgba(59, 130, 246, 0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center; margin-top: 2px; }

/* ── Lead Section ───────────────────────────────────────────────── */
.work-page .lead-section { padding: var(--section-gap) 0; background: linear-gradient(180deg, #f0f3f9 0%, #e8edf7 100%); color: var(--fg); position: relative; overflow: hidden; }
.work-page .lead-section::before { content: ''; position: absolute; top: -200px; right: -200px; width: 700px; height: 700px; background: radial-gradient(circle, rgba(0,31,92,0.08), transparent 65%); filter: blur(40px); pointer-events: none; }
.work-page .lead-section::after { content: ''; position: absolute; bottom: -300px; left: -200px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(0,31,92,0.05), transparent 65%); filter: blur(60px); pointer-events: none; }
