        <meta property="og:type" content="website" />
      </Helmet>

      <LandingNav activePage="about" ctaLabel="Book a demo" ctaHref="#lead-form" />
      <AboutHero />
      <AboutStorySection />
      <AboutMissionSection />
      <AboutDifferentSection />
      <AboutCtaSection />
