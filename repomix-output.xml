.about-page .hero-grid { display: block; text-align: center; }
.about-page .hero-grid .hero-text { max-width: 900px; margin: 0 auto; }

.about-page .shape { position: absolute; border-radius: 50%; z-index: 0; pointer-events: none; }
.about-page .shape-1 { width: 400px; height: 400px; background: linear-gradient(135deg, rgba(24, 99, 220, 0.08), transparent); top: 10%; right: -10%; animation: about-hero-float 8s ease-in-out infinite; }
.about-page .shape-2 { width: 300px; height: 300px; background: linear-gradient(135deg, rgba(24, 99, 220, 0.05), transparent); bottom: 20%; left: -5%; animation: about-hero-float-reverse 10s ease-in-out infinite; }
.about-page .shape-3 { width: 200px; height: 200px; border: 1px solid var(--border-light); top: 30%; left: 10%; animation: about-hero-pulse 6s ease-in-out infinite; }
.about-page .shape-4 { width: 150px; height: 150px; border: 1px solid var(--border-light); bottom: 30%; right: 15%; animation: about-hero-pulse 8s ease-in-out infinite; animation-delay: 2s; }

.about-page .hero h1 {
