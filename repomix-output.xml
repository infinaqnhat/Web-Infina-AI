    }

    .platform-icon {
      width: 56px;
      height: 56px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
    }

    .platform-item h4 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    .platform-item p {
      font-size: 15px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.65;
    }

    .partners {
      padding: 40px 0;
      background: linear-gradient(135deg, #f0f4ff 0%, #e8eef9 100%);
      position: relative;
      overflow: hidden;
      text-align: center;
    }

    .partners::before {
      content: '';
      position: absolute;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 500px;
      background: radial-gradient(circle, rgba(24,99,220,0.1), transparent 70%);
      filter: blur(80px);
      pointer-events: none;
    }

    .partners-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin: 0 auto 14px;
      position: relative;
      z-index: 1;
      width: fit-content;
    }

    .partners-headline {
      font-family: var(--font-display);
      font-size: clamp(24px, 3vw, 36px);
      font-weight: 700;
      letter-spacing: -.03em;
      color: var(--fg);
      margin-bottom: 8px;
      position: relative;
      z-index: 1;
    }

    .partners-sub {
      font-size: 15px;
      color: var(--muted);
      margin-bottom: 48px;
      position: relative;
      z-index: 1;
    }

    .industry-marquee {
