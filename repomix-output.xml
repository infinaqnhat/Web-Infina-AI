    .core-platform-row:last-child { margin-bottom: 0; }
    .core-platform-row svg {
      width: 13px; height: 13px;
      color: var(--accent);
      flex-shrink: 0;
    }
    .core-node--user {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      color: #fff;
    }
    .core-node--user .core-node-icon {
      background: rgba(40,200,120,0.1);
      color: #4cd584;
      border: 1px solid rgba(40,200,120,0.2);
    }

    /* Animated connecting line */
    .core-arrow {
      position: relative;
      align-self: center;
      width: 100%;
      min-width: 32px;
      height: 2px;
      background: repeating-linear-gradient(
        90deg,
        rgba(24,99,220,0.55) 0, rgba(24,99,220,0.55) 6px,
        transparent 6px, transparent 12px
      );
    }
    .core-arrow::before {
      /* Arrow head */
      content: "";
      position: absolute;
      right: -2px; top: 50%;
      width: 0; height: 0;
      border-left: 6px solid rgba(111,168,255,0.85);
      border-top: 4px solid transparent;
      border-bottom: 4px solid transparent;
      transform: translateY(-50%);
    }
    .core-arrow::after {
      /* Flowing dot */
      content: "";
      position: absolute;
      top: 50%; left: 0;
      width: 10px; height: 10px;
      margin-top: -5px;
      border-radius: 50%;
      background: #6fa8ff;
      box-shadow: 0 0 14px rgba(111,168,255,0.9), 0 0 28px rgba(24,99,220,0.6);
      animation: core-flow-dot 2.4s cubic-bezier(.4,0,.6,1) infinite;
    }
    .core-arrow:nth-of-type(2)::after { animation-delay: 0.4s; }
    .core-arrow:nth-of-type(4)::after { animation-delay: 0.8s; }
    .core-arrow:nth-of-type(6)::after { animation-delay: 1.2s; }
    @keyframes core-flow-dot {
      0%   { left: -5px; opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { left: calc(100% - 5px); opacity: 0; }
    }
    @keyframes core-flow-dot-vertical {
      0%   { top: -5px; opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { top: calc(100% - 5px); opacity: 0; }
    }
    @media (max-width: 900px) {
      .core-arrow {
        justify-self: center;
        width: 1.5px;
        height: 28px;
        min-width: 0;
        background: repeating-linear-gradient(
          180deg,
          rgba(24,99,220,0.55) 0, rgba(24,99,220,0.55) 4px,
          transparent 4px, transparent 8px
        );
      }
      .core-arrow::before {
        right: auto; top: auto;
        left: 50%; bottom: -4px;
        border-left: 3px solid transparent;
        border-right: 3px solid transparent;
        border-top: 5px solid rgba(111,168,255,0.85);
        border-bottom: 0;
        transform: translateX(-50%);
      }
      .core-arrow::after {
        left: 50%; top: 0;
        width: 6px; height: 6px;
        margin-top: 0; margin-left: -3px;
        animation-name: core-flow-dot-vertical;
      }
    }

