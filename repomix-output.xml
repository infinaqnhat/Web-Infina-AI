<file path="src/styles/landing-about.css">
/*
 * landing-about.css
 * Page-specific styles for /about (port of public/landing-html/about.html).
 * Class names are preserved verbatim so HTML selectors continue to match.
 * :root CSS custom-properties are shared — only page-specific rules here.
 * All selectors scoped under .about-page to prevent bleed.
 */

/* ── Animations ─────────────────────────────────────────────────── */
@keyframes about-fade-up { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
@keyframes about-pulse-dot { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(1.3); } }
@keyframes about-gradient-shift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
@keyframes about-hero-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-20px) rotate(3deg); } }
@keyframes about-hero-float-reverse { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(20px) rotate(-3deg); } }
@keyframes about-hero-pulse { 0%, 100% { opacity: 0.4; transform: scale(1); } 50% { opacity: 0.8; transform: scale(1.05); } }
@keyframes about-float { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-30px); } }
@keyframes about-pulse { 0%, 100% { opacity: .4; transform: scale(1); } 50% { opacity: .8; transform: scale(1.05); } }
@keyframes lead-combo-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
@keyframes lead-spin { to { transform: rotate(360deg); } }

/* ── CSS variables ──────────────────────────────────────────────── */
.about-page {
  --bg: #ffffff;
  --surface: #fafafa;
  --fg: #000000;
  --fg-secondary: #212121;
  --muted: #6b6b76;
  --border: #e5e7eb;
  --border-light: #f2f2f2;
  --accent: #001F5C;
  --accent-dark: #001340;
  --accent-light: rgba(0, 31, 92, 0.08);
  --font-display: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  --font-body: 'Be Vietnam Pro', -apple-system, system-ui, sans-serif;
  --section-gap: clamp(72px, 9vw, 112px);
  --radius: 22px;
}

.about-page * { box-sizing: border-box; }
.about-page a { color: inherit; text-decoration: none; }

.about-page .container {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 32px;
}

/* ── Nav ─────────────────────────────────────────────────────────── */
.about-page nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-light);
  z-index: 1000;
}

/* .nav-inner layout owned by .landing-root nav .nav-inner in landing.css */

.about-page .logo {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.03em;
  display: flex;
  align-items: center;
  gap: 10px;
}

.about-page .logo-img { height: 23px; width: auto; display: block; }

.about-page .nav-center {
  display: flex;
  align-items: center;
  gap: 40px;
}

.about-page .nav-center a {
  font-size: 15px;
  font-weight: 500;
  color: var(--fg-secondary);
  transition: color 0.2s;
  position: relative;
}

.about-page .nav-center a.active { color: var(--fg); }

.about-page .nav-center a::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--accent);
  transition: width 0.3s;
}

.about-page .nav-center a.active::after,
.about-page .nav-center a:hover::after { width: 100%; }

.about-page .nav-cta {
  background: var(--accent);
  color: white;
  padding: 11px 22px;
  border-radius: 9999px;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.3s;
}

.about-page .nav-cta:hover {
  background: var(--accent-dark);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
}

@media (max-width: 768px) {
  /* .nav-cta visibility owned by landing.css */
  .about-page .nav-center { display: none; }
}

/* ── Hero ────────────────────────────────────────────────────────── */
.about-page .hero {
  position: relative;
  padding: clamp(140px, 18vw, 180px) 0 clamp(80px, 10vw, 120px);
  text-align: center;
  overflow: hidden;
  background: var(--bg);
}

.about-page .hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 70% 30%, rgba(24, 99, 220, 0.14), transparent 60%),
    radial-gradient(ellipse 60% 50% at 20% 80%, rgba(126, 87, 194, 0.08), transparent 60%);
  z-index: 0;
}

.about-page .hero-grid-bg {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, rgba(24, 99, 220, 0.06) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(24, 99, 220, 0.06) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
  z-index: 0;
  pointer-events: none;
}

.about-page .hero .container {
