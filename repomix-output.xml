    .rk-cubie {
      position: absolute;
      width: var(--u);
      height: var(--u);
      top: calc(var(--u) * -0.5);
      left: calc(var(--u) * -0.5);
      transform-style: preserve-3d;
      transform:
        translate3d(calc(var(--x) * var(--u)),
          calc(var(--y) * var(--u)),
          calc(var(--z) * var(--u)));
    }

    .rk-cubie>i {
      position: absolute;
      inset: 0;
      border: 1px solid rgba(140, 180, 255, 0.7);
