          const v = card.dataset.v;
          cards.forEach(c => c.classList.toggle('active', c === card));
          panels.forEach(p => p.classList.toggle('active', p.dataset.v === v));
          card.scrollIntoView({behavior:'smooth', inline:'center', block:'nearest'});
          startAutoplay();
        });
      });

      // Nav arrows scroll one card at a time
      if (grid && navBtns.length) {
        const scrollByCard = (dir) => {
          const first = grid.querySelector('.vspec-card');
          if (!first) return;
          const step = first.offsetWidth + 18;
          grid.scrollBy({left: dir === 'next' ? step : -step, behavior: 'smooth'});
        };
        navBtns.forEach(btn => btn.addEventListener('click', () => scrollByCard(btn.dataset.dir)));
        // Update disabled state
        const updateNav = () => {
          const max = grid.scrollWidth - grid.clientWidth - 1;
          navBtns.forEach(btn => {
            if (btn.dataset.dir === 'prev') btn.disabled = grid.scrollLeft <= 1;
            if (btn.dataset.dir === 'next') btn.disabled = grid.scrollLeft >= max;
          });
        };
        grid.addEventListener('scroll', updateNav);
        window.addEventListener('resize', updateNav);
        updateNav();
      }

      // ===== Auto-cycle demo tabs within active panel =====
      let autoTimer = null;
      function startAutoplay() {
        clearInterval(autoTimer);
        autoTimer = setInterval(() => {
          const activePanel = document.querySelector('.vspec-panel.active');
          if (!activePanel) return;
          if (activePanel.dataset.paused === 'true') return;
          const tabs = activePanel.querySelectorAll('.vsd-tab');
          if (tabs.length < 2) return;
          const cur = activePanel.querySelector('.vsd-tab.active');
          let idx = [...tabs].indexOf(cur);
          idx = (idx + 1) % tabs.length;
          tabs[idx].click();
        }, 4200);
      }

      // Tab click → switch screen + reset autoplay timer
      panels.forEach(panel => {
        const tabs = panel.querySelectorAll('.vsd-tab');
        const screens = panel.querySelectorAll('.vsd-screen');
        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const t = tab.dataset.t;
            tabs.forEach(x => x.classList.toggle('active', x === tab));
            screens.forEach(sc => sc.classList.toggle('active', sc.dataset.t === t));
            // user click resets timer
            startAutoplay();
          });
        });

        // Pause on hover
        panel.addEventListener('mouseenter', () => { panel.dataset.paused = 'true'; });
        panel.addEventListener('mouseleave', () => { panel.dataset.paused = 'false'; });
      });

      startAutoplay();
    })();
  </script>

  <!-- React, Babel for Tweaks -->
  <script src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>
  
  <!-- Tweaks Panel Component -->
  <script type="text/babel" src="tweaks-panel.jsx"></script>
  
  <!-- Tweaks Implementation -->
  <script type="text/babel">
    const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
      "productTerm": "Product"
    }/*EDITMODE-END*/;

    function TweaksUI() {
      const [tweaks, setTweak] = window.useTweaks(TWEAK_DEFAULTS);

      // Apply tweaks to DOM
      React.useEffect(() => {
        // Update headline
        const headline = document.querySelector('.core-headline');
        if (headline) {
          headline.innerHTML = `Bring AI Specialist Agents<br><span class="headline-gradient">Inside Your ${tweaks.productTerm}</span>`;
        }

        // Update Partner Application node
        const partnerNode = document.querySelector('.core-node--partner strong');
        if (partnerNode) {
          partnerNode.textContent = `Partner ${tweaks.productTerm}`;
        }
      }, [tweaks.productTerm]);

      return (
        <window.TweaksPanel title="Content Options">
          <window.TweakSection title="Terminology">
            <window.TweakRadio
              label="Product/Application Term"
              value={tweaks.productTerm}
              options={['Application', 'Product']}
              onChange={(val) => setTweak('productTerm', val)}
            />
          </window.TweakSection>
        </window.TweaksPanel>
      );
    }

    // Mount tweaks
    const root = ReactDOM.createRoot(document.getElementById('tweaks-root') || (() => {
      const el = document.createElement('div');
      el.id = 'tweaks-root';
      document.body.appendChild(el);
      return el;
    })());
    root.render(<TweaksUI />);
  </script>

  <script>
  <script>
    // What You Get — expandable detail panels
    (function() {
      const cardToRow = { c1: 'row1', c4: 'row2', c5: 'row2', c6: 'row2' };
      let activeCard = null;

      document.querySelectorAll('.why-inside-card[data-card]').forEach(function(card) {
        card.addEventListener('click', function() {
          const cardId = card.getAttribute('data-card');
          const rowId = cardToRow[cardId];
          const panel = document.getElementById('panel-' + rowId);

          // Hide all detail inners
          document.querySelectorAll('.why-detail-inner').forEach(function(d) { d.classList.remove('is-visible'); });

          if (activeCard === cardId) {
            // Toggle off
            panel.classList.remove('is-open');
            card.classList.remove('is-active');
            activeCard = null;
          } else {
            // Close all panels first
            document.querySelectorAll('.why-detail-panel').forEach(function(p) { p.classList.remove('is-open'); });
            document.querySelectorAll('.why-inside-card').forEach(function(c) { c.classList.remove('is-active'); });

            // Open this one
            const detail = document.getElementById('detail-' + cardId);
            if (detail) detail.classList.add('is-visible');
            panel.classList.add('is-open');
            card.classList.add('is-active');
            activeCard = cardId;

            // Scroll panel into view smoothly
            setTimeout(function() { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 50);
          }
        });
      });
    })();
  </script>
