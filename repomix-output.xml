    @keyframes hv-blink {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.4;
      }
    }

    @keyframes hv-float {

      0%,
      100% {
        translate: 0 0;
      }

      50% {
        translate: 0 -5px;
      }
    }

    /* Push 4 cards OUTSIDE the visual corners so they never overlap the cube */
    .hv-node.n1 {
      top: 4%;
      left: -10%;
      --n-color: #1863dc;
      animation-delay: 0s;
    }

    .hv-node.n2 {
      top: 4%;
      right: -10%;
      left: auto;
      --n-color: #149a6e;
      animation-delay: -1.5s;
    }

    .hv-node.n3 {
      bottom: 4%;
      top: auto;
      left: -10%;
      --n-color: #7e57c2;
      animation-delay: -3s;
    }

    .hv-node.n4 {
      bottom: 4%;
      top: auto;
      right: -10%;
      left: auto;
      --n-color: #1863dc;
      animation-delay: -4.5s;
    }

    @media (max-width: 720px) {

      /* Pull cards back inside on small screens to avoid hitting page edges */
      .hv-node.n1 {
        left: -2%;
      }

      .hv-node.n2 {
        right: -2%;
      }

      .hv-node.n3 {
        left: -2%;
      }

      .hv-node.n4 {
        right: -2%;
      }
    }

    @media (max-width: 480px) {
      .hv-node {
        font-size: 10px;
        padding: 7px 10px;
      }

      .hv-node-text small {
        font-size: 7.5px;
      }

      .hv-node.n1,
      .hv-node.n3 {
        left: 0;
      }

      .hv-node.n2,
      .hv-node.n4 {
        right: 0;
      }
    }

    .hv-spark {
      position: absolute;
      width: 4px;
      height: 4px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--accent);
    }

    .hv-spark.s1 {
      top: 30%;
      left: 70%;
      animation: hv-spark 3s ease-in-out infinite;
    }

    .hv-spark.s2 {
      top: 65%;
      left: 30%;
      animation: hv-spark 4s ease-in-out 1s infinite;
    }

    .hv-spark.s3 {
      top: 50%;
      left: 90%;
      animation: hv-spark 3.5s ease-in-out 0.5s infinite;
    }

    @keyframes hv-spark {

      0%,
      100% {
        opacity: 0;
        transform: scale(0.6);
      }

      50% {
        opacity: 1;
        transform: scale(1.4);
      }
    }

    @keyframes pulse-line {
      0% {
        stroke-dashoffset: 0;
        opacity: 0.4;
      }

      50% {
        opacity: 0.8;
      }

      100% {
        stroke-dashoffset: -16;
        opacity: 0.4;
      }
    }

    .hv-line.animated {
      animation: pulse-line 2s linear infinite;
    }

    .shape {
      position: absolute;
      border-radius: 50%;
      z-index: -1;
      pointer-events: none;
    }

    .shape-1 {
      width: 400px;
      height: 400px;
      background: linear-gradient(135deg, rgba(24, 99, 220, 0.08), transparent);
      top: 10%;
      right: -10%;
      animation: float 8s ease-in-out infinite;
    }

    .shape-2 {
      width: 300px;
      height: 300px;
      background: linear-gradient(135deg, rgba(24, 99, 220, 0.05), transparent);
      bottom: 20%;
      left: -5%;
      animation: float-reverse 10s ease-in-out infinite;
    }

    .shape-3 {
      width: 200px;
      height: 200px;
      border: 1px solid var(--border-light);
      top: 30%;
      left: 10%;
      animation: pulse 6s ease-in-out infinite;
    }

    .shape-4 {
      width: 150px;
      height: 150px;
      border: 1px solid var(--border-light);
      bottom: 30%;
      right: 15%;
      animation: pulse 8s ease-in-out infinite;
      animation-delay: 2s;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 28px;
      opacity: 0;
      animation: fade-up 0.6s ease-out 0.2s forwards;
    }

    .hero-badge::before {
      content: "";
      width: 8px;
      height: 8px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }

    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(40px, 5.5vw, 72px);
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1.05;
      color: #001964;
      margin-bottom: 28px;
      opacity: 0;
      animation: fade-up 0.8s ease-out 0.3s forwards;
    }

    .hero h1 .line {
      white-space: nowrap;
      display: inline-block;
      padding: 0.12em 0 0.05em;
      line-height: 1.15;
    }

    .hero h1 .line-accent {
      background: linear-gradient(135deg, var(--accent) 0%, #4c6ee6 50%, var(--accent) 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradient-shift 4s ease infinite;
    }

    .hero-sub {
      font-size: 20px;
      color: var(--muted);
      max-width: 700px;
      margin: 0 auto 44px;
      line-height: 1.65;
      opacity: 0;
      animation: fade-up 0.8s ease-out 0.4s forwards;
    }

    .hero-sub-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
      font-size: 18px;
      font-weight: 500;
      color: var(--fg-secondary);
      max-width: 640px;
      margin: 0 auto 44px;
      opacity: 0;
      animation: fade-up 0.8s ease-out 0.4s forwards;
    }

    .hero-sub-visual span {
      font-size: 14px;
      color: var(--muted);
      font-weight: 400;
    }

    .hero-sub-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 18px;
      background: var(--bg);
      border: 1px solid var(--border-light);
      border-radius: 12px;
      transition: all 0.3s;
    }

    .hero-sub-item:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(24, 99, 220, 0.12);
    }

    .hero-sub-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: linear-gradient(135deg, var(--accent-light), color-mix(in oklab, var(--accent) 6%, transparent));
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent);
      flex-shrink: 0;
    }

    .hero-sub-icon svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .hero-sub-label {
      font-size: 16px;
      font-weight: 600;
      color: var(--fg);
      letter-spacing: -0.01em;
    }

    @media (max-width: 640px) {
      .hero-sub-visual {
        flex-direction: column;
        gap: 12px;
      }

      .hero-sub-item {
        width: 100%;
        max-width: 280px;
      }
    }

    .hero-ctas {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      opacity: 0;
      animation: fade-up 0.8s ease-out 0.5s forwards;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
      padding: 16px 32px;
      border-radius: 9999px;
      font-size: 15px;
      font-weight: 500;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transform: translateX(-100%);
      transition: transform 0.5s;
    }

    .btn-primary:hover::before {
      transform: translateX(100%);
    }

    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
    }

    .btn-ghost {
      background: transparent;
      color: var(--fg);
      padding: 16px 32px;
      border-radius: 9999px;
      font-size: 15px;
      font-weight: 500;
      transition: all 0.3s;
      border: 1px solid var(--border);
    }

    .btn-ghost:hover {
      border-color: var(--fg);
      background: var(--surface);
    }

    .stats {
      padding: 80px 0;
      border-bottom: 1px solid var(--border-light);
    }

    /* ===== Speed banner (text + phone mockup) ===== */
    .speed-banner {
      padding: var(--section-gap) 0;
      position: relative;
      background:
        radial-gradient(ellipse at 80% 50%, rgba(24, 99, 220, 0.08), transparent 55%),
        var(--bg);
      overflow: hidden;
    }

    .speed-banner::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(24, 99, 220, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(24, 99, 220, 0.05) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse at 80% 50%, black 0%, transparent 60%);
      -webkit-mask-image: radial-gradient(ellipse at 80% 50%, black 0%, transparent 60%);
      pointer-events: none;
    }

    .speed-banner .container {
      position: relative;
      z-index: 1;
    }

    .speed-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 80px;
      align-items: center;
    }

    @media (max-width: 960px) {
      .speed-grid {
        grid-template-columns: 1fr;
        gap: 56px;
        text-align: center;
      }

      .speed-cta {
        justify-content: center;
      }
    }

    /* Left text */
    .speed-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 7px 18px;
      background: linear-gradient(135deg, var(--accent) 0%, #1863dc 100%);
      border: none;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      margin-bottom: 20px;
      box-shadow: 0 4px 12px rgba(0, 31, 92, 0.25);
    }

    .speed-pill-dot {
      width: 6px;
      height: 6px;
      background: #ffffff;
      border-radius: 50%;
      box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
      animation: speed-dot 1.6s ease-in-out infinite;
    }

    @keyframes speed-dot {

      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }

      50% {
        transform: scale(1.4);
        opacity: 0.6;
      }
    }

    .speed-headline {
      font-family: var(--font-display);
      font-size: clamp(28px, 3.6vw, 44px);
      line-height: 1.2;
      letter-spacing: -0.025em;
      font-weight: 700;
      margin: 0 0 20px;
      color: var(--fg);
    }

    .speed-accent {
      background: linear-gradient(135deg, #6fa8ff 0%, var(--accent) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      padding: 0 6px 0 4px;
      display: inline-block;
    }

    .speed-sub {
      font-size: 17px;
      line-height: 1.7;
      color: var(--muted);
      margin: 0 0 28px;
      max-width: 520px;
    }

    .speed-grid:not(:has(*))~* {
      display: none;
    }

    @media (max-width: 960px) {
      .speed-sub {
        margin-left: auto;
        margin-right: auto;
      }
    }

    .speed-checks {
      list-style: none;
      padding: 0;
      margin: 0 0 36px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .speed-checks li {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 15px;
      color: var(--fg-secondary);
    }

    @media (max-width: 960px) {
      .speed-checks li {
        justify-content: center;
      }
    }

    .speed-check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--accent-light);
      border: 1px solid color-mix(in oklab, var(--accent) 28%, transparent);
      flex-shrink: 0;
      position: relative;
    }

    .speed-check::after {
      content: "";
      position: absolute;
      top: 5px;
      left: 6px;
      width: 8px;
      height: 5px;
      border-left: 2px solid var(--accent);
      border-bottom: 2px solid var(--accent);
      transform: rotate(-45deg);
    }

    .speed-cta {
      display: flex;
      gap: 12px;
    }

    .speed-benefits {
      list-style: none;
      padding: 0;
      margin: 0 0 28px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .speed-benefits li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      font-size: 17px;
      line-height: 1.5;
      font-weight: 500;
      color: var(--fg);
      letter-spacing: -0.01em;
    }

    @media (max-width: 960px) {
      .speed-benefits li {
        justify-content: flex-start;
        text-align: left;
      }
    }

    .speed-benefit-icon {
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent) 65%, #4f8df0));
      flex-shrink: 0;
      position: relative;
      margin-top: 2px;
      box-shadow: 0 4px 12px color-mix(in oklab, var(--accent) 25%, transparent);
    }

    .speed-benefit-icon::after {
      content: "";
      position: absolute;
      top: 8px;
      left: 7px;
      width: 10px;
      height: 6px;
      border-left: 2.2px solid #fff;
      border-bottom: 2.2px solid #fff;
      transform: rotate(-45deg);
    }

    /* Italic emphasis in headline */
    .speed-headline em {
      font-style: italic;
      font-weight: 600;
      color: var(--accent);
      position: relative;
      padding: 0 2px;
    }

    @keyframes speed-track-fill {
      from {
        width: 0;
      }

      to {
        width: 100%;
      }
    }

    @keyframes tl-pulse {

      0%,
      100% {
        box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 40%, transparent);
      }

      50% {
        box-shadow: 0 0 0 8px color-mix(in oklab, var(--accent) 0%, transparent);
      }
    }

    @keyframes speed-card-in {
      from {
        opacity: 0;
        transform: translateY(16px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes speed-step-in {
      from {
        opacity: 0;
        transform: translateY(-6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Timeline */
    .speed-timeline {
      margin: 28px 0 36px;
      max-width: 520px;
      position: relative;
    }

    .speed-tl-track {
      position: relative;
      height: 4px;
      background: color-mix(in oklab, var(--accent) 12%, transparent);
      border-radius: 999px;
      margin: 0 14px 14px;
      overflow: hidden;
    }

    .speed-tl-fill {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 0;
      background: linear-gradient(90deg, #6fa8ff, var(--accent));
      border-radius: 999px;
    }

    .speed-tl-steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
    }

    .speed-tl-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-align: center;
      position: relative;
    }

    .speed-tl-dot {
      position: absolute;
      top: -22px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent);
      border: 2.5px solid var(--accent);
      box-shadow: 0 2px 6px color-mix(in oklab, var(--accent) 20%, transparent);
    }

    .speed-tl-step.is-live .speed-tl-dot {
      background: linear-gradient(135deg, #6fa8ff, var(--accent));
      animation: tl-pulse 2s ease-in-out 1.6s infinite;
    }

    .speed-tl-step small {
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 500;
    }

    .speed-tl-step strong {
      font-size: 13px;
      color: var(--fg);
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .speed-tl-step.is-live strong {
      color: var(--accent);
    }

    /* Benefits grid */
    .speed-benefits-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      max-width: 560px;
    }

    @media (max-width: 960px) {
      .speed-benefits-grid {
        margin-left: auto;
        margin-right: auto;
      }
    }

    @media (max-width: 520px) {
      .speed-benefits-grid {
        grid-template-columns: 1fr;
      }
    }

    .benefit-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 16px 16px 18px;
      background: linear-gradient(180deg, #ffffff, color-mix(in oklab, var(--accent) 2%, #ffffff));
      border: 1px solid var(--border-light);
      border-radius: 16px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
      text-align: left;
    }

    .benefit-card:hover {
      transform: translateY(-2px);
      border-color: color-mix(in oklab, var(--accent) 30%, var(--border));
      box-shadow:
        0 12px 28px -16px color-mix(in oklab, var(--accent) 50%, transparent),
        0 2px 6px rgba(15, 23, 42, 0.04);
    }

    .benefit-icon {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      border-radius: 10px;
      background: linear-gradient(135deg, #001F5C 0%, #003380 100%);
      border: 1px solid #001F5C;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
      box-shadow: 0 2px 8px rgba(0, 31, 92, 0.15);
    }

    .benefit-card:hover .benefit-icon {
      transform: scale(1.06) rotate(-3deg);
      background: linear-gradient(135deg, #003380 0%, #004499 100%);
      box-shadow: 0 4px 12px rgba(0, 31, 92, 0.25);
    }

    .benefit-icon svg {
      width: 18px;
      height: 18px;
    }

    .benefit-body {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .benefit-body strong {
      font-size: 14.5px;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--fg);
      line-height: 1.35;
    }

    .benefit-body small {
      font-size: 12.5px;
      line-height: 1.5;
      color: var(--muted);
    }

    @media (prefers-reduced-motion: reduce) {

      .speed-tl-fill,
      .speed-tl-step.is-live .speed-tl-dot {
        animation: none;
      }
    }

    /* Right: phone mockup */
    .speed-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 580px;
    }

    .speed-visual-glow {
      position: absolute;
      inset: 10% 5%;
      background: radial-gradient(ellipse, rgba(24, 99, 220, 0.25), transparent 65%);
      filter: blur(40px);
      pointer-events: none;
      z-index: 0;
      animation: speed-glow 6s ease-in-out infinite;
    }

    @keyframes speed-glow {

      0%,
      100% {
        transform: scale(1);
        opacity: 0.7;
      }

      50% {
        transform: scale(1.05);
        opacity: 1;
      }
    }

    .phone {
      position: relative;
      width: 320px;
      height: 640px;
      background:
        linear-gradient(145deg, #2a2f3a 0%, #14171f 35%, #0a0c12 65%, #1c2230 100%);
      border-radius: 48px;
      padding: 11px;
      box-shadow:
        0 50px 100px -30px rgba(24, 99, 220, 0.4),
        0 30px 60px -20px rgba(0, 0, 0, 0.45),
        inset 0 0 0 1px rgba(255, 255, 255, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.18),
        inset 0 -1px 0 rgba(0, 0, 0, 0.5);
      z-index: 1;
      animation: phone-float 6s ease-in-out infinite;
    }

    .phone::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 48px;
      background: linear-gradient(160deg, rgba(255, 255, 255, 0.18), transparent 35%, transparent 65%, rgba(255, 255, 255, 0.06));
      pointer-events: none;
      mix-blend-mode: overlay;
    }

    /* Side buttons */
    .phone::after {
      content: "";
      position: absolute;
      left: -2px;
      top: 140px;
      width: 3px;
      height: 60px;
      background: linear-gradient(180deg, #1a1d24, #0a0c12);
      border-radius: 2px 0 0 2px;
      box-shadow: 0 80px 0 #1a1d24, 0 150px 0 #1a1d24;
    }

    @keyframes phone-float {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-8px);
      }
    }

    .phone-notch {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: 110px;
      height: 32px;
      background: #050608;
      border-radius: 999px;
      z-index: 4;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04), 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .phone-notch::after {
      content: "";
      position: absolute;
      top: 50%;
      right: 16px;
      transform: translateY(-50%);
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #2d3548, #0a0c12 70%);
      box-shadow: inset 0 0 0 1px rgba(111, 168, 255, 0.18);
    }

    .phone-screen {
      position: relative;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, #fafafa 0%, #f4f6fb 100%);
      border-radius: 38px;
      padding: 60px 18px 24px;
      overflow: hidden;
      font-family: var(--font-body);
      color: var(--fg);
    }

    .phone-status {
      position: absolute;
      top: 18px;
      left: 28px;
      right: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      font-weight: 600;
      color: var(--fg);
      z-index: 3;
    }

    .phone-status-icons {
      display: flex;
      gap: 5px;
      align-items: center;
    }

    .phone-status-icons svg:first-child {
      width: 14px;
      height: 10px;
    }

    .phone-status-icons svg:last-child {
      width: 22px;
      height: 12px;
    }

    .phone-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
    }

    .phone-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), #6fa8ff);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .phone-avatar svg {
      width: 24px;
      height: 24px;
    }

    .phone-greeting {
      flex: 1;
      line-height: 1.2;
      text-align: left;
    }

    .phone-greeting small {
      display: block;
      font-size: 11px;
      color: var(--muted);
    }

    .phone-greeting strong {
      font-size: 15px;
      font-weight: 700;
      color: var(--fg);
    }

    .phone-icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      cursor: pointer;
    }

    .phone-icon-btn svg {
      width: 16px;
      height: 16px;
    }

    .phone-balance {
      background: linear-gradient(135deg, #0a0a0a 0%, #0f1a3a 50%, #112a5e 100%);
      border-radius: 18px;
      padding: 18px;
      color: #fff;
      margin-bottom: 14px;
      position: relative;
      overflow: hidden;
    }

    .phone-balance::before {
      content: "";
      position: absolute;
      inset: -30% -30% auto auto;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(111, 168, 255, 0.3), transparent 70%);
      pointer-events: none;
    }

    .phone-balance-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      position: relative;
      z-index: 1;
    }

    .phone-balance-label {
      font-size: 11px;
      color: rgba(255, 255, 255, 0.7);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .phone-balance-trend {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      background: rgba(40, 200, 120, 0.15);
      border: 1px solid rgba(40, 200, 120, 0.3);
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      color: #4cd584;
    }

    .phone-balance-trend svg {
      width: 10px;
      height: 10px;
    }

    .phone-balance-value {
      font-family: var(--font-display);
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 14px;
      position: relative;
      z-index: 1;
    }

    .phone-balance-actions {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      position: relative;
      z-index: 1;
    }

    .phone-action {
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(4px);
      border-radius: 10px;
      padding: 8px 4px;
      text-align: center;
      font-size: 11px;
      color: rgba(255, 255, 255, 0.85);
    }

    .phone-action span {
      display: block;
      font-size: 14px;
      margin-bottom: 2px;
      color: #fff;
    }

    .phone-ai-card {
      background: #fff;
      border: 1px solid color-mix(in oklab, var(--accent) 20%, transparent);
      border-radius: 16px;
      padding: 14px;
      box-shadow: 0 8px 24px rgba(24, 99, 220, 0.08);
      position: relative;
      animation: ai-card-glow 3s ease-in-out infinite;
    }

    @keyframes ai-card-glow {

      0%,
      100% {
        box-shadow: 0 8px 24px rgba(24, 99, 220, 0.08), 0 0 0 0 rgba(24, 99, 220, 0);
      }

      50% {
        box-shadow: 0 8px 24px rgba(24, 99, 220, 0.15), 0 0 0 4px rgba(24, 99, 220, 0.08);
      }
    }

    .phone-ai-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .phone-ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      font-weight: 700;
      color: var(--accent);
    }

    .phone-ai-dot {
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 6px var(--accent);
      animation: speed-dot 1.6s ease-in-out infinite;
    }

    .phone-ai-brand {
      font-size: 9px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.12em;
    }

    .phone-ai-msg {
      font-size: 12.5px;
      line-height: 1.5;
      color: var(--fg-secondary);
      margin: 0 0 10px;
      text-align: left;
      font-weight: 500;
    }

    /* Goal block inside AI card */
    .phone-goal {
      background: #fff;
      border: 1px solid rgba(24, 99, 220, 0.14);
      border-radius: 12px;
      padding: 10px 12px;
      margin-bottom: 10px;
      box-shadow: 0 2px 8px rgba(24, 99, 220, 0.04);
    }

    .phone-goal-top {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 8px;
    }

    .phone-goal-icon {
      width: 30px;
      height: 30px;
      border-radius: 9px;
      background: linear-gradient(135deg, var(--accent), #6fa8ff);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(24, 99, 220, 0.25);
    }

    .phone-goal-icon svg {
      width: 16px;
      height: 16px;
    }

    .phone-goal-info {
      flex: 1;
      line-height: 1.15;
      text-align: left;
    }

    .phone-goal-info small {
      font-size: 9px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }

    .phone-goal-info strong {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--fg);
      letter-spacing: -0.01em;
    }

    .phone-goal-badge {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 9.5px;
      font-weight: 700;
      color: #0e7c3e;
      background: rgba(40, 200, 120, 0.13);
      padding: 3px 7px;
      border-radius: 999px;
      white-space: nowrap;
    }

    .phone-goal-badge svg {
      width: 9px;
      height: 9px;
    }

    .phone-progress {
      height: 5px;
      background: rgba(24, 99, 220, 0.1);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 10px;
      position: relative;
    }

    .phone-progress-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--accent), #6fa8ff);
      border-radius: 999px;
      animation: phone-progress 2.4s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
      box-shadow: 0 0 8px rgba(24, 99, 220, 0.4);
      position: relative;
    }

    .phone-progress-bar::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: 6px;
      background: rgba(255, 255, 255, 0.6);
      border-radius: 999px;
      filter: blur(2px);
    }

    @keyframes phone-progress {
      from {
        width: 0;
      }

      to {
        width: 85%;
      }
    }

    .phone-goal-stats {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .phone-stat {
      flex: 1;
      line-height: 1.15;
      text-align: left;
    }

    .phone-stat small {
      font-size: 9px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: block;
      font-weight: 600;
    }

    .phone-stat strong {
      font-size: 13px;
      font-weight: 700;
      color: var(--fg);
      font-family: var(--font-display);
      letter-spacing: -0.01em;
    }

    .phone-stat-up {
      color: #0e7c3e !important;
    }

    .phone-stat-divider {
      width: 1px;
      height: 22px;
      background: rgba(24, 99, 220, 0.12);
    }

    .phone-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .phone-btn-primary svg {
      width: 13px;
      height: 13px;
    }

    .phone-ai-actions {
      display: flex;
      gap: 6px;
    }

    .phone-btn-ghost,
    .phone-btn-primary {
      flex: 1;
      padding: 8px 10px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 600;
      border: 0;
      cursor: pointer;
      font-family: inherit;
    }

    .phone-btn-ghost {
      background: #f4f6fb;
      color: var(--fg-secondary);
      border: 1px solid var(--border-light);
    }

    .phone-btn-primary {
      background: var(--accent);
      color: #fff;
    }

    .phone-ai-typing {
      position: absolute;
      bottom: -18px;
      left: 18px;
      display: flex;
      gap: 4px;
      padding: 6px 10px;
      background: var(--accent);
      border-radius: 999px;
      box-shadow: 0 4px 12px rgba(24, 99, 220, 0.25);
    }

    .phone-ai-typing span {
      width: 5px;
      height: 5px;
      background: #fff;
      border-radius: 50%;
      opacity: 0.4;
      animation: ai-typing 1.2s ease-in-out infinite;
    }

    .phone-ai-typing span:nth-child(2) {
      animation-delay: 0.15s;
    }

    .phone-ai-typing span:nth-child(3) {
      animation-delay: 0.3s;
    }

    @keyframes ai-typing {

      0%,
      100% {
        opacity: 0.4;
        transform: translateY(0);
      }

      50% {
        opacity: 1;
        transform: translateY(-2px);
      }
    }

    /* ===== Infina AI Core Section ===== */
    .core-section {
      padding: var(--section-gap) 0;
      position: relative;
      background:
        radial-gradient(ellipse 70% 50% at 50% 50%, rgba(24, 99, 220, 0.06), transparent 70%),
        #fafafa;
      overflow: hidden;
    }

    .core-section::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(24, 99, 220, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(24, 99, 220, 0.04) 1px, transparent 1px);
      background-size: 64px 64px;
      mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 0%, transparent 70%);
      -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 0%, transparent 70%);
      pointer-events: none;
    }

    .core-section .container {
      position: relative;
      z-index: 1;
    }

    .core-header {
      text-align: center;
      margin-bottom: 56px;
    }

    .core-headline {
      font-family: var(--font-display);
      font-size: clamp(28px, 3.8vw, 48px);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.025em;
      color: var(--fg);
      max-width: 900px;
      margin: 0 auto;
    }

    .core-accent {
      background: linear-gradient(135deg, var(--accent) 0%, #6fa8ff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .core-products-row {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 48px;
    }

    .core-product-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 24px;
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: 999px;
      font-size: 15px;
      font-weight: 600;
      color: var(--fg);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: default;
    }

    .core-product-pill[data-product="personal"] {
      --pill-color: #7e57c2;
    }

    .core-product-pill[data-product="inside"] {
      --pill-color: #1863dc;
    }

    .core-product-pill[data-product="work"] {
      --pill-color: #149a6e;
    }

    .core-product-pill:hover {
      transform: translateY(-3px);
      border-color: var(--pill-color);
      box-shadow: 0 12px 32px -8px color-mix(in oklab, var(--pill-color) 35%, transparent);
    }

    .core-pill-icon {
      width: 22px;
      height: 22px;
      border-radius: 8px;
      background: color-mix(in oklab, var(--pill-color) 10%, transparent);
      color: var(--pill-color);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .core-pill-icon svg {
      width: 13px;
      height: 13px;
    }

    .core-platform {
      position: relative;
      margin-bottom: 64px;
    }

    .core-platform-header {
      display: flex;
      justify-content: center;
      margin-bottom: 40px;
    }

    .core-platform-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0;
      background: none;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: var(--muted);
      text-transform: uppercase;
      box-shadow: none;
      position: relative;
      overflow: visible;
    }

    .core-platform-badge::before {
      content: none;
    }

    .core-badge-dot {
      display: none;
      width: 7px;
      height: 7px;
      background: #fff;
      border-radius: 50%;
      box-shadow: 0 0 12px rgba(255, 255, 255, 0.8);
      animation: core-dot-pulse 2s ease-in-out infinite;
    }

    @keyframes core-dot-pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.7;
        transform: scale(1.3);
      }
    }

    .core-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      max-width: 1100px;
      margin: 0 auto;
    }

    @media (max-width: 768px) {
      .core-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 568px) {
      .core-grid {
        grid-template-columns: 1fr;
      }
    }

    .core-card {
      background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
      border: 1px solid var(--border-light);
      border-radius: 18px;
      padding: 28px 24px;
      position: relative;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 0;
      animation: core-card-in 0.6s ease-out forwards;
      animation-delay: var(--delay, 0s);
      overflow: hidden;
    }

    @keyframes core-card-in {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .core-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, var(--accent-light) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.4s;
      pointer-events: none;
    }

    .core-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in oklab, var(--accent) 25%, transparent);
      box-shadow:
        0 24px 48px -16px rgba(24, 99, 220, 0.2),
        0 0 0 1px color-mix(in oklab, var(--accent) 15%, transparent);
    }

    .core-card:hover::before {
      opacity: 1;
    }

    .core-card-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, #001F5C 0%, #003380 100%);
      border: 1px solid #001F5C;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      color: #ffffff;
      position: relative;
      overflow: hidden;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
      box-shadow: 0 4px 12px rgba(0, 31, 92, 0.15);
    }

    .core-card-icon::after {
      content: "";
      position: absolute;
      inset: -100%;
      background: conic-gradient(from 0deg, transparent 0%, rgba(255, 255, 255, 0.2) 50%, transparent 100%);
      opacity: 0;
      animation: core-icon-spin 4s linear infinite;
      transition: opacity 0.3s;
    }

    @keyframes core-icon-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .core-card:hover .core-card-icon {
      transform: scale(1.08) rotate(-5deg);
      box-shadow: 0 6px 16px rgba(0, 31, 92, 0.25);
    }

    .core-card:hover .core-card-icon::after {
      opacity: 0.4;
    }

    .core-card-icon svg {
      width: 28px;
      height: 28px;
      position: relative;
      z-index: 1;
    }

    .core-card-title {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--fg);
      margin-bottom: 10px;
      line-height: 1.3;
    }

    .core-card-desc {
      font-size: 14px;
      line-height: 1.65;
      color: var(--muted);
    }

    .core-footer {
      text-align: center;
      padding-top: 24px;
    }

    .core-tagline {
      font-family: var(--font-display);
      font-size: clamp(18px, 2.2vw, 26px);
      font-weight: 600;
      line-height: 1.4;
      color: var(--fg-secondary);
      font-style: italic;
      max-width: 900px;
      margin: 0 auto;
      white-space: nowrap;
    }

    @media (max-width: 768px) {
      .core-tagline {
        white-space: normal;
      }
    }

    .core-tagline-accent {
      color: var(--accent);
      font-weight: 700;
      font-style: normal;
    }

    /* Legacy stats hidden */
    .stats {
      display: none;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
      text-align: center;
    }

    @media (max-width: 800px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .stat-item {
      opacity: 0;
      animation: counter 0.6s ease-out forwards;
    }

    .stat-item:nth-child(1) {
      animation-delay: 0.1s;
    }

    .stat-item:nth-child(2) {
      animation-delay: 0.2s;
    }

    .stat-item:nth-child(3) {
      animation-delay: 0.3s;
    }

    .stat-item:nth-child(4) {
      animation-delay: 0.4s;
    }

    .stat-number {
      font-family: var(--font-display);
      font-size: 48px;
      font-weight: 700;
      letter-spacing: -0.03em;
      background: linear-gradient(135deg, var(--fg) 0%, var(--accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .stat-label {
      font-size: 14px;
      color: var(--muted);
      margin-top: 8px;
    }

    .products {
      padding: var(--section-gap) 0;
      background: linear-gradient(180deg, #fafafa 0%, var(--bg) 100%);
      position: relative;
      overflow: hidden;
    }

    .products::before {
      content: '';
      position: absolute;
      top: -200px;
      right: -200px;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, var(--accent-light) 0%, transparent 70%);
      opacity: 0.5;
      pointer-events: none;
    }

    .products .container {
      position: relative;
      z-index: 1;
    }

    .products .section-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 72px;
    }

    .products .section-header h2 {
      text-align: center;
      max-width: none;
      font-size: clamp(36px, 4.6vw, 56px);
      line-height: 1.08;
      letter-spacing: -0.025em;
      color: #001964;
    }

    .products .section-header h2 .accent {
      background: linear-gradient(135deg, var(--accent) 0%, #6fa8ff 50%, var(--accent) 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      animation: gradient-shift 4s ease infinite;
    }

    .products .section-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0;
      background: none;
      border: none;
      border-radius: 0;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 20px;
      box-shadow: none;
    }

    .products .section-eyebrow::before {
      content: none;
    }

    .section-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .section-header {
      margin-bottom: 48px;
    }

    .section-header h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 5vw, 52px);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin-bottom: 20px;
    }

    .section-header p {
      font-size: 18px;
      color: var(--muted);
      max-width: 520px;
      line-height: 1.6;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      column-gap: 24px;
      row-gap: 0;
    }


    .product-card {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 44px 32px 32px;
      position: relative;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s, border-color 0.3s;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      isolation: isolate;
    }

    .product-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, var(--card-tint, var(--accent-light)) 0%, transparent 55%);
      opacity: 0;
      transition: opacity 0.4s;
      z-index: -1;
    }

    .product-card[data-product="personal"] {
      --card-tint: rgba(0, 31, 92, 0.04);
      --card-accent: rgba(0, 31, 92, 0.5);
    }

    .product-card[data-product="inside"] {
      --card-tint: rgba(0, 31, 92, 0.04);
      --card-accent: rgba(0, 31, 92, 0.5);
    }

    .product-card[data-product="work"] {
      --card-tint: rgba(0, 31, 92, 0.04);
      --card-accent: rgba(0, 31, 92, 0.5);
    }

    .product-num {
      position: absolute;
      top: 24px;
      right: 28px;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 700;
      color: #001F5C;
      letter-spacing: 0.1em;
      opacity: 0.6;
    }

    .product-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), #4c6ee6);
      transform: scaleX(0);
      transition: transform 0.4s;
    }


    .product-card:hover {
      transform: translateY(-6px);
      border-color: transparent;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 31, 92, 0.3);
    }

    /* Active card — desktop: lift + colored ring (old style) */
    @media (min-width: 1001px) {
      .product-card.active {
        transform: translateY(-6px);
        border-color: transparent;
        box-shadow: none;
      }
      .product-card[data-product="inside"].active  { box-shadow: 0 24px 60px rgba(24,99,220,0.15),  0 0 0 2px #1863dc; }
      .product-card[data-product="work"].active    { box-shadow: 0 24px 60px rgba(20,154,110,0.15), 0 0 0 2px #149a6e; }
      .product-card[data-product="personal"].active{ box-shadow: 0 24px 60px rgba(126,87,194,0.15), 0 0 0 2px #7e57c2; }
    }

    /* Active card — mobile: flatten bottom, merge into accordion panel */
    @media (max-width: 1000px) {
      .product-card.active {
        transform: translateY(0);
        border-radius: 20px 20px 0 0;
        border-bottom: none;
        box-shadow: none;
      }
      .product-card[data-product="inside"].active  { border-color: #1863dc; border-width: 2px; }
      .product-card[data-product="work"].active    { border-color: #149a6e; border-width: 2px; }
      .product-card[data-product="personal"].active{ border-color: #7e57c2; border-width: 2px; }
    }


    .product-card:hover::before {
      opacity: 1;
    }


    .product-icon {
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #001F5C 0%, #003380 100%);
      border-radius: 14px;
      margin-bottom: 20px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
      position: relative;
      overflow: hidden;
      border: none;
      box-shadow: 0 4px 12px rgba(0, 31, 92, 0.25);
    }

    .product-icon svg {
      width: 26px;
      height: 26px;
      color: #ffffff;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .product-icon::after {
      content: '';
      position: absolute;
      inset: -50%;
      background: conic-gradient(from 0deg, transparent 0%, rgba(0, 31, 92, 0.1) 50%, transparent 100%);
      opacity: 0;
      animation: icon-spin 4s linear infinite;
      transition: opacity 0.3s;
    }

    .product-icon::before {
      content: '';
      position: absolute;
      inset: 2px;
      background: linear-gradient(135deg, rgba(0, 31, 92, 0.06) 0%, rgba(0, 31, 92, 0.1) 100%);
      border-radius: 12px;
      z-index: 1;
    }

    .product-icon svg {
      position: relative;
      z-index: 2;
    }

    .product-card:hover .product-icon::after {
      opacity: 0.6;
    }

    @keyframes icon-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .product-icon .icon-pulse {
      animation: icon-pulse 2s ease-in-out infinite;
      transform-origin: center;
    }

    .product-card:hover .icon-pulse {
      animation-duration: 1s;
    }

    @keyframes icon-pulse {

      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }

      50% {
        opacity: 0.6;
        transform: scale(0.92);
      }
    }

    .product-icon .icon-dot {
      animation: icon-dot 1.6s ease-in-out infinite;
    }

    .product-icon .icon-dot:nth-child(2) {
      animation-delay: 0.2s;
    }

    .product-icon .icon-dot:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes icon-dot {

      0%,
      100% {
        opacity: 0.3;
      }

      50% {
        opacity: 1;
      }
    }

    .product-card:hover .product-icon {
      transform: scale(1.05) rotate(-3deg);
      background: linear-gradient(135deg, #003380 0%, #004aad 100%);
      box-shadow: 0 6px 16px rgba(0, 31, 92, 0.35);
    }

    .product-tag {
      display: inline-block;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: var(--tag-color, rgba(0, 31, 92, 0.9));
      background: transparent;
      border: 2px solid var(--tag-color, rgba(0, 31, 92, 0.9));
      padding: 6px 18px;
      border-radius: 999px;
      margin-bottom: 20px;
      align-self: flex-start;
      box-shadow: none;
    }

    .product-card[data-product="inside"] .product-tag {
      --tag-color: #1863dc;
    }

    .product-card[data-product="work"] .product-tag {
      --tag-color: #149a6e;
    }

    .product-card[data-product="personal"] .product-tag {
      --tag-color: #7e57c2;
    }

    .product-tag-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .product-audience-label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.10em;
      text-transform: uppercase;
      color: #4a4a55;
      margin-bottom: 8px;
      padding-left: 20px;
    }


    .product-card h3 {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 8px;
      color: var(--fg);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-tagline {
      font-size: 15px;
      font-weight: 400;
      color: #4a4a55;
      line-height: 1.75;
      margin-bottom: 24px;
    }

    .product-desc {
      font-size: 14px;
      color: #4a4a55;
      line-height: 1.65;
      margin: 0 0 24px;
    }

    .product-bullets {
      list-style: none;
      padding: 0;
      margin: 0 0 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .product-bullets li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: #4a4a55;
      line-height: 1.5;
    }

    .product-bullets li::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
      opacity: 0.7;
      margin-top: 6px;
    }

    .product-desc {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 24px;
      flex-grow: 1;
    }

    .product-desc:empty {
      display: none;
    }

    .product-features {
      list-style: none;
      margin-bottom: 28px;
      flex-grow: 1;
    }

    .product-features li {
      font-size: 13px;
      color: var(--fg-secondary);
      padding: 10px 0;
      border-top: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      gap: 10px;
      transition: transform 0.2s;
    }

    .product-card:hover .product-features li {
      transform: translateX(4px);
    }

    .product-features li:last-child {
      border-bottom: 1px solid var(--border-light);
    }

    .check {
      width: 18px;
      height: 18px;
      background: rgba(0, 31, 92, 0.08);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 10px;
      color: #001F5C;
      border: 1px solid rgba(0, 31, 92, 0.15);
    }

    .product-link {
      font-size: 14px;
      font-weight: 600;
      color: var(--fg);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s;
      margin-top: auto;
    }

    .product-see-more {
      font-size: 13px;
      font-weight: 600;
      color: var(--muted, #9ca3af);
      margin-top: auto;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      user-select: none;
      transition: color 0.2s;
    }
    /* CSS filled triangle — points right by default */
    .product-see-more::before {
      content: '';
      display: inline-block;
      flex-shrink: 0;
      width: 0;
      height: 0;
      border-top: 5px solid transparent;
      border-bottom: 5px solid transparent;
      border-left: 8px solid currentColor;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* Text label swap */
    .see-more-default { display: inline; }
    .see-more-active  { display: none; }
    .product-card.active .see-more-default { display: none; }
    .product-card.active .see-more-active  { display: inline; }
    /* Rotate triangle down when active */
    .product-card.active .product-see-more::before {
      transform: rotate(90deg);
    }
    .product-card:hover .product-see-more {
      color: var(--accent, #001F5C);
    }
    .product-card[data-product="inside"].active .product-see-more  { color: #1863dc; }
    .product-card[data-product="work"].active .product-see-more    { color: #149a6e; }
    .product-card[data-product="personal"].active .product-see-more{ color: #7e57c2; }

    .product-link:hover {
      color: var(--card-accent, var(--accent));
      gap: 14px;
    }

    .product-link::after {
      content: "→";
    }

    /* ===== Why Infina — Light high-tech ===== */
    .why-infina {
      padding: var(--section-gap) 0;
      background: linear-gradient(180deg, #f7f9ff 0%, var(--bg) 100%);
      position: relative;
      overflow: hidden;
      color: var(--fg);
    }

    .why-infina::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 0%, rgba(24, 99, 220, 0.12), transparent 55%),
        radial-gradient(ellipse at 85% 100%, rgba(111, 168, 255, 0.10), transparent 55%);
      pointer-events: none;
    }

    .why-infina::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(24, 99, 220, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(24, 99, 220, 0.06) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse at 50% 40%, black 30%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 30%, transparent 75%);
      pointer-events: none;
      animation: why-grid-drift 30s linear infinite;
    }

    @keyframes why-grid-drift {
      from {
        background-position: 0 0, 0 0;
      }

      to {
        background-position: 56px 56px, 56px 56px;
      }
    }

    .why-infina .container {
      position: relative;
      z-index: 1;
    }

    .why-infina .section-header {
      text-align: center;
      margin-bottom: 72px;
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
    }

    .why-infina .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      background: var(--accent-light);
      border: 1px solid color-mix(in oklab, var(--accent) 22%, transparent);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 20px;
    }

    .why-infina .eyebrow::before {
      content: "";
      width: 6px;
      height: 6px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--accent);
      animation: why-pulse 2s ease-in-out infinite;
    }

    @keyframes why-pulse {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: 0.4;
      }
    }

    .why-infina h2 {
      font-family: var(--font-display);
      font-size: clamp(36px, 4.6vw, 60px);
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: var(--fg);
      font-weight: 700;
    }

    .why-infina h2 .accent {
      background: linear-gradient(135deg, #6fa8ff 0%, var(--accent) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    @media (max-width: 900px) {
      .why-grid {
        grid-template-columns: 1fr;
      }
    }

    .why-item {
      position: relative;
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(24, 99, 220, 0.12);
      border-radius: 20px;
      padding: 36px;
      display: flex;
      flex-direction: column;
      gap: 18px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
      overflow: hidden;
      isolation: isolate;
      opacity: 0;
      animation: why-card-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .why-item:nth-child(1) {
      animation-delay: 0.05s;
    }

    .why-item:nth-child(2) {
      animation-delay: 0.18s;
    }

    .why-item:nth-child(3) {
      animation-delay: 0.31s;
    }

    .why-item:nth-child(4) {
      animation-delay: 0.44s;
    }

    @keyframes why-card-in {
      from {
        opacity: 0;
        transform: translateY(28px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .why-item::before {
      content: "";
      position: absolute;
      top: -1px;
      left: -1px;
      right: -1px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(24, 99, 220, 0.5), transparent);
      opacity: 0.5;
      animation: why-top-shimmer 4s ease-in-out infinite;
    }

    .why-item:nth-child(2)::before {
      animation-delay: 1s;
    }

    .why-item:nth-child(3)::before {
      animation-delay: 2s;
    }

    .why-item:nth-child(4)::before {
      animation-delay: 3s;
    }

    @keyframes why-top-shimmer {

      0%,
      100% {
        opacity: 0.3;
        background-position: -100% 0;
      }

      50% {
        opacity: 0.8;
        background-position: 200% 0;
      }
    }

    .why-item::after {
      content: "";
      position: absolute;
      inset: -40% -40% auto auto;
      width: 280px;
      height: 280px;
      background: radial-gradient(circle, rgba(24, 99, 220, 0.15), transparent 70%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: -1;
    }

    .why-item:hover {
      transform: translateY(-4px);
      border-color: rgba(24, 99, 220, 0.35);
      background: #fff;
      box-shadow: 0 18px 50px -20px rgba(24, 99, 220, 0.35);
    }

    .why-item:hover::after {
      opacity: 1;
    }

    .why-item-num {
      position: absolute;
      top: 28px;
      right: 32px;
      font-family: var(--font-display);
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.12em;
      transition: color 0.3s ease, transform 0.3s ease;
    }

    .why-item:hover .why-item-num {
      color: var(--accent);
      transform: translateX(-2px);
    }

    .why-item-icon {
      width: 56px;
      height: 56px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(24, 99, 220, 0.18), rgba(24, 99, 220, 0.05));
      border: 1px solid rgba(24, 99, 220, 0.18);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .why-item:hover .why-item-icon {
      transform: rotate(-8deg) scale(1.08);
    }

    .why-item-icon::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 14px;
      box-shadow: 0 0 24px rgba(24, 99, 220, 0.3);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .why-item:hover .why-item-icon::after {
      opacity: 1;
    }

    .why-item-icon svg {
      width: 26px;
      height: 26px;
      stroke-width: 1.6;
      position: relative;
      z-index: 1;
      transition: transform 0.4s ease;
    }

    .why-item:hover .why-item-icon svg {
      transform: rotate(8deg);
    }

    .why-item h4 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      color: var(--fg);
      margin: 0;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    .why-item p {
      font-size: 15px;
      line-height: 1.65;
      color: var(--muted);
      margin: 0;
    }

    .platform-deprecated {
      padding: 0;
      background: var(--fg);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .platform-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 20% 80%, rgba(24, 99, 220, 0.15), transparent),
        radial-gradient(ellipse 50% 30% at 80% 20%, rgba(76, 110, 230, 0.1), transparent);
      z-index: 0;
    }

    .platform .container {
      position: relative;
      z-index: 1;
    }

    .platform .section-label {
      color: rgba(255, 255, 255, 0.5);
    }

    .platform .section-header h2 {
      color: white;
    }

    .platform .section-header p {
      color: rgba(255, 255, 255, 0.6);
      white-space: nowrap;
      max-width: none;
    }

    .platform-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }

    @media (max-width: 900px) {
      .platform-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
    }

    .platform-item {
      text-align: left;
      padding: 32px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius);
