<script>
// ========== Hero chat — typewriter cycling personal-finance prompts ==========
const prompts = [
  'ACB stock at 23k, should I buy now?',
  'I have 1B, want to buy 3B house in 2 years - invest how?',
  'Income 20M/month, how much rent to save enough?',
  'Any important news affecting VN market today?'
];
const inp = document.getElementById('heroInput');
const ghost = document.getElementById('ghostText');
let typeIdx = 0, charIdx = 0, isDel = false, typeTimer = null, userTyped = false;
function typeStep(){
  if (userTyped) return;
  const cur = prompts[typeIdx];
  let delay;
  if (!isDel) {
    charIdx++;
    ghost.textContent = cur.substring(0, charIdx);
    if (charIdx >= cur.length) { isDel = true; delay = 1800; }
    else delay = 40 + Math.random() * 40;
  } else {
    charIdx--;
    ghost.textContent = cur.substring(0, charIdx);
    if (charIdx <= 0) { isDel = false; typeIdx = (typeIdx + 1) % prompts.length; delay = 300; }
    else delay = 20;
  }
  typeTimer = setTimeout(typeStep, delay);
}
typeStep();
inp.addEventListener('input', () => {
  if (inp.value.length > 0 && !userTyped) { userTyped = true; clearTimeout(typeTimer); ghost.classList.add('hidden'); }
  else if (inp.value.length === 0 && userTyped) { userTyped = false; ghost.classList.remove('hidden'); ghost.textContent=''; typeIdx=0; charIdx=0; isDel=false; typeStep(); }
  inp.style.height='auto'; inp.style.height=Math.min(inp.scrollHeight,120)+'px';
});
function handleSend(){ if(inp.value.trim() || ghost.textContent) window.open('https://infina.ai','_blank'); }
function goNow(){ window.open('https://infina.ai','_blank'); }
inp.addEventListener('keydown', e=>{ if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); handleSend(); }});

// ========== Featured plan stepper — animated loop ==========
const planSteps = document.querySelectorAll('#planStepper .plan-step');
const planResult = document.getElementById('planResult');
if (planSteps.length > 0 && planResult) {
  function runPlanCycle(){
    // reset
    planSteps.forEach(s => s.classList.remove('show','active','done'));
    planResult.classList.remove('show');
    // reveal each
    planSteps.forEach((s, i) => setTimeout(() => s.classList.add('show'), 200 + i*120));
    // sequence active → done
    const totalSteps = planSteps.length;
    for (let i=0; i<totalSteps; i++) {
      setTimeout(() => {
        planSteps.forEach((s,j) => {
          s.classList.remove('active');
          if (j < i) s.classList.add('done');
          if (j === i) s.classList.add('active');
        });
      }, 800 + i*600);
    }
    // finalize
    setTimeout(() => {
      planSteps.forEach(s => { s.classList.remove('active'); s.classList.add('done'); });
      planResult.classList.add('show');
    }, 800 + totalSteps*600);
    // restart
    setTimeout(runPlanCycle, 800 + totalSteps*600 + 2200);
  }
  runPlanCycle();
}

