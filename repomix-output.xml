.personal-page .sm-msg-meta b { font-size: 13px; font-weight: 700; color: #1d1c1d; }
.personal-page .sm-msg-meta small { font-size: 11px; color: #616061; }
.personal-page .sm-ai-badge { display: inline-block; background: var(--accent-light); color: var(--accent); padding: 1px 6px; border-radius: 3px; font-size: 9.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; margin-left: 4px; }
.personal-page .sm-msg-text { font-size: 13.5px; color: #1d1c1d; line-height: 1.55; }
.personal-page .sm-msg-text b { color: var(--accent); }
.personal-page .sm-list { padding-left: 18px; margin-top: 6px; display: flex; flex-direction: column; gap: 3px; }
.personal-page .sm-list li { list-style: disc; font-size: 13px; }
.personal-page .sm-typing { display: inline-flex; gap: 3px; align-items: center; padding: 6px 0; }
.personal-page .sm-typing span { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); animation: personal-type-dot 1.4s ease-in-out infinite; }
.personal-page .sm-typing span:nth-child(2) { animation-delay: .15s; }
.personal-page .sm-typing span:nth-child(3) { animation-delay: .3s; }
.personal-page .sm-input { padding: 10px 16px 14px; border-top: 1px solid #e9e9e9; background: #fff; position: relative; }
.personal-page .sm-input-box { border: 1.5px solid #bbb; border-radius: 8px; padding: 9px 12px; font-size: 12.5px; color: #1d1c1d; background: #fff; min-height: 38px; position: relative; display: flex; align-items: center; }
.personal-page .sm-input-box.is-typing { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(24,99,220,.08); }
.personal-page .sm-input-typed { position: relative; color: #1d1c1d; }
.personal-page .sm-input-typed::after { content: ''; display: inline-block; width: 2px; height: 1em; background: var(--accent); margin-left: 1px; vertical-align: -2px; animation: personal-blink 1s step-end infinite; }
.personal-page .sm-input-placeholder { color: #9c9c9c; }
.personal-page .sm-cursor { position: absolute; width: 18px; height: 18px; pointer-events: none; z-index: 50; transition: all .9s cubic-bezier(.34,1.1,.64,1); opacity: 0; filter: drop-shadow(0 2px 6px rgba(15,23,42,.3)); }
.personal-page .sm-cursor.show { opacity: 1; }
.personal-page .sm-cursor svg { width: 100%; height: 100%; display: block; color: #1863dc; }
.personal-page .sm-cursor.click::after { content: ''; position: absolute; left: 9px; top: 9px; width: 0; height: 0; border-radius: 50%; background: rgba(24,99,220,.4); animation: personal-cursor-ripple .55s ease-out forwards; }
