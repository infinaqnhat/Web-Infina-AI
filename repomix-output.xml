      gap: 8px;
      padding: 14px 28px;
      background: var(--accent);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      border-radius: 10px;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(24,99,220,0.2);
