    .vsd-tc-msg.user .vsd-tc-bubble { background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
    .vsd-tc-msg.ai .vsd-tc-bubble { background: var(--surface); color: var(--fg-secondary); border-bottom-left-radius: 4px; }
    .vsd-tc-msg.ai .vsd-tc-bubble b { color: var(--accent); font-weight: 700; }

    .vsd-tc-input { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--accent-light); border-top: 1px solid rgba(24,99,220,.15); }
    .vsd-tc-mic { flex: 1; display: flex; align-items: center; gap: 10px; }
    .vsd-tc-wave { display: flex; gap: 3px; align-items: center; height: 22px; }
    .vsd-tc-wave i { width: 3px; background: var(--accent); border-radius: 99px; animation: vsd-wave 1.2s ease-in-out infinite; }
    .vsd-tc-wave i:nth-child(1) { height: 8px; animation-delay: 0s; }
    .vsd-tc-wave i:nth-child(2) { height: 16px; animation-delay: .15s; }
    .vsd-tc-wave i:nth-child(3) { height: 22px; animation-delay: .3s; }
    .vsd-tc-wave i:nth-child(4) { height: 14px; animation-delay: .45s; }
    .vsd-tc-wave i:nth-child(5) { height: 10px; animation-delay: .6s; }
    @keyframes vsd-wave { 0%,100% { transform: scaleY(.5); } 50% { transform: scaleY(1); } }
    .vsd-tc-mic-text { font-size: 12px; color: var(--accent); font-weight: 600; }
    .vsd-tc-dot { display: inline-block; animation: vsd-dot 1.4s ease-in-out infinite; opacity: 0; }
    .vsd-tc-dot:nth-child(2) { animation-delay: .2s; }
    .vsd-tc-dot:nth-child(3) { animation-delay: .4s; }
    @keyframes vsd-dot { 0%, 60%, 100% { opacity: 0; } 30% { opacity: 1; } }
    .vsd-tc-mic-btn { all: unset; cursor: pointer; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all .15s; }
    .vsd-tc-mic-btn:hover { background: var(--accent-dark, #0e4eb8); transform: scale(1.05); }
    .vsd-tc-mic-btn svg { width: 16px; height: 16px; }

    /* Travel inspiring images grid */
    .vsd-travel-inspire { display: flex; flex-direction: column; min-height: 460px; }
    .vsd-tc-inspire-hd { margin-bottom: 12px; }
    .vsd-tc-inspire-hd small { display: block; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
    .vsd-tc-inspire-hd b { font-family: var(--font-display); font-size: 15px; font-weight: 700; }
    .vsd-tc-imggrid { display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 130px; gap: 8px; flex: 1; }
    .vsd-tc-img { position: relative; border-radius: 12px; overflow: hidden; cursor: pointer; display: block; background: var(--surface); transition: transform .25s cubic-bezier(.16,1,.3,1); }
    .vsd-tc-img:hover { transform: translateY(-3px) scale(1.02); z-index: 2; }
    .vsd-tc-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s cubic-bezier(.16,1,.3,1); }
    .vsd-tc-img:hover img { transform: scale(1.05); }
    .vsd-tc-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,.7) 100%); pointer-events: none; }
    .vsd-tc-img-tag { position: absolute; top: 8px; left: 8px; background: rgba(255,255,255,.95); color: var(--accent); font-size: 9px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 3px 8px; border-radius: 99px; z-index: 2; }
    .vsd-tc-img-title { position: absolute; bottom: 8px; left: 10px; right: 10px; color: #fff; font-size: 11px; font-weight: 600; z-index: 2; }
    .vsd-tc-img-tall { grid-row: span 2; }
    .vsd-tc-img-wide { grid-column: span 2; }
    @media (max-width: 720px) {
      .vsd-tc-imggrid { grid-auto-rows: 110px; }
    }

    /* Law — contract review */
    .vsd-law-doc { display: flex; flex-direction: column; gap: 6px; padding: 12px; background: var(--surface); border-radius: 8px; margin-bottom: 12px; }
    .vsd-law-line { height: 6px; background: var(--border-light); border-radius: 2px; }
    .vsd-law-line.short { width: 60%; }
    .vsd-law-line.highlight { height: auto; padding: 8px 10px; background: rgba(217,119,6,.1); border-radius: 6px; font-size: 11px; color: var(--fg-secondary); border-left: 3px solid #d97706; line-height: 1.4; display: flex; flex-direction: column; gap: 4px; }
    .vsd-law-line.highlight.ok { background: var(--accent-light); border-left-color: var(--accent); }
    .vsd-law-tag { display: inline-block; font-size: 8.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 2px 6px; border-radius: 99px; align-self: flex-start; }
    .vsd-law-tag.warn { background: #d97706; color: #fff; }
    .vsd-law-tag.ok { background: var(--accent); color: #fff; }

    @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(1.3); } }
    /* ─── Panel tabs (multi-screen demos) ─── */
    .vsd-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; padding: 4px; background: var(--surface); border-radius: 10px; }
    .vsd-tab { all: unset; cursor: pointer; padding: 7px 12px; border-radius: 7px; font-size: 12px; font-weight: 600; color: var(--muted); transition: all .15s; text-align: center; }
    .vsd-tab:hover { color: var(--fg); }
    .vsd-tab.active { background: #fff; color: var(--accent); box-shadow: 0 1px 3px rgba(15,23,42,.06); }
    .vsd-screens { position: relative; min-height: 380px; }
    .vsd-screen { display: none; opacity: 0; animation: vsd-fade-in .35s cubic-bezier(.16,1,.3,1) forwards; }
    .vsd-screen.active { display: flex; align-items: flex-start; justify-content: center; }
    @keyframes vsd-fade-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    .vspec-demo { flex-direction: column; align-items: stretch; min-height: 460px; }

    /* ─── Net worth / Holdings card (Finance / Stocks / Funds) ─── */
    .vsd-net { width: 100%; max-width: 440px; }
    .vsd-net-hero { background: linear-gradient(135deg, var(--accent), #4c6ee6); color: #fff; border-radius: 16px; padding: 20px 22px 22px; margin-bottom: 12px; box-shadow: 0 24px 48px -20px rgba(24,99,220,.4); }
    .vsd-net-hero small { font-size: 10px; text-transform: uppercase; letter-spacing: .1em; opacity: .8; }
    .vsd-net-hero b { display: block; font-family: var(--font-display); font-size: 26px; font-weight: 700; letter-spacing: -.02em; margin: 6px 0 4px; }
    .vsd-net-hero .up { font-size: 12px; opacity: .9; }
    .vsd-net-breakdown { background: #fff; border: 1px solid var(--border-light); border-radius: 14px; padding: 14px 16px; }
    .vsd-net-row { display: grid; grid-template-columns: 12px 1fr auto auto; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border-light); font-size: 12px; }
    .vsd-net-row:last-child { border-bottom: none; }
    .vsd-net-dot { width: 10px; height: 10px; border-radius: 3px; background: var(--accent); }
    .vsd-net-dot.alt2 { background: #4c6ee6; }
    .vsd-net-dot.alt3 { background: #6fa8ff; }
    .vsd-net-dot.alt4 { background: #94a3b8; }
    .vsd-net-row .nm { color: var(--fg-secondary); font-weight: 500; }
    .vsd-net-row .amt { font-variant-numeric: tabular-nums; color: var(--fg); font-weight: 600; }
    .vsd-net-row .pct { color: var(--muted); font-size: 11px; }

    /* ─── Generic chat (compact) ─── */
    .vsd-chat { width: 100%; max-width: 380px; background: #fff; border: 1px solid var(--border-light); border-radius: 14px; padding: 14px; box-shadow: 0 16px 32px -16px rgba(15,23,42,.14); }
    .vsd-chat-msg { display: flex; gap: 8px; margin-bottom: 10px; align-items: flex-start; }
    .vsd-chat-msg.user { justify-content: flex-end; }
    .vsd-chat-bubble { max-width: 78%; padding: 8px 11px; font-size: 12px; line-height: 1.5; border-radius: 11px; }
    .vsd-chat-msg.user .vsd-chat-bubble { background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
    .vsd-chat-msg.ai .vsd-chat-bubble { background: var(--surface); color: var(--fg-secondary); border-bottom-left-radius: 4px; }
    .vsd-chat-bubble b { color: var(--accent); font-weight: 700; }
    .vsd-chat-msg.user .vsd-chat-bubble b { color: #fff; }
    .vsd-chat-input { margin-top: 10px; padding: 9px 12px; background: var(--surface); border-radius: 10px; font-size: 11.5px; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
    .vsd-chat-input::after { content: '→'; color: var(--accent); font-weight: 700; }

    /* ─── Learn / Knowledge cards ─── */
    .vsd-learn { width: 100%; max-width: 420px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .vsd-learn-card { background: #fff; border: 1px solid var(--border-light); border-radius: 12px; padding: 14px; transition: all .2s; cursor: pointer; }
    .vsd-learn-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 10px 24px -10px rgba(24,99,220,.18); }
    .vsd-learn-card span { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: 8px; }
    .vsd-learn-card b { display: block; font-size: 13px; font-weight: 700; color: var(--fg); line-height: 1.35; margin-bottom: 6px; }
    .vsd-learn-card small { font-size: 11px; color: var(--muted); line-height: 1.5; display: block; }
    .vsd-learn-card.wide { grid-column: span 2; background: var(--accent-light); border-color: rgba(24,99,220,.2); }

    /* ─── Mini transaction list shared ─── */
    .vsd-list { width: 100%; max-width: 380px; background: #fff; border: 1px solid var(--border-light); border-radius: 14px; padding: 14px 16px; box-shadow: 0 16px 32px -16px rgba(15,23,42,.14); }
    /* Auto-cycle tab progress indicator */
    .vsd-tabs { position: relative; }
    .vsd-tab.active { position: relative; }
    .vsd-tab.active::after {
      content: '';
      position: absolute;
      left: 8px; right: 8px; bottom: 4px;
      height: 2px;
      background: var(--accent);
      border-radius: 99px;
      transform-origin: left;
      animation: vsd-progress 4.2s linear forwards;
    }
    @keyframes vsd-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .vspec-panel[data-paused="true"] .vsd-tab.active::after { animation-play-state: paused; }

    /* "AUTO" badge */
    .vspec-panel::before {
      content: 'Auto demo · hover to pause';
      position: absolute;
      top: 16px; right: 20px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      z-index: 3;
    }
    .vspec-panel { position: relative; }

    /* === MOBILE RESPONSIVE OVERRIDES === */

    /* P1-1: Lead section decorative blobs — overflow viewport on mobile */
    @media (max-width: 768px) {
      .lead-section::before, .lead-section::after { display: none; }
    }

    /* P1-2: Hero decorative shapes — 350×350 and 250×250 overflow on mobile */
    @media (max-width: 768px) {
      .shape-1, .shape-2 { display: none; }
    }

    /* P1-3: CTA section blob — reduce at 768px, hide at 600px */
    @media (max-width: 768px) {
      .cta-section::before { width: 400px; height: 400px; }
    }
    @media (max-width: 600px) {
      .cta-section::before { display: none; }
    }

    /* P1-4: Lead form row 2 — collapse to single col at 768px (already 1fr at 480px) */
    @media (max-width: 768px) {
      .lead-row-2 { grid-template-columns: 1fr; gap: 12px; }
    }

    /* P2-5: Why Inside orbit visual — shrink for mobile */
    @media (max-width: 768px) {
      .why-visual { max-width: 280px; }
      .why-orbit { width: 200px; height: 200px; margin: -100px 0 0 -100px; }
      .why-node { width: 60px; height: 60px; }
    }

    /* P2-6: Why Inside headline — reduce fixed 48px font size */
    @media (max-width: 768px) {
      .why-inside-headline { font-size: 36px; }
    }
    @media (max-width: 480px) {
      .why-inside-headline { font-size: 28px; }
    }

    /* P2-7: VSD wallet actions — collapse repeat(4,1fr) grid */
    @media (max-width: 768px) {
      .vsd-wallet-actions { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 480px) {
      .vsd-wallet-actions { grid-template-columns: 1fr; }
    }

    /* P2-8: VSD travel image grid — collapse 2-col to 1-col */
    @media (max-width: 600px) {
      .vsd-tc-imggrid { grid-template-columns: 1fr; }
    }

    /* P2-9: VSD learn cards — collapse repeat(2,1fr) to single col */
    @media (max-width: 600px) {
      .vsd-learn { grid-template-columns: 1fr; }
    }

    /* P2-10: Container padding — reduce side padding on small screens */
    @media (max-width: 480px) {
      .container, .container-wide, .nav-inner, .footer-inner { padding-left: 16px; padding-right: 16px; }
    }

    /* P2-11: Hero padding — keep padding-top above fixed nav (72px) on small screens */
    @media (max-width: 480px) {
      .core#hero { padding-top: 88px; padding-bottom: 60px; }
    }

    /* ===== Mobile nav panel ===== */
    .nav-mobile-panel { display: none; }
    @media (max-width: 768px) {
      .nav-mobile-panel {
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 72px;
        left: 0;
        right: 0;
        background: rgba(255, 255, 255, 0.98);
        -webkit-backdrop-filter: blur(20px);
        backdrop-filter: blur(20px);
        padding: 8px 24px 20px;
        gap: 0;
        border-bottom: 1px solid var(--border-light);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        transform: translateY(-12px);
        opacity: 0;
        visibility: hidden;
        transition: transform 0.25s ease, opacity 0.25s ease, visibility 0.25s ease;
        z-index: 999;
      }
      body.nav-open .nav-mobile-panel {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }
      .nav-mobile-panel a {
        padding: 14px 6px;
        font-size: 16px;
        font-weight: 500;
        color: var(--fg-secondary);
        border-bottom: 1px solid var(--border-light);
      }
      .nav-mobile-panel a:last-child { border-bottom: none; }
      .nav-mobile-panel a.nav-mobile-cta {
        margin-top: 14px;
        text-align: center;
        justify-content: center;
        background: var(--accent);
        color: #fff;
        padding: 14px 24px;
        border-radius: 9999px;
        border: none;
        font-weight: 600;
      }
      body.nav-open { overflow: hidden; }
    }

  </style>

  

  

  
