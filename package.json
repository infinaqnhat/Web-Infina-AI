{
  "name": "web-infina-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source-of-truth marketing UI (static HTML) for Infina AI. See docs/ui-spec/ for the living UI contract synced to apps/infina-ai.",
  "scripts": {
    "setup:assets": "node scripts/setup-harness-assets.mjs",
    "predev": "node scripts/setup-harness-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/setup-harness-assets.mjs",
    "build": "vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "spec": "node scripts/extract-ui-spec.mjs",
    "spec:scaffold": "node scripts/extract-ui-spec.mjs --scaffold",
    "spec:check": "node scripts/extract-ui-spec.mjs --check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "node-html-parser": "^7.0.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
